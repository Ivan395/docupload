                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        btn_reset_sort := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_reset_sorting(); }
                        }
                    }

                    Rectangle {
                        height: 30px;
                        width: 100px;
                        border-radius: 5px;
                        background: btn_ok_sort.has-hover ? #1d4ed8 : #2563eb;

                        Text {
                            text: "Listo / Cerrar";
                            font-size: 11px;
                            font-weight: 700;
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        btn_ok_sort := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_close_sort_modal(); }
                        }
                    }
                }
            }
        }
