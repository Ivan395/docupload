    // Modal de Filtro y Selección de Empleados Seleccionados
    if AppData.show_reporte_emp_modal : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #00000066;

        TouchArea { }

        Rectangle {
            width: 530px;
            border-radius: 12px;
            background: #ffffff;
            border-width: 1px;
            border-color: #cbd5e1;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                // Cabecera
                HorizontalLayout {
                    alignment: space-between;
                    cross-axis-alignment: center;

                    HorizontalLayout {
                        spacing: 8px;
                        cross-axis-alignment: center;
                        Text { text: "👥"; font-size: 16px; vertical-alignment: center; }
                        Text {
                            text: "Explorar y Filtrar Empleados Seleccionados";
                            font-size: 15px;
                            font-weight: 800;
                            color: #0f172a;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: btn_close_emp_m.has-hover ? #f1f5f9 : transparent;

                        Text { text: "✕"; font-size: 13px; font-weight: 700; color: #64748b; horizontal-alignment: center; vertical-alignment: center; }
                        btn_close_emp_m := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_close_empleados_filter_modal(); }
                        }
                    }
                }

                // Resumen de trabajadores (compacto con ScrollView para no agrandar la ventana)
                Rectangle {
                    border-radius: 6px;
                    background: #f8fafc;
                    border-width: 1px;
                    border-color: #e2e8f0;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 3px;
                        Text {
                            text: "Trabajadores seleccionados (" + AppData.reporte_emp_modal_worker_count + "):";
                            font-size: 11px;
                            font-weight: 800;
                            color: #1e293b;
                        }
                        Rectangle {
                            height: 52px;
                            border-radius: 4px;
                            background: #ffffff;
                            border-width: 1px;
                            border-color: #cbd5e1;
                            clip: true;

                            ScrollView {
                                width: 100%;
                                height: 100%;
                                Text {
                                    text: AppData.reporte_emp_modal_worker_names_str;
                                    font-size: 11px;
                                    color: #334155;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }

                // Botón Acción Rápida: Seleccionar en Todos sus Meses
                Rectangle {
                    height: 32px;
                    border-radius: 5px;
                    background: btn_sel_all_months.has-hover ? #dbeafe : #eff6ff;
                    border-width: 1.5px;
                    border-color: #3b82f6;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        cross-axis-alignment: center;

                        Text { text: "📅"; font-size: 12px; vertical-alignment: center; }
                        Text {
                            text: "Seleccionar Todas sus Apariciones en Todos los Meses (" + AppData.reporte_emp_modal_total_occurrences + " filas)";
                            font-size: 11px;
                            font-weight: 800;
                            color: #1d4ed8;
                            vertical-alignment: center;
                        }
                    }

                    btn_sel_all_months := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            AppLogic.reporte_select_all_months_for_selected_employees();
                        }
                    }
                }

                // Sección 1: Filtro por Meses
                VerticalLayout {
                    spacing: 4px;
                    HorizontalLayout {
                        alignment: space-between;
                        cross-axis-alignment: center;
                        Text { text: "🗓 Meses en los que aparecen:"; font-size: 11px; font-weight: 800; color: #1e293b; }

                        HorizontalLayout {
                            spacing: 6px;
                            Rectangle {
                                height: 22px;
                                border-radius: 4px;
                                background: AppData.reporte_emp_filter_all_months ? #2563eb : #e2e8f0;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: "Todos los meses";
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: AppData.reporte_emp_filter_all_months ? #ffffff : #475569;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { AppLogic.reporte_set_emp_filter_all_months(true); }
                                }
                            }
                            Rectangle {
                                height: 22px;
                                border-radius: 4px;
                                background: !AppData.reporte_emp_filter_all_months ? #2563eb : #e2e8f0;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: "Algunos meses";
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: !AppData.reporte_emp_filter_all_months ? #ffffff : #475569;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { AppLogic.reporte_set_emp_filter_all_months(false); }
                                }
                            }
                        }
                    }

                    if !AppData.reporte_emp_filter_all_months : Rectangle {
                        height: 75px;
                        border-radius: 5px;
                        background: #f8fafc;
                        border-width: 1px;
                        border-color: #cbd5e1;

                        ScrollView {
                            VerticalLayout {
                                padding: 4px;
                                spacing: 3px;
                                for m_item in AppData.reporte_emp_modal_meses : Rectangle {
                                    height: 22px;
                                    border-radius: 4px;
                                    background: m_item.selected ? #dbeafe : transparent;

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        spacing: 6px;
                                        cross-axis-alignment: center;

                                        Rectangle {
                                            width: 14px;
                                            height: 14px;
                                            border-radius: 3px;
                                            background: m_item.selected ? #2563eb : #ffffff;
                                            border-width: 1px;
                                            border-color: m_item.selected ? #2563eb : #94a3b8;

                                            Text {
                                                text: "✓";
                                                font-size: 9px;
                                                font-weight: 800;
                                                color: #ffffff;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                visible: m_item.selected;
                                            }
                                        }

                                        Text {
                                            text: m_item.label + " (" + m_item.count + ")";
                                            font-size: 11px;
                                            font-weight: m_item.selected ? 700 : 500;
                                            color: #1e293b;
                                            vertical-alignment: center;
                                        }
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { AppLogic.reporte_toggle_emp_filter_month(m_item.id); }
                                    }
                                }
                            }
                        }
                    }
                }

                // Sección 2: Filtro por Registros de Obra
                VerticalLayout {
                    spacing: 4px;
                    HorizontalLayout {
                        alignment: space-between;
                        cross-axis-alignment: center;
                        Text { text: "🏗 Registros de Obra en los que aparecen:"; font-size: 11px; font-weight: 800; color: #1e293b; }

                        HorizontalLayout {
                            spacing: 6px;
                            Rectangle {
                                height: 22px;
                                border-radius: 4px;
                                background: AppData.reporte_emp_filter_all_obras ? #2563eb : #e2e8f0;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: "Todas las obras";
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: AppData.reporte_emp_filter_all_obras ? #ffffff : #475569;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { AppLogic.reporte_set_emp_filter_all_obras(true); }
                                }
                            }
                            Rectangle {
                                height: 22px;
                                border-radius: 4px;
                                background: !AppData.reporte_emp_filter_all_obras ? #2563eb : #e2e8f0;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: "Algunas obras";
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: !AppData.reporte_emp_filter_all_obras ? #ffffff : #475569;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { AppLogic.reporte_set_emp_filter_all_obras(false); }
                                }
                            }
                        }
                    }

                    if !AppData.reporte_emp_filter_all_obras : Rectangle {
                        height: 75px;
                        border-radius: 5px;
                        background: #f8fafc;
                        border-width: 1px;
                        border-color: #cbd5e1;

                        ScrollView {
                            VerticalLayout {
                                padding: 4px;
                                spacing: 3px;
                                for o_item in AppData.reporte_emp_modal_obras : Rectangle {
                                    height: 22px;
                                    border-radius: 4px;
                                    background: o_item.selected ? #dbeafe : transparent;

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        spacing: 6px;
                                        cross-axis-alignment: center;

                                        Rectangle {
                                            width: 14px;
                                            height: 14px;
                                            border-radius: 3px;
                                            background: o_item.selected ? #2563eb : #ffffff;
                                            border-width: 1px;
                                            border-color: o_item.selected ? #2563eb : #94a3b8;

                                            Text {
                                                text: "✓";
                                                font-size: 9px;
                                                font-weight: 800;
                                                color: #ffffff;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                visible: o_item.selected;
                                            }
                                        }

                                        Text {
                                            text: o_item.label + " (" + o_item.count + ")";
                                            font-size: 11px;
                                            font-weight: o_item.selected ? 700 : 500;
                                            color: #1e293b;
                                            vertical-alignment: center;
                                        }
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { AppLogic.reporte_toggle_emp_filter_obra(o_item.id); }
                                    }
                                }
                            }
                        }
                    }
                }

                // Botones Inferiores
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    cross-axis-alignment: center;

                    if AppData.reporte_emp_filter_active : Rectangle {
                        height: 32px;
                        width: 110px;
                        border-radius: 5px;
                        background: btn_clr_emp_f.has-hover ? #fee2e2 : #f8fafc;
                        border-width: 1px;
                        border-color: #cbd5e1;

                        Text { text: "Limpiar Filtro"; font-size: 11px; font-weight: 700; color: #dc2626; horizontal-alignment: center; vertical-alignment: center; }
                        btn_clr_emp_f := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_clear_emp_filter(); }
                        }
                    }

                    Rectangle {
                        height: 32px;
                        width: 80px;
                        border-radius: 5px;
                        background: btn_cancel_emp_m.has-hover ? #e2e8f0 : #f1f5f9;
                        border-width: 1px;
                        border-color: #cbd5e1;

                        Text { text: "Cancelar"; font-size: 11px; font-weight: 700; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                        btn_cancel_emp_m := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_close_empleados_filter_modal(); }
                        }
                    }

                    Rectangle {
                        height: 32px;
                        width: 125px;
                        border-radius: 5px;
                        background: btn_apply_emp_m.has-hover ? #1d4ed8 : #2563eb;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            cross-axis-alignment: center;
                            Text { text: "🔍"; font-size: 11px; vertical-alignment: center; }
                            Text { text: "Aplicar Filtro"; font-size: 11px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                        }

                        btn_apply_emp_m := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_apply_emp_filter(); }
                        }
                    }
                }
            }
        }
    }

    // Modal de Selección Rápida por Registro de Obra
    if AppData.show_reporte_select_obras_modal : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #00000066;

        TouchArea { }

        Rectangle {
            width: 460px;
            border-radius: 10px;
            background: #ffffff;
            border-width: 1px;
            border-color: #cbd5e1;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                // Cabecera
                HorizontalLayout {
                    alignment: space-between;
                    cross-axis-alignment: center;

                    HorizontalLayout {
                        spacing: 8px;
                        cross-axis-alignment: center;
                        Text { text: "🏗️"; font-size: 16px; vertical-alignment: center; }
                        Text {
                            text: "Selección Rápida por Obra";
                            font-size: 14px;
                            font-weight: 800;
                            color: #0f172a;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: btn_close_sel_obras.has-hover ? #f1f5f9 : transparent;

                        Text { text: "✕"; font-size: 12px; font-weight: 700; color: #64748b; horizontal-alignment: center; vertical-alignment: center; }
                        btn_close_sel_obras := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_close_select_obras_modal(); }
                        }
                    }
                }

                Text {
                    text: "Elige uno o más registros de obra para seleccionar a los empleados asignados a ellas:";
                    font-size: 11px;
                    color: #64748b;
                    wrap: word-wrap;
                }

                // Botones rápidos: Marcar Todas / Desmarcar Todas
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Rectangle {
                        height: 26px;
                        border-radius: 4px;
                        background: btn_sel_all_obras_opt.has-hover ? #dbeafe : #eff6ff;
                        border-width: 1px;
                        border-color: #93c5fd;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            cross-axis-alignment: center;
                            Text {
                                text: "Marcar Todas";
                                font-size: 10px;
                                font-weight: 700;
                                color: #1d4ed8;
                                vertical-alignment: center;
                            }
                        }

                        btn_sel_all_obras_opt := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_quick_select_all_obras(true); }
                        }
                    }

                    Rectangle {
                        height: 26px;
                        border-radius: 4px;
                        background: btn_desel_all_obras_opt.has-hover ? #f1f5f9 : #ffffff;
                        border-width: 1px;
                        border-color: #cbd5e1;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            cross-axis-alignment: center;
                            Text {
                                text: "Desmarcar Todas";
                                font-size: 10px;
                                font-weight: 700;
                                color: #475569;
                                vertical-alignment: center;
                            }
                        }

                        btn_desel_all_obras_opt := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_quick_select_all_obras(false); }
                        }
                    }
                }

                // Lista de Obras con checkboxes
                Rectangle {
                    height: 210px;
                    border-radius: 6px;
                    background: #f8fafc;
                    border-width: 1px;
                    border-color: #e2e8f0;
                    clip: true;

                    ScrollView {
                        VerticalLayout {
                            padding: 6px;
                            spacing: 4px;

                            for item in AppData.reporte_quick_select_obras : Rectangle {
                                height: 34px;
                                border-radius: 4px;
                                background: item.selected ? #eff6ff : (touch_item_obra.has-hover ? #f1f5f9 : #ffffff);
                                border-width: 1px;
                                border-color: item.selected ? #3b82f6 : #e2e8f0;

                                touch_item_obra := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { AppLogic.reporte_toggle_quick_select_obra(item.id); }
                                }

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    alignment: space-between;
                                    cross-axis-alignment: center;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        cross-axis-alignment: center;

                                        Rectangle {
                                            width: 16px;
                                            height: 16px;
                                            border-radius: 3px;
                                            background: item.selected ? #2563eb : #ffffff;
                                            border-width: 1px;
                                            border-color: item.selected ? #2563eb : #cbd5e1;

                                            Text {
                                                text: "✓";
                                                font-size: 10px;
                                                font-weight: 800;
                                                color: #ffffff;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                visible: item.selected;
                                            }
                                        }

                                        Text {
                                            text: item.label;
                                            font-size: 11px;
                                            font-weight: item.selected ? 700 : 500;
                                            color: item.selected ? #1e40af : #1e293b;
                                            vertical-alignment: center;
                                        }
                                    }

                                    Rectangle {
                                        height: 20px;
                                        border-radius: 10px;
                                        background: item.selected ? #dbeafe : #f1f5f9;

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            cross-axis-alignment: center;
                                            Text {
                                                text: item.count + " empleados";
                                                font-size: 10px;
                                                font-weight: 600;
                                                color: item.selected ? #1d4ed8 : #64748b;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Botones de acción
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    cross-axis-alignment: center;

                    Rectangle {
                        height: 32px;
                        width: 80px;
                        border-radius: 5px;
                        background: btn_cancel_sel_obras.has-hover ? #e2e8f0 : #f1f5f9;
                        border-width: 1px;
                        border-color: #cbd5e1;

                        Text { text: "Cancelar"; font-size: 11px; font-weight: 700; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                        btn_cancel_sel_obras := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_close_select_obras_modal(); }
                        }
                    }

                    Rectangle {
                        height: 32px;
                        width: 145px;
                        border-radius: 5px;
                        background: btn_apply_sel_obras.has-hover ? #1d4ed8 : #2563eb;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            cross-axis-alignment: center;
                            Text { text: "☑️"; font-size: 11px; vertical-alignment: center; }
                            Text { text: "Aplicar Selección"; font-size: 11px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                        }

                        btn_apply_sel_obras := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_apply_quick_select_obras(); }
                        }
                    }
                }
            }
        }
    }

    // Modal de Exportación a SUA
    if AppData.show_reporte_export_sua_modal : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #00000066;

        TouchArea { }

        Rectangle {
            width: 530px;
            border-radius: 10px;
            background: #ffffff;
            border-width: 1px;
            border-color: #cbd5e1;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                // Cabecera
                HorizontalLayout {
                    alignment: space-between;
                    cross-axis-alignment: center;

                    HorizontalLayout {
                        spacing: 8px;
                        cross-axis-alignment: center;
                        Text { text: "📄"; font-size: 18px; vertical-alignment: center; }
                        VerticalLayout {
                            spacing: 1px;
                            Text {
                                text: "Exportar Archivos para SUA (IMSS)";
                                font-size: 15px;
                                font-weight: 800;
                                color: #0f172a;
                            }
                            Text {
                                text: "Generación de archivos .TXT compatibles con el Sistema Único de Autodeterminación";
                                font-size: 11px;
                                color: #64748b;
                            }
                        }
                    }

                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: btn_close_export_sua.has-hover ? #f1f5f9 : transparent;

                        Text { text: "✕"; font-size: 12px; font-weight: 700; color: #64748b; horizontal-alignment: center; vertical-alignment: center; }
                        btn_close_export_sua := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_cerrar_modal_exportar_sua(); }
                        }
                    }
                }

                // Explicación
                Rectangle {
                    border-radius: 6px;
                    background: #f8fafc;
                    border-width: 1px;
                    border-color: #e2e8f0;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;
                        Text {
                            text: "Selecciona los registros de obra para filtrar los empleados a exportar:";
                            font-size: 11.5px;
                            font-weight: 700;
                            color: #334155;
                        }
                        Text {
                            text: "Por defecto se encuentran seleccionadas las obras creadas por el usuario en esta revisión. Los empleados no vinculados a las obras seleccionadas serán excluidos.";
                            font-size: 11px;
                            color: #64748b;
                            wrap: word-wrap;
                        }
                    }
                }

                // Botones rápidos: Marcar Todas / Desmarcar Todas
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    cross-axis-alignment: center;

                    Rectangle {
                        height: 26px;
                        border-radius: 4px;
                        background: btn_sel_all_sua.has-hover ? #fef3c7 : #fffbeb;
                        border-width: 1px;
                        border-color: #fcd34d;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            cross-axis-alignment: center;
                            Text {
                                text: "Marcar Todas";
                                font-size: 10px;
                                font-weight: 700;
                                color: #b45309;
                                vertical-alignment: center;
                            }
                        }

                        btn_sel_all_sua := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_sua_select_all_obras(true); }
                        }
                    }

                    Rectangle {
                        height: 26px;
                        border-radius: 4px;
                        background: btn_desel_all_sua.has-hover ? #f1f5f9 : #ffffff;
                        border-width: 1px;
                        border-color: #cbd5e1;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            cross-axis-alignment: center;
                            Text {
                                text: "Desmarcar Todas";
                                font-size: 10px;
                                font-weight: 700;
                                color: #475569;
                                vertical-alignment: center;
                            }
                        }

                        btn_desel_all_sua := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_sua_select_all_obras(false); }
                        }
                    }

                    Text {
                        text: "(" + AppData.reporte_sua_selected_count + " obras • " + AppData.reporte_sua_total_empleados_filtrados + " empleados)";
                        font-size: 11px;
                        font-weight: 600;
                        color: #1e3a8a;
                        vertical-alignment: center;
                    }
                }

                // Lista de Obras con checkboxes
                Rectangle {
                    height: 180px;
                    border-radius: 6px;
                    background: #f8fafc;
                    border-width: 1px;
                    border-color: #e2e8f0;
                    clip: true;

                    ScrollView {
                        VerticalLayout {
                            padding: 6px;
                            spacing: 4px;

                            for item in AppData.reporte_sua_obras : Rectangle {
                                height: 42px;
                                border-radius: 5px;
                                background: item.selected ? #eff6ff : (touch_item_sua.has-hover ? #f1f5f9 : #ffffff);
                                border-width: 1px;
                                border-color: item.selected ? #3b82f6 : #e2e8f0;

                                touch_item_sua := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { AppLogic.reporte_toggle_sua_obra(item.id); }
                                }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: space-between;
                                    cross-axis-alignment: center;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        cross-axis-alignment: center;

                                        Rectangle {
                                            width: 16px;
                                            height: 16px;
                                            border-radius: 3px;
                                            background: item.selected ? #2563eb : #ffffff;
                                            border-width: 1px;
                                            border-color: item.selected ? #2563eb : #cbd5e1;

                                            Text {
                                                text: "✓";
                                                font-size: 10px;
                                                font-weight: 800;
                                                color: #ffffff;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                visible: item.selected;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 1px;

                                            HorizontalLayout {
                                                spacing: 6px;
                                                cross-axis-alignment: center;
                                                Text {
                                                    text: item.numero;
                                                    font-size: 12px;
                                                    font-weight: 800;
                                                    color: item.selected ? #1d4ed8 : #1e293b;
                                                }
                                                if item.tipo_obra != "" : Text {
                                                    text: "- " + item.tipo_obra;
                                                    font-size: 11px;
                                                    font-weight: 500;
                                                    color: #64748b;
                                                }
                                                if item.creado_usuario : Rectangle {
                                                    height: 16px;
                                                    border-radius: 3px;
                                                    background: #dcfce7;
                                                    border-width: 1px;
                                                    border-color: #86efac;
                                                    HorizontalLayout {
                                                        padding-left: 4px;
                                                        padding-right: 4px;
                                                        Text { text: "Obra Usuario"; font-size: 9px; font-weight: 700; color: #166534; vertical-alignment: center; }
                                                    }
                                                }
                                            }

                                            if item.vigencia != "" : Text {
                                                text: "📅 " + item.vigencia;
                                                font-size: 10px;
                                                font-weight: 500;
                                                color: #047857;
                                            }
                                        }
                                    }

                                    Rectangle {
                                        height: 20px;
                                        border-radius: 10px;
                                        background: item.selected ? #dbeafe : #f1f5f9;

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            cross-axis-alignment: center;
                                            Text {
                                                text: item.empleados_count + " empleados";
                                                font-size: 10px;
                                                font-weight: 600;
                                                color: item.selected ? #1d4ed8 : #64748b;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Resumen de archivos a generar
                Rectangle {
                    border-radius: 6px;
                    background: #fefce8;
                    border-width: 1px;
                    border-color: #fef08a;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 2px;
                        Text {
                            text: "Archivos que se generarán en la carpeta de destino:";
                            font-size: 11px;
                            font-weight: 700;
                            color: #854d0e;
                        }
                        Text {
                            text: "• ASEG_<Folio>.TXT (Altas de trabajadores)   • AFIL_<Folio>.TXT (Datos afiliatorios)\n• MOVT_<Folio>.TXT (Movimientos/salarios)     • CRED_<Folio>.TXT (Créditos Infonavit)\n• INCAP.TXT (Incapacidades médicas)";
                            font-size: 10px;
                            color: #713f12;
                        }
                    }
                }

                // Botones de acción
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    cross-axis-alignment: center;

                    Rectangle {
                        height: 34px;
                        width: 90px;
                        border-radius: 5px;
                        background: btn_cancel_sua.has-hover ? #e2e8f0 : #f1f5f9;
                        border-width: 1px;
                        border-color: #cbd5e1;

                        Text { text: "Cancelar"; font-size: 12px; font-weight: 700; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                        btn_cancel_sua := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_cerrar_modal_exportar_sua(); }
                        }
                    }

                    Rectangle {
                        height: 34px;
                        width: 180px;
                        border-radius: 5px;
                        background: btn_submit_sua.has-hover ? #b45309 : #d97706;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            cross-axis-alignment: center;
                            Text { text: "💾"; font-size: 12px; vertical-alignment: center; }
                            Text { text: "Generar Archivos SUA"; font-size: 12px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                        }

                        btn_submit_sua := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_generar_sua(); }
                        }
                    }
                }
            }
        }
    }
}
