                            font-size: 13px;
                            font-weight: 700;
                            color: #ffffff;
                            vertical-alignment: center;
                        }
                    }

                    btn_excel := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppLogic.exportar_reporte_liquidaciones_excel(); }
                    }
