                        mouse-cursor: pointer;
                        clicked => { AppLogic.reporte_toggle_sort_criterion("rfc"); }
                    }

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: space-between;
                        cross-axis-alignment: center;

                        HorizontalLayout {
                            spacing: 8px;
                            cross-axis-alignment: center;

                            Rectangle {
                                width: 16px;
                                height: 16px;
                                border-radius: 3px;
                                background: AppData.reporte_sort_by_rfc ? #2563eb : #ffffff;
                                border-width: 1px;
                                border-color: AppData.reporte_sort_by_rfc ? #2563eb : #cbd5e1;

                                Text {
                                    text: "✓";
                                    font-size: 10px;
                                    font-weight: 800;
                                    color: #ffffff;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    visible: AppData.reporte_sort_by_rfc;
                                }
                            }

                            Text {
                                text: "4. RFC / CURP";
                                font-size: 12px;
                                font-weight: 700;
                                color: AppData.reporte_sort_by_rfc ? #1e40af : #334155;
                                vertical-alignment: center;
                            }
                        }

                        if AppData.reporte_sort_by_rfc : Rectangle {
                            height: 22px;
                            border-radius: 4px;
                            background: btn_dir_rfc.has-hover ? #dbeafe : #ffffff;
                            border-width: 1px;
                            border-color: #93c5fd;

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                cross-axis-alignment: center;
                                Text {
                                    text: AppData.reporte_sort_rfc_asc ? "▲ A → Z" : "▼ Z → A";
                                    font-size: 10px;
                                    font-weight: 700;
