import { ScrollView, ListView, Button, LineEdit, ComboBox, CheckBox } from "std-widgets.slint";
import { AppData, AppLogic, ReporteLiquidacionRow, ReporteObraItem, ReporteEditObraItem, ReporteBatchWorkerItem, ReporteSelectedItem, ReporteUniqueEmpleadoItem } from "models.slint";
component ReporteNumericCell inherits Rectangle {
    in property <string> curr_str: "$0.00";
    in property <string> orig_str: "$0.00";
    in property <bool> has_prorrateo: false;
    in property <length> cell_width: 85px;
    in property <color> text_color: #334155;
    in property <int> font_weight: 400;

    width: root.cell_width;
    height: 34px;
    border-radius: 4px;
    background: (root.has_prorrateo && cell_touch.has-hover) ? #e0f2fe : transparent;
    border-width: (root.has_prorrateo && cell_touch.has-hover) ? 1px : 0px;
    border-color: #bae6fd;

    VerticalLayout {
        alignment: center;
        spacing: 0px;
        padding-right: 4px;

        Text {
            text: root.curr_str;
            font-size: root.has_prorrateo ? 11px : 12.5px;
            font-weight: root.has_prorrateo ? 800 : root.font_weight;
            color: (root.has_prorrateo && cell_touch.has-hover) ? #0369a1 : root.text_color;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        if root.has_prorrateo : Text {
            text: (cell_touch.has-hover ? "Orig: " : "") + root.orig_str;
            font-size: 9.5px;
            font-weight: cell_touch.has-hover ? 700 : 500;
            color: cell_touch.has-hover ? #0284c7 : #94a3b8;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    cell_touch := TouchArea {}
}

component ObraAsignadaRow inherits Rectangle {
    in property <string> obra_id;
    in property <string> label;
    in property <string> vigencia_str;
    in property <int> dias_activos_mes;
    in property <int> tope_max;
    in property <bool> has_error;
    in property <string> initial_dias_str;
    callback dias_changed(string, string);
    callback remove(string);

    height: 38px;
    border-radius: 6px;
    background: root.has_error ? #fff1f2 : #eff6ff;
    border-width: 1px;
    border-color: root.has_error ? #f87171 : #93c5fd;

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 8px;
        cross-axis-alignment: center;

        Text {
            text: "🗃️ " + root.label;
            font-size: 12px;
            font-weight: 700;
            color: root.has_error ? #991b1b : #1e3a8a;
            horizontal-stretch: 3;
            overflow: elide;
            vertical-alignment: center;
        }

        Text {
            text: root.vigencia_str != "" ? root.vigencia_str : "Sin vigencia";
            font-size: 11px;
            color: root.has_error ? #b91c1c : #64748b;
            horizontal-stretch: 2;
            overflow: elide;
            vertical-alignment: center;
        }

        // Input Editable
        Rectangle {
            width: 130px;
            height: 30px;
            border-radius: 4px;
            background: root.has_error ? #fef2f2 : #ffffff;
            border-width: root.has_error ? 2px : 1.5px;
            border-color: root.has_error ? #ef4444 : #3b82f6;

            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                alignment: center;
                cross-axis-alignment: center;

                LineEdit {
                    font-size: 12.5px;
                    horizontal-alignment: center;
                    text: root.initial_dias_str;
                    edited(val) => {
                        root.dias_changed(root.obra_id, val);
                    }
                }
            }
        }

        // Badge Tope Máx Dinámico
        Rectangle {
            width: 120px;
            height: 28px;
            border-radius: 4px;
            background: root.has_error ? #fee2e2 : #ecfdf5;
            border-width: root.has_error ? 1.5px : 1px;
            border-color: root.has_error ? #fca5a5 : #a7f3d0;

            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                alignment: center;
                cross-axis-alignment: center;

                Text {
                    text: "Tope: " + root.tope_max + " d";
                    font-size: 12px;
                    font-weight: 800;
                    color: root.has_error ? #dc2626 : #047857;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // Botón Quitar ✕
        Rectangle {
            width: 45px;
            height: 28px;
            border-radius: 4px;
            background: btn_rem.has-hover ? #fee2e2 : #ffffff;
            border-width: 1px;
            border-color: btn_rem.has-hover ? #fca5a5 : #cbd5e1;

            Text {
                text: "✕";
                font-size: 12px;
                font-weight: 800;
                color: #ef4444;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            btn_rem := TouchArea {
                mouse-cursor: pointer;
                clicked => {
                    root.remove(root.obra_id);
                }
            }
        }
    }
}

component ReporteEmpleadoMultiFilterWidget inherits Rectangle {
    height: 38px;
    width: 220px;
    border-radius: 6px;
    background: emp_filter_touch.has-hover || emp_pop.is-open
        ? #dbeafe
        : (AppData.reporte_unique_empleados_filter_active ? #eff6ff : #ffffff);
    border-width: AppData.reporte_unique_empleados_filter_active ? 1.5px : 1px;
    border-color: AppData.reporte_unique_empleados_filter_active ? #2563eb : (emp_filter_touch.has-hover ? #93c5fd : #cbd5e1);

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        alignment: space-between;
        cross-axis-alignment: center;

        HorizontalLayout {
            spacing: 6px;
            cross-axis-alignment: center;
            Text { text: "👥"; font-size: 13px; vertical-alignment: center; }
            Text {
                text: AppData.reporte_unique_empleados_selected_count > 0
                    ? "Empleados (" + AppData.reporte_unique_empleados_selected_count + ")"
                    : "Empleados: Todos";
                font-size: 12.5px;
                font-weight: 700;
                color: AppData.reporte_unique_empleados_filter_active ? #1d4ed8 : #475569;
                vertical-alignment: center;
                overflow: elide;
            }
        }

        HorizontalLayout {
            spacing: 4px;
            cross-axis-alignment: center;

            if AppData.reporte_unique_empleados_filter_active : Rectangle {
                width: 18px;
                height: 18px;
                border-radius: 9px;
                background: btn_emp_clear.has-hover ? #fca5a5 : #fee2e2;

                Text {
                    text: "✕";
                    font-size: 10px;
                    font-weight: 800;
                    color: #b91c1c;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                btn_emp_clear := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        AppLogic.reporte_limpiar_unique_empleados_filter();
                    }
                }
            }

            Text {
                text: emp_pop.is-open ? "▴" : "▾";
                font-size: 12px;
                font-weight: 800;
                color: AppData.reporte_unique_empleados_filter_active ? #2563eb : #94a3b8;
                vertical-alignment: center;
            }
        }
    }

    emp_filter_touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if emp_pop.is-open {
                emp_pop.close();
            } else {
                emp_pop.show();
            }
        }
    }

    emp_pop := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: 380px;
        height: 420px;
        close-policy: close-on-click-outside;

        Rectangle {
            width: 100%;
            height: 100%;
            background: #ffffff;
            border-radius: 8px;
            border-width: 1px;
            border-color: #93c5fd;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000028;

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                // Header
                HorizontalLayout {
                    alignment: space-between;
                    cross-axis-alignment: center;

                    HorizontalLayout {
                        spacing: 6px;
                        Text { text: "👥"; font-size: 13px; }
                        Text { text: "Filtrar por Empleados"; font-size: 12.5px; font-weight: 800; color: #1e3a8a; }
                    }

                    Rectangle {
                        height: 20px;
                        border-radius: 10px;
                        background: #dbeafe;
                        HorizontalLayout {
                            padding-left: 6px;
                            padding-right: 6px;
                            Text {
                                text: AppData.reporte_unique_empleados_selected_count + " / " + AppData.reporte_unique_empleados.length;
                                font-size: 10.5px;
                                font-weight: 700;
                                color: #1d4ed8;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Buscador interno en el popup
                Rectangle {
                    height: 32px;
                    border-radius: 5px;
                    background: #f8fafc;
                    border-width: 1px;
                    border-color: #cbd5e1;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        spacing: 6px;
                        alignment: center;
                        Text { text: "🔍"; font-size: 11px; vertical-alignment: center; }
                        LineEdit {
                            placeholder-text: "Buscar empleado en la lista...";
                            font-size: 11.5px;
                            text: AppData.reporte_unique_empleados_search;
                            edited(txt) => {
                                AppData.reporte_unique_empleados_search = txt;
                                AppLogic.reporte_unique_empleados_search_changed(txt);
                            }
                        }
                    }
                }

                // Botones rápidos: Seleccionar Todos / Deseleccionar
                HorizontalLayout {
                    spacing: 8px;
                    alignment: space-between;

                    Rectangle {
                        height: 26px;
                        horizontal-stretch: 1;
                        border-radius: 4px;
                        background: btn_sel_all_u.has-hover ? #dbeafe : #eff6ff;
                        border-width: 1px;
                        border-color: #93c5fd;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 4px;
                            Text { text: "✓"; font-size: 11px; font-weight: 800; color: #1d4ed8; vertical-alignment: center; }
                            Text { text: "Todos"; font-size: 11px; font-weight: 700; color: #1d4ed8; vertical-alignment: center; }
                        }

                        btn_sel_all_u := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                AppLogic.reporte_unique_empleados_select_all(true);
                            }
                        }
                    }

                    Rectangle {
                        height: 26px;
                        horizontal-stretch: 1;
                        border-radius: 4px;
                        background: btn_desel_all_u.has-hover ? #f1f5f9 : #f8fafc;
                        border-width: 1px;
                        border-color: #cbd5e1;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 4px;
                            Text { text: "◻"; font-size: 11px; font-weight: 800; color: #475569; vertical-alignment: center; }
                            Text { text: "Ninguno"; font-size: 11px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        }

                        btn_desel_all_u := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                AppLogic.reporte_unique_empleados_select_all(false);
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: #e2e8f0; }

                // ListView de Empleados Únicos
                ListView {
                    vertical-stretch: 1;
                    for emp in AppData.reporte_unique_empleados_filtered : Rectangle {
                        height: 36px;
                        border-radius: 4px;
                        background: emp.selected ? #eff6ff : (btn_emp_row.has-hover ? #f8fafc : transparent);

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 8px;
                            cross-axis-alignment: center;

                            // Checkbox
                            Rectangle {
                                width: 16px;
                                height: 16px;
                                border-radius: 3px;
                                background: emp.selected ? #2563eb : #ffffff;
                                border-width: 1.5px;
                                border-color: emp.selected ? #2563eb : #94a3b8;

                                Text {
                                    text: "✓";
                                    font-size: 10px;
                                    font-weight: 800;
                                    color: #ffffff;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    visible: emp.selected;
                                }
                            }

                            // Nombre e info
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 1px;
                                alignment: center;

                                Text {
                                    text: emp.nombre;
                                    font-size: 11.5px;
                                    font-weight: emp.selected ? 700 : 600;
                                    color: emp.selected ? #1e3a8a : #0f172a;
                                    overflow: elide;
                                }

                                Text {
                                    text: "NSS: " + (emp.nss != "" ? emp.nss : "S/N") + " • RFC: " + (emp.rfc != "" ? emp.rfc : "S/R");
                                    font-size: 9.5px;
                                    color: #64748b;
                                    overflow: elide;
                                }
                            }

                            // Badge de Periodos
                            Rectangle {
                                height: 18px;
                                border-radius: 4px;
                                background: #f1f5f9;
                                HorizontalLayout {
                                    padding-left: 5px;
                                    padding-right: 5px;
                                    Text {
                                        text: emp.periodos_count + " per.";
                                        font-size: 9.5px;
                                        font-weight: 600;
                                        color: #475569;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        btn_emp_row := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                AppLogic.reporte_toggle_unique_empleado(emp.id);
                            }
                        }
                    }
                }
            }
        }
    }
}

component ReporteSelectedCombobox inherits Rectangle {
    height: 34px;
    border-radius: 5px;
    background: sel_touch.has-hover || sel_pop.is-open ? #dbeafe : (AppData.reporte_selected_count > 0 ? #eff6ff : #ffffff);
    border-width: 1px;
    border-color: sel_touch.has-hover || sel_pop.is-open ? #2563eb : (AppData.reporte_selected_count > 0 ? #93c5fd : #cbd5e1);

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        alignment: center;
        cross-axis-alignment: center;

        Text {
            text: "☑️";
            font-size: 12px;
            vertical-alignment: center;
        }

        Text {
            text: AppData.reporte_selected_count > 0
                ? "Seleccionados (" + AppData.reporte_selected_count + ")"
                : "Seleccionados (0)";
            font-size: 12px;
            font-weight: 700;
            color: AppData.reporte_selected_count > 0 ? #1d4ed8 : #64748b;
            vertical-alignment: center;
        }

        Text {
            text: sel_pop.is-open ? "▴" : "▾";
            font-size: 13px;
            font-weight: 800;
            color: AppData.reporte_selected_count > 0 ? #2563eb : #94a3b8;
            vertical-alignment: center;
        }
    }

    sel_touch := TouchArea {
        mouse-cursor: pointer;
        clicked => {
            if sel_pop.is-open {
                sel_pop.close();
            } else {
                sel_pop.show();
            }
        }
    }

    sel_pop := PopupWindow {
        x: 0px;
        y: root.height + 4px;
        width: 440px;
        height: AppData.reporte_selected_count == 0 ? 120px : 320px;
        close-policy: close-on-click-outside;

        Rectangle {
            width: 100%;
            height: 100%;
            background: #ffffff;
            border-radius: 8px;
            border-width: 1px;
            border-color: #93c5fd;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000028;

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                // Cabecera del Combobox
                HorizontalLayout {
                    alignment: space-between;
                    cross-axis-alignment: center;

                    HorizontalLayout {
                        spacing: 6px;
                        cross-axis-alignment: center;

                        Text { text: "📋"; font-size: 13px; vertical-alignment: center; }
                        Text {
                            text: "Registros Seleccionados";
                            font-size: 12.5px;
                            font-weight: 800;
                            color: #1e3a8a;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            height: 20px;
                            border-radius: 10px;
                            background: #dbeafe;
                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                alignment: center;
                                cross-axis-alignment: center;
                                Text {
                                    text: "" + AppData.reporte_selected_count;
                                    font-size: 11px;
                                    font-weight: 800;
                                    color: #1d4ed8;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;
                        cross-axis-alignment: center;

                        if AppData.reporte_selected_count > 0 : Rectangle {
                            height: 24px;
                            border-radius: 4px;
                            background: btn_pop_clear.has-hover ? #fee2e2 : #fef2f2;
                            border-width: 1px;
                            border-color: #fca5a5;

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                spacing: 3px;
                                alignment: center;
                                cross-axis-alignment: center;
                                Text { text: "🗑️"; font-size: 10px; vertical-alignment: center; }
                                Text {
                                    text: "Remover todos";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #dc2626;
                                    vertical-alignment: center;
                                }
                            }

                            btn_pop_clear := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    AppLogic.reporte_limpiar_seleccion();
                                    sel_pop.close();
                                }
                            }
                        }

                        Rectangle {
                            width: 22px;
                            height: 22px;
                            border-radius: 11px;
                            background: btn_pop_close.has-hover ? #f1f5f9 : transparent;

                            Text {
                                text: "✕";
                                font-size: 11px;
                                font-weight: 800;
                                color: #64748b;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            btn_pop_close := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    sel_pop.close();
                                }
                            }
                        }
                    }
                }

                // Línea separadora
                Rectangle { height: 1px; background: #e2e8f0; }

                // Estado vacío si no hay selección
                if AppData.reporte_selected_count == 0 : VerticalLayout {
                    alignment: center;
                    spacing: 4px;
                    padding: 10px;

                    Text {
                        text: "ℹ️ No hay liquidaciones seleccionadas.";
                        font-size: 12px;
                        color: #64748b;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "Marca casillas en la tabla para verlas y gestionarlas aquí.";
                        font-size: 11px;
                        color: #94a3b8;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Lista de seleccionados con Scroll
                if AppData.reporte_selected_count > 0 : ScrollView {
                    VerticalLayout {
                        spacing: 4px;
                        padding-right: 4px;

                        for item in AppData.reporte_selected_items : Rectangle {
                            height: 44px;
                            border-radius: 5px;
                            background: item_row_touch.has-hover ? #f1f5f9 : #ffffff;
                            border-width: 1px;
                            border-color: item_row_touch.has-hover ? #cbd5e1 : #e2e8f0;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 8px;
                                cross-axis-alignment: center;

                                Rectangle {
                                    width: 18px;
                                    height: 18px;
                                    border-radius: 4px;
                                    background: #2563eb;
                                    border-width: 1px;
                                    border-color: #1d4ed8;

                                    Text {
                                        text: "✓";
                                        font-size: 12px;
                                        font-weight: 800;
                                        color: #ffffff;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 2px;
                                    horizontal-stretch: 1;

                                    HorizontalLayout {
                                        spacing: 6px;
                                        cross-axis-alignment: center;

                                        Text {
                                            text: item.nombre_trabajador;
                                            font-size: 11.5px;
                                            font-weight: 700;
                                            color: #1e293b;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }

                                        if item.pensionado != "": Rectangle {
                                            height: 16px;
                                            border-radius: 3px;
                                            background: #fef3c7;
                                            border-width: 1px;
                                            border-color: #f59e0b;
                                            HorizontalLayout {
                                                padding-left: 4px;
                                                padding-right: 4px;
                                                cross-axis-alignment: center;
                                                Text {
                                                    text: item.pensionado;
                                                    font-size: 10px;
                                                    font-weight: 700;
                                                    color: #b45309;
                                                }
                                            }
                                        }

                                        Rectangle {
                                            height: 16px;
                                            border-radius: 3px;
                                            background: #dbeafe;
                                            HorizontalLayout {
                                                padding-left: 4px;
                                                padding-right: 4px;
                                                cross-axis-alignment: center;
                                                Text {
                                                    text: item.periodo;
                                                    font-size: 10px;
                                                    font-weight: 700;
                                                    color: #1e40af;
                                                }
                                            }
                                        }
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;
                                        cross-axis-alignment: center;

                                        Text {
                                            text: "NSS: " + item.nss;
                                            font-size: 10px;
                                            color: #64748b;
                                        }

                                        Text {
                                            text: "• " + item.obra_label;
                                            font-size: 10px;
                                            color: #3b82f6;
                                            overflow: elide;
                                        }
                                    }
                                }

                                Rectangle {
                                    width: 20px;
                                    height: 20px;
                                    border-radius: 10px;
                                    background: item_row_touch.has-hover ? #fee2e2 : transparent;

                                    Text {
                                        text: "✕";
                                        font-size: 11px;
                                        font-weight: 800;
                                        color: item_row_touch.has-hover ? #dc2626 : #94a3b8;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            item_row_touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    AppLogic.reporte_toggle_select_row(item.id);
                                }
                            }
                        }
                    }
                }

                // Pie informativo
                if AppData.reporte_selected_count > 0 : HorizontalLayout {
                    alignment: space-between;
                    cross-axis-alignment: center;
                    padding-top: 2px;

                    Text {
                        text: "Haz clic en una casilla para deseleccionar.";
                        font-size: 10px;
                        color: #94a3b8;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        height: 22px;
                        border-radius: 4px;
                        background: btn_pop_done.has-hover ? #e2e8f0 : #f1f5f9;
                        border-width: 1px;
                        border-color: #cbd5e1;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            alignment: center;
                            cross-axis-alignment: center;
                            Text {
                                text: "Listo";
                                font-size: 10.5px;
                                font-weight: 700;
                                color: #475569;
                            }
                        }

                        btn_pop_done := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                sel_pop.close();
                            }
                        }
                    }
                }
            }
        }
    }
}

export component ReporteLiquidacionesView inherits Rectangle {
    background: #f8fafc;

    ScrollView {
        width: 100%;
        content-width: self.width;

        VerticalLayout {
            padding: 16px;
            spacing: 12px;

        // 1. Encabezado Superior y Botones de Acción
        HorizontalLayout {
            alignment: space-between;
            spacing: 16px;

            VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;

                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    Text {
                        text: "📊";
                        font-size: 24px;
                        vertical-alignment: center;
                    }

                    Text {
