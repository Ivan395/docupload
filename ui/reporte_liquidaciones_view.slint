import { ScrollView, Button, LineEdit, ComboBox, CheckBox } from "std-widgets.slint";
import { AppData, AppLogic, ReporteLiquidacionRow, ReporteObraItem, ReporteBatchWorkerItem } from "models.slint";
component ReporteNumericCell inherits Rectangle {
    in property <string> curr_str: "$0.00";
    in property <string> orig_str: "$0.00";
    in property <bool> has_prorrateo: false;
    in property <length> cell_width: 85px;
    in property <color> text_color: #334155;
    in property <int> font_weight: 400;

    width: root.cell_width;
    height: 34px;
    border-radius: 4px;
    background: (root.has_prorrateo && cell_touch.has-hover) ? #e0f2fe : transparent;
    border-width: (root.has_prorrateo && cell_touch.has-hover) ? 1px : 0px;
    border-color: #bae6fd;

    VerticalLayout {
        alignment: center;
        spacing: 0px;
        padding-right: 4px;

        Text {
            text: root.curr_str;
            font-size: root.has_prorrateo ? 11px : 12.5px;
            font-weight: root.has_prorrateo ? 800 : root.font_weight;
            color: (root.has_prorrateo && cell_touch.has-hover) ? #0369a1 : root.text_color;
            horizontal-alignment: right;
            vertical-alignment: center;
        }

        if root.has_prorrateo : Text {
            text: (cell_touch.has-hover ? "Orig: " : "") + root.orig_str;
            font-size: 9.5px;
            font-weight: cell_touch.has-hover ? 700 : 500;
            color: cell_touch.has-hover ? #0284c7 : #94a3b8;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
    }

    cell_touch := TouchArea {}
}

export component ReporteLiquidacionesView inherits Rectangle {
    background: #f8fafc;

    ScrollView {
        VerticalLayout {
            padding: 20px;
            spacing: 14px;

        // 1. Encabezado Superior y Botones de Acción
        HorizontalLayout {
            alignment: space-between;
            spacing: 16px;

            VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;

                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    Text {
                        text: "📊";
                        font-size: 24px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "Reporte de Liquidaciones y Prorrateo por Obra";
                        font-size: 22px;
                        font-weight: 800;
                        color: #0f172a;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: AppData.reporte_subtitle != "" ? AppData.reporte_subtitle : "Liquidaciones SUA filtradas por vigencia de Registros de Obra en la revisión activa.";
                    font-size: 13px;
                    font-weight: 500;
                    color: #64748b;
                    wrap: word-wrap;
                }
            }

            // Botones de Acción a la derecha
            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                // Guardar
                Rectangle {
                    height: 38px;
                    width: 105px;
                    border-radius: 6px;
                    background: btn_save.has-hover ? #1e40af : #1e3a8a;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        Text { text: "💾"; font-size: 13px; vertical-alignment: center; }
                        Text {
                            text: "Guardar";
                            font-size: 13px;
                            font-weight: 700;
                            color: #ffffff;
                            vertical-alignment: center;
                        }
                    }

                    btn_save := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppLogic.guardar_reporte_liquidaciones(); }
                    }
                }

                // Exportar a Excel
                Rectangle {
                    height: 38px;
                    width: 180px;
                    border-radius: 6px;
                    background: btn_excel.has-hover ? #15803d : #16a34a;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        Text { text: "📥"; font-size: 13px; vertical-alignment: center; }
                        Text {
                            text: "Exportar a Excel (.xlsx)";
                            font-size: 13px;
                            font-weight: 700;
                            color: #ffffff;
                            vertical-alignment: center;
                        }
                    }

                    btn_excel := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppLogic.exportar_reporte_liquidaciones_excel(); }
                    }
                }

                // Exportar SUA
                Rectangle {
                    height: 38px;
                    width: 145px;
                    border-radius: 6px;
                    background: btn_export_sua.has-hover ? #b45309 : #d97706;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        Text { text: "📄"; font-size: 13px; vertical-alignment: center; }
                        Text {
                            text: "Exportar SUA";
                            font-size: 13px;
                            font-weight: 700;
                            color: #ffffff;
                            vertical-alignment: center;
                        }
                    }

                    btn_export_sua := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppLogic.reporte_abrir_modal_exportar_sua(); }
                    }
                }

                // Revertir Cambios
                Rectangle {
                    height: 38px;
                    width: 145px;
                    border-radius: 6px;
                    background: btn_revert.has-hover ? #e2e8f0 : #ffffff;
                    border-width: 1px;
                    border-color: #cbd5e1;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        Text { text: "↺"; font-size: 13px; vertical-alignment: center; }
                        Text {
                            text: "Revertir Cambios";
                            font-size: 13px;
                            font-weight: 700;
                            color: #475569;
                            vertical-alignment: center;
                        }
                    }

                    btn_revert := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppLogic.revertir_reporte_liquidaciones(); }
                    }
                }
            }
        }

        // 2. Tarjetas KPI
        HorizontalLayout {
            spacing: 12px;

            // KPI 1: Registros Procesados
            Rectangle {
                horizontal-stretch: 1;
                height: 70px;
                border-radius: 8px;
                background: #ffffff;
                border-width: 1px;
                border-color: #e2e8f0;

                VerticalLayout {
                    padding: 10px;
                    alignment: space-between;
                    Text {
                        text: "REGISTROS PROCESADOS";
                        font-size: 11.5px;
                        font-weight: 800;
                        color: #64748b;
                        letter-spacing: 0.5px;
                    }
                    Text {
                        text: AppData.reporte_kpi_total_registros_str;
                        font-size: 18px;
                        font-weight: 800;
                        color: #0f172a;
                    }
                }
            }

            // KPI 2: Obras en Revisión
            Rectangle {
                horizontal-stretch: 1;
                height: 70px;
                border-radius: 8px;
                background: #ffffff;
                border-width: 1px;
                border-color: #e2e8f0;

                VerticalLayout {
                    padding: 10px;
                    alignment: space-between;
                    Text {
                        text: "OBRAS EN REVISIÓN";
                        font-size: 11.5px;
                        font-weight: 800;
                        color: #64748b;
                        letter-spacing: 0.5px;
                    }
                    Text {
                        text: AppData.reporte_kpi_obras_homologadas_str;
                        font-size: 18px;
                        font-weight: 800;
                        color: #2563eb;
                    }
                }
            }

            // KPI 3: Subtotal Cuotas IMSS
            Rectangle {
                horizontal-stretch: 1;
                height: 70px;
                border-radius: 8px;
                background: #ffffff;
                border-width: 1px;
                border-color: #e2e8f0;

                VerticalLayout {
                    padding: 10px;
                    alignment: space-between;
                    Text {
                        text: "SUBTOTAL CUOTAS IMSS";
                        font-size: 11.5px;
                        font-weight: 800;
                        color: #64748b;
                        letter-spacing: 0.5px;
                    }
                    Text {
                        text: AppData.reporte_kpi_subtotal_imss_str;
                        font-size: 18px;
                        font-weight: 800;
                        color: #0f172a;
                    }
                }
            }

            // KPI 4: Importe Subtotal
            Rectangle {
                horizontal-stretch: 1;
                height: 70px;
                border-radius: 8px;
                background: #f0fdf4;
                border-width: 1px;
                border-color: #bbf7d0;

                VerticalLayout {
                    padding: 10px;
                    alignment: space-between;
                    Text {
                        text: "IMPORTE SUBTOTAL";
                        font-size: 11.5px;
                        font-weight: 800;
                        color: #166534;
                        letter-spacing: 0.5px;
                    }
                    Text {
                        text: AppData.reporte_kpi_prorrateado_str;
                        font-size: 18px;
                        font-weight: 800;
                        color: #15803d;
                    }
                }
            }
        }

        // 3. Fila de Filtros de Búsqueda
        HorizontalLayout {
            spacing: 12px;
            alignment: space-between;

            // Buscador por empleado
            Rectangle {
                horizontal-stretch: 1;
                height: 38px;
                border-radius: 6px;
                background: #ffffff;
                border-width: 1px;
                border-color: #cbd5e1;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 8px;
                    alignment: center;

                    Text { text: "🔍"; font-size: 14px; vertical-alignment: center; }
                    search_input := LineEdit {
                        placeholder-text: "Buscar por Empleado (Nombre, RFC, NSS, CURP)...";
                        text: AppData.reporte_search_query;
                        edited(text) => {
                            AppData.reporte_search_query = text;
                            AppLogic.reporte_filtrar_busqueda(text);
                        }
                    }
                }
            }

            // Filtro Registro de Obra
            HorizontalLayout {
                spacing: 6px;
                alignment: center;
                Text { text: "🏗 Obra:"; font-size: 13px; font-weight: 700; color: #475569; vertical-alignment: center; }
                ComboBox {
                    width: 220px;
                    height: 38px;
                    model: AppData.reporte_obras_filter_labels;
                    current-index <=> AppData.reporte_filter_obra_idx;
                    selected(val) => {
                        AppLogic.reporte_filtrar_obra(self.current-index);
                    }
                }
            }

            // Filtro Periodo
            HorizontalLayout {
                spacing: 6px;
                alignment: center;
                Text { text: "📅 Periodo:"; font-size: 13px; font-weight: 700; color: #475569; vertical-alignment: center; }
                ComboBox {
                    width: 195px;
                    height: 38px;
                    model: AppData.reporte_periodo_options;
                    current-index <=> AppData.reporte_filter_periodo_idx;
                    selected(val) => {
                        AppLogic.reporte_filtrar_periodo(self.current-index);
                    }
                }
            }

            // Filtro Estado
            HorizontalLayout {
                spacing: 6px;
                alignment: center;
                Text { text: "🏷 Estado:"; font-size: 13px; font-weight: 700; color: #475569; vertical-alignment: center; }
                ComboBox {
                    width: 175px;
                    height: 38px;
                    model: AppData.reporte_estado_options;
                    current-index <=> AppData.reporte_filter_estado_idx;
                    selected(val) => {
                        AppLogic.reporte_filtrar_estado(self.current-index);
                    }
                }
            }

            // Botón Ordenar Multi-Criterio
            Rectangle {
                height: 38px;
                border-radius: 6px;
                background: btn_open_sort.has-hover ? #f1f5f9 : (AppData.reporte_active_sort_count > 0 ? #eff6ff : #ffffff);
                border-width: 1px;
                border-color: AppData.reporte_active_sort_count > 0 ? #3b82f6 : #cbd5e1;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 6px;
                    alignment: center;
                    cross-axis-alignment: center;

                    Text { text: "⇅"; font-size: 14px; font-weight: 800; color: AppData.reporte_active_sort_count > 0 ? #1d4ed8 : #475569; vertical-alignment: center; }
                    Text {
                        text: AppData.reporte_active_sort_count > 0 ? "Ordenar (" + AppData.reporte_active_sort_count + ")" : "Ordenar...";
                        font-size: 13px;
                        font-weight: 700;
                        color: AppData.reporte_active_sort_count > 0 ? #1d4ed8 : #475569;
                        vertical-alignment: center;
                    }
                }

                btn_open_sort := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        AppLogic.reporte_open_sort_modal();
                    }
                }
            }

            // Botón Remover Filtros (visible cuando hay cualquier filtro activo)
            if AppData.reporte_search_query != "" || AppData.reporte_filter_obra_idx != 0 || AppData.reporte_filter_periodo_idx != 0 || AppData.reporte_filter_estado_idx != 0 || AppData.reporte_emp_filter_active : Rectangle {
                height: 38px;
                border-radius: 6px;
                background: btn_clear_all_f.has-hover ? #fee2e2 : #ffffff;
                border-width: 1px;
                border-color: #fca5a5;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    spacing: 5px;
                    alignment: center;
                    cross-axis-alignment: center;

                    Text { text: "✕"; font-size: 13px; font-weight: 800; color: #dc2626; vertical-alignment: center; }
                    Text {
                        text: "Remover Filtros";
                        font-size: 13px;
                        font-weight: 700;
                        color: #dc2626;
                        vertical-alignment: center;
                    }
                }

                btn_clear_all_f := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        AppLogic.reporte_limpiar_todos_filtros();
                    }
                }
            }
        }

        // 4. Panel de Modificación Masiva en Lote (Siempre Disponible)
        Rectangle {
            height: 54px;
            border-radius: 8px;
            background: #eff6ff;
            border-width: 1px;
            border-color: #bfdbfe;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 12px;
                alignment: space-between;
                cross-axis-alignment: center;

                // Título del lote y conteo
                HorizontalLayout {
                    spacing: 6px;
                    alignment: center;
                    cross-axis-alignment: center;
                    Text { text: "⚡"; font-size: 14px; vertical-alignment: center; }
                    Text {
                        text: "Panel Masivo:";
                        font-size: 13px;
                        font-weight: 800;
                        color: #1e40af;
                        vertical-alignment: center;
                    }
                    Rectangle {
                        height: 24px;
                        border-radius: 12px;
                        background: #dbeafe;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            alignment: center;
                            cross-axis-alignment: center;
                            Text {
                                text: AppData.reporte_selected_count + " seleccionados";
                                font-size: 12px;
                                font-weight: 700;
                                color: #1d4ed8;
                                vertical-alignment: center;
                                horizontal-alignment: center;
                            }
                        }
                    }
                }



                // Botón Explorar / Filtrar Empleados Seleccionados
                Rectangle {
                    height: 34px;
                    border-radius: 5px;
                    background: AppData.reporte_emp_filter_active ? (btn_body_touch.has-hover ? #dbeafe : #eff6ff) : (btn_body_touch.has-hover ? #f1f5f9 : #ffffff);
                    border-width: 1px;
                    border-color: AppData.reporte_emp_filter_active ? #2563eb : #93c5fd;

                    btn_body_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            AppLogic.reporte_open_empleados_filter_modal();
                        }
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 10px;
                        spacing: 6px;
                        alignment: center;
                        cross-axis-alignment: center;

                        // '✕' interactiva al lado izquierdo cuando el filtro está activo para eliminar el filtro
                        if AppData.reporte_emp_filter_active : Rectangle {
                            width: 20px;
                            height: 20px;
                            border-radius: 10px;
                            background: btn_clear_x.has-hover ? #fca5a5 : #fee2e2;

                            Text {
                                text: "✕";
                                font-size: 12px;
                                font-weight: 800;
                                color: #b91c1c;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            btn_clear_x := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    AppLogic.reporte_clear_emp_filter();
                                }
                            }
                        }

                        if !AppData.reporte_emp_filter_active : Text {
                            text: "👥";
                            font-size: 12px;
                            vertical-alignment: center;
                        }

                        Text {
                            text: AppData.reporte_emp_filter_active ? "Filtro Empleados Activo" : (AppData.reporte_selected_count > 0 ? "Filtrar Selección (" + AppData.reporte_selected_count + ")..." : "Filtrar Selección...");
                            font-size: 12px;
                            font-weight: 700;
                            color: #1d4ed8;
                            vertical-alignment: center;
                        }
                    }
                }

                // Acciones por Lote (Siempre Disponibles)
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    cross-axis-alignment: center;

                    // Botón Principal: Modificar Asignación Masiva
                    Rectangle {
                        height: 34px;
                        border-radius: 5px;
                        background: btn_batch_edit_modal.has-hover ? #1d4ed8 : #2563eb;
                        drop-shadow-blur: 4px;
                        drop-shadow-color: #2563eb40;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 12px;
                            spacing: 6px;
                            alignment: center;
                            cross-axis-alignment: center;

                            Text { text: "✏️"; font-size: 12px; vertical-alignment: center; }
                            Text {
                                text: AppData.reporte_selected_count > 0 ? "Modificar en Lote (" + AppData.reporte_selected_count + ")..." : "Modificar en Lote...";
                                font-size: 12px;
                                font-weight: 700;
                                color: #ffffff;
                                vertical-alignment: center;
                            }
                        }

                        btn_batch_edit_modal := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                AppLogic.reporte_open_batch_edit_modal();
                            }
                        }
                    }

                    // Botón Asignar Máximo
                    Rectangle {
                        height: 34px;
                        border-radius: 5px;
                        background: btn_batch_igualar.has-hover ? #f0fdf4 : #ffffff;
                        border-width: 1px;
                        border-color: #86efac;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 10px;
                            spacing: 5px;
                            alignment: center;
                            cross-axis-alignment: center;

                            Text { text: "⚡"; font-size: 12px; vertical-alignment: center; }
                            Text {
                                text: "Asignar Máximo";
                                font-size: 12px;
                                font-weight: 700;
                                color: #16a34a;
                                vertical-alignment: center;
                            }
                        }

                        btn_batch_igualar := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                AppLogic.reporte_request_confirm_igualar_dias();
                            }
                        }
                    }
                }

                // Separador visual
                Rectangle { width: 1px; height: 26px; background: #bfdbfe; }

                // Botón Selección Rápida por Registro de Obra
                Rectangle {
                    height: 34px;
                    border-radius: 5px;
                    background: btn_sel_obras.has-hover ? #dbeafe : #ffffff;
                    border-width: 1px;
                    border-color: #93c5fd;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 10px;
                        spacing: 5px;
                        alignment: center;
                        cross-axis-alignment: center;

                        Text { text: "🏗️"; font-size: 12px; vertical-alignment: center; }
                        Text {
                            text: "Seleccionar por Obra...";
                            font-size: 12px;
                            font-weight: 700;
                            color: #1d4ed8;
                            vertical-alignment: center;
                        }
                    }

                    btn_sel_obras := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            AppLogic.reporte_open_select_obras_modal();
                        }
                    }
                }

                // Separador visual
                Rectangle { width: 1px; height: 26px; background: #bfdbfe; }

                // Checkbox seleccionar todas del filtro
                HorizontalLayout {
                    spacing: 6px;
                    alignment: center;
                    cross-axis-alignment: center;

                    Rectangle {
                        width: 18px;
                        height: 18px;
                        border-radius: 4px;
                        background: AppData.reporte_all_filter_selected ? #2563eb : #ffffff;
                        border-width: 1px;
                        border-color: AppData.reporte_all_filter_selected ? #2563eb : #94a3b8;

                        Text {
                            text: "✓";
                            font-size: 12px;
                            font-weight: 800;
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                            visible: AppData.reporte_all_filter_selected;
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                AppData.reporte_all_filter_selected = !AppData.reporte_all_filter_selected;
                                AppLogic.reporte_toggle_select_all(AppData.reporte_all_filter_selected);
                            }
                        }
                    }

                    Text {
                        text: "Filtro (" + AppData.reporte_total_filtered + ")";
                        font-size: 12px;
                        font-weight: 600;
                        color: #334155;
                        vertical-alignment: center;
                    }
                }


            }
        }

        // 4.1. Panel Informativo: Registros de Obra Creados por el Usuario (Vigencias)
        if AppData.reporte_has_obras_usuario : Rectangle {
            border-radius: 8px;
            background: #f8fafc;
            border-width: 1px;
            border-color: #cbd5e1;

            VerticalLayout {
                padding: 10px;
                spacing: 8px;

                HorizontalLayout {
                    alignment: space-between;
                    cross-axis-alignment: center;

                    HorizontalLayout {
                        spacing: 8px;
                        cross-axis-alignment: center;
                        Text { text: "🏗️"; font-size: 14px; vertical-alignment: center; }
                        Text {
                            text: "Registros de Obra Creados por el Usuario (Vigencias de Análisis):";
                            font-size: 12.5px;
                            font-weight: 800;
                            color: #1e3a8a;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "Fechas clave para determinar los días máximos asignables a cada trabajador";
                        font-size: 11px;
                        font-weight: 500;
                        color: #64748b;
                        vertical-alignment: center;
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    for obra in AppData.reporte_obras_usuario : Rectangle {
                        border-radius: 6px;
                        background: #ffffff;
                        border-width: 1px;
                        border-color: #93c5fd;
                        height: 50px;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 12px;
                            cross-axis-alignment: center;

                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                HorizontalLayout {
                                    spacing: 6px;
                                    cross-axis-alignment: center;
                                    Text {
                                        text: obra.numero;
                                        font-size: 13px;
                                        font-weight: 800;
                                        color: #1d4ed8;
                                    }
                                    if obra.tipo_obra != "" : Text {
                                        text: "(" + obra.tipo_obra + ")";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: #475569;
                                    }
                                }
                                Text {
                                    text: "📅 " + obra.vigencia_str;
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: #047857;
                                }
                            }
                        }
                    }
                }
            }
        }

        // Pestañas de Navegación por Mes (Empleados por Mes)
        if AppData.reporte_periodo_options.length > 1 : HorizontalLayout {
            spacing: 8px;
            alignment: start;

            for opt[idx] in AppData.reporte_periodo_options : Rectangle {
                height: 36px;
                border-radius: 6px;
                background: AppData.reporte_filter_periodo_idx == idx ? #1e3a8a : #ffffff;
                border-width: 1px;
                border-color: AppData.reporte_filter_periodo_idx == idx ? #1e3a8a : #cbd5e1;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 14px;
                    spacing: 6px;
                    alignment: center;
                    Text {
                        text: idx == 0 ? "📅" : "🗓";
                        font-size: 13px;
                        vertical-alignment: center;
                    }
                    Text {
                        text: opt;
                        font-size: 13px;
                        font-weight: 700;
                        color: AppData.reporte_filter_periodo_idx == idx ? #ffffff : #334155;
                        vertical-alignment: center;
                    }
                }

                TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        AppData.reporte_filter_periodo_idx = idx;
                        AppLogic.reporte_filtrar_periodo(idx);
                    }
                }
            }
        }

        // 5. Tabla Principal con Encabezados Fijos en Scroll Vertical y sincronizados en Horizontal
        Rectangle {
            height: 580px;
            border-radius: 8px;
            background: #ffffff;
            border-width: 1px;
            border-color: #cbd5e1;
            clip: true;

            VerticalLayout {
                spacing: 0px;
                padding: 0px;

                // Encabezados Fijos
                Rectangle {
                    height: 40px;
                    background: #f1f5f9;
                    clip: true;

                    Rectangle {
                        x: table_scroll.content-x;
                        width: 3250px;
                        height: 40px;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 8px;
                            alignment: start;
                            cross-axis-alignment: center;

                            // Columna 1: Checkbox
                            Rectangle {
                                width: 30px;
                                Rectangle {
                                    width: 16px;
                                    height: 16px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 3px;
                                    background: AppData.reporte_all_filter_selected ? #2563eb : #ffffff;
                                    border-width: 1px;
                                    border-color: #94a3b8;
                                    Text { text: "✓"; font-size: 12px; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; visible: AppData.reporte_all_filter_selected; }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            AppData.reporte_all_filter_selected = !AppData.reporte_all_filter_selected;
                                            AppLogic.reporte_toggle_select_all(AppData.reporte_all_filter_selected);
                                        }
                                    }
                                }
                            }

                            Text { width: 35px; text: "#"; font-size: 12px; font-weight: 800; color: #475569; vertical-alignment: center; }
                            Text { width: 105px; text: "Mes / Año"; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                            Text { width: 105px; text: "NSS"; font-size: 12px; font-weight: 800; color: #475569; vertical-alignment: center; }
                            Text { width: 165px; text: "RFC / CURP"; font-size: 12px; font-weight: 800; color: #475569; vertical-alignment: center; }
                            Text { width: 220px; text: "Nombre del Trabajador"; font-size: 12px; font-weight: 800; color: #475569; vertical-alignment: center; }
                            Text { width: 105px; text: "Reg. Patronal"; font-size: 12px; font-weight: 800; color: #475569; vertical-alignment: center; }
                            Text { width: 210px; text: "✏️ Registro de Obra"; font-size: 12px; font-weight: 800; color: #1e40af; vertical-alignment: center; }
                            Text { width: 65px; text: "Días Céd."; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                            Text { width: 65px; text: "Días Obra"; font-size: 12px; font-weight: 800; color: #1e40af; horizontal-alignment: center; vertical-alignment: center; }
                            Text { width: 75px; text: "Clave"; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                            Text { width: 90px; text: "Fecha"; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                            Text { width: 85px; text: "SDI"; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 50px; text: "Lic."; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                            Text { width: 50px; text: "Inc."; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                            Text { width: 50px; text: "Aus."; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                            Text { width: 85px; text: "Cuota Fija"; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 85px; text: "Exc. Pat."; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 85px; text: "Exc. Obr."; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 85px; text: "PD Pat."; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 85px; text: "PD Obr."; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 85px; text: "GMP Pat."; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 85px; text: "GMP Obr."; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 85px; text: "Riesgo Trab."; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 85px; text: "IV Pat."; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 85px; text: "IV Obr."; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 85px; text: "Guard y PS"; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 95px; text: "Suma Patronal"; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 95px; text: "Suma Obrera"; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 105px; text: "Subtotal"; font-size: 12px; font-weight: 800; color: #166534; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 55px; text: "Acción"; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }

                // Línea divisoria
                Rectangle { height: 1px; background: #cbd5e1; }

                // Cuerpo de la tabla con scroll vertical y horizontal
                table_scroll := ScrollView {
                    vertical-stretch: 1;
                    content-width: 3250px;
                    content-height: AppData.reporte_liquidaciones_list.length > 0 ? ((AppData.reporte_liquidaciones_list.length * 40px) + 20px) : 180px;

                    Rectangle {
                        width: 3250px;
                        height: AppData.reporte_liquidaciones_list.length > 0 ? ((AppData.reporte_liquidaciones_list.length * 40px) + 20px) : 180px;

                        VerticalLayout {
                            alignment: start;
                            spacing: 0px;
                            padding: 0px;

                            // Filas de Datos (Paginadas)
                            for item[idx] in AppData.reporte_liquidaciones_list : Rectangle {
                            height: 40px;
                            background: item.selected ? #eff6ff : (row_touch.has-hover ? (item.has_incidencias ? #fef3c7 : (item.is_assigned ? item.row_hover_color : #f8fafc)) : (item.has_incidencias ? #fffbeb : (item.is_assigned ? item.row_bg_color : (Math.mod(idx, 2) == 0 ? #ffffff : #fbfcfe))));
                            border-width: 1px;
                            border-color: item.has_incidencias ? #fcd34d : (item.is_assigned ? item.row_hover_color : #f1f5f9);

                            row_touch := TouchArea {}

                            // Barra lateral de color distintivo del Registro de Obra o Alerta de Incidencia
                            if item.has_incidencias || item.is_assigned : Rectangle {
                                x: 0px;
                                y: 0px;
                                width: 4px;
                                height: parent.height;
                                background: item.has_incidencias ? #f59e0b : item.row_accent_color;
                            }

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                alignment: start;

                                // 1. Checkbox
                                Rectangle {
                                    width: 30px;
                                    Rectangle {
                                        width: 16px;
                                        height: 16px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 3px;
                                        background: item.is_baja ? #f1f5f9 : (item.selected ? #2563eb : #ffffff);
                                        border-width: 1px;
                                        border-color: item.is_baja ? #cbd5e1 : (item.selected ? #2563eb : #cbd5e1);
                                        Text {
                                            text: item.is_baja ? "🔒" : "✓";
                                            font-size: item.is_baja ? 9px : 12px;
                                            color: item.is_baja ? #94a3b8 : #ffffff;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            visible: item.is_baja || item.selected;
                                        }
                                        if !item.is_baja : TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                AppLogic.reporte_toggle_select_row(item.id_reporte_liq);
                                            }
                                        }
                                    }
                                }

                                // 2. Index
                                Text { width: 35px; text: item.idx; font-size: 12px; color: #64748b; vertical-alignment: center; }

                                // 3. Periodo
                                TextInput {
                                    width: 105px;
                                    text: item.periodo;
                                    read-only: true;
                                    single-line: true;
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: #1e293b;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                // 4. NSS
                                TextInput {
                                    width: 105px;
                                    text: item.nss;
                                    read-only: true;
                                    single-line: true;
                                    font-size: 12px;
                                    font-family: "monospace";
                                    color: #334155;
                                    vertical-alignment: center;
                                }

                                // 5. RFC / CURP
                                TextInput {
                                    width: 165px;
                                    text: item.rfc_curp;
                                    read-only: true;
                                    single-line: true;
                                    font-size: 12px;
                                    font-family: "monospace";
                                    color: #475569;
                                    vertical-alignment: center;
                                }

                                // 6. Nombre del Trabajador
                                TextInput {
                                    width: 220px;
                                    text: item.nombre_trabajador;
                                    read-only: true;
                                    single-line: true;
                                    font-size: 12.5px;
                                    font-weight: 600;
                                    color: #0f172a;
                                    vertical-alignment: center;
                                }

                                // 7. Reg. Patronal
                                TextInput {
                                    width: 105px;
                                    text: item.registro_patronal;
                                    read-only: true;
                                    single-line: true;
                                    font-size: 12px;
                                    color: #475569;
                                    vertical-alignment: center;
                                }

                                // 8. Registro de Obra (Editable ComboBox / Picker)
                                Rectangle {
                                    width: 210px;
                                    height: 28px;
                                    border-radius: 5px;
                                    background: item.is_baja ? #f5f5f5 : (item.is_assigned ? #f0fdf4 : #fef2f2);
                                    border-width: 1px;
                                    border-color: item.is_baja ? #e0e0e0 : (item.is_assigned ? #bbf7d0 : #fecaca);
                                    y: (parent.height - self.height) / 2;

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        alignment: space-between;
                                        Text {
                                            text: item.is_baja ? ("🔒 " + item.obra_label) : item.obra_label;
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: item.is_baja ? #9e9e9e : (item.is_assigned ? #166534 : #b91c1c);
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        if !item.is_baja : Text { text: "▾"; font-size: 11px; color: item.is_assigned ? #16a34a : #dc2626; vertical-alignment: center; }
                                    }

                                    if !item.is_baja : TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            AppLogic.reporte_open_unified_modal(item.id_reporte_liq);
                                        }
                                    }
                                }

                                // 9. Días Cédula (Clickable para modificar)
                                Rectangle {
                                    width: 65px;
                                    height: 26px;
                                    border-radius: 4px;
                                    background: item.is_baja ? #f5f5f5 : #f1f5f9;
                                    border-width: 1px;
                                    border-color: item.is_baja ? #e0e0e0 : #cbd5e1;
                                    y: (parent.height - self.height) / 2;

                                    Text {
                                        text: item.dias_cedula;
                                        font-size: 12.5px;
                                        font-weight: 700;
                                        color: item.is_baja ? #9e9e9e : #1e293b;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    if !item.is_baja : TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            AppLogic.reporte_open_unified_modal(item.id_reporte_liq);
                                        }
                                    }
                                }

                                // 10. Días Obra (Clickable para modificar)
                                Rectangle {
                                    width: 65px;
                                    height: 26px;
                                    border-radius: 4px;
                                    background: item.is_baja ? #f5f5f5 : (item.is_assigned ? #eff6ff : #fff1f2);
                                    border-width: 1px;
                                    border-color: item.is_baja ? #e0e0e0 : (item.is_assigned ? #93c5fd : #fecdd3);
                                    y: (parent.height - self.height) / 2;

                                    Text {
                                        text: item.is_baja ? "🔒" : (item.is_assigned ? item.dias_obra : "-");
                                        font-size: 12.5px;
                                        font-weight: 800;
                                        color: item.is_baja ? #9e9e9e : (item.is_assigned ? #1d4ed8 : #e11d48);
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    if !item.is_baja : TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            AppLogic.reporte_open_unified_modal(item.id_reporte_liq);
                                        }
                                    }
                                }

                                // Clave
                                Rectangle {
                                    width: 75px;
                                    height: 26px;
                                    border-radius: 4px;
                                    background: item.is_baja ? #fee2e2 : #f1f5f9;
                                    border-width: 1px;
                                    border-color: item.is_baja ? #fca5a5 : #cbd5e1;
                                    y: (parent.height - self.height) / 2;

                                    Text {
                                        text: item.clave;
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: item.is_baja ? #b91c1c : #334155;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                // Fecha
                                TextInput {
                                    width: 90px;
                                    text: item.fecha;
                                    read-only: true;
                                    single-line: true;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: #334155;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                // SDI
                                TextInput {
                                    width: 85px;
                                    text: item.sdi_str;
                                    read-only: true;
                                    single-line: true;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: #334155;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }

                                // Licencia
                                TextInput {
                                    width: 50px;
                                    text: item.lic_str;
                                    read-only: true;
                                    single-line: true;
                                    font-size: 12px;
                                    font-weight: (item.has_incidencias && item.lic_str != "-") ? 800 : 400;
                                    color: (item.has_incidencias && item.lic_str != "-") ? #b45309 : #64748b;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                // Incapacidad
                                TextInput {
                                    width: 50px;
                                    text: item.inc_str;
                                    read-only: true;
                                    single-line: true;
                                    font-size: 12px;
                                    font-weight: (item.has_incidencias && item.inc_str != "-") ? 800 : 400;
                                    color: (item.has_incidencias && item.inc_str != "-") ? #b45309 : #64748b;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                // Ausentismo
                                TextInput {
                                    width: 50px;
                                    text: item.aus_str;
                                    read-only: true;
                                    single-line: true;
                                    font-size: 12px;
                                    font-weight: (item.has_incidencias && item.aus_str != "-") ? 800 : 400;
                                    color: (item.has_incidencias && item.aus_str != "-") ? #b45309 : #64748b;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                // 11. Cuota Fija
                                ReporteNumericCell {
                                    curr_str: item.cf_str;
                                    orig_str: item.cf_orig_str;
                                    has_prorrateo: item.has_prorrateo;
                                    cell_width: 85px;
                                }

                                // 13. Exc. Pat.
                                ReporteNumericCell {
                                    curr_str: item.exc_pat_str;
                                    orig_str: item.exc_pat_orig_str;
                                    has_prorrateo: item.has_prorrateo;
                                    cell_width: 85px;
                                }

                                // 14. Exc. Obr.
                                ReporteNumericCell {
                                    curr_str: item.exc_obr_str;
                                    orig_str: item.exc_obr_orig_str;
                                    has_prorrateo: item.has_prorrateo;
                                    cell_width: 85px;
                                }

                                // 15. PD Pat.
                                ReporteNumericCell {
                                    curr_str: item.pd_pat_str;
                                    orig_str: item.pd_pat_orig_str;
                                    has_prorrateo: item.has_prorrateo;
                                    cell_width: 85px;
                                }

                                // 16. PD Obr.
                                ReporteNumericCell {
                                    curr_str: item.pd_obr_str;
                                    orig_str: item.pd_obr_orig_str;
                                    has_prorrateo: item.has_prorrateo;
                                    cell_width: 85px;
                                }

                                // 17. GMP Pat.
                                ReporteNumericCell {
                                    curr_str: item.gmp_pat_str;
                                    orig_str: item.gmp_pat_orig_str;
                                    has_prorrateo: item.has_prorrateo;
                                    cell_width: 85px;
                                }

                                // 18. GMP Obr.
                                ReporteNumericCell {
                                    curr_str: item.gmp_obr_str;
                                    orig_str: item.gmp_obr_orig_str;
                                    has_prorrateo: item.has_prorrateo;
                                    cell_width: 85px;
                                }

                                // 19. Riesgo Trab.
                                ReporteNumericCell {
                                    curr_str: item.rt_str;
                                    orig_str: item.rt_orig_str;
                                    has_prorrateo: item.has_prorrateo;
                                    cell_width: 85px;
                                }

                                // 20. IV Pat.
                                ReporteNumericCell {
                                    curr_str: item.iv_pat_str;
                                    orig_str: item.iv_pat_orig_str;
                                    has_prorrateo: item.has_prorrateo;
                                    cell_width: 85px;
                                }

                                // 21. IV Obr.
                                ReporteNumericCell {
                                    curr_str: item.iv_obr_str;
                                    orig_str: item.iv_obr_orig_str;
                                    has_prorrateo: item.has_prorrateo;
                                    cell_width: 85px;
                                }

                                // 22. Guard y PS
                                ReporteNumericCell {
                                    curr_str: item.gps_str;
                                    orig_str: item.gps_orig_str;
                                    has_prorrateo: item.has_prorrateo;
                                    cell_width: 85px;
                                }

                                // 23. Suma Patronal
                                ReporteNumericCell {
                                    curr_str: item.patronal_str;
                                    orig_str: item.patronal_orig_str;
                                    has_prorrateo: item.has_prorrateo;
                                    cell_width: 95px;
                                    text_color: #1e3a8a;
                                    font_weight: 700;
                                }

                                // 24. Suma Obrera
                                ReporteNumericCell {
                                    curr_str: item.obrera_str;
                                    orig_str: item.obrera_orig_str;
                                    has_prorrateo: item.has_prorrateo;
                                    cell_width: 95px;
                                    text_color: #0284c7;
                                    font_weight: 700;
                                }

                                // 25. Subtotal (Prorrateado y Original)
                                ReporteNumericCell {
                                    curr_str: item.subtotal_str;
                                    orig_str: item.subtotal_orig_str;
                                    has_prorrateo: item.has_prorrateo;
                                    cell_width: 105px;
                                    text_color: #166534;
                                    font_weight: 800;
                                }

                                // 26. Acciones
                                HorizontalLayout {
                                    width: 55px;
                                    spacing: 4px;
                                    alignment: center;
                                    cross-axis-alignment: center;

                                    Rectangle {
                                        width: 26px;
                                        height: 26px;
                                        border-radius: 4px;
                                        background: (!item.is_baja && btn_act_obra.has-hover) ? #e2e8f0 : transparent;

                                        Text { text: item.is_baja ? "🔒" : "✏️"; font-size: item.is_baja ? 11px : 14px; horizontal-alignment: center; vertical-alignment: center; color: item.is_baja ? #94a3b8 : #0f172a; }
                                        btn_act_obra := TouchArea {
                                            enabled: !item.is_baja;
                                            mouse-cursor: !item.is_baja ? pointer : default;
                                            clicked => {
                                                if !item.is_baja {
                                                    AppLogic.reporte_open_unified_modal(item.id_reporte_liq);
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        if AppData.reporte_liquidaciones_list.length == 0 : Rectangle {
                            height: 160px;
                            VerticalLayout {
                                alignment: center;
                                spacing: 8px;
                                Text {
                                    text: "📋";
                                    font-size: 36px;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "No se encontraron liquidaciones para la revisión activa o los filtros seleccionados.";
                                    font-size: 14px;
                                    font-weight: 700;
                                    color: #475569;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Procesa cédulas en 'Cédulas de Cuotas' o ajusta los filtros superiores.";
                                    font-size: 12px;
                                    color: #94a3b8;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // Línea divisoria superior del pie fijo
            Rectangle { height: 2px; background: #cbd5e1; }

            // Pie de Tabla Fijo: Totales Generales / Totales por Mes sincronizado con el scroll horizontal
            Rectangle {
                height: 40px;
                background: #f8fafc;
                clip: true;

                Rectangle {
                    x: table_scroll.content-x;
                    width: 3250px;
                    height: 40px;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        alignment: start;
                        cross-axis-alignment: center;

                        // Bloque de Título / Etiqueta de Totales alineado con las columnas no numéricas (30+35+105+105+165+220+105+210 + 7*8 = 1031px)
                        Rectangle {
                            width: 1031px;
                            height: 40px;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: end;
                                cross-axis-alignment: center;
                                padding-right: 12px;

                                Text {
                                    text: "Σ";
                                    font-size: 15px;
                                    font-weight: 900;
                                    color: #1e3a8a;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: AppData.reporte_filter_periodo_idx == 0 ? ("TOTAL GENERAL (" + AppData.reporte_total_filtered + "):") : ("TOTAL MES (" + AppData.reporte_total_filtered + "):");
                                    font-size: 12px;
                                    font-weight: 800;
                                    color: #1e293b;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Días Cédula
                        Text { width: 65px; text: AppData.reporte_footer_total_dias_ced_str; font-size: 12.5px; font-weight: 800; color: #334155; horizontal-alignment: center; vertical-alignment: center; }

                        // Días Obra
                        Text { width: 65px; text: AppData.reporte_footer_total_dias_obr_str; font-size: 12.5px; font-weight: 800; color: #1d4ed8; horizontal-alignment: center; vertical-alignment: center; }

                        // Clave (espacio sin total)
                        Rectangle { width: 75px; }

                        // Fecha (espacio sin total)
                        Rectangle { width: 90px; }

                        // SDI (espacio sin total)
                        Rectangle { width: 85px; }

                        // Lic.
                        Text { width: 50px; text: AppData.reporte_footer_total_lic_str; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: center; vertical-alignment: center; }

                        // Inc.
                        Text { width: 50px; text: AppData.reporte_footer_total_inc_str; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: center; vertical-alignment: center; }

                        // Aus.
                        Text { width: 50px; text: AppData.reporte_footer_total_aus_str; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: center; vertical-alignment: center; }

                        // Cuota Fija
                        Text { width: 85px; text: AppData.reporte_footer_total_cf_str; font-size: 12.5px; font-weight: 800; color: #1e293b; horizontal-alignment: right; vertical-alignment: center; }

                        // Exc. Pat.
                        Text { width: 85px; text: AppData.reporte_footer_total_exc_pat_str; font-size: 12.5px; font-weight: 800; color: #1e293b; horizontal-alignment: right; vertical-alignment: center; }

                        // Exc. Obr.
                        Text { width: 85px; text: AppData.reporte_footer_total_exc_obr_str; font-size: 12.5px; font-weight: 800; color: #1e293b; horizontal-alignment: right; vertical-alignment: center; }

                        // PD Pat.
                        Text { width: 85px; text: AppData.reporte_footer_total_pd_pat_str; font-size: 12.5px; font-weight: 800; color: #1e293b; horizontal-alignment: right; vertical-alignment: center; }

                        // PD Obr.
                        Text { width: 85px; text: AppData.reporte_footer_total_pd_obr_str; font-size: 12.5px; font-weight: 800; color: #1e293b; horizontal-alignment: right; vertical-alignment: center; }

                        // GMP Pat.
                        Text { width: 85px; text: AppData.reporte_footer_total_gmp_pat_str; font-size: 12.5px; font-weight: 800; color: #1e293b; horizontal-alignment: right; vertical-alignment: center; }

                        // GMP Obr.
                        Text { width: 85px; text: AppData.reporte_footer_total_gmp_obr_str; font-size: 12.5px; font-weight: 800; color: #1e293b; horizontal-alignment: right; vertical-alignment: center; }

                        // Riesgo Trab.
                        Text { width: 85px; text: AppData.reporte_footer_total_rt_str; font-size: 12.5px; font-weight: 800; color: #1e293b; horizontal-alignment: right; vertical-alignment: center; }

                        // IV Pat.
                        Text { width: 85px; text: AppData.reporte_footer_total_iv_pat_str; font-size: 12.5px; font-weight: 800; color: #1e293b; horizontal-alignment: right; vertical-alignment: center; }

                        // IV Obr.
                        Text { width: 85px; text: AppData.reporte_footer_total_iv_obr_str; font-size: 12.5px; font-weight: 800; color: #1e293b; horizontal-alignment: right; vertical-alignment: center; }

                        // Guard y PS
                        Text { width: 85px; text: AppData.reporte_footer_total_gps_str; font-size: 12.5px; font-weight: 800; color: #1e293b; horizontal-alignment: right; vertical-alignment: center; }

                        // Suma Patronal
                        Text { width: 95px; text: AppData.reporte_footer_total_patronal_str; font-size: 12.5px; font-weight: 800; color: #1e3a8a; horizontal-alignment: right; vertical-alignment: center; }

                        // Suma Obrera
                        Text { width: 95px; text: AppData.reporte_footer_total_obrera_str; font-size: 12.5px; font-weight: 800; color: #0284c7; horizontal-alignment: right; vertical-alignment: center; }

                        // Subtotal
                        Text { width: 105px; text: AppData.reporte_footer_total_subtotal_str; font-size: 12.5px; font-weight: 800; color: #166534; horizontal-alignment: right; vertical-alignment: center; }

                        // Espacio para columna de Acción (55px)
                        Rectangle { width: 55px; }
                    }
                }
            }
        }
    }

        // 6. Pie de Tabla: Paginación de 100 en 100 e Información
        HorizontalLayout {
            alignment: space-between;
            spacing: 16px;

            // Información de registros y atajos
            HorizontalLayout {
                spacing: 12px;
                alignment: center;

                Text {
                    text: "Mostrando registros " + AppData.reporte_page_start_row + " - " + AppData.reporte_page_end_row + " de " + AppData.reporte_total_filtered + " (Paginado de 100 en 100)";
                    font-size: 12px;
                    font-weight: 600;
                    color: #475569;
                    vertical-alignment: center;
                }

                Rectangle {
                    height: 24px;
                    border-radius: 4px;
                    background: #f1f5f9;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        alignment: center;
                        Text {
                            text: "F2 Editar | Tab Sig. Celda | Enter Confirmar | Ctrl+S Guardar";
                            font-size: 11px;
                            font-weight: 600;
                            color: #64748b;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Controles de Paginación
            HorizontalLayout {
                spacing: 6px;
                alignment: end;

                // Primera
                Rectangle {
                    height: 32px;
                    width: 85px;
                    border-radius: 4px;
                    background: btn_p_first.has-hover ? #e2e8f0 : #ffffff;
                    border-width: 1px;
                    border-color: #cbd5e1;
                    opacity: AppData.reporte_page_current > 1 ? 1.0 : 0.4;

                    Text { text: "|< Primera"; font-size: 12px; font-weight: 700; color: #334155; horizontal-alignment: center; vertical-alignment: center; }
                    btn_p_first := TouchArea {
                        enabled: AppData.reporte_page_current > 1;
                        mouse-cursor: AppData.reporte_page_current > 1 ? pointer : not-allowed;
                        clicked => { AppLogic.reporte_cambiar_pagina(1); }
                    }
                }

                // Anterior
                Rectangle {
                    height: 32px;
                    width: 85px;
                    border-radius: 4px;
                    background: btn_p_prev.has-hover ? #e2e8f0 : #ffffff;
                    border-width: 1px;
                    border-color: #cbd5e1;
                    opacity: AppData.reporte_page_current > 1 ? 1.0 : 0.4;

                    Text { text: "< Anterior"; font-size: 12px; font-weight: 700; color: #334155; horizontal-alignment: center; vertical-alignment: center; }
                    btn_p_prev := TouchArea {
                        enabled: AppData.reporte_page_current > 1;
                        mouse-cursor: AppData.reporte_page_current > 1 ? pointer : not-allowed;
                        clicked => { AppLogic.reporte_cambiar_pagina(AppData.reporte_page_current - 1); }
                    }
                }

                // Indicador de página
                Rectangle {
                    height: 32px;
                    width: 95px;
                    border-radius: 4px;
                    background: #1e3a8a;

                    Text {
                        text: AppData.reporte_page_current + " / " + AppData.reporte_page_total;
                        font-size: 12px;
                        font-weight: 800;
                        color: #ffffff;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Siguiente
                Rectangle {
                    height: 32px;
                    width: 85px;
                    border-radius: 4px;
                    background: btn_p_next.has-hover ? #e2e8f0 : #ffffff;
                    border-width: 1px;
                    border-color: #cbd5e1;
                    opacity: AppData.reporte_page_current < AppData.reporte_page_total ? 1.0 : 0.4;

                    Text { text: "Siguiente >"; font-size: 12px; font-weight: 700; color: #334155; horizontal-alignment: center; vertical-alignment: center; }
                    btn_p_next := TouchArea {
                        enabled: AppData.reporte_page_current < AppData.reporte_page_total;
                        mouse-cursor: AppData.reporte_page_current < AppData.reporte_page_total ? pointer : not-allowed;
                        clicked => { AppLogic.reporte_cambiar_pagina(AppData.reporte_page_current + 1); }
                    }
                }

                // Última
                Rectangle {
                    height: 32px;
                    width: 85px;
                    border-radius: 4px;
                    background: btn_p_last.has-hover ? #e2e8f0 : #ffffff;
                    border-width: 1px;
                    border-color: #cbd5e1;
                    opacity: AppData.reporte_page_current < AppData.reporte_page_total ? 1.0 : 0.4;

                    Text { text: "Última >|"; font-size: 12px; font-weight: 700; color: #334155; horizontal-alignment: center; vertical-alignment: center; }
                    btn_p_last := TouchArea {
                        enabled: AppData.reporte_page_current < AppData.reporte_page_total;
                        mouse-cursor: AppData.reporte_page_current < AppData.reporte_page_total ? pointer : not-allowed;
                        clicked => { AppLogic.reporte_cambiar_pagina(AppData.reporte_page_total); }
                    }
                }
            }
        }

        // 7. Análisis de Guarderías (Tope 18% por Registro de Obra del Usuario)
        if AppData.reporte_guarderias_obras.length > 0 : VerticalLayout {
            spacing: 10px;

            for g_item in AppData.reporte_guarderias_obras : Rectangle {
                border-radius: 8px;
                background: #ffffff;
                border-width: 1px;
                border-color: g_item.supera_18 ? #facc15 : #e2e8f0;

                VerticalLayout {
                    padding: 12px;
                    spacing: 10px;

                    // Encabezado de la Obra y Alerta si supera el 18%
                    HorizontalLayout {
                        alignment: space-between;
                        spacing: 12px;

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;
                            Text { text: "🏗️"; font-size: 15px; vertical-alignment: center; }
                            Text {
                                text: "Registro de Obra: " + g_item.obra_label + " (" + g_item.empleados_count + " registros vinculados)";
                                font-size: 13px;
                                font-weight: 800;
                                color: #1e3a8a;
                                vertical-alignment: center;
                            }
                        }

                        if g_item.supera_18 : Rectangle {
                            height: 26px;
                            border-radius: 4px;
                            background: #fef08a;
                            border-width: 1px;
                            border-color: #eab308;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 6px;
                                alignment: center;
                                Text { text: "⚠️"; font-size: 12px; vertical-alignment: center; }
                                Text {
                                    text: "ADVERTENCIA: Guarderías supera el 18% del valor de la obra";
                                    font-size: 11.5px;
                                    font-weight: 800;
                                    color: #854d0e;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // Cuadros KPI Responsivos de Contraste
                    HorizontalLayout {
                        spacing: 12px;

                        // Cuadro 1: Valor Guarderías (1% Total GPS) -> Amarillo si supera el 18%
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 70px;
                            border-radius: 8px;
                            background: g_item.supera_18 ? #fef9c3 : #ffffff;
                            border-width: g_item.supera_18 ? 2px : 1px;
                            border-color: g_item.supera_18 ? #eab308 : #e2e8f0;

                            VerticalLayout {
                                padding: 10px;
                                alignment: space-between;
                                HorizontalLayout {
                                    alignment: space-between;
                                    Text {
                                        text: "VALOR GUARDERÍAS (1% GPS)";
                                        font-size: 11px;
                                        font-weight: 800;
                                        color: g_item.supera_18 ? #854d0e : #64748b;
                                        letter-spacing: 0.5px;
                                    }
                                    if g_item.supera_18 : Text {
                                        text: "⚠️ > 18%";
                                        font-size: 11px;
                                        font-weight: 800;
                                        color: #ca8a04;
                                    }
                                }
                                Text {
                                    text: g_item.valor_guarderias_str;
                                    font-size: 18px;
                                    font-weight: 800;
                                    color: g_item.supera_18 ? #854d0e : #0f172a;
                                }
                            }
                        }

                        // Cuadro 2: Valor Total de la Obra
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 70px;
                            border-radius: 8px;
                            background: #ffffff;
                            border-width: 1px;
                            border-color: #e2e8f0;

                            VerticalLayout {
                                padding: 10px;
                                alignment: space-between;
                                Text {
                                    text: "VALOR TOTAL DE LA OBRA";
                                    font-size: 11px;
                                    font-weight: 800;
                                    color: #64748b;
                                    letter-spacing: 0.5px;
                                }
                                Text {
                                    text: g_item.monto_obra_str;
                                    font-size: 18px;
                                    font-weight: 800;
                                    color: #0f172a;
                                }
                            }
                        }

                        // Cuadro 3: Límite 18% de la Obra
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 70px;
                            border-radius: 8px;
                            background: #f0fdf4;
                            border-width: 1px;
                            border-color: #bbf7d0;

                            VerticalLayout {
                                padding: 10px;
                                alignment: space-between;
                                Text {
                                    text: "LÍMITE 18% DE LA OBRA";
                                    font-size: 11px;
                                    font-weight: 800;
                                    color: #166534;
                                    letter-spacing: 0.5px;
                                }
                                Text {
                                    text: g_item.limite_18_obra_str;
                                    font-size: 18px;
                                    font-weight: 800;
                                    color: #15803d;
                                }
                            }
                        }

                        // Cuadro 4: Total Cuotas GPS IMSS
                        Rectangle {
                            horizontal-stretch: 1;
                            height: 70px;
                            border-radius: 8px;
                            background: #f8fafc;
                            border-width: 1px;
                            border-color: #e2e8f0;

                            VerticalLayout {
                                padding: 10px;
                                alignment: space-between;
                                Text {
                                    text: "TOTAL CUOTAS GPS (IMSS)";
                                    font-size: 11px;
                                    font-weight: 800;
                                    color: #64748b;
                                    letter-spacing: 0.5px;
                                }
                                Text {
                                    text: g_item.total_gps_str;
                                    font-size: 18px;
                                    font-weight: 800;
                                    color: #2563eb;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    }

    // Modal Unificado: Modificar Asignación de Registro de Obra y Días (SIROC)
    if AppData.show_reporte_edit_modal : Rectangle {
        background: #00000088;
        width: 100%;
        height: 100%;

        TouchArea {}

        Rectangle {
            width: 580px;
            height: (AppData.reporte_edit_dropdown_open ? 590px : 480px) + (AppData.reporte_edit_alert_show ? 54px : 0px);
            border-radius: 12px;
            background: #ffffff;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000040;
            animate height { duration: 150ms; easing: ease-out; }

            VerticalLayout {
                padding: 22px;
                spacing: 14px;
                alignment: space-between;

                // 1. Título y Cabecera
                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: 3px;
                        Text {
                            text: "Modificar Asignación de Obra y Días";
                            font-size: 18px;
                            font-weight: 800;
                            color: #0f172a;
                        }
                        Text {
                            text: "Trabajador: " + AppData.reporte_edit_worker_name + (AppData.reporte_edit_periodo != "" ? " • " + AppData.reporte_edit_periodo : "");
                            font-size: 13.5px;
                            font-weight: 600;
                            color: #2563eb;
                            overflow: elide;
                        }
                    }

                    Rectangle {
                        width: 30px;
                        height: 30px;
                        border-radius: 15px;
                        background: btn_close_edit.has-hover ? #fee2e2 : #f1f5f9;
                        Text { text: "✕"; font-size: 14px; font-weight: 800; color: #ef4444; horizontal-alignment: center; vertical-alignment: center; }
                        btn_close_edit := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_close_edit_modal(); }
                        }
                    }
                }

                // ALERTA TEMPORAL EN EL MODAL (Visible ante errores/restricciones de asignación)
                if AppData.reporte_edit_alert_show : Rectangle {
                    border-radius: 8px;
                    background: AppData.reporte_edit_alert_type == "error" ? #fef2f2 : (AppData.reporte_edit_alert_type == "warning" ? #fffbeb : #eff6ff);
                    border-width: 1.5px;
                    border-color: AppData.reporte_edit_alert_type == "error" ? #f87171 : (AppData.reporte_edit_alert_type == "warning" ? #fde68a : #93c5fd);

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 10px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 10px;
                        cross-axis-alignment: center;

                        Text {
                            text: AppData.reporte_edit_alert_type == "error" ? "⛔" : (AppData.reporte_edit_alert_type == "warning" ? "⚠️" : "ℹ");
                            font-size: 16px;
                            vertical-alignment: center;
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: AppData.reporte_edit_alert_text;
                            font-size: 12.5px;
                            font-weight: 700;
                            color: AppData.reporte_edit_alert_type == "error" ? #991b1b : (AppData.reporte_edit_alert_type == "warning" ? #92400e : #1e40af);
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 22px;
                            height: 22px;
                            border-radius: 11px;
                            background: btn_dismiss_edit_alert.has-hover ? #fecaca : transparent;
                            Text {
                                text: "✕";
                                font-size: 12px;
                                font-weight: 800;
                                color: #991b1b;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            btn_dismiss_edit_alert := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { AppData.reporte_edit_alert_show = false; }
                            }
                        }
                    }
                }

                // 2. Campo Registro de Obra (Combobox con filtro)
                VerticalLayout {
                    spacing: 6px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "Registro de Obra (SIROC):";
                            font-size: 13px;
                            font-weight: 700;
                            color: #334155;
                            vertical-alignment: center;
                        }
                        Text {
                            text: AppData.reporte_edit_selected_obra_id != "" ? "Obra Vinculada" : "⚠️ Sin Asignar (Pendiente)";
                            font-size: 12px;
                            font-weight: 700;
                            color: AppData.reporte_edit_selected_obra_id != "" ? #166534 : #b91c1c;
                            vertical-alignment: center;
                        }
                    }

                    // Cuadro de Combobox / Input
                    Rectangle {
                        height: 40px;
                        border-radius: 6px;
                        background: #ffffff;
                        border-width: 1.5px;
                        border-color: AppData.reporte_edit_dropdown_open ? #3b82f6 : #cbd5e1;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 6px;
                            spacing: 8px;
                            alignment: space-between;

                            edit_search_input := LineEdit {
                                horizontal-stretch: 1;
                                placeholder-text: "Escribe para filtrar o selecciona una obra...";
                                text <=> AppData.reporte_edit_search_query;
                                edited(text) => {
                                    AppData.reporte_edit_dropdown_open = true;
                                    AppLogic.reporte_filter_edit_obras(text);
                                }
                            }

                            // Botón flecha desplegable Combobox
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 4px;
                                background: btn_drop_toggle.has-hover ? #e2e8f0 : transparent;
                                y: (parent.height - self.height) / 2;

                                Text {
                                    text: AppData.reporte_edit_dropdown_open ? "▴" : "▾";
                                    font-size: 14px;
                                    font-weight: 800;
                                    color: #2563eb;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                btn_drop_toggle := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        AppData.reporte_edit_dropdown_open = !AppData.reporte_edit_dropdown_open;
                                        if AppData.reporte_edit_dropdown_open {
                                            AppLogic.reporte_filter_edit_obras("");
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Menú desplegable Combobox (Lista de opciones)
                    if AppData.reporte_edit_dropdown_open : Rectangle {
                        height: 135px;
                        border-radius: 6px;
                        background: #ffffff;
                        border-width: 1px;
                        border-color: #93c5fd;
                        drop-shadow-blur: 10px;
                        drop-shadow-color: #00000020;
                        clip: true;

                        ScrollView {
                            VerticalLayout {
                                padding: 4px;
                                spacing: 4px;

                                // Opción: Dejar Sin Asignar (Pendiente)
                                Rectangle {
                                    height: 34px;
                                    border-radius: 4px;
                                    background: btn_pick_none.has-hover ? #fee2e2 : (AppData.reporte_edit_selected_obra_id == "" ? #fef2f2 : #ffffff);
                                    border-width: 1px;
                                    border-color: AppData.reporte_edit_selected_obra_id == "" ? #fca5a5 : #f1f5f9;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 8px;
                                        alignment: start;
                                        Text { text: "⚠️"; font-size: 12px; vertical-alignment: center; }
                                        Text {
                                            text: "Dejar Sin Asignar (Pendiente)";
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: #b91c1c;
                                            vertical-alignment: center;
                                        }
                                    }

                                    btn_pick_none := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            edit_search_input.text = "⚠️ Sin Asignar (Pendiente)";
                                            AppData.reporte_edit_search_query = "⚠️ Sin Asignar (Pendiente)";
                                            AppData.reporte_edit_dropdown_open = false;
                                            AppLogic.reporte_select_edit_obra("", "⚠️ Sin Asignar (Pendiente)");
                                        }
                                    }
                                }

                                // Obras disponibles filtradas
                                for o in AppData.reporte_edit_filtered_obras : Rectangle {
                                    height: 34px;
                                    border-radius: 4px;
                                    background: btn_pick_item.has-hover ? #dbeafe : (AppData.reporte_edit_selected_obra_id == o.id ? #eff6ff : #ffffff);
                                    border-width: 1px;
                                    border-color: AppData.reporte_edit_selected_obra_id == o.id ? #93c5fd : #f1f5f9;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 8px;
                                        alignment: start;
                                        Text { text: "🏗"; font-size: 12px; vertical-alignment: center; }
                                        Text {
                                            text: o.label;
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: #1e3a8a;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }

                                    btn_pick_item := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            edit_search_input.text = o.label;
                                            AppData.reporte_edit_search_query = o.label;
                                            AppData.reporte_edit_dropdown_open = false;
                                            AppLogic.reporte_select_edit_obra(o.id, o.label);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // 2.5 Resumen Informativo de Incidencias (Lic, Inc, Aus) y Límite de Días
                Rectangle {
                    border-radius: 8px;
                    background: #fffbeb;
                    border-width: 1px;
                    border-color: #fde68a;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 8px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "⚠️ Incidencias registradas en el mes:";
                                font-size: 12px;
                                font-weight: 800;
                                color: #92400e;
                            }
                            Text {
                                text: "Límite máx. asignable: " + AppData.reporte_edit_dias_max + " días";
                                font-size: 12px;
                                font-weight: 800;
                                color: #b45309;
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            Rectangle {
                                height: 26px;
                                border-radius: 4px;
                                background: #ffffff;
                                border-width: 1px;
                                border-color: #fde68a;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    alignment: center;
                                    Text { text: "Licencias: " + AppData.reporte_edit_lic_info; font-size: 11.5px; font-weight: 700; color: #b45309; vertical-alignment: center; }
                                }
                            }

                            Rectangle {
                                height: 26px;
                                border-radius: 4px;
                                background: #ffffff;
                                border-width: 1px;
                                border-color: #fde68a;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    alignment: center;
                                    Text { text: "Incapacidades: " + AppData.reporte_edit_inc_info; font-size: 11.5px; font-weight: 700; color: #b45309; vertical-alignment: center; }
                                }
                            }

                            Rectangle {
                                height: 26px;
                                border-radius: 4px;
                                background: #ffffff;
                                border-width: 1px;
                                border-color: #fde68a;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    alignment: center;
                                    Text { text: "Ausentismos: " + AppData.reporte_edit_aus_info; font-size: 11.5px; font-weight: 700; color: #b45309; vertical-alignment: center; }
                                }
                            }
                        }

                        if AppData.reporte_edit_obra_vigencia_info != "" : Rectangle {
                            border-radius: 4px;
                            background: AppData.reporte_edit_dias_max == 0 ? #fef2f2 : #eff6ff;
                            border-width: 1px;
                            border-color: AppData.reporte_edit_dias_max == 0 ? #fca5a5 : #bfdbfe;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                padding-top: 4px;
                                padding-bottom: 4px;
                                Text {
                                    text: AppData.reporte_edit_obra_vigencia_info;
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: AppData.reporte_edit_dias_max == 0 ? #b91c1c : #1e40af;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }

                // 3. Campos de Días Cédula y Días Obra
                HorizontalLayout {
                    spacing: 16px;

                    VerticalLayout {
                        spacing: 6px;
                        horizontal-stretch: 1;
                        Text { text: "Días Cédula SUA:"; font-size: 13px; font-weight: 700; color: #334155; }
                        Rectangle {
                            height: 40px;
                            border-radius: 6px;
                            background: #ffffff;
                            border-width: 1px;
                            border-color: #cbd5e1;

                            LineEdit {
                                text <=> AppData.reporte_edit_dias_cedula_val;
                                edited(text) => {
                                    AppLogic.reporte_edit_dias_cedula_changed(text);
                                }
                            }
                        }
                    }

                    VerticalLayout {
                        spacing: 6px;
                        horizontal-stretch: 1;
                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: "Días Registro Obra:"; font-size: 13px; font-weight: 700; color: #1e40af; }
                            Text { text: "(Tope máx: " + AppData.reporte_edit_dias_max + ")"; font-size: 11.5px; font-weight: 700; color: #64748b; vertical-alignment: center; }
                        }
                        Rectangle {
                            height: 40px;
                            border-radius: 6px;
                            background: #ffffff;
                            border-width: 1.5px;
                            border-color: #93c5fd;

                            LineEdit {
                                text <=> AppData.reporte_edit_dias_obra_val;
                            }
                        }
                    }
                }

                // 4. Botones Cancelar y Guardar Cambios
                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;

                    Rectangle {
                        height: 38px;
                        width: 105px;
                        border-radius: 6px;
                        background: btn_cancel_unif.has-hover ? #e2e8f0 : #f1f5f9;
                        border-width: 1px;
                        border-color: #cbd5e1;

                        Text { text: "Cancelar"; font-size: 13px; font-weight: 700; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                        btn_cancel_unif := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_close_edit_modal(); }
                        }
                    }

                    Rectangle {
                        height: 38px;
                        width: 165px;
                        border-radius: 6px;
                        background: btn_save_unif.has-hover ? #1d4ed8 : #2563eb;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            Text { text: "💾"; font-size: 13px; vertical-alignment: center; }
                            Text { text: "Guardar Cambios"; font-size: 13px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                        }

                        btn_save_unif := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                AppLogic.reporte_submit_unified_edit(
                                    AppData.reporte_edit_row_id,
                                    AppData.reporte_edit_selected_obra_id,
                                    AppData.reporte_edit_dias_cedula_val,
                                    AppData.reporte_edit_dias_obra_val
                                );
                            }
                        }
                    }
                }
            }
        }
    }

    // Modal de Modificación Masiva de Asignación de Obra y Días
    if AppData.show_reporte_batch_edit_modal : Rectangle {
        background: #00000088;
        width: 100%;
        height: 100%;

        TouchArea {}

        Rectangle {
            width: 820px;
            height: (AppData.reporte_batch_edit_dropdown_open ? 690px : 570px) + (AppData.reporte_batch_edit_alert_show ? 54px : 0px);
            border-radius: 12px;
            background: #ffffff;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000040;
            animate height { duration: 150ms; easing: ease-out; }

            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                alignment: space-between;

                // 1. Título y Cabecera
                HorizontalLayout {
                    alignment: space-between;
                    cross-axis-alignment: center;

                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: "Modificar Asignación Masiva de Obra y Días";
                            font-size: 18px;
                            font-weight: 800;
                            color: #0f172a;
                        }
                        Text {
                            text: "Se aplicarán los cambios a " + AppData.reporte_batch_edit_worker_count + " trabajador(es) / registro(s) seleccionados";
                            font-size: 13px;
                            font-weight: 600;
                            color: #2563eb;
                            overflow: elide;
                        }
                    }

                    Rectangle {
                        width: 30px;
                        height: 30px;
                        border-radius: 15px;
                        background: btn_close_batch_edit.has-hover ? #fee2e2 : #f1f5f9;
                        Text { text: "✕"; font-size: 14px; font-weight: 800; color: #ef4444; horizontal-alignment: center; vertical-alignment: center; }
                        btn_close_batch_edit := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_close_batch_edit_modal(); }
                        }
                    }
                }

                // ALERTA TEMPORAL EN EL MODAL MASIVO (Visible ante errores/restricciones)
                if AppData.reporte_batch_edit_alert_show : Rectangle {
                    border-radius: 8px;
                    background: AppData.reporte_batch_edit_alert_type == "error" ? #fef2f2 : (AppData.reporte_batch_edit_alert_type == "warning" ? #fffbeb : #eff6ff);
                    border-width: 1.5px;
                    border-color: AppData.reporte_batch_edit_alert_type == "error" ? #f87171 : (AppData.reporte_batch_edit_alert_type == "warning" ? #fde68a : #93c5fd);

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 10px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 10px;
                        cross-axis-alignment: center;

                        Text {
                            text: AppData.reporte_batch_edit_alert_type == "error" ? "⛔" : (AppData.reporte_batch_edit_alert_type == "warning" ? "⚠️" : "ℹ");
                            font-size: 16px;
                            vertical-alignment: center;
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: AppData.reporte_batch_edit_alert_text;
                            font-size: 12.5px;
                            font-weight: 700;
                            color: AppData.reporte_batch_edit_alert_type == "error" ? #991b1b : (AppData.reporte_batch_edit_alert_type == "warning" ? #92400e : #1e40af);
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 22px;
                            height: 22px;
                            border-radius: 11px;
                            background: btn_dismiss_batch_alert.has-hover ? #fecaca : transparent;
                            Text {
                                text: "✕";
                                font-size: 12px;
                                font-weight: 800;
                                color: #991b1b;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            btn_dismiss_batch_alert := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { AppData.reporte_batch_edit_alert_show = false; }
                            }
                        }
                    }
                }

                // 2. Tabla de Trabajadores Seleccionados
                Rectangle {
                    height: 145px;
                    border-radius: 6px;
                    background: #f8fafc;
                    border-width: 1px;
                    border-color: #cbd5e1;
                    clip: true;

                    VerticalLayout {
                        // Cabecera de la tabla
                        Rectangle {
                            height: 28px;
                            background: #e2e8f0;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                cross-axis-alignment: center;
                                Text { text: "Trabajador (Nombre / NSS)"; font-size: 11px; font-weight: 800; color: #334155; horizontal-stretch: 3; }
                                Text { text: "Periodo"; font-size: 11px; font-weight: 800; color: #334155; horizontal-stretch: 1; horizontal-alignment: center; }
                                Text { text: "Obra Actual"; font-size: 11px; font-weight: 800; color: #334155; horizontal-stretch: 2; }
                                Text { text: "D. Cédula"; font-size: 11px; font-weight: 800; color: #334155; width: 58px; horizontal-alignment: center; }
                                Text { text: "D. Obra"; font-size: 11px; font-weight: 800; color: #334155; width: 58px; horizontal-alignment: center; }
                                Text { text: "Tope Máx"; font-size: 11px; font-weight: 800; color: #047857; width: 66px; horizontal-alignment: center; }
                            }
                        }

                        // Filas scrolleables
                        ScrollView {
                            VerticalLayout {
                                padding: 3px;
                                spacing: 2px;

                                for worker[idx] in AppData.reporte_batch_edit_workers : Rectangle {
                                    height: 27px;
                                    border-radius: 4px;
                                    background: Math.mod(idx, 2) == 0 ? #ffffff : #f1f5f9;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 8px;
                                        cross-axis-alignment: center;

                                        // Nombre y NSS
                                        HorizontalLayout {
                                            horizontal-stretch: 3;
                                            spacing: 6px;
                                            cross-axis-alignment: center;
                                            Text {
                                                text: worker.nombre;
                                                font-size: 11.5px;
                                                font-weight: 700;
                                                color: #0f172a;
                                                overflow: elide;
                                            }
                                            if worker.nss != "" : Text {
                                                text: "(" + worker.nss + ")";
                                                font-size: 10.5px;
                                                color: #64748b;
                                                overflow: elide;
                                            }
                                        }

                                        // Periodo
                                        Text {
                                            text: worker.periodo;
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: #475569;
                                            horizontal-stretch: 1;
                                            horizontal-alignment: center;
                                        }

                                        // Obra actual
                                        Text {
                                            text: worker.obra_label;
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: #1e40af;
                                            horizontal-stretch: 2;
                                            overflow: elide;
                                        }

                                        // Días Cédula
                                        Text {
                                            text: worker.dias_cedula;
                                            font-size: 11.5px;
                                            font-weight: 700;
                                            color: #334155;
                                            width: 58px;
                                            horizontal-alignment: center;
                                        }

                                        // Días Obra
                                        Text {
                                            text: worker.dias_obra;
                                            font-size: 11.5px;
                                            font-weight: 700;
                                            color: #2563eb;
                                            width: 58px;
                                            horizontal-alignment: center;
                                        }

                                        // Tope Máx
                                        Rectangle {
                                            width: 66px;
                                            height: 22px;
                                            border-radius: 4px;
                                            background: worker.tope_max == 0 ? #fef2f2 : #ecfdf5;
                                            border-width: 1px;
                                            border-color: worker.tope_max == 0 ? #fca5a5 : #a7f3d0;

                                            Text {
                                                text: worker.tope_max;
                                                font-size: 11.5px;
                                                font-weight: 800;
                                                color: worker.tope_max == 0 ? #b91c1c : #047857;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // 3. Campo Registro de Obra (Combobox con filtro)
                VerticalLayout {
                    spacing: 5px;

                    HorizontalLayout {
                        alignment: space-between;
                        cross-axis-alignment: center;

                        HorizontalLayout {
                            spacing: 8px;
                            cross-axis-alignment: center;

                            Rectangle {
                                width: 18px;
                                height: 18px;
                                border-radius: 4px;
                                background: AppData.reporte_batch_edit_change_obra ? #2563eb : #ffffff;
                                border-width: 1px;
                                border-color: AppData.reporte_batch_edit_change_obra ? #2563eb : #94a3b8;

                                Text {
                                    text: "✓";
                                    font-size: 12px;
                                    font-weight: 800;
                                    color: #ffffff;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    visible: AppData.reporte_batch_edit_change_obra;
                                }

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        AppData.reporte_batch_edit_change_obra = !AppData.reporte_batch_edit_change_obra;
                                    }
                                }
                            }

                            Text {
                                text: "Modificar Registro de Obra (SIROC):";
                                font-size: 13px;
                                font-weight: 700;
                                color: #334155;
                                vertical-alignment: center;
                            }
                        }

                        Text {
                            text: !AppData.reporte_batch_edit_change_obra ? "Sin cambios (Mantener actuales)" : (AppData.reporte_batch_edit_selected_obra_id == "__NONE__" ? "⚠️ Se Desvinculará" : (AppData.reporte_batch_edit_selected_obra_id == "__KEEP__" ? "🔄 Mantener Obras" : "🏗 Se Asignará"));
                            font-size: 12px;
                            font-weight: 700;
                            color: !AppData.reporte_batch_edit_change_obra ? #64748b : (AppData.reporte_batch_edit_selected_obra_id == "__NONE__" ? #b91c1c : #166534);
                            vertical-alignment: center;
                        }
                    }

                    // Cuadro de Combobox / Input
                    Rectangle {
                        height: 38px;
                        border-radius: 6px;
                        background: #ffffff;
                        border-width: 1.5px;
                        border-color: AppData.reporte_batch_edit_dropdown_open ? #3b82f6 : (AppData.reporte_batch_edit_change_obra ? #93c5fd : #cbd5e1);

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 6px;
                            spacing: 8px;
                            alignment: space-between;

                            batch_edit_search_input := LineEdit {
                                horizontal-stretch: 1;
                                placeholder-text: "Escribe para filtrar obra o selecciona del menú...";
                                text <=> AppData.reporte_batch_edit_search_query;
                                edited(text) => {
                                    AppData.reporte_batch_edit_dropdown_open = true;
                                    AppLogic.reporte_filter_batch_edit_obras(text);
                                }
                            }

                            // Botón flecha desplegable Combobox
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 4px;
                                background: btn_batch_drop_toggle.has-hover ? #e2e8f0 : transparent;
                                y: (parent.height - self.height) / 2;

                                Text {
                                    text: AppData.reporte_batch_edit_dropdown_open ? "▴" : "▾";
                                    font-size: 14px;
                                    font-weight: 800;
                                    color: #2563eb;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                btn_batch_drop_toggle := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        AppData.reporte_batch_edit_dropdown_open = !AppData.reporte_batch_edit_dropdown_open;
                                        if AppData.reporte_batch_edit_dropdown_open {
                                            AppLogic.reporte_filter_batch_edit_obras("");
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Menú desplegable Combobox (Lista de opciones)
                    if AppData.reporte_batch_edit_dropdown_open : Rectangle {
                        height: 130px;
                        border-radius: 6px;
                        background: #ffffff;
                        border-width: 1px;
                        border-color: #93c5fd;
                        drop-shadow-blur: 10px;
                        drop-shadow-color: #00000020;
                        clip: true;

                        ScrollView {
                            VerticalLayout {
                                padding: 4px;
                                spacing: 4px;

                                // Opción: Mantener obras actuales (Sin Cambios)
                                Rectangle {
                                    height: 32px;
                                    border-radius: 4px;
                                    background: btn_batch_pick_keep.has-hover ? #eff6ff : (AppData.reporte_batch_edit_selected_obra_id == "__KEEP__" ? #f0fdf4 : #ffffff);
                                    border-width: 1px;
                                    border-color: AppData.reporte_batch_edit_selected_obra_id == "__KEEP__" ? #86efac : #f1f5f9;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 8px;
                                        alignment: start;
                                        Text { text: "🔄"; font-size: 12px; vertical-alignment: center; }
                                        Text {
                                            text: "Mantener Obras Actuales (Sin Cambios)";
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: #1e3a8a;
                                            vertical-alignment: center;
                                        }
                                    }

                                    btn_batch_pick_keep := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            batch_edit_search_input.text = "🔄 Mantener Obras Actuales (Sin Cambios)";
                                            AppData.reporte_batch_edit_search_query = "🔄 Mantener Obras Actuales (Sin Cambios)";
                                            AppData.reporte_batch_edit_dropdown_open = false;
                                            AppLogic.reporte_select_batch_edit_obra("__KEEP__", "🔄 Mantener Obras Actuales (Sin Cambios)");
                                        }
                                    }
                                }

                                // Opción: Dejar Sin Asignar (Desvincular todas)
                                Rectangle {
                                    height: 32px;
                                    border-radius: 4px;
                                    background: btn_batch_pick_none.has-hover ? #fee2e2 : (AppData.reporte_batch_edit_selected_obra_id == "__NONE__" ? #fef2f2 : #ffffff);
                                    border-width: 1px;
                                    border-color: AppData.reporte_batch_edit_selected_obra_id == "__NONE__" ? #fca5a5 : #f1f5f9;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 8px;
                                        alignment: start;
                                        Text { text: "⚠️"; font-size: 12px; vertical-alignment: center; }
                                        Text {
                                            text: "Desvincular Obra (Dejar Sin Asignar a Todos)";
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: #b91c1c;
                                            vertical-alignment: center;
                                        }
                                    }

                                    btn_batch_pick_none := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            batch_edit_search_input.text = "⚠️ Desvincular Obra (Sin Asignar)";
                                            AppData.reporte_batch_edit_search_query = "⚠️ Desvincular Obra (Sin Asignar)";
                                            AppData.reporte_batch_edit_dropdown_open = false;
                                            AppLogic.reporte_select_batch_edit_obra("__NONE__", "⚠️ Desvincular Obra (Sin Asignar)");
                                        }
                                    }
                                }

                                // Obras disponibles filtradas
                                for o in AppData.reporte_batch_edit_filtered_obras : Rectangle {
                                    height: 32px;
                                    border-radius: 4px;
                                    background: btn_batch_pick_item.has-hover ? #dbeafe : (AppData.reporte_batch_edit_selected_obra_id == o.id ? #eff6ff : #ffffff);
                                    border-width: 1px;
                                    border-color: AppData.reporte_batch_edit_selected_obra_id == o.id ? #93c5fd : #f1f5f9;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 8px;
                                        alignment: start;
                                        Text { text: "🏗"; font-size: 12px; vertical-alignment: center; }
                                        Text {
                                            text: o.label;
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: #1e3a8a;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }

                                    btn_batch_pick_item := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            batch_edit_search_input.text = o.label;
                                            AppData.reporte_batch_edit_search_query = o.label;
                                            AppData.reporte_batch_edit_dropdown_open = false;
                                            AppLogic.reporte_select_batch_edit_obra(o.id, o.label);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // 4. Campos de Días Cédula y Días Obra
                HorizontalLayout {
                    spacing: 16px;

                    // Columna 1: Días Cédula SUA
                    VerticalLayout {
                        spacing: 5px;
                        horizontal-stretch: 1;

                        HorizontalLayout {
                            spacing: 8px;
                            cross-axis-alignment: center;

                            Rectangle {
                                width: 18px;
                                height: 18px;
                                border-radius: 4px;
                                background: AppData.reporte_batch_edit_change_dias_cedula ? #2563eb : #ffffff;
                                border-width: 1px;
                                border-color: AppData.reporte_batch_edit_change_dias_cedula ? #2563eb : #94a3b8;

                                Text {
                                    text: "✓";
                                    font-size: 12px;
                                    font-weight: 800;
                                    color: #ffffff;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    visible: AppData.reporte_batch_edit_change_dias_cedula;
                                }

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        AppData.reporte_batch_edit_change_dias_cedula = !AppData.reporte_batch_edit_change_dias_cedula;
                                    }
                                }
                            }

                            Text {
                                text: "Modificar Días Cédula SUA:";
                                font-size: 13px;
                                font-weight: 700;
                                color: #334155;
                            }
                        }

                        Rectangle {
                            height: 38px;
                            border-radius: 6px;
                            background: #ffffff;
                            border-width: 1.5px;
                            border-color: AppData.reporte_batch_edit_change_dias_cedula ? #3b82f6 : #cbd5e1;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;

                                LineEdit {
                                    placeholder-text: "Ej. 30 (dejar vacío para no cambiar)";
                                    text <=> AppData.reporte_batch_edit_dias_cedula_val;
                                    edited(text) => {
                                        AppData.reporte_batch_edit_change_dias_cedula = (text != "");
                                        AppLogic.reporte_batch_edit_dias_cedula_changed(text);
                                    }
                                }
                            }
                        }
                    }

                    // Columna 2: Días Registro Obra
                    VerticalLayout {
                        spacing: 5px;
                        horizontal-stretch: 1;

                        HorizontalLayout {
                            spacing: 8px;
                            cross-axis-alignment: center;

                            Rectangle {
                                width: 18px;
                                height: 18px;
                                border-radius: 4px;
                                background: AppData.reporte_batch_edit_change_dias_obra ? #2563eb : #ffffff;
                                border-width: 1px;
                                border-color: AppData.reporte_batch_edit_change_dias_obra ? #2563eb : #94a3b8;

                                Text {
                                    text: "✓";
                                    font-size: 12px;
                                    font-weight: 800;
                                    color: #ffffff;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    visible: AppData.reporte_batch_edit_change_dias_obra;
                                }

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        AppData.reporte_batch_edit_change_dias_obra = !AppData.reporte_batch_edit_change_dias_obra;
                                    }
                                }
                            }

                            Text {
                                text: "Modificar Días Registro Obra:";
                                font-size: 13px;
                                font-weight: 700;
                                color: #1e40af;
                            }
                        }

                        Rectangle {
                            height: 38px;
                            border-radius: 6px;
                            background: #ffffff;
                            border-width: 1.5px;
                            border-color: AppData.reporte_batch_edit_change_dias_obra ? #3b82f6 : #cbd5e1;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;

                                LineEdit {
                                    placeholder-text: "Ej. 15 ó 0 (dejar vacío para tope máx)";
                                    text <=> AppData.reporte_batch_edit_dias_obra_val;
                                    edited(text) => {
                                        AppData.reporte_batch_edit_change_dias_obra = (text != "");
                                    }
                                }
                            }
                        }
                    }
                }

                // 5. Nota informativa sobre cálculo de límites
                Rectangle {
                    border-radius: 6px;
                    background: #fffbeb;
                    border-width: 1px;
                    border-color: #fde68a;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: 8px;
                        cross-axis-alignment: center;

                        Text { text: "ℹ️"; font-size: 13px; vertical-alignment: center; }
                        Text {
                            text: "Los Días Obra se ajustarán automáticamente al límite permitido de cada trabajador según las fechas de vigencia de la obra y las incidencias (licencias, incapacidades, ausentismos) de su respectivo periodo.";
                            font-size: 11px;
                            font-weight: 600;
                            color: #92400e;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                }

                // 6. Botones Cancelar y Aplicar Cambios
                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;

                    Rectangle {
                        height: 38px;
                        width: 110px;
                        border-radius: 6px;
                        background: btn_batch_cancel.has-hover ? #e2e8f0 : #f1f5f9;
                        border-width: 1px;
                        border-color: #cbd5e1;

                        Text { text: "Cancelar"; font-size: 13px; font-weight: 700; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                        btn_batch_cancel := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_close_batch_edit_modal(); }
                        }
                    }

                    Rectangle {
                        height: 38px;
                        width: 240px;
                        border-radius: 6px;
                        background: btn_batch_save.has-hover ? #1d4ed8 : #2563eb;
                        drop-shadow-blur: 4px;
                        drop-shadow-color: #2563eb40;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;
                            cross-axis-alignment: center;
                            Text { text: "💾"; font-size: 13px; vertical-alignment: center; }
                            Text {
                                text: "Aplicar a Seleccionados (" + AppData.reporte_batch_edit_worker_count + ")";
                                font-size: 13px;
                                font-weight: 700;
                                color: #ffffff;
                                vertical-alignment: center;
                            }
                        }

                        btn_batch_save := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                AppLogic.reporte_submit_batch_edit(
                                    AppData.reporte_batch_edit_selected_obra_id,
                                    AppData.reporte_batch_edit_change_obra,
                                    AppData.reporte_batch_edit_dias_cedula_val,
                                    AppData.reporte_batch_edit_change_dias_cedula,
                                    AppData.reporte_batch_edit_dias_obra_val,
                                    AppData.reporte_batch_edit_change_dias_obra
                                );
                            }
                        }
                    }
                }
            }
        }
    }

    // Modal de Confirmación: Igualar Días Cédula en Lote
    if AppData.show_reporte_confirm_batch_dias_modal : Rectangle {
        background: #00000088;
        width: 100%;
        height: 100%;

        TouchArea {}

        Rectangle {
            width: 480px;
            height: 220px;
            border-radius: 12px;
            background: #ffffff;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000040;

            VerticalLayout {
                padding: 24px;
                spacing: 16px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 14px;
                    alignment: start;

                    Rectangle {
                        width: 44px;
                        height: 44px;
                        border-radius: 22px;
                        background: #eff6ff;
                        border-width: 1px;
                        border-color: #bfdbfe;
                        Text { text: "📅"; font-size: 20px; horizontal-alignment: center; vertical-alignment: center; }
                    }

                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;

                        Text {
                            text: "Confirmar Asignación de Días Máximos";
                            font-size: 15px;
                            font-weight: 800;
                            color: #0f172a;
                        }
                        Text {
                            text: AppData.reporte_confirm_batch_msg != "" ? AppData.reporte_confirm_batch_msg : "¿Estás seguro de asignar los Días de Obra máximos permitidos a los registros seleccionados en la base de datos?";
                            font-size: 12px;
                            color: #475569;
                            wrap: word-wrap;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;

                    Rectangle {
                        height: 36px;
                        width: 100px;
                        border-radius: 6px;
                        background: btn_cancel_batch_dias.has-hover ? #e2e8f0 : #f1f5f9;
                        border-width: 1px;
                        border-color: #cbd5e1;

                        Text { text: "Cancelar"; font-size: 12px; font-weight: 700; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                        btn_cancel_batch_dias := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_cancel_confirm_igualar_dias(); }
                        }
                    }

                    Rectangle {
                        height: 36px;
                        width: 155px;
                        border-radius: 6px;
                        background: btn_ok_batch_dias.has-hover ? #1d4ed8 : #2563eb;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            Text { text: "✓"; font-size: 12px; font-weight: 800; color: #ffffff; vertical-alignment: center; }
                            Text { text: "Sí, Asignar"; font-size: 12px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                        }

                        btn_ok_batch_dias := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                AppLogic.reporte_execute_confirm_igualar_dias();
                            }
                        }
                    }
                }
            }
        }
    }

    // Modal de Ordenamiento Multi-Criterio
    if AppData.show_reporte_sort_modal : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #00000066;

        TouchArea { }

        Rectangle {
            width: 420px;
            border-radius: 10px;
            background: #ffffff;
            border-width: 1px;
            border-color: #cbd5e1;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            VerticalLayout {
                padding: 14px;
                spacing: 8px;

                // Cabecera
                HorizontalLayout {
                    alignment: space-between;
                    cross-axis-alignment: center;

                    HorizontalLayout {
                        spacing: 8px;
                        cross-axis-alignment: center;
                        Text { text: "⇅"; font-size: 16px; font-weight: 800; color: #1e40af; vertical-alignment: center; }
                        Text {
                            text: "Ordenamiento Multi-Criterio";
                            font-size: 14px;
                            font-weight: 800;
                            color: #0f172a;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: btn_close_sort.has-hover ? #f1f5f9 : transparent;

                        Text { text: "✕"; font-size: 12px; font-weight: 700; color: #64748b; horizontal-alignment: center; vertical-alignment: center; }
                        btn_close_sort := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_close_sort_modal(); }
                        }
                    }
                }

                Text {
                    text: "Selecciona uno o más criterios de ordenamiento simultáneos (evaluados en cascada):";
                    font-size: 11px;
                    color: #64748b;
