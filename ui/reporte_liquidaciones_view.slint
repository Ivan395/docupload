                            text: "Exportar SUA";
                            font-size: 13px;
                            font-weight: 700;
                            color: #ffffff;
                            vertical-alignment: center;
                        }
                    }

                    btn_export_sua := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppLogic.reporte_abrir_modal_exportar_sua(); }
                    }
                }

                // Revertir Cambios
                Rectangle {
                    height: 38px;
                    width: 145px;
                    border-radius: 6px;
                    background: btn_revert.has-hover ? #e2e8f0 : #ffffff;
                    border-width: 1px;
                    border-color: #cbd5e1;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        Text { text: "↺"; font-size: 13px; vertical-alignment: center; }
                        Text {
                            text: "Revertir Cambios";
                            font-size: 13px;
                            font-weight: 700;
                            color: #475569;
                            vertical-alignment: center;
                        }
                    }

                    btn_revert := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppLogic.revertir_reporte_liquidaciones(); }
                    }
                }
            }
        }

        // 2. Tarjetas KPI
        HorizontalLayout {
            spacing: 12px;

            // KPI 1: Registros Procesados
            Rectangle {
                horizontal-stretch: 1;
                height: 70px;
                border-radius: 8px;
                background: #ffffff;
                border-width: 1px;
                border-color: #e2e8f0;

                VerticalLayout {
                    padding: 10px;
                    alignment: space-between;
                    Text {
                        text: "REGISTROS PROCESADOS";
                        font-size: 11.5px;
                        font-weight: 800;
                        color: #64748b;
                        letter-spacing: 0.5px;
                    }
                    Text {
                        text: AppData.reporte_kpi_total_registros_str;
                        font-size: 18px;
                        font-weight: 800;
                        color: #0f172a;
                    }
                }
            }

            // KPI 2: Obras en Revisión
            Rectangle {
                horizontal-stretch: 1;
                height: 70px;
                border-radius: 8px;
                background: #ffffff;
                border-width: 1px;
                border-color: #e2e8f0;

                VerticalLayout {
                    padding: 10px;
                    alignment: space-between;
                    Text {
                        text: "OBRAS EN REVISIÓN";
                        font-size: 11.5px;
                        font-weight: 800;
                        color: #64748b;
                        letter-spacing: 0.5px;
                    }
                    Text {
                        text: AppData.reporte_kpi_obras_homologadas_str;
                        font-size: 18px;
                        font-weight: 800;
                        color: #2563eb;
                    }
                }
            }

            // KPI 3: Subtotal Cuotas IMSS
            Rectangle {
                horizontal-stretch: 1;
                height: 70px;
                border-radius: 8px;
                background: #ffffff;
                border-width: 1px;
                border-color: #e2e8f0;

                VerticalLayout {
                    padding: 10px;
                    alignment: space-between;
                    Text {
                        text: "SUBTOTAL CUOTAS IMSS";
                        font-size: 11.5px;
                        font-weight: 800;
                        color: #64748b;
                        letter-spacing: 0.5px;
                    }
                    Text {
                        text: AppData.reporte_kpi_subtotal_imss_str;
                        font-size: 18px;
                        font-weight: 800;
                        color: #0f172a;
                    }
                }
            }

            // KPI 4: Importe Subtotal
            Rectangle {
                horizontal-stretch: 1;
                height: 70px;
                border-radius: 8px;
                background: #f0fdf4;
                border-width: 1px;
                border-color: #bbf7d0;

                VerticalLayout {
                    padding: 10px;
                    alignment: space-between;
                    Text {
                        text: "IMPORTE SUBTOTAL";
                        font-size: 11.5px;
                        font-weight: 800;
                        color: #166534;
                        letter-spacing: 0.5px;
                    }
                    Text {
                        text: AppData.reporte_kpi_prorrateado_str;
                        font-size: 18px;
                        font-weight: 800;
                        color: #15803d;
                    }
                }
            }
        }

        // 3. Fila de Filtros de Búsqueda
        HorizontalLayout {
            spacing: 8px;
            alignment: space-between;

            // Buscador por empleado
            Rectangle {
                horizontal-stretch: 1;
                min-width: 130px;
                height: 38px;
                border-radius: 6px;
                background: #ffffff;
                border-width: 1px;
                border-color: #cbd5e1;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 6px;
                    alignment: center;

                    Text { text: "🔍"; font-size: 13px; vertical-alignment: center; }
                    search_input := LineEdit {
                        placeholder-text: "Buscar Empleado...";
                        text: AppData.reporte_search_query;
                        edited(text) => {
                            AppData.reporte_search_query = text;
                            AppLogic.reporte_filtrar_busqueda(text);
                        }
                    }
                }
            }

            // Filtro Multi-Selección de Empleados Únicos
            ReporteEmpleadoMultiFilterWidget {}

            // Botón Trigger del Right Side Drawer: Ver Obras (N)
            Rectangle {
                height: 38px;
                border-radius: 6px;
                background: AppData.reporte_drawer_obras_open ? #eff6ff : (btn_drawer_trigger.has-hover ? #f8fafc : #ffffff);
                border-width: AppData.reporte_drawer_obras_open ? 1.5px : 1px;
                border-color: AppData.reporte_drawer_obras_open ? #2563eb : #cbd5e1;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 10px;
                    spacing: 5px;
                    alignment: center;
                    cross-axis-alignment: center;

                    Text { text: "🏗️"; font-size: 13px; vertical-alignment: center; }
                    Text {
                        text: "Ver Obras (" + AppData.reporte_obras_usuario.length + ")";
                        font-size: 12px;
                        font-weight: 700;
                        color: AppData.reporte_drawer_obras_open ? #1d4ed8 : #2563eb;
                        vertical-alignment: center;
                    }
                }

                btn_drawer_trigger := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        AppData.reporte_drawer_obras_open = !AppData.reporte_drawer_obras_open;
                        AppLogic.reporte_toggle_drawer_obras();
                    }
                }
            }

            // Filtro Registro de Obra
            HorizontalLayout {
                spacing: 5px;
                alignment: center;
                Text { text: "🏗 Obra:"; font-size: 12px; font-weight: 700; color: #475569; vertical-alignment: center; }
                ComboBox {
                    width: 170px;
                    height: 38px;
                    model: AppData.reporte_obras_filter_labels;
                    current-index <=> AppData.reporte_filter_obra_idx;
                    selected(val) => {
                        AppLogic.reporte_filtrar_obra(self.current-index);
                    }
                }
            }

            // Filtro Periodo
            HorizontalLayout {
                spacing: 5px;
                alignment: center;
                Text { text: "📅 Periodo:"; font-size: 12px; font-weight: 700; color: #475569; vertical-alignment: center; }
                ComboBox {
                    width: 150px;
                    height: 38px;
                    model: AppData.reporte_periodo_options;
                    current-index <=> AppData.reporte_filter_periodo_idx;
                    selected(val) => {
                        AppLogic.reporte_filtrar_periodo(self.current-index);
                    }
                }
            }

            // Filtro Estado
            HorizontalLayout {
                spacing: 5px;
                alignment: center;
                Text { text: "🏷 Estado:"; font-size: 12px; font-weight: 700; color: #475569; vertical-alignment: center; }
                ComboBox {
                    width: 130px;
                    height: 38px;
                    model: AppData.reporte_estado_options;
                    current-index <=> AppData.reporte_filter_estado_idx;
                    selected(val) => {
                        AppLogic.reporte_filtrar_estado(self.current-index);
                    }
                }
            }

            // Botón Ordenar Multi-Criterio
            Rectangle {
                height: 38px;
                border-radius: 6px;
                background: btn_open_sort.has-hover ? #f1f5f9 : (AppData.reporte_active_sort_count > 0 ? #eff6ff : #ffffff);
                border-width: 1px;
                border-color: AppData.reporte_active_sort_count > 0 ? #3b82f6 : #cbd5e1;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 4px;
                    alignment: center;
                    cross-axis-alignment: center;

                    Text { text: "⇅"; font-size: 13px; font-weight: 800; color: AppData.reporte_active_sort_count > 0 ? #1d4ed8 : #475569; vertical-alignment: center; }
                    Text {
                        text: AppData.reporte_active_sort_count > 0 ? "Ordenar (" + AppData.reporte_active_sort_count + ")" : "Ordenar...";
                        font-size: 12px;
                        font-weight: 700;
                        color: AppData.reporte_active_sort_count > 0 ? #1d4ed8 : #475569;
                        vertical-alignment: center;
                    }
                }

                btn_open_sort := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        AppLogic.reporte_open_sort_modal();
                    }
                }
            }

            // Botón Limpiar Todos los Filtros
            btn_clean_rect := Rectangle {
                property <bool> has_active_filters: AppData.reporte_search_query != "" || AppData.reporte_filter_obra_idx != 0 || AppData.reporte_filter_periodo_idx != 0 || AppData.reporte_filter_estado_idx != 0 || AppData.reporte_emp_filter_active || AppData.reporte_unique_empleados_filter_active;
                height: 38px;
                border-radius: 6px;
                background: self.has_active_filters ? (btn_clear_all_f.has-hover ? #fecaca : #fee2e2) : (btn_clear_all_f.has-hover ? #f8fafc : #ffffff);
                border-width: self.has_active_filters ? 1.5px : 1px;
                border-color: self.has_active_filters ? #ef4444 : #cbd5e1;

                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 4px;
                    alignment: center;
                    cross-axis-alignment: center;

                    Text { text: "✕"; font-size: 12px; font-weight: 800; color: btn_clean_rect.has_active_filters ? #dc2626 : #64748b; vertical-alignment: center; }
                    Text {
                        text: "Limpiar";
                        font-size: 12px;
                        font-weight: 700;
                        color: btn_clean_rect.has_active_filters ? #dc2626 : #64748b;
                        vertical-alignment: center;
                    }
                }

                btn_clear_all_f := TouchArea {
                    mouse-cursor: pointer;
                    clicked => {
                        AppLogic.reporte_limpiar_todos_filtros();
                    }
                }
            }
        }

        // 4. Panel de Modificación Masiva en Lote (Siempre Disponible)
        Rectangle {
            height: 52px;
            border-radius: 8px;
            background: #eff6ff;
            border-width: 1px;
            border-color: #bfdbfe;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;
                alignment: space-between;
                cross-axis-alignment: center;

                // Título del lote, conteo y botones de selección
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    cross-axis-alignment: center;
                    Text { text: "⚡"; font-size: 14px; vertical-alignment: center; }
                    Text {
                        text: "Panel Masivo:";
                        font-size: 13px;
                        font-weight: 800;
                        color: #1e40af;
                        vertical-alignment: center;
                    }

                    // Combobox desplegable con los elementos seleccionados
                    ReporteSelectedCombobox {}

                    // Botón Seleccionar Todos los Visibles
                    Rectangle {
                        height: 32px;
                        border-radius: 5px;
                        background: btn_sel_all_vis.has-hover ? #dbeafe : #ffffff;
                        border-width: 1px;
                        border-color: #93c5fd;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;
                            alignment: center;
                            cross-axis-alignment: center;
                            Text { text: "☑️"; font-size: 11px; vertical-alignment: center; }
                            Text { text: "Todos Visibles"; font-size: 11.5px; font-weight: 700; color: #1d4ed8; vertical-alignment: center; }
                        }

                        btn_sel_all_vis := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_toggle_select_all(true); }
                        }
                    }

                    // Botón Deseleccionar Todos
                    if AppData.reporte_selected_count > 0 : Rectangle {
                        height: 32px;
                        border-radius: 5px;
                        background: btn_desel_all.has-hover ? #fee2e2 : #ffffff;
                        border-width: 1px;
                        border-color: #fca5a5;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 4px;
                            alignment: center;
                            cross-axis-alignment: center;
                            Text { text: "✕"; font-size: 11px; font-weight: 800; color: #dc2626; vertical-alignment: center; }
                            Text { text: "Deseleccionar"; font-size: 11.5px; font-weight: 700; color: #dc2626; vertical-alignment: center; }
                        }

                        btn_desel_all := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_limpiar_seleccion(); }
                        }
                    }
                }



                // Botón Explorar / Filtrar Empleados Seleccionados
                Rectangle {
                    height: 34px;
                    border-radius: 5px;
                    background: AppData.reporte_emp_filter_active ? (btn_body_touch.has-hover ? #dbeafe : #eff6ff) : (btn_body_touch.has-hover ? #f1f5f9 : #ffffff);
                    border-width: 1px;
                    border-color: AppData.reporte_emp_filter_active ? #2563eb : #93c5fd;

                    btn_body_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            AppLogic.reporte_open_empleados_filter_modal();
                        }
                    }

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 10px;
                        spacing: 6px;
                        alignment: center;
                        cross-axis-alignment: center;

                        // '✕' interactiva al lado izquierdo cuando el filtro está activo para eliminar el filtro
                        if AppData.reporte_emp_filter_active : Rectangle {
                            width: 20px;
                            height: 20px;
                            border-radius: 10px;
                            background: btn_clear_x.has-hover ? #fca5a5 : #fee2e2;

                            Text {
                                text: "✕";
                                font-size: 12px;
                                font-weight: 800;
                                color: #b91c1c;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            btn_clear_x := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    AppLogic.reporte_clear_emp_filter();
                                }
                            }
                        }

                        if !AppData.reporte_emp_filter_active : Text {
                            text: "👥";
                            font-size: 12px;
                            vertical-alignment: center;
                        }

                        Text {
                            text: AppData.reporte_emp_filter_active ? "Filtro Empleados Activo" : (AppData.reporte_selected_count > 0 ? "Filtrar Selección (" + AppData.reporte_selected_count + ")..." : "Filtrar Selección...");
                            font-size: 12px;
                            font-weight: 700;
                            color: #1d4ed8;
                            vertical-alignment: center;
                        }
                    }
                }

                // Acciones por Lote (Siempre Disponibles)
                HorizontalLayout {
                    spacing: 8px;
                    alignment: center;
                    cross-axis-alignment: center;

                    // Botón Principal: Modificar Asignación Masiva
                    Rectangle {
                        height: 34px;
                        border-radius: 5px;
                        background: btn_batch_edit_modal.has-hover ? #1d4ed8 : #2563eb;
                        drop-shadow-blur: 4px;
                        drop-shadow-color: #2563eb40;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 12px;
                            spacing: 6px;
                            alignment: center;
                            cross-axis-alignment: center;

                            Text { text: "✏️"; font-size: 12px; vertical-alignment: center; }
                            Text {
                                text: AppData.reporte_selected_count > 0 ? "Modificar en Lote (" + AppData.reporte_selected_count + ")..." : "Modificar en Lote...";
                                font-size: 12px;
                                font-weight: 700;
                                color: #ffffff;
                                vertical-alignment: center;
                            }
                        }

                        btn_batch_edit_modal := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                AppLogic.reporte_open_batch_edit_modal();
                            }
                        }
                    }

                    // Botón Asignar Máximo
                    Rectangle {
                        height: 34px;
                        border-radius: 5px;
                        background: btn_batch_igualar.has-hover ? #f0fdf4 : #ffffff;
                        border-width: 1px;
                        border-color: #86efac;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 10px;
                            spacing: 5px;
                            alignment: center;
                            cross-axis-alignment: center;

                            Text { text: "⚡"; font-size: 12px; vertical-alignment: center; }
                            Text {
                                text: "Asignar Máximo";
                                font-size: 12px;
                                font-weight: 700;
                                color: #16a34a;
                                vertical-alignment: center;
                            }
                        }

                        btn_batch_igualar := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                AppLogic.reporte_request_confirm_igualar_dias();
                            }
                        }
                    }
                }

                // Separador visual
                Rectangle { width: 1px; height: 26px; background: #bfdbfe; }

                // Botón Selección Rápida por Registro de Obra
                Rectangle {
                    height: 34px;
                    border-radius: 5px;
                    background: btn_sel_obras.has-hover ? #dbeafe : #ffffff;
                    border-width: 1px;
                    border-color: #93c5fd;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 10px;
                        spacing: 5px;
                        alignment: center;
                        cross-axis-alignment: center;

                        Text { text: "🏗️"; font-size: 12px; vertical-alignment: center; }
                        Text {
                            text: "Seleccionar por Obra...";
                            font-size: 12px;
                            font-weight: 700;
                            color: #1d4ed8;
                            vertical-alignment: center;
                        }
                    }

                    btn_sel_obras := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            AppLogic.reporte_open_select_obras_modal();
                        }
                    }
                }


            }
        }

        // Contenedor Flexible: Tabla Principal y Right Side Drawer
        HorizontalLayout {
            spacing: AppData.reporte_drawer_obras_open ? 12px : 0px;

            // Área Principal de la Tabla
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 10px;

        // Pestañas de Navegación por Mes (Empleados por Mes) con scroll horizontal independiente
        if AppData.reporte_periodo_options.length > 1 : Rectangle {
            height: 40px;
            clip: true;

            ScrollView {
                vertical-stretch: 0;
                content-height: self.height;

                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    for opt[idx] in AppData.reporte_periodo_options : Rectangle {
                        height: 34px;
                        border-radius: 6px;
                        background: AppData.reporte_filter_periodo_idx == idx ? #1e3a8a : #ffffff;
                        border-width: 1px;
                        border-color: AppData.reporte_filter_periodo_idx == idx ? #1e3a8a : #cbd5e1;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 6px;
                            alignment: center;
                            Text {
                                text: idx == 0 ? "📅" : "🗓";
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: opt;
                                font-size: 12px;
                                font-weight: 700;
                                color: AppData.reporte_filter_periodo_idx == idx ? #ffffff : #334155;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                AppData.reporte_filter_periodo_idx = idx;
                                AppLogic.reporte_filtrar_periodo(idx);
                            }
                        }
                    }
                }
            }
        }

        // 5. Tabla Principal con Encabezados Fijos en Scroll Vertical y sincronizados en Horizontal
        Rectangle {
            height: 580px;
            border-radius: 8px;
            background: #ffffff;
            border-width: 1px;
            border-color: #cbd5e1;
            clip: true;

            VerticalLayout {
                spacing: 0px;
                padding: 0px;

                // Encabezados Fijos
                Rectangle {
                    height: 40px;
                    background: #f1f5f9;
                    clip: true;

                    Rectangle {
                        x: table_scroll.content-x;
                        width: 3445px;
                        height: 40px;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 8px;
                            alignment: start;
                            cross-axis-alignment: center;

                            // Columna 1: Checkbox
                            Rectangle {
                                width: 30px;
                                Rectangle {
                                    width: 16px;
                                    height: 16px;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 3px;
                                    background: AppData.reporte_all_filter_selected ? #2563eb : #ffffff;
                                    border-width: 1px;
                                    border-color: #94a3b8;
                                    Text { text: "✓"; font-size: 12px; color: #ffffff; horizontal-alignment: center; vertical-alignment: center; visible: AppData.reporte_all_filter_selected; }
                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            AppData.reporte_all_filter_selected = !AppData.reporte_all_filter_selected;
                                            AppLogic.reporte_toggle_select_all(AppData.reporte_all_filter_selected);
                                        }
                                    }
                                }
                            }

                            Text { width: 35px; text: "#"; font-size: 12px; font-weight: 800; color: #475569; vertical-alignment: center; }
                            Text { width: 135px; text: "Mes / Año"; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                            Text { width: 105px; text: "NSS"; font-size: 12px; font-weight: 800; color: #475569; vertical-alignment: center; }
                            Text { width: 175px; text: "RFC / CURP"; font-size: 12px; font-weight: 800; color: #475569; vertical-alignment: center; }
                            Text { width: 330px; text: "Nombre del Trabajador"; font-size: 12px; font-weight: 800; color: #475569; vertical-alignment: center; }
                            Text { width: 110px; text: "Reg. Patronal"; font-size: 12px; font-weight: 800; color: #475569; vertical-alignment: center; }
                            Text { width: 210px; text: "✏️ Registro de Obra"; font-size: 12px; font-weight: 800; color: #1e40af; vertical-alignment: center; }
                            Text { width: 65px; text: "Días Céd."; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                            Text { width: 65px; text: "Días Obra"; font-size: 12px; font-weight: 800; color: #1e40af; horizontal-alignment: center; vertical-alignment: center; }
                            Text { width: 75px; text: "Clave"; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                            Text { width: 90px; text: "Fecha"; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                            Text { width: 85px; text: "SDI"; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 50px; text: "Lic."; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                            Text { width: 50px; text: "Inc."; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                            Text { width: 50px; text: "Aus."; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                            Text { width: 85px; text: "Cuota Fija"; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 85px; text: "Exc. Pat."; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 85px; text: "Exc. Obr."; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 85px; text: "PD Pat."; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 85px; text: "PD Obr."; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 85px; text: "GMP Pat."; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 85px; text: "GMP Obr."; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 85px; text: "Riesgo Trab."; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 85px; text: "IV Pat."; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 85px; text: "IV Obr."; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 85px; text: "Guard y PS"; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 95px; text: "Suma Patronal"; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 95px; text: "Suma Obrera"; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 105px; text: "Subtotal"; font-size: 12px; font-weight: 800; color: #166534; horizontal-alignment: right; vertical-alignment: center; }
                            Text { width: 90px; text: "Acciones"; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                        }
                    }
                }

                // Línea divisoria
                Rectangle { height: 1px; background: #cbd5e1; }

                // Cuerpo de la tabla con scroll vertical y horizontal
                table_scroll := ScrollView {
                    vertical-stretch: 1;
                    content-width: 3405px;
                    content-height: AppData.reporte_liquidaciones_list.length > 0 ? ((AppData.reporte_liquidaciones_list.length * 40px) + (AppData.reporte_expanded_row_id != "" ? 75px : 0px) + 20px) : 180px;

                    Rectangle {
                        width: 3405px;
                        height: AppData.reporte_liquidaciones_list.length > 0 ? ((AppData.reporte_liquidaciones_list.length * 40px) + (AppData.reporte_expanded_row_id != "" ? 75px : 0px) + 20px) : 180px;

                        VerticalLayout {
                            alignment: start;
                            spacing: 0px;
                            padding: 0px;

                            // Filas de Datos (Paginadas)
                            for item[idx] in AppData.reporte_liquidaciones_list : VerticalLayout {
                                spacing: 0px;

                                Rectangle {
                                    height: 40px;
                                    background: item.selected ? #eff6ff : (row_touch.has-hover ? (item.has_incidencias ? #fef3c7 : (item.is_assigned ? item.row_hover_color : #f8fafc)) : (item.has_incidencias ? #fffbeb : (item.is_assigned ? item.row_bg_color : (Math.mod(idx, 2) == 0 ? #ffffff : #fbfcfe))));
                                    border-width: 1px;
                                    border-color: item.has_incidencias ? #fcd34d : (item.is_assigned ? item.row_hover_color : #f1f5f9);

                                    row_touch := TouchArea {
                                        clicked => {
                                            AppLogic.reporte_toggle_expand_row(item.id_reporte_liq);
                                        }
                                    }

                            // Barra lateral de color distintivo del Registro de Obra o Alerta de Incidencia
                            if item.has_incidencias || item.is_assigned : Rectangle {
                                x: 0px;
                                y: 0px;
                                width: 4px;
                                height: parent.height;
                                background: item.has_incidencias ? #f59e0b : item.row_accent_color;
                            }

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                alignment: start;

                                // 1. Checkbox
                                Rectangle {
                                    width: 30px;
                                    Rectangle {
                                        width: 16px;
                                        height: 16px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 3px;
                                        background: item.is_baja ? #f1f5f9 : (item.selected ? #2563eb : #ffffff);
                                        border-width: 1px;
                                        border-color: item.is_baja ? #cbd5e1 : (item.selected ? #2563eb : #cbd5e1);
                                        Text {
                                            text: item.is_baja ? "🔒" : "✓";
                                            font-size: item.is_baja ? 9px : 12px;
                                            color: item.is_baja ? #94a3b8 : #ffffff;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                            visible: item.is_baja || item.selected;
                                        }
                                        if !item.is_baja : TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                AppLogic.reporte_toggle_select_row(item.id_reporte_liq);
                                            }
                                        }
                                    }
                                }

                                // 2. Index
                                Text { width: 35px; text: item.idx; font-size: 12px; color: #64748b; vertical-alignment: center; }

                                // 3. Periodo
                                TextInput {
                                    width: 135px;
                                    text: item.periodo;
                                    read-only: true;
                                    single-line: true;
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: #1e293b;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                // 4. NSS
                                TextInput {
                                    width: 105px;
                                    text: item.nss;
                                    read-only: true;
                                    single-line: true;
                                    font-size: 12px;
                                    font-family: "monospace";
                                    color: #334155;
                                    vertical-alignment: center;
                                }

                                // 5. RFC / CURP
                                TextInput {
                                    width: 175px;
                                    text: item.rfc_curp;
                                    read-only: true;
                                    single-line: true;
                                    font-size: 12px;
                                    font-family: "monospace";
                                    color: #475569;
                                    vertical-alignment: center;
                                }

                                // 6. Nombre del Trabajador
                                Rectangle {
                                    width: 330px;
                                    clip: true;
                                    HorizontalLayout {
                                        padding-left: 2px;
                                        padding-right: 2px;
                                        spacing: 6px;
                                        alignment: start;
                                        cross-axis-alignment: center;
                                        TextInput {
                                            horizontal-stretch: 1;
                                            text: item.nombre_trabajador;
                                            read-only: true;
                                            single-line: true;
                                            font-size: 12px;
                                            font-weight: 600;
                                            color: #0f172a;
                                            vertical-alignment: center;
                                        }
                                        if item.has_multi_obra : Rectangle {
                                            height: 18px;
                                            border-radius: 3px;
                                            background: #ede9fe;
                                            border-width: 1px;
                                            border-color: #c4b5fd;
                                            HorizontalLayout {
                                                padding-left: 5px;
                                                padding-right: 5px;
                                                cross-axis-alignment: center;
                                                Text {
                                                    text: "🔗 " + item.multi_obra_badge;
                                                    font-size: 10px;
                                                    font-weight: 800;
                                                    color: #6d28d9;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                        if item.pensionado != "": Rectangle {
                                            height: 18px;
                                            border-radius: 3px;
                                            background: #fef3c7;
                                            border-width: 1px;
                                            border-color: #f59e0b;
                                            HorizontalLayout {
                                                padding-left: 5px;
                                                padding-right: 5px;
                                                cross-axis-alignment: center;
                                                Text {
                                                    text: item.pensionado;
                                                    font-size: 10px;
                                                    font-weight: 700;
                                                    color: #b45309;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }

                                // 7. Reg. Patronal
                                TextInput {
                                    width: 110px;
                                    text: item.registro_patronal;
                                    read-only: true;
                                    single-line: true;
                                    font-size: 12px;
                                    color: #475569;
                                    vertical-alignment: center;
                                }

                                // 8. Registro de Obra (Editable ComboBox / Picker)
                                Rectangle {
                                    width: 210px;
                                    height: 28px;
                                    border-radius: 5px;
                                    background: item.is_baja ? #f5f5f5 : (item.dias_mismatch ? #fff7ed : (item.is_assigned ? #f0fdf4 : #fef2f2));
                                    border-width: 1px;
                                    border-color: item.is_baja ? #e0e0e0 : (item.dias_mismatch ? #fdba74 : (item.is_assigned ? #bbf7d0 : #fecaca));
                                    y: (parent.height - self.height) / 2;

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        spacing: 4px;
                                        alignment: space-between;

                                        if item.has_multi_obra : Rectangle {
                                             height: 18px;
                                             border-radius: 3px;
                                             background: #ede9fe;
                                             border-width: 1px;
                                             border-color: #c4b5fd;
                                             y: (parent.height - self.height) / 2;
                                             HorizontalLayout {
                                                 padding-left: 4px;
                                                 padding-right: 4px;
                                                 Text {
                                                     text: item.multi_obra_badge;
                                                     font-size: 10px;
                                                     font-weight: 800;
                                                     color: #6d28d9;
                                                     vertical-alignment: center;
                                                 }
                                             }
                                        }

                                        Text {
                                            text: item.is_baja ? ("🔒 " + item.obra_label) : item.obra_label;
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: item.is_baja ? #9e9e9e : (item.dias_mismatch ? #c2410c : (item.is_assigned ? #166534 : #b91c1c));
                                            vertical-alignment: center;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                        if item.dias_mismatch && !item.is_baja : Text {
                                            text: "⚠";
                                            font-size: 12px;
                                            color: #ea580c;
                                            vertical-alignment: center;
                                        }
                                        if !item.is_baja : Text { text: "▾"; font-size: 11px; color: item.is_assigned ? #16a34a : #dc2626; vertical-alignment: center; }
                                    }

                                    if !item.is_baja : TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            AppLogic.reporte_open_unified_modal(item.id_reporte_liq);
                                        }
                                    }
                                }

                                // 9. Días Cédula (Clickable para modificar)
                                Rectangle {
                                    width: 65px;
                                    height: 26px;
                                    border-radius: 4px;
                                    background: item.is_baja ? #f5f5f5 : #f1f5f9;
                                    border-width: 1px;
                                    border-color: item.is_baja ? #e0e0e0 : #cbd5e1;
                                    y: (parent.height - self.height) / 2;

                                    Text {
                                        text: item.dias_cedula;
                                        font-size: 12.5px;
                                        font-weight: 700;
                                        color: item.is_baja ? #9e9e9e : #1e293b;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    if !item.is_baja : TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            AppLogic.reporte_open_unified_modal(item.id_reporte_liq);
                                        }
                                    }
                                }

                                // 10. Días Obra (Clickable para modificar)
                                Rectangle {
                                    width: 65px;
                                    height: 26px;
                                    border-radius: 4px;
                                    background: item.is_baja ? #f5f5f5 : (item.dias_mismatch ? #fff7ed : (item.is_assigned ? #eff6ff : #fff1f2));
                                    border-width: 1px;
                                    border-color: item.is_baja ? #e0e0e0 : (item.dias_mismatch ? #ea580c : (item.is_assigned ? #93c5fd : #fecdd3));
                                    y: (parent.height - self.height) / 2;

                                    Text {
                                        text: item.is_baja ? "🔒" : (item.is_assigned ? item.dias_obra : "-");
                                        font-size: 12.5px;
                                        font-weight: 800;
                                        color: item.is_baja ? #9e9e9e : (item.dias_mismatch ? #c2410c : (item.is_assigned ? #1d4ed8 : #e11d48));
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    if !item.is_baja : TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            AppLogic.reporte_open_unified_modal(item.id_reporte_liq);
                                        }
                                    }
                                }

                                // Clave (Clickable para modificar/asignar)
                                Rectangle {
                                    width: 75px;
                                    height: 26px;
                                    border-radius: 4px;
                                    background: item.is_baja ? #fee2e2 : #f1f5f9;
                                    border-width: 1px;
                                    border-color: item.is_baja ? #fca5a5 : #cbd5e1;
                                    y: (parent.height - self.height) / 2;

                                    Text {
                                        text: item.clave;
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: item.is_baja ? #b91c1c : #334155;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    if !item.is_baja : TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            AppLogic.reporte_open_unified_modal(item.id_reporte_liq);
                                        }
                                    }
                                }

                                // Fecha
                                TextInput {
                                    width: 90px;
                                    text: item.fecha;
                                    read-only: true;
                                    single-line: true;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: #334155;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                // SDI
                                TextInput {
                                    width: 85px;
                                    text: item.sdi_str;
                                    read-only: true;
                                    single-line: true;
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: #334155;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }

                                // Licencia
                                TextInput {
                                    width: 50px;
                                    text: item.lic_str;
                                    read-only: true;
                                    single-line: true;
                                    font-size: 12px;
                                    font-weight: (item.has_incidencias && item.lic_str != "-") ? 800 : 400;
                                    color: (item.has_incidencias && item.lic_str != "-") ? #b45309 : #64748b;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                // Incapacidad
                                TextInput {
                                    width: 50px;
                                    text: item.inc_str;
                                    read-only: true;
                                    single-line: true;
                                    font-size: 12px;
                                    font-weight: (item.has_incidencias && item.inc_str != "-") ? 800 : 400;
                                    color: (item.has_incidencias && item.inc_str != "-") ? #b45309 : #64748b;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                // Ausentismo
                                TextInput {
                                    width: 50px;
                                    text: item.aus_str;
                                    read-only: true;
                                    single-line: true;
                                    font-size: 12px;
                                    font-weight: (item.has_incidencias && item.aus_str != "-") ? 800 : 400;
                                    color: (item.has_incidencias && item.aus_str != "-") ? #b45309 : #64748b;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                // 11. Cuota Fija
                                ReporteNumericCell {
                                    curr_str: item.cf_str;
                                    orig_str: item.cf_orig_str;
                                    has_prorrateo: item.has_prorrateo;
                                    cell_width: 85px;
                                }

                                // 13. Exc. Pat.
                                ReporteNumericCell {
                                    curr_str: item.exc_pat_str;
                                    orig_str: item.exc_pat_orig_str;
                                    has_prorrateo: item.has_prorrateo;
                                    cell_width: 85px;
                                }

                                // 14. Exc. Obr.
                                ReporteNumericCell {
                                    curr_str: item.exc_obr_str;
                                    orig_str: item.exc_obr_orig_str;
                                    has_prorrateo: item.has_prorrateo;
                                    cell_width: 85px;
                                }

                                // 15. PD Pat.
                                ReporteNumericCell {
                                    curr_str: item.pd_pat_str;
                                    orig_str: item.pd_pat_orig_str;
                                    has_prorrateo: item.has_prorrateo;
                                    cell_width: 85px;
                                }

                                // 16. PD Obr.
                                ReporteNumericCell {
                                    curr_str: item.pd_obr_str;
                                    orig_str: item.pd_obr_orig_str;
                                    has_prorrateo: item.has_prorrateo;
                                    cell_width: 85px;
                                }

                                // 17. GMP Pat.
                                ReporteNumericCell {
                                    curr_str: item.gmp_pat_str;
                                    orig_str: item.gmp_pat_orig_str;
                                    has_prorrateo: item.has_prorrateo;
                                    cell_width: 85px;
                                }

                                // 18. GMP Obr.
                                ReporteNumericCell {
                                    curr_str: item.gmp_obr_str;
                                    orig_str: item.gmp_obr_orig_str;
                                    has_prorrateo: item.has_prorrateo;
                                    cell_width: 85px;
                                }

                                // 19. Riesgo Trab.
                                ReporteNumericCell {
                                    curr_str: item.rt_str;
                                    orig_str: item.rt_orig_str;
                                    has_prorrateo: item.has_prorrateo;
                                    cell_width: 85px;
                                }

                                // 20. IV Pat.
                                ReporteNumericCell {
                                    curr_str: item.iv_pat_str;
                                    orig_str: item.iv_pat_orig_str;
                                    has_prorrateo: item.has_prorrateo;
                                    cell_width: 85px;
                                }

                                // 21. IV Obr.
                                ReporteNumericCell {
                                    curr_str: item.iv_obr_str;
                                    orig_str: item.iv_obr_orig_str;
                                    has_prorrateo: item.has_prorrateo;
                                    cell_width: 85px;
                                }

                                // 22. Guard y PS
                                ReporteNumericCell {
                                    curr_str: item.gps_str;
                                    orig_str: item.gps_orig_str;
                                    has_prorrateo: item.has_prorrateo;
                                    cell_width: 85px;
                                }

                                // 23. Suma Patronal
                                ReporteNumericCell {
                                    curr_str: item.patronal_str;
                                    orig_str: item.patronal_orig_str;
                                    has_prorrateo: item.has_prorrateo;
                                    cell_width: 95px;
                                    text_color: #1e3a8a;
                                    font_weight: 700;
                                }

                                // 24. Suma Obrera
                                ReporteNumericCell {
                                    curr_str: item.obrera_str;
                                    orig_str: item.obrera_orig_str;
                                    has_prorrateo: item.has_prorrateo;
                                    cell_width: 95px;
                                    text_color: #0284c7;
                                    font_weight: 700;
                                }

                                // 25. Subtotal (Prorrateado y Original)
                                ReporteNumericCell {
                                    curr_str: item.subtotal_str;
                                    orig_str: item.subtotal_orig_str;
                                    has_prorrateo: item.has_prorrateo;
                                    cell_width: 105px;
                                    text_color: #166534;
                                    font_weight: 800;
                                }

                                // 26. Acciones
                                HorizontalLayout {
                                    width: 90px;
                                    spacing: 4px;
                                    alignment: center;
                                    cross-axis-alignment: center;

                                    // Editar obra / días
                                    Rectangle {
                                        width: 26px;
                                        height: 26px;
                                        border-radius: 4px;
                                        background: (!item.is_baja && btn_act_obra.has-hover) ? #e2e8f0 : transparent;

                                        Text { text: item.is_baja ? "🔒" : "✏️"; font-size: item.is_baja ? 11px : 13px; horizontal-alignment: center; vertical-alignment: center; color: item.is_baja ? #94a3b8 : #0f172a; }
                                        btn_act_obra := TouchArea {
                                            enabled: !item.is_baja;
                                            mouse-cursor: !item.is_baja ? pointer : default;
                                            clicked => {
                                                if !item.is_baja {
                                                    AppLogic.reporte_open_unified_modal(item.id_reporte_liq);
                                                }
                                            }
                                        }
                                    }

                                    // Vincular a otra obra adicional
                                    if !item.is_baja : Rectangle {
                                        width: 26px;
                                        height: 26px;
                                        border-radius: 4px;
                                        background: btn_act_add.has-hover ? #dbeafe : transparent;

                                        Text { text: "➕"; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                                        btn_act_add := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                AppLogic.reporte_open_add_obra_modal(item.id_reporte_liq);
                                            }
                                        }
                                    }

                                    // Eliminar vinculación adicional (si el empleado tiene más de una obra)
                                    if !item.is_baja && item.can_delete_split : Rectangle {
                                        width: 26px;
                                        height: 26px;
                                        border-radius: 4px;
                                        background: btn_act_del.has-hover ? #fee2e2 : transparent;

                                        Text { text: "🗑️"; font-size: 11px; horizontal-alignment: center; vertical-alignment: center; }
                                        btn_act_del := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                AppLogic.reporte_delete_split_row(item.id_reporte_liq);
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        if item.is_expanded : Rectangle {
                                height: 75px;
                                background: #f8fafc;
                                border-width: 1px;
                                border-color: #cbd5e1;
                                clip: true;

                                HorizontalLayout {
                                    padding-left: 20px;
                                    padding-right: 20px;
                                    padding-top: 8px;
                                    padding-bottom: 8px;
                                    spacing: 14px;
                                    alignment: start;
                                    cross-axis-alignment: center;

                                    Rectangle {
                                        width: 36px;
                                        height: 36px;
                                        border-radius: 18px;
                                        background: #e0f2fe;
                                        Text {
                                            text: "📋";
                                            font-size: 18px;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    VerticalLayout {
                                        spacing: 4px;
                                        alignment: center;
                                        HorizontalLayout {
                                            spacing: 8px;
                                            Text {
                                                text: "Historial de Movimientos y Salarios en el Periodo:";
                                                font-size: 12px;
                                                font-weight: 800;
                                                color: #1e3a8a;
                                            }
                                            Text {
                                                text: item.nombre_trabajador + " — NSS: " + item.nss + (item.has_multi_obra ? (" [" + item.multi_obra_badge + "]") : "");
                                                font-size: 12px;
                                                font-weight: 700;
                                                color: #475569;
                                            }
                                        }
                                        Text {
                                            text: item.movimientos_resumen;
                                            font-size: 11.5px;
                                            color: #1e293b;
                                            font-weight: 600;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }

                        if AppData.reporte_liquidaciones_list.length == 0 : Rectangle {
                            height: 160px;
                            VerticalLayout {
                                alignment: center;
                                spacing: 8px;
                                Text {
                                    text: "📋";
                                    font-size: 36px;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "No se encontraron liquidaciones para la revisión activa o los filtros seleccionados.";
                                    font-size: 14px;
                                    font-weight: 700;
                                    color: #475569;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Procesa cédulas en 'Cédulas de Cuotas' o ajusta los filtros superiores.";
                                    font-size: 12px;
                                    color: #94a3b8;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // Línea divisoria superior del pie fijo
            Rectangle { height: 2px; background: #cbd5e1; }

            // Pie de Tabla Fijo: Totales Generales / Totales por Mes sincronizado con el scroll horizontal
            Rectangle {
                height: 40px;
                background: #f8fafc;
                clip: true;

                Rectangle {
                    x: table_scroll.content-x;
                    width: 3405px;
                    height: 40px;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        alignment: start;
                        cross-axis-alignment: center;

                        // Bloque de Título / Etiqueta de Totales alineado con las columnas no numéricas (30+35+135+105+175+330+110+210 + 7*8 = 1186px)
                        Rectangle {
                            width: 1186px;
                            height: 40px;

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: end;
                                cross-axis-alignment: center;
                                padding-right: 12px;

                                Text {
                                    text: "Σ";
                                    font-size: 15px;
                                    font-weight: 900;
                                    color: #1e3a8a;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: AppData.reporte_filter_periodo_idx == 0 ? ("TOTAL GENERAL (" + AppData.reporte_total_filtered + "):") : ("TOTAL MES (" + AppData.reporte_total_filtered + "):");
                                    font-size: 12px;
                                    font-weight: 800;
                                    color: #1e293b;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Días Cédula
                        Text { width: 65px; text: AppData.reporte_footer_total_dias_ced_str; font-size: 12.5px; font-weight: 800; color: #334155; horizontal-alignment: center; vertical-alignment: center; }

                        // Días Obra
                        Text { width: 65px; text: AppData.reporte_footer_total_dias_obr_str; font-size: 12.5px; font-weight: 800; color: #1d4ed8; horizontal-alignment: center; vertical-alignment: center; }

                        // Clave (espacio sin total)
                        Rectangle { width: 75px; }

                        // Fecha (espacio sin total)
                        Rectangle { width: 90px; }

                        // SDI (espacio sin total)
                        Rectangle { width: 85px; }

                        // Lic.
                        Text { width: 50px; text: AppData.reporte_footer_total_lic_str; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: center; vertical-alignment: center; }

                        // Inc.
                        Text { width: 50px; text: AppData.reporte_footer_total_inc_str; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: center; vertical-alignment: center; }

                        // Aus.
                        Text { width: 50px; text: AppData.reporte_footer_total_aus_str; font-size: 12px; font-weight: 800; color: #475569; horizontal-alignment: center; vertical-alignment: center; }

                        // Cuota Fija
                        Text { width: 85px; text: AppData.reporte_footer_total_cf_str; font-size: 12.5px; font-weight: 800; color: #1e293b; horizontal-alignment: right; vertical-alignment: center; }

                        // Exc. Pat.
                        Text { width: 85px; text: AppData.reporte_footer_total_exc_pat_str; font-size: 12.5px; font-weight: 800; color: #1e293b; horizontal-alignment: right; vertical-alignment: center; }

                        // Exc. Obr.
                        Text { width: 85px; text: AppData.reporte_footer_total_exc_obr_str; font-size: 12.5px; font-weight: 800; color: #1e293b; horizontal-alignment: right; vertical-alignment: center; }

                        // PD Pat.
                        Text { width: 85px; text: AppData.reporte_footer_total_pd_pat_str; font-size: 12.5px; font-weight: 800; color: #1e293b; horizontal-alignment: right; vertical-alignment: center; }

                        // PD Obr.
                        Text { width: 85px; text: AppData.reporte_footer_total_pd_obr_str; font-size: 12.5px; font-weight: 800; color: #1e293b; horizontal-alignment: right; vertical-alignment: center; }

                        // GMP Pat.
                        Text { width: 85px; text: AppData.reporte_footer_total_gmp_pat_str; font-size: 12.5px; font-weight: 800; color: #1e293b; horizontal-alignment: right; vertical-alignment: center; }

                        // GMP Obr.
                        Text { width: 85px; text: AppData.reporte_footer_total_gmp_obr_str; font-size: 12.5px; font-weight: 800; color: #1e293b; horizontal-alignment: right; vertical-alignment: center; }

                        // Riesgo Trab.
                        Text { width: 85px; text: AppData.reporte_footer_total_rt_str; font-size: 12.5px; font-weight: 800; color: #1e293b; horizontal-alignment: right; vertical-alignment: center; }

                        // IV Pat.
                        Text { width: 85px; text: AppData.reporte_footer_total_iv_pat_str; font-size: 12.5px; font-weight: 800; color: #1e293b; horizontal-alignment: right; vertical-alignment: center; }

                        // IV Obr.
                        Text { width: 85px; text: AppData.reporte_footer_total_iv_obr_str; font-size: 12.5px; font-weight: 800; color: #1e293b; horizontal-alignment: right; vertical-alignment: center; }

                        // Guard y PS
                        Text { width: 85px; text: AppData.reporte_footer_total_gps_str; font-size: 12.5px; font-weight: 800; color: #1e293b; horizontal-alignment: right; vertical-alignment: center; }

                        // Suma Patronal
                        Text { width: 95px; text: AppData.reporte_footer_total_patronal_str; font-size: 12.5px; font-weight: 800; color: #1e3a8a; horizontal-alignment: right; vertical-alignment: center; }

                        // Suma Obrera
                        Text { width: 95px; text: AppData.reporte_footer_total_obrera_str; font-size: 12.5px; font-weight: 800; color: #0284c7; horizontal-alignment: right; vertical-alignment: center; }

                        // Subtotal
                        Text { width: 105px; text: AppData.reporte_footer_total_subtotal_str; font-size: 12.5px; font-weight: 800; color: #166534; horizontal-alignment: right; vertical-alignment: center; }

                        // Espacio para columna de Acción (55px)
                        Rectangle { width: 55px; }
                    }
                }
            }
        }
    }

        // 6. Pie de Tabla: Paginación de 100 en 100 e Información
        HorizontalLayout {
            alignment: space-between;
            spacing: 16px;

            // Información de registros y atajos
            HorizontalLayout {
                spacing: 12px;
                alignment: center;

                Text {
                    text: "Mostrando registros " + AppData.reporte_page_start_row + " - " + AppData.reporte_page_end_row + " de " + AppData.reporte_total_filtered + " (Paginado de 100 en 100)";
                    font-size: 12px;
                    font-weight: 600;
                    color: #475569;
                    vertical-alignment: center;
                }

                Rectangle {
                    height: 24px;
                    border-radius: 4px;
                    background: #f1f5f9;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;
                        alignment: center;
                        Text {
                            text: "F2 Editar | Tab Sig. Celda | Enter Confirmar";
                            font-size: 11px;
                            font-weight: 600;
                            color: #64748b;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Controles de Paginación
            HorizontalLayout {
                spacing: 6px;
                alignment: end;

                // Primera
                Rectangle {
                    height: 32px;
                    width: 85px;
                    border-radius: 4px;
                    background: btn_p_first.has-hover ? #e2e8f0 : #ffffff;
                    border-width: 1px;
                    border-color: #cbd5e1;
                    opacity: AppData.reporte_page_current > 1 ? 1.0 : 0.4;

                    Text { text: "|< Primera"; font-size: 12px; font-weight: 700; color: #334155; horizontal-alignment: center; vertical-alignment: center; }
                    btn_p_first := TouchArea {
                        enabled: AppData.reporte_page_current > 1;
                        mouse-cursor: AppData.reporte_page_current > 1 ? pointer : not-allowed;
                        clicked => { AppLogic.reporte_cambiar_pagina(1); }
                    }
                }

                // Anterior
                Rectangle {
                    height: 32px;
                    width: 85px;
                    border-radius: 4px;
                    background: btn_p_prev.has-hover ? #e2e8f0 : #ffffff;
                    border-width: 1px;
                    border-color: #cbd5e1;
                    opacity: AppData.reporte_page_current > 1 ? 1.0 : 0.4;

                    Text { text: "< Anterior"; font-size: 12px; font-weight: 700; color: #334155; horizontal-alignment: center; vertical-alignment: center; }
                    btn_p_prev := TouchArea {
                        enabled: AppData.reporte_page_current > 1;
                        mouse-cursor: AppData.reporte_page_current > 1 ? pointer : not-allowed;
                        clicked => { AppLogic.reporte_cambiar_pagina(AppData.reporte_page_current - 1); }
                    }
                }

                // Indicador de página
                Rectangle {
                    height: 32px;
                    width: 95px;
                    border-radius: 4px;
                    background: #1e3a8a;

                    Text {
                        text: AppData.reporte_page_current + " / " + AppData.reporte_page_total;
                        font-size: 12px;
                        font-weight: 800;
                        color: #ffffff;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                // Siguiente
                Rectangle {
                    height: 32px;
                    width: 85px;
                    border-radius: 4px;
                    background: btn_p_next.has-hover ? #e2e8f0 : #ffffff;
                    border-width: 1px;
                    border-color: #cbd5e1;
                    opacity: AppData.reporte_page_current < AppData.reporte_page_total ? 1.0 : 0.4;

                    Text { text: "Siguiente >"; font-size: 12px; font-weight: 700; color: #334155; horizontal-alignment: center; vertical-alignment: center; }
                    btn_p_next := TouchArea {
                        enabled: AppData.reporte_page_current < AppData.reporte_page_total;
                        mouse-cursor: AppData.reporte_page_current < AppData.reporte_page_total ? pointer : not-allowed;
                        clicked => { AppLogic.reporte_cambiar_pagina(AppData.reporte_page_current + 1); }
                    }
                }

                // Última
                Rectangle {
                    height: 32px;
                    width: 85px;
                    border-radius: 4px;
                    background: btn_p_last.has-hover ? #e2e8f0 : #ffffff;
                    border-width: 1px;
                    border-color: #cbd5e1;
                    opacity: AppData.reporte_page_current < AppData.reporte_page_total ? 1.0 : 0.4;

                    Text { text: "Última >|"; font-size: 12px; font-weight: 700; color: #334155; horizontal-alignment: center; vertical-alignment: center; }
                    btn_p_last := TouchArea {
                        enabled: AppData.reporte_page_current < AppData.reporte_page_total;
                        mouse-cursor: AppData.reporte_page_current < AppData.reporte_page_total ? pointer : not-allowed;
                        clicked => { AppLogic.reporte_cambiar_pagina(AppData.reporte_page_total); }
                    }
                }
            }
        }
        } // Fin del Área Principal de la Tabla (VerticalLayout)

        // Right Side Drawer (Panel Lateral Desplegable No Modal)
        if AppData.reporte_drawer_obras_open : Rectangle {
            width: 350px;
            background: #ffffff;
            border-radius: 8px;
            border-width: 1px;
            border-color: #cbd5e1;
            drop-shadow-blur: 16px;
            drop-shadow-color: #00000018;
            clip: true;

            VerticalLayout {
                padding: 14px;
                spacing: 12px;

                // Header fijo del Drawer
                HorizontalLayout {
                    alignment: space-between;
                    cross-axis-alignment: center;

                    HorizontalLayout {
                        spacing: 8px;
                        cross-axis-alignment: center;
                        Text { text: "🏗️"; font-size: 16px; vertical-alignment: center; }
                        Text {
                            text: "Registros de Obra";
                            font-size: 15px;
                            font-weight: 800;
                            color: #1e3a8a;
                            vertical-alignment: center;
                        }
                    }

                    // Botón "X" para cerrar
                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: btn_close_drawer.has-hover ? #fee2e2 : #f1f5f9;
                        border-width: 1px;
                        border-color: btn_close_drawer.has-hover ? #fca5a5 : #e2e8f0;

                        Text {
                            text: "✕";
                            font-size: 12px;
                            font-weight: 800;
                            color: btn_close_drawer.has-hover ? #dc2626 : #64748b;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        btn_close_drawer := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                AppData.reporte_drawer_obras_open = false;
                                AppLogic.reporte_set_drawer_obras(false);
                            }
                        }
                    }
                }

                // Separador inferior del header
                Rectangle { height: 1px; background: #e2e8f0; }

                // Subtítulo
                Text {
                    text: "Haz clic en una obra para filtrar la tabla principal:";
                    font-size: 11.5px;
                    font-weight: 600;
                    color: #64748b;
                }

                // Body: Scrollable list of cards
                if AppData.reporte_obras_usuario.length == 0 : Rectangle {
                    vertical-stretch: 1;
                    HorizontalLayout {
                        alignment: center;
                        cross-axis-alignment: center;
                        spacing: 8px;
                        Text { text: "ℹ️"; font-size: 13px; }
                        Text {
                            text: "No hay registros de obras creados por el usuario en esta revisión.";
                            font-size: 12px;
                            font-weight: 600;
                            color: #64748b;
                            wrap: word-wrap;
                        }
                    }
                }

                if AppData.reporte_obras_usuario.length > 0 : ListView {
                    vertical-stretch: 1;
                    for obra in AppData.reporte_obras_usuario : Rectangle {
                        height: 82px;
                        border-radius: 8px;
                        background: obra.selected ? #eff6ff : (card_drawer_touch.has-hover ? #f0fdf4 : #ffffff);
                        border-width: obra.selected ? 2px : 1px;
                        border-color: obra.selected ? #2563eb : (card_drawer_touch.has-hover ? #86efac : #cbd5e1);
                        drop-shadow-blur: 4px;
                        drop-shadow-color: #0000000a;

                        VerticalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            spacing: 5px;
                            alignment: space-between;

                            // Top: ID de obra en negrita (Ej. C0640941) + tipo
                            HorizontalLayout {
                                alignment: space-between;
                                cross-axis-alignment: center;

                                HorizontalLayout {
                                    spacing: 6px;
                                    cross-axis-alignment: center;
                                    Text {
                                        text: obra.numero;
                                        font-size: 13.5px;
                                        font-weight: 800;
                                        color: obra.selected ? #1d4ed8 : #0f172a;
                                    }
                                    if obra.tipo_obra != "" : Text {
                                        text: "(" + obra.tipo_obra + ")";
                                        font-size: 11px;
                                        font-weight: 600;
                                        color: #64748b;
                                    }
                                }

                                if obra.selected : Rectangle {
                                    height: 18px;
                                    border-radius: 4px;
                                    background: #2563eb;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text { text: "Filtro Activo"; font-size: 9.5px; font-weight: 800; color: #ffffff; vertical-alignment: center; }
                                    }
                                }
                            }

                            // Middle: Rango de fechas
                            HorizontalLayout {
                                spacing: 5px;
                                cross-axis-alignment: center;
                                Text { text: "📅"; font-size: 11px; vertical-alignment: center; }
                                Text {
                                    text: "Vigencia: " + obra.vigencia_str;
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: #047857;
                                    vertical-alignment: center;
                                }
                            }

                            // Bottom: Badge verde con el número de "empleados únicos (N reg)"
                            HorizontalLayout {
                                alignment: start;
                                Rectangle {
                                    height: 22px;
                                    border-radius: 11px;
                                    background: obra.empleados_count > 0 ? #ecfdf5 : #f1f5f9;
                                    border-width: 1px;
                                    border-color: obra.empleados_count > 0 ? #a7f3d0 : #cbd5e1;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 5px;
                                        alignment: center;
                                        cross-axis-alignment: center;

                                        Text {
                                            text: "👥";
                                            font-size: 10px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: obra.empleados_count + " empleados únicos (" + obra.empleados_count_str + ")";
                                            font-size: 10.5px;
                                            font-weight: 700;
                                            color: obra.empleados_count > 0 ? #065f46 : #64748b;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        card_drawer_touch := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                AppLogic.reporte_seleccionar_obra_usuario(obra.id);
                            }
                        }
                    }
                }
            }
        }
    } // Fin del HorizontalLayout contenedor de Tabla y Right Side Drawer

        // 7. Análisis de Guarderías (Tope 18% por Registro de Obra del Usuario)
        Rectangle {
            border-radius: 8px;
            background: #ffffff;
            border-width: 1px;
            border-color: #cbd5e1;

            VerticalLayout {
                padding: 14px;
                spacing: 12px;

                HorizontalLayout {
                    alignment: space-between;
                    cross-axis-alignment: center;

                    HorizontalLayout {
                        spacing: 8px;
                        cross-axis-alignment: center;
                        Text { text: "📊"; font-size: 16px; vertical-alignment: center; }
                        Text {
                            text: "Análisis en Tiempo Real: Tope del 18% y Valor Guarderías (1% GPS) por Registro de Obra";
                            font-size: 13.5px;
                            font-weight: 800;
                            color: #1e3a8a;
                            vertical-alignment: center;
                        }
                    }

                    Text {
                        text: "Fórmula: Valor Guarderías = Total GPS / 0.01 | Límite Máximo = 18% del Valor Total de la Obra";
                        font-size: 11px;
                        font-weight: 600;
                        color: #64748b;
                        vertical-alignment: center;
                    }
                }

                if AppData.reporte_guarderias_obras.length == 0 : Rectangle {
                    height: 52px;
                    border-radius: 6px;
                    background: #f8fafc;
                    border-width: 1px;
                    border-color: #e2e8f0;

                    HorizontalLayout {
                        alignment: center;
                        cross-axis-alignment: center;
                        spacing: 8px;
                        Text { text: "ℹ️"; font-size: 13px; vertical-alignment: center; }
                        Text {
                            text: "No se encontraron registros de obras creados por el usuario con vinculaciones para calcular el análisis del 18% y guarderías.";
                            font-size: 12px;
                            font-weight: 600;
                            color: #64748b;
                            vertical-alignment: center;
                        }
                    }
                }

                if AppData.reporte_guarderias_obras.length > 0 : VerticalLayout {
                    spacing: 12px;

                    for g_item in AppData.reporte_guarderias_obras : Rectangle {
                        border-radius: 8px;
                        background: #ffffff;
                        border-width: 1px;
                        border-color: g_item.supera_18 ? #facc15 : #e2e8f0;

                        VerticalLayout {
                            padding: 12px;
                            spacing: 10px;

                            // Encabezado de la Obra y Alerta si supera el 18%
                            HorizontalLayout {
                                alignment: space-between;
                                spacing: 12px;

                                VerticalLayout {
                                    spacing: 3px;
                                    alignment: center;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: start;
                                        Text { text: "🏗️"; font-size: 15px; vertical-alignment: center; }
                                        Text {
                                            text: "Registro de Obra: " + g_item.obra_label + " (" + g_item.empleados_count + " registros vinculados)";
                                            font-size: 13px;
                                            font-weight: 800;
                                            color: #1e3a8a;
                                            vertical-alignment: center;
                                        }
                                    }

                                    if g_item.registros_patronales_str != "" : Text {
                                        text: g_item.registros_patronales_str;
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: #64748b;
                                    }
                                }

                                if g_item.supera_18 : Rectangle {
                                    height: 26px;
                                    border-radius: 4px;
                                    background: #fef08a;
                                    border-width: 1px;
                                    border-color: #eab308;

                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 6px;
                                        alignment: center;
                                        Text { text: "⚠️"; font-size: 12px; vertical-alignment: center; }
                                        Text {
                                            text: "ADVERTENCIA: Guarderías supera el 18% del valor de la obra";
                                            font-size: 11.5px;
                                            font-weight: 800;
                                            color: #854d0e;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // Cuadros KPI Responsivos de Contraste
                            HorizontalLayout {
                                spacing: 12px;

                                // Cuadro 1: Valor Guarderías (1% Total GPS) -> Amarillo si supera el 18%
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 70px;
                                    border-radius: 8px;
                                    background: g_item.supera_18 ? #fef9c3 : #ffffff;
                                    border-width: g_item.supera_18 ? 2px : 1px;
                                    border-color: g_item.supera_18 ? #eab308 : #e2e8f0;

                                    VerticalLayout {
                                        padding: 10px;
                                        alignment: space-between;
                                        HorizontalLayout {
                                            alignment: space-between;
                                            Text {
                                                text: "VALOR GUARDERÍAS (1% GPS)";
                                                font-size: 11px;
                                                font-weight: 800;
                                                color: g_item.supera_18 ? #854d0e : #64748b;
                                                letter-spacing: 0.5px;
                                            }
                                            if g_item.supera_18 : Text {
                                                text: "⚠️ > 18%";
                                                font-size: 11px;
                                                font-weight: 800;
                                                color: #ca8a04;
                                            }
                                        }
                                        Text {
                                            text: g_item.valor_guarderias_str;
                                            font-size: 18px;
                                            font-weight: 800;
                                            color: g_item.supera_18 ? #854d0e : #0f172a;
                                        }
                                    }
                                }

                                // Cuadro 2: Valor Total de la Obra
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 70px;
                                    border-radius: 8px;
                                    background: #ffffff;
                                    border-width: 1px;
                                    border-color: #e2e8f0;

                                    VerticalLayout {
                                        padding: 10px;
                                        alignment: space-between;
                                        Text {
                                            text: "VALOR TOTAL DE LA OBRA";
                                            font-size: 11px;
                                            font-weight: 800;
                                            color: #64748b;
                                            letter-spacing: 0.5px;
                                        }
                                        Text {
                                            text: g_item.monto_obra_str;
                                            font-size: 18px;
                                            font-weight: 800;
                                            color: #0f172a;
                                        }
                                    }
                                }

                                // Cuadro 3: Límite 18% de la Obra
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 70px;
                                    border-radius: 8px;
                                    background: #f0fdf4;
                                    border-width: 1px;
                                    border-color: #bbf7d0;

                                    VerticalLayout {
                                        padding: 10px;
                                        alignment: space-between;
                                        Text {
                                            text: "LÍMITE 18% DE LA OBRA";
                                            font-size: 11px;
                                            font-weight: 800;
                                            color: #166534;
                                            letter-spacing: 0.5px;
                                        }
                                        Text {
                                            text: g_item.limite_18_obra_str;
                                            font-size: 18px;
                                            font-weight: 800;
                                            color: #15803d;
                                        }
                                    }
                                }

                                // Cuadro 4: Total Cuotas GPS IMSS
                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 70px;
                                    border-radius: 8px;
                                    background: #f8fafc;
                                    border-width: 1px;
                                    border-color: #e2e8f0;

                                    VerticalLayout {
                                        padding: 10px;
                                        alignment: space-between;
                                        Text {
                                            text: "TOTAL CUOTAS GPS (IMSS)";
                                            font-size: 11px;
                                            font-weight: 800;
                                            color: #64748b;
                                            letter-spacing: 0.5px;
                                        }
                                        Text {
                                            text: g_item.total_gps_str;
                                            font-size: 18px;
                                            font-weight: 800;
                                            color: #2563eb;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }
    }

    // Modal Unificado: Modificar Asignación de Registro de Obra y Días (SIROC)
    if AppData.show_reporte_edit_modal : Rectangle {
        background: #00000088;
        width: 100%;
        height: 100%;

        TouchArea {}

        Rectangle {
            width: 1080px;
            height: 850px;
            border-radius: 12px;
            background: #ffffff;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000040;

            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                alignment: space-between;

                // 1. Título y Cabecera
                HorizontalLayout {
                    alignment: space-between;
                    cross-axis-alignment: center;
                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: "Modificar Asignación de Obra y Días (Multi-Obra)";
                            font-size: 17px;
                            font-weight: 800;
                            color: #0f172a;
                        }
                        Text {
                            text: "Trabajador: " + AppData.reporte_edit_worker_name + (AppData.reporte_edit_periodo != "" ? " • Periodo: " + AppData.reporte_edit_periodo : "");
                            font-size: 13px;
                            font-weight: 600;
                            color: #2563eb;
                            overflow: elide;
                        }
                    }

                    Rectangle {
                        width: 30px;
                        height: 30px;
                        border-radius: 15px;
                        background: btn_close_edit.has-hover ? #fee2e2 : #f1f5f9;
                        Text { text: "✕"; font-size: 14px; font-weight: 800; color: #ef4444; horizontal-alignment: center; vertical-alignment: center; }
                        btn_close_edit := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_close_edit_modal(); }
                        }
                    }
                }

                // ALERTA TEMPORAL EN EL MODAL (Visible ante errores/restricciones)
                if AppData.reporte_edit_alert_show : Rectangle {
                    border-radius: 8px;
                    background: AppData.reporte_edit_alert_type == "error" ? #fef2f2 : (AppData.reporte_edit_alert_type == "warning" ? #fffbeb : #eff6ff);
                    border-width: 1.5px;
                    border-color: AppData.reporte_edit_alert_type == "error" ? #f87171 : (AppData.reporte_edit_alert_type == "warning" ? #fde68a : #93c5fd);

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 10px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: 10px;
                        cross-axis-alignment: center;

                        Text {
                            text: AppData.reporte_edit_alert_type == "error" ? "⛔" : (AppData.reporte_edit_alert_type == "warning" ? "⚠️" : "ℹ");
                            font-size: 15px;
                            vertical-alignment: center;
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: AppData.reporte_edit_alert_text;
                            font-size: 12px;
                            font-weight: 700;
                            color: AppData.reporte_edit_alert_type == "error" ? #991b1b : (AppData.reporte_edit_alert_type == "warning" ? #92400e : #1e40af);
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 20px;
                            height: 20px;
                            border-radius: 10px;
                            background: btn_dismiss_edit_alert.has-hover ? #fecaca : transparent;
                            Text {
                                text: "✕";
                                font-size: 11px;
                                font-weight: 800;
                                color: #991b1b;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            btn_dismiss_edit_alert := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { AppData.reporte_edit_alert_show = false; }
                            }
                        }
                    }
                }

                // 2. Banner de Reglas de Auditoría e Incidencias (Descuento LIC, INC, AUS)
                Rectangle {
                    border-radius: 8px;
                    background: #f8fafc;
                    border-width: 1px;
                    border-color: #cbd5e1;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;

                        HorizontalLayout {
                            alignment: space-between;
                            cross-axis-alignment: center;
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Días Cédula: " + AppData.reporte_edit_dias_cedula_val;
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: #334155;
                                }
                                Text { text: "•"; font-size: 12px; color: #94a3b8; }
                                Text {
                                    text: "Incidencias No Pagadas (LIC: " + AppData.reporte_edit_lic_info + ", INC: " + AppData.reporte_edit_inc_info + ", AUS: " + AppData.reporte_edit_aus_info + ")";
                                    font-size: 11.5px;
                                    font-weight: 600;
                                    color: #b45309;
                                }
                            }

                            Rectangle {
                                height: 24px;
                                border-radius: 4px;
                                background: #eff6ff;
                                border-width: 1px;
                                border-color: #bfdbfe;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    cross-axis-alignment: center;
                                    Text {
                                        text: "Total Disponibles: " + AppData.reporte_edit_total_disponibles + " días";
                                        font-size: 11.5px;
                                        font-weight: 800;
                                        color: #1d4ed8;
                                    }
                                }
                            }
                        }

                        // Live KPI Counter Bar
                        HorizontalLayout {
                            spacing: 10px;
                            cross-axis-alignment: center;

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 28px;
                                border-radius: 5px;
                                background: #ffffff;
                                border-width: 1px;
                                border-color: #cbd5e1;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: space-between;
                                    cross-axis-alignment: center;
                                    Text { text: "Días Asignados:"; font-size: 11.5px; font-weight: 700; color: #475569; }
                                    Text {
                                        text: AppData.reporte_edit_dias_asignados_sum + " / " + AppData.reporte_edit_total_disponibles + " d";
                                        font-size: 12px;
                                        font-weight: 800;
                                        color: AppData.reporte_edit_has_errors || AppData.reporte_edit_dias_asignados_sum > AppData.reporte_edit_total_disponibles ? #dc2626 : (AppData.reporte_edit_dias_asignados_sum == AppData.reporte_edit_total_disponibles ? #166534 : #1e40af);
                                    }
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                height: 28px;
                                border-radius: 5px;
                                background: AppData.reporte_edit_has_errors || AppData.reporte_edit_dias_asignados_sum > AppData.reporte_edit_total_disponibles ? #fef2f2 : (AppData.reporte_edit_dias_restantes == 0 ? #ecfdf5 : #fffbeb);
                                border-width: 1px;
                                border-color: AppData.reporte_edit_has_errors || AppData.reporte_edit_dias_asignados_sum > AppData.reporte_edit_total_disponibles ? #fca5a5 : (AppData.reporte_edit_dias_restantes == 0 ? #a7f3d0 : #fde68a);
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: space-between;
                                    cross-axis-alignment: center;
                                    Text {
                                        text: AppData.reporte_edit_has_errors || AppData.reporte_edit_dias_asignados_sum > AppData.reporte_edit_total_disponibles ? "⛔ Exceso de Días en Asignación" : (AppData.reporte_edit_dias_restantes == 0 ? "✅ Totalmente Asignado" : "ℹ️ Días Libres por Asignar:");
                                        font-size: 11.5px;
                                        font-weight: 700;
                                        color: AppData.reporte_edit_has_errors || AppData.reporte_edit_dias_asignados_sum > AppData.reporte_edit_total_disponibles ? #b91c1c : (AppData.reporte_edit_dias_restantes == 0 ? #047857 : #92400e);
                                    }
                                    Text {
                                        text: AppData.reporte_edit_dias_asignados_sum > AppData.reporte_edit_total_disponibles
                                            ? ("+" + (AppData.reporte_edit_dias_asignados_sum - AppData.reporte_edit_total_disponibles) + " d de más")
                                            : (AppData.reporte_edit_dias_restantes == 0 ? "0 d libres" : (AppData.reporte_edit_dias_restantes + " d"));
                                        font-size: 12px;
                                        font-weight: 800;
                                        color: AppData.reporte_edit_has_errors || AppData.reporte_edit_dias_asignados_sum > AppData.reporte_edit_total_disponibles ? #b91c1c : (AppData.reporte_edit_dias_restantes == 0 ? #047857 : #92400e);
                                    }
                                }
                            }
                        }
                    }
                }

                // 3. Tabla Superior: Obras Vinculadas al Trabajador (Días a Asignar)
                VerticalLayout {
                    spacing: 5px;

                    HorizontalLayout {
                        alignment: space-between;
                        cross-axis-alignment: center;
                        Text {
                            text: "🗂️ Obras Vinculadas al Trabajador (" + AppData.reporte_edit_selected_count + " asignada(s)) — Asignación de Días:";
                            font-size: 13px;
                            font-weight: 700;
                            color: #1e3a8a;
                        }
                        Text {
                            text: "Tope Máximo Permitido: " + AppData.reporte_edit_total_disponibles + " días";
                            font-size: 12px;
                            font-weight: 700;
                            color: #15803d;
                        }
                    }

                    Rectangle {
                        height: 235px;
                        border-radius: 8px;
                        background: #ffffff;
                        border-width: 1px;
                        border-color: #cbd5e1;
                        clip: true;

                        VerticalLayout {
                            // Sticky Header de la Tabla Superior
                            Rectangle {
                                height: 32px;
                                background: #f1f5f9;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 8px;
                                    cross-axis-alignment: center;
                                    Text { text: "Registro de Obra (Folio / Tipo)"; font-size: 11.5px; font-weight: 800; color: #475569; horizontal-stretch: 3; }
                                    Text { text: "Vigencia en el Mes"; font-size: 11.5px; font-weight: 800; color: #475569; horizontal-stretch: 2; }
                                    Text { text: "Días Obra (Editable)"; font-size: 11.5px; font-weight: 800; color: #1e40af; width: 130px; horizontal-alignment: center; }
                                    Text { text: "Tope Máx Dinámico"; font-size: 11.5px; font-weight: 800; color: #047857; width: 120px; horizontal-alignment: center; }
                                    Text { text: "Quitar"; font-size: 11.5px; font-weight: 800; color: #ef4444; width: 45px; horizontal-alignment: center; }
                                }
                            }

                            Rectangle { height: 1px; background: #e2e8f0; }

                            if AppData.reporte_edit_selected_obras.length == 0 : Rectangle {
                                vertical-stretch: 1;
                                HorizontalLayout {
                                    alignment: center;
                                    cross-axis-alignment: center;
                                    spacing: 8px;
                                    Text { text: "⚠️"; font-size: 13px; }
                                    Text {
                                        text: "No hay obras vinculadas actualmente. Marca una o más casillas en el catálogo inferior para vincular obras a este trabajador.";
                                        font-size: 11.5px;
                                        font-weight: 600;
                                        color: #64748b;
                                    }
                                }
                            }

                            if AppData.reporte_edit_selected_obras.length > 0 : ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    padding-top: 4px;
                                    padding-bottom: 20px;
                                    spacing: 4px;

                                    for o in AppData.reporte_edit_selected_obras : ObraAsignadaRow {
                                        obra_id: o.id;
                                        label: o.label;
                                        vigencia_str: o.vigencia_str;
                                        dias_activos_mes: o.dias_activos_mes;
                                        tope_max: o.tope_max;
                                        has_error: o.has_error;
                                        initial_dias_str: o.dias_obra_str;
                                        dias_changed(id, val) => {
                                            AppLogic.reporte_edit_obra_dias_changed(id, val);
                                        }
                                        remove(id) => {
                                            AppLogic.reporte_edit_toggle_obra(id);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // 4. Catálogo Amplio de Registros de Obra en el Periodo (Checkboxes para vincular / desvincular)
                VerticalLayout {
                    spacing: 5px;

                    HorizontalLayout {
                        alignment: space-between;
                        cross-axis-alignment: center;
                        Text {
                            text: "🗃️ Catálogo de Registros de Obra en el Periodo (Palomea para vincular / Despalomea para desvincular):";
                            font-size: 13px;
                            font-weight: 700;
                            color: #0f172a;
                        }
                        Text {
                            text: AppData.reporte_edit_obras_list.length + " obra(s) disponible(s)";
                            font-size: 12px;
                            font-weight: 600;
                            color: #64748b;
                        }
                    }

                    Rectangle {
                        height: 235px;
                        border-radius: 8px;
                        background: #ffffff;
                        border-width: 1px;
                        border-color: #cbd5e1;
                        clip: true;

                        VerticalLayout {
                            // Encabezado Fijo del Catálogo
                            Rectangle {
                                height: 32px;
                                background: #f8fafc;
                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 8px;
                                    cross-axis-alignment: center;
                                    Text { text: "Vincular"; font-size: 11.5px; font-weight: 800; color: #475569; width: 65px; }
                                    Text { text: "Registro de Obra (Folio / Tipo)"; font-size: 11.5px; font-weight: 800; color: #475569; horizontal-stretch: 3; }
                                    Text { text: "Vigencia Registrada"; font-size: 11.5px; font-weight: 800; color: #475569; horizontal-stretch: 2; }
                                    Text { text: "Días Activos Mes"; font-size: 11.5px; font-weight: 800; color: #475569; width: 115px; horizontal-alignment: center; }
                                    Text { text: "Estado de Asignación"; font-size: 11.5px; font-weight: 800; color: #1e40af; width: 140px; horizontal-alignment: center; }
                                }
                            }

                            Rectangle { height: 1px; background: #e2e8f0; }

                            ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    padding-top: 4px;
                                    padding-bottom: 40px;
                                    spacing: 3px;

                                    for o in AppData.reporte_edit_obras_list : Rectangle {
                                        height: 36px;
                                        border-radius: 5px;
                                        background: o.selected ? #f0fdf4 : (btn_obra_row.has-hover ? #f8fafc : #ffffff);
                                        border-width: 1px;
                                        border-color: o.selected ? #86efac : #e2e8f0;

                                        HorizontalLayout {
                                            padding-left: 10px;
                                            padding-right: 10px;
                                            spacing: 8px;
                                            cross-axis-alignment: center;

                                            // Checkbox Interactivo
                                            Rectangle {
                                                width: 65px;
                                                HorizontalLayout {
                                                    alignment: start;
                                                    cross-axis-alignment: center;
                                                    Rectangle {
                                                        width: 18px;
                                                        height: 18px;
                                                        border-radius: 4px;
                                                        background: o.selected ? #16a34a : #ffffff;
                                                        border-width: 1.5px;
                                                        border-color: o.selected ? #15803d : #94a3b8;

                                                        Text {
                                                            text: "✓";
                                                            font-size: 12px;
                                                            font-weight: 800;
                                                            color: #ffffff;
                                                            horizontal-alignment: center;
                                                            vertical-alignment: center;
                                                            visible: o.selected;
                                                        }
                                                    }
                                                }
                                            }

                                            // Nombre / Folio
                                            Text {
                                                text: o.label;
                                                font-size: 12px;
                                                font-weight: 700;
                                                color: o.selected ? #14532d : #334155;
                                                horizontal-stretch: 3;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }

                                            // Vigencia
                                            Text {
                                                text: o.vigencia_str != "" ? o.vigencia_str : "Sin vigencia registrada";
                                                font-size: 11px;
                                                color: #64748b;
                                                horizontal-stretch: 2;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }

                                            // Días Activos en Mes
                                            Text {
                                                text: o.dias_activos_mes > 0 ? (o.dias_activos_mes + " días") : "0 días";
                                                font-size: 11.5px;
                                                font-weight: 600;
                                                color: #475569;
                                                width: 115px;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }

                                            // Badge de Estado
                                            Rectangle {
                                                width: 140px;
                                                height: 26px;
                                                border-radius: 4px;
                                                background: o.selected ? #ecfdf5 : transparent;
                                                border-width: 1px;
                                                border-color: o.selected ? #a7f3d0 : #e2e8f0;

                                                Text {
                                                    text: o.selected ? ("✓ Asignada: " + o.dias_obra + " d") : "";
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                    color: #15803d;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        btn_obra_row := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                AppLogic.reporte_edit_toggle_obra(o.id);
                                            }
                                        }
                                    }

                                    if AppData.reporte_edit_obras_list.length == 0 : Rectangle {
                                        height: 80px;
                                        Text {
                                            text: "No hay registros de obras activos para este periodo.";
                                            font-size: 12px;
                                            color: #64748b;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // 4. Separador y Botones Cancelar / Guardar Cambios
                Rectangle { height: 1px; background: #e2e8f0; }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: space-between;
                    cross-axis-alignment: center;

                    Text {
                        text: "💡 Tip: Escribe los días correspondientes a cada obra. El sistema calcula en tiempo real el tope máximo permitido.";
                        font-size: 11px;
                        font-weight: 600;
                        color: #64748b;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        Rectangle {
                            height: 38px;
                            width: 105px;
                            border-radius: 6px;
                            background: btn_cancel_unif.has-hover ? #e2e8f0 : #f1f5f9;
                            border-width: 1px;
                            border-color: #cbd5e1;

                            Text { text: "Cancelar"; font-size: 13px; font-weight: 700; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                            btn_cancel_unif := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { AppLogic.reporte_close_edit_modal(); }
                            }
                        }

                        Rectangle {
                            height: 38px;
                            width: 195px;
                            border-radius: 6px;
                            property <bool> is_enabled: !AppData.reporte_edit_has_errors && AppData.reporte_edit_selected_count > 0;
                            background: !self.is_enabled ? #94a3b8 : (btn_save_unif.has-hover ? #1d4ed8 : #2563eb);
                            drop-shadow-blur: self.is_enabled ? 4px : 0px;
                            drop-shadow-color: #2563eb40;

                            HorizontalLayout {
                                alignment: center;
                                spacing: 6px;
                                Text { text: "💾"; font-size: 13px; vertical-alignment: center; }
                                Text { text: "Guardar Asignación"; font-size: 13px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                            }

                            btn_save_unif := TouchArea {
                                mouse-cursor: parent.is_enabled ? pointer : default;
                                enabled: parent.is_enabled;
                                clicked => {
                                    if parent.is_enabled {
                                        AppLogic.reporte_submit_unified_edit_multi(AppData.reporte_edit_row_id);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Modal para Vincular Trabajador a Otra Obra Adicional
    if AppData.show_reporte_add_obra_modal : Rectangle {
        background: #00000088;
        width: 100%;
        height: 100%;

        TouchArea {}

        Rectangle {
            width: 580px;
            height: (AppData.reporte_add_dropdown_open ? 590px : 480px) + (AppData.reporte_add_alert_show ? 54px : 0px);
            border-radius: 12px;
            background: #ffffff;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000040;
            animate height { duration: 150ms; easing: ease-out; }

            VerticalLayout {
                padding: 22px;
                spacing: 14px;
                alignment: space-between;

                // 1. Título y Cabecera
                HorizontalLayout {
                    alignment: space-between;
                    VerticalLayout {
                        spacing: 3px;
                        Text {
                            text: "Vincular Trabajador a Otra Obra";
                            font-size: 18px;
                            font-weight: 800;
                            color: #0f172a;
                        }
                        Text {
                            text: "Trabajador: " + AppData.reporte_add_worker_name + (AppData.reporte_add_periodo != "" ? " • " + AppData.reporte_add_periodo : "");
                            font-size: 13.5px;
                            font-weight: 600;
                            color: #2563eb;
                            overflow: elide;
                        }
                    }

                    Rectangle {
                        width: 30px;
                        height: 30px;
                        border-radius: 15px;
                        background: btn_close_add_obra.has-hover ? #fee2e2 : #f1f5f9;
                        Text { text: "✕"; font-size: 14px; font-weight: 800; color: #ef4444; horizontal-alignment: center; vertical-alignment: center; }
                        btn_close_add_obra := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_close_add_obra_modal(); }
                        }
                    }
                }

                // Resumen de Días del Trabajador (Cédula vs Asignados vs Disponibles)
                Rectangle {
                    border-radius: 8px;
                    background: #f0fdf4;
                    border-width: 1px;
                    border-color: #bbf7d0;

                    VerticalLayout {
                        padding: 10px;
                        spacing: 6px;

                        HorizontalLayout {
                            alignment: space-between;
                            Text {
                                text: "📊 Balance de Días en el Periodo:";
                                font-size: 12px;
                                font-weight: 800;
                                color: #166534;
                            }
                            Text {
                                text: "Disponibles para asignar: " + AppData.reporte_add_dias_available + " días";
                                font-size: 12px;
                                font-weight: 800;
                                color: AppData.reporte_add_dias_available > 0 ? #15803d : #b91c1c;
                            }
                        }

                        HorizontalLayout {
                            spacing: 8px;
                            alignment: start;

                            Rectangle {
                                height: 26px;
                                border-radius: 4px;
                                background: #ffffff;
                                border-width: 1px;
                                border-color: #bbf7d0;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    alignment: center;
                                    Text { text: "Días Cédula: " + AppData.reporte_add_dias_cedula; font-size: 11.5px; font-weight: 700; color: #166534; vertical-alignment: center; }
                                }
                            }

                            Rectangle {
                                height: 26px;
                                border-radius: 4px;
                                background: #ffffff;
                                border-width: 1px;
                                border-color: #bbf7d0;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    alignment: center;
                                    Text { text: "Ya Asignados: " + AppData.reporte_add_dias_used; font-size: 11.5px; font-weight: 700; color: #1e40af; vertical-alignment: center; }
                                }
                            }

                            Rectangle {
                                height: 26px;
                                border-radius: 4px;
                                background: #ffffff;
                                border-width: 1px;
                                border-color: AppData.reporte_add_dias_available > 0 ? #bbf7d0 : #fecdd3;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    alignment: center;
                                    Text {
                                        text: "Restantes: " + AppData.reporte_add_dias_available;
                                        font-size: 11.5px;
                                        font-weight: 700;
                                        color: AppData.reporte_add_dias_available > 0 ? #15803d : #be123c;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // ALERTA TEMPORAL EN EL MODAL (Visible ante errores/restricciones)
                if AppData.reporte_add_alert_show : Rectangle {
                    border-radius: 8px;
                    background: AppData.reporte_add_alert_type == "error" ? #fef2f2 : (AppData.reporte_add_alert_type == "warning" ? #fffbeb : #eff6ff);
                    border-width: 1.5px;
                    border-color: AppData.reporte_add_alert_type == "error" ? #f87171 : (AppData.reporte_add_alert_type == "warning" ? #fde68a : #93c5fd);

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 10px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 10px;
                        cross-axis-alignment: center;

                        Text {
                            text: AppData.reporte_add_alert_type == "error" ? "⛔" : (AppData.reporte_add_alert_type == "warning" ? "⚠️" : "ℹ");
                            font-size: 16px;
                            vertical-alignment: center;
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: AppData.reporte_add_alert_text;
                            font-size: 12.5px;
                            font-weight: 700;
                            color: AppData.reporte_add_alert_type == "error" ? #991b1b : (AppData.reporte_add_alert_type == "warning" ? #92400e : #1e40af);
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 22px;
                            height: 22px;
                            border-radius: 11px;
                            background: btn_dismiss_add_alert.has-hover ? #fecaca : transparent;
                            Text {
                                text: "✕";
                                font-size: 12px;
                                font-weight: 800;
                                color: #991b1b;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            btn_dismiss_add_alert := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { AppData.reporte_add_alert_show = false; }
                            }
                        }
                    }
                }

                // Campo Seleccionar Obra Adicional (Combobox con filtro)
                VerticalLayout {
                    spacing: 6px;

                    HorizontalLayout {
                        alignment: space-between;
                        Text {
                            text: "Seleccionar Obra Adicional (SIROC):";
                            font-size: 13px;
                            font-weight: 700;
                            color: #334155;
                            vertical-alignment: center;
                        }
                        Text {
                            text: AppData.reporte_add_selected_obra_id != "" ? "Obra Seleccionada" : "Selecciona una obra...";
                            font-size: 12px;
                            font-weight: 700;
                            color: AppData.reporte_add_selected_obra_id != "" ? #166534 : #64748b;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        height: 40px;
                        border-radius: 6px;
                        background: #ffffff;
                        border-width: 1.5px;
                        border-color: AppData.reporte_add_dropdown_open ? #3b82f6 : #cbd5e1;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 6px;
                            spacing: 8px;
                            alignment: space-between;

                            add_search_input := LineEdit {
                                horizontal-stretch: 1;
                                placeholder-text: "Escribe para buscar obra...";
                                text <=> AppData.reporte_add_search_query;
                                edited(text) => {
                                    AppData.reporte_add_dropdown_open = true;
                                    AppLogic.reporte_filter_add_obras(text);
                                }
                            }

                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 4px;
                                background: btn_add_drop_toggle.has-hover ? #e2e8f0 : transparent;
                                y: (parent.height - self.height) / 2;

                                Text {
                                    text: AppData.reporte_add_dropdown_open ? "▴" : "▾";
                                    font-size: 14px;
                                    font-weight: 800;
                                    color: #2563eb;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                btn_add_drop_toggle := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        AppData.reporte_add_dropdown_open = !AppData.reporte_add_dropdown_open;
                                        if AppData.reporte_add_dropdown_open {
                                            AppLogic.reporte_filter_add_obras("");
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Menú desplegable Combobox
                    if AppData.reporte_add_dropdown_open : Rectangle {
                        height: 135px;
                        border-radius: 6px;
                        background: #ffffff;
                        border-width: 1px;
                        border-color: #93c5fd;
                        drop-shadow-blur: 10px;
                        drop-shadow-color: #00000020;
                        clip: true;

                        ScrollView {
                            VerticalLayout {
                                padding: 4px;
                                spacing: 4px;

                                for o in AppData.reporte_add_filtered_obras : Rectangle {
                                    height: 34px;
                                    border-radius: 4px;
                                    background: btn_add_pick_item.has-hover ? #dbeafe : (AppData.reporte_add_selected_obra_id == o.id ? #eff6ff : #ffffff);
                                    border-width: 1px;
                                    border-color: AppData.reporte_add_selected_obra_id == o.id ? #93c5fd : #f1f5f9;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 8px;
                                        alignment: start;
                                        Text { text: "🏗"; font-size: 12px; vertical-alignment: center; }
                                        Text {
                                            text: o.label;
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: #1e3a8a;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }

                                    btn_add_pick_item := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            add_search_input.text = o.label;
                                            AppData.reporte_add_search_query = o.label;
                                            AppData.reporte_add_dropdown_open = false;
                                            AppLogic.reporte_select_add_obra(o.id, o.label);
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Info de vigencia de obra seleccionada
                if AppData.reporte_add_obra_vigencia_info != "" : Rectangle {
                    border-radius: 6px;
                    background: #eff6ff;
                    border-width: 1px;
                    border-color: #bfdbfe;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        Text {
                            text: AppData.reporte_add_obra_vigencia_info;
                            font-size: 12px;
                            font-weight: 700;
                            color: #1e40af;
                            wrap: word-wrap;
                        }
                    }
                }

                // Campo Días para la nueva obra
                VerticalLayout {
                    spacing: 6px;
                    HorizontalLayout {
                        alignment: space-between;
                        Text { text: "Días para esta obra:"; font-size: 13px; font-weight: 700; color: #1e40af; }
                        Text { text: "(Máx. disponibles: " + AppData.reporte_add_dias_available + " días)"; font-size: 12px; font-weight: 700; color: #64748b; }
                    }
                    Rectangle {
                        height: 40px;
                        border-radius: 6px;
                        background: #ffffff;
                        border-width: 1.5px;
                        border-color: #93c5fd;

                        LineEdit {
                            text <=> AppData.reporte_add_dias_obra_val;
                            placeholder-text: "Ej: " + AppData.reporte_add_dias_available;
                        }
                    }
                }

                // Botones Cancelar y Vincular
                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;

                    Rectangle {
                        height: 38px;
                        width: 105px;
                        border-radius: 6px;
                        background: btn_cancel_add_obra.has-hover ? #e2e8f0 : #f1f5f9;
                        border-width: 1px;
                        border-color: #cbd5e1;

                        Text { text: "Cancelar"; font-size: 13px; font-weight: 700; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                        btn_cancel_add_obra := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_close_add_obra_modal(); }
                        }
                    }

                    Rectangle {
                        height: 38px;
                        width: 180px;
                        border-radius: 6px;
                        background: btn_submit_add_obra.has-hover ? #15803d : #16a34a;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            Text { text: "➕"; font-size: 12px; vertical-alignment: center; }
                            Text { text: "Vincular a Obra"; font-size: 13px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                        }

                        btn_submit_add_obra := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                AppLogic.reporte_submit_add_obra(
                                    AppData.reporte_add_row_id,
                                    AppData.reporte_add_selected_obra_id,
                                    AppData.reporte_add_dias_obra_val
                                );
                            }
                        }
                    }
                }
            }
        }
    }

    // Modal de Modificación Masiva de Asignación de Obra y Días
    if AppData.show_reporte_batch_edit_modal : Rectangle {
        background: #00000088;
        width: 100%;
        height: 100%;

        TouchArea {}

        Rectangle {
            width: 980px;
            height: 800px + (AppData.reporte_batch_edit_alert_show ? 54px : 0px);
            border-radius: 12px;
            background: #ffffff;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000040;
            animate height { duration: 150ms; easing: ease-out; }

            VerticalLayout {
                padding: 20px;
                spacing: 12px;
                alignment: space-between;

                // 1. Título y Cabecera
                HorizontalLayout {
                    alignment: space-between;
                    cross-axis-alignment: center;

                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: "Modificar Asignación Masiva de Obra y Días";
                            font-size: 18px;
                            font-weight: 800;
                            color: #0f172a;
                        }
                        Text {
                            text: "Se aplicarán los cambios a " + AppData.reporte_batch_edit_worker_count + " trabajador(es) / registro(s) seleccionados";
                            font-size: 13px;
                            font-weight: 600;
                            color: #2563eb;
                            overflow: elide;
                        }
                    }

                    Rectangle {
                        width: 30px;
                        height: 30px;
                        border-radius: 15px;
                        background: btn_close_batch_edit.has-hover ? #fee2e2 : #f1f5f9;
                        Text { text: "✕"; font-size: 14px; font-weight: 800; color: #ef4444; horizontal-alignment: center; vertical-alignment: center; }
                        btn_close_batch_edit := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_close_batch_edit_modal(); }
                        }
                    }
                }

                // ALERTA TEMPORAL EN EL MODAL MASIVO (Visible ante errores/restricciones)
                if AppData.reporte_batch_edit_alert_show : Rectangle {
                    border-radius: 8px;
                    background: AppData.reporte_batch_edit_alert_type == "error" ? #fef2f2 : (AppData.reporte_batch_edit_alert_type == "warning" ? #fffbeb : #eff6ff);
                    border-width: 1.5px;
                    border-color: AppData.reporte_batch_edit_alert_type == "error" ? #f87171 : (AppData.reporte_batch_edit_alert_type == "warning" ? #fde68a : #93c5fd);

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 10px;
                        padding-top: 8px;
                        padding-bottom: 8px;
                        spacing: 10px;
                        cross-axis-alignment: center;

                        Text {
                            text: AppData.reporte_batch_edit_alert_type == "error" ? "⛔" : (AppData.reporte_batch_edit_alert_type == "warning" ? "⚠️" : "ℹ");
                            font-size: 16px;
                            vertical-alignment: center;
                        }

                        Text {
                            horizontal-stretch: 1;
                            text: AppData.reporte_batch_edit_alert_text;
                            font-size: 12.5px;
                            font-weight: 700;
                            color: AppData.reporte_batch_edit_alert_type == "error" ? #991b1b : (AppData.reporte_batch_edit_alert_type == "warning" ? #92400e : #1e40af);
                            wrap: word-wrap;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 22px;
                            height: 22px;
                            border-radius: 11px;
                            background: btn_dismiss_batch_alert.has-hover ? #fecaca : transparent;
                            Text {
                                text: "✕";
                                font-size: 12px;
                                font-weight: 800;
                                color: #991b1b;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            btn_dismiss_batch_alert := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { AppData.reporte_batch_edit_alert_show = false; }
                            }
                        }
                    }
                }

                // 2. Tabla de Trabajadores Seleccionados
                Rectangle {
                    height: 185px;
                    border-radius: 6px;
                    background: #f8fafc;
                    border-width: 1px;
                    border-color: #cbd5e1;
                    clip: true;

                    VerticalLayout {
                        // Cabecera Fija de la tabla (Sticky Header)
                        Rectangle {
                            height: 28px;
                            background: #e2e8f0;
                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                cross-axis-alignment: center;
                                Text { text: "Trabajador (Nombre / NSS)"; font-size: 11px; font-weight: 800; color: #334155; horizontal-stretch: 3; overflow: elide; }
                                Text { text: "Incidencias"; font-size: 11px; font-weight: 800; color: #b45309; width: 135px; horizontal-alignment: center; }
                                Text { text: "Periodo"; font-size: 11px; font-weight: 800; color: #334155; horizontal-stretch: 1; horizontal-alignment: center; }
                                Text { text: "Obra Actual"; font-size: 11px; font-weight: 800; color: #334155; horizontal-stretch: 2; overflow: elide; }
                                Text { text: "D. Cédula"; font-size: 11px; font-weight: 800; color: #334155; width: 58px; horizontal-alignment: center; }
                                Text { text: "D. Obra (Editable)"; font-size: 11px; font-weight: 800; color: #1e40af; width: 80px; horizontal-alignment: center; }
                                Text { text: "Tope Máx"; font-size: 11px; font-weight: 800; color: #047857; width: 66px; horizontal-alignment: center; }
                            }
                        }

                        // Filas scrolleables con Padding Inferior Generoso (evita corte en el fondo)
                        ScrollView {
                            VerticalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                padding-top: 4px;
                                padding-bottom: 50px;
                                spacing: 3px;

                                for worker[idx] in AppData.reporte_batch_edit_workers : Rectangle {
                                    height: 30px;
                                    border-radius: 4px;
                                    background: Math.mod(idx, 2) == 0 ? #ffffff : #f1f5f9;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 8px;
                                        cross-axis-alignment: center;

                                        // Nombre y NSS
                                        HorizontalLayout {
                                            horizontal-stretch: 3;
                                            spacing: 6px;
                                            cross-axis-alignment: center;
                                            Text {
                                                text: worker.nombre;
                                                font-size: 11.5px;
                                                font-weight: 700;
                                                color: #0f172a;
                                                overflow: elide;
                                            }
                                            if worker.nss != "" : Text {
                                                text: "(" + worker.nss + ")";
                                                font-size: 10.5px;
                                                color: #64748b;
                                                overflow: elide;
                                            }
                                        }

                                        // Incidencias (LIC, INC, AUS)
                                        Rectangle {
                                            width: 135px;
                                            height: 22px;
                                            border-radius: 4px;
                                            background: worker.incidencias_str != "Sin incidencias" ? #fffbeb : #f8fafc;
                                            border-width: 1px;
                                            border-color: worker.incidencias_str != "Sin incidencias" ? #fde68a : #e2e8f0;

                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                alignment: center;
                                                cross-axis-alignment: center;
                                                Text {
                                                    text: worker.incidencias_str != "Sin incidencias" ? ("⚠️ " + worker.incidencias_str) : "✓ 0 incidencias";
                                                    font-size: 10px;
                                                    font-weight: 700;
                                                    color: worker.incidencias_str != "Sin incidencias" ? #b45309 : #64748b;
                                                    overflow: elide;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        // Periodo
                                        Text {
                                            text: worker.periodo;
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: #475569;
                                            horizontal-stretch: 1;
                                            horizontal-alignment: center;
                                        }

                                        // Obra actual
                                        Text {
                                            text: worker.obra_label;
                                            font-size: 11px;
                                            font-weight: 600;
                                            color: #1e40af;
                                            horizontal-stretch: 2;
                                            overflow: elide;
                                        }

                                        // Días Cédula
                                        Text {
                                            text: worker.dias_cedula;
                                            font-size: 11.5px;
                                            font-weight: 700;
                                            color: #334155;
                                            width: 58px;
                                            horizontal-alignment: center;
                                        }

                                        // Días Obra (Editable Inline)
                                        Rectangle {
                                            width: 80px;
                                            height: 25px;
                                            border-radius: 4px;
                                            background: worker.has_error ? #fef2f2 : #ffffff;
                                            border-width: 1.5px;
                                            border-color: worker.has_error ? #ef4444 : #93c5fd;

                                            HorizontalLayout {
                                                padding-left: 4px;
                                                padding-right: 4px;
                                                alignment: center;
                                                cross-axis-alignment: center;

                                                LineEdit {
                                                    font-size: 11.5px;
                                                    horizontal-alignment: center;
                                                    text: worker.dias_obra_str;
                                                    edited(val) => {
                                                        AppLogic.reporte_batch_worker_dias_changed(worker.id, val);
                                                    }
                                                }
                                            }
                                        }

                                        // Tope Máx Dinámico
                                        Rectangle {
                                            width: 66px;
                                            height: 22px;
                                            border-radius: 4px;
                                            background: worker.tope_max == 0 ? #fef2f2 : #ecfdf5;
                                            border-width: 1px;
                                            border-color: worker.tope_max == 0 ? #fca5a5 : #a7f3d0;

                                            Text {
                                                text: worker.tope_max;
                                                font-size: 11.5px;
                                                font-weight: 800;
                                                color: worker.tope_max == 0 ? #b91c1c : #047857;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // 3. Checklist de Registros de Obra Disponibles (Checkboxes en lugar de Dropdown)
                VerticalLayout {
                    spacing: 6px;
                    vertical-stretch: 1;

                    HorizontalLayout {
                        alignment: space-between;
                        cross-axis-alignment: center;
                        Text {
                            text: "Registros de Obra en el Periodo (Palomea para vincular / Despalomea para desvincular):";
                            font-size: 12.5px;
                            font-weight: 700;
                            color: #1e3a8a;
                        }
                        Text {
                            text: AppData.reporte_batch_edit_selected_obras_count == 0 ? "⚠️ Ninguna seleccionada (Sin Asignar)" : ("✓ " + AppData.reporte_batch_edit_selected_obras_count + " obra(s) seleccionada(s)");
                            font-size: 11.5px;
                            font-weight: 700;
                            color: AppData.reporte_batch_edit_selected_obras_count == 0 ? #b91c1c : #166534;
                        }
                    }

                        Rectangle {
                            vertical-stretch: 1;
                            min-height: 180px;
                            border-radius: 6px;
                            background: #f8fafc;
                            border-width: 1px;
                            border-color: #cbd5e1;
                            clip: true;

                            ScrollView {
                                VerticalLayout {
                                    padding-left: 6px;
                                    padding-right: 6px;
                                    padding-top: 4px;
                                    padding-bottom: 50px;
                                    spacing: 3px;

                                    for o in AppData.reporte_batch_edit_obras_multiselect : Rectangle {
                                        height: 32px;
                                        border-radius: 4px;
                                        background: o.selected ? #eff6ff : (btn_multi_obra_row.has-hover ? #f1f5f9 : #ffffff);
                                        border-width: 1px;
                                        border-color: o.selected ? #93c5fd : #e2e8f0;

                                        HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 8px;
                                            spacing: 8px;
                                            cross-axis-alignment: center;

                                            Rectangle {
                                                width: 16px;
                                                height: 16px;
                                                border-radius: 3px;
                                                background: o.selected ? #2563eb : #ffffff;
                                                border-width: 1px;
                                                border-color: o.selected ? #2563eb : #94a3b8;

                                                Text {
                                                    text: "✓";
                                                    font-size: 11px;
                                                    font-weight: 800;
                                                    color: #ffffff;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                    visible: o.selected;
                                                }
                                            }

                                            Text {
                                                text: "🏗 " + o.label;
                                                font-size: 11.5px;
                                                font-weight: 700;
                                                color: #1e3a8a;
                                                horizontal-stretch: 3;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }

                                            if o.vigencia_str != "" : Text {
                                                text: o.vigencia_str;
                                                font-size: 10.5px;
                                                color: #64748b;
                                                horizontal-stretch: 2;
                                                overflow: elide;
                                                vertical-alignment: center;
                                            }

                                            Rectangle {
                                                width: 82px;
                                                height: 20px;
                                                border-radius: 4px;
                                                background: o.dias_tope_est > 0 ? #ecfdf5 : #fef2f2;
                                                border-width: 1px;
                                                border-color: o.dias_tope_est > 0 ? #a7f3d0 : #fca5a5;

                                                Text {
                                                    text: o.dias_tope_est > 0 ? ("Tope: " + o.dias_tope_est + "d") : "0 días";
                                                    font-size: 10px;
                                                    font-weight: 700;
                                                    color: o.dias_tope_est > 0 ? #047857 : #b91c1c;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        btn_multi_obra_row := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                AppLogic.reporte_batch_edit_toggle_obra(o.id);
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                // 4. Campos de Días Cédula y Días Obra
                HorizontalLayout {
                    spacing: 16px;

                    // Columna 1: Días Cédula SUA
                    VerticalLayout {
                        spacing: 5px;
                        horizontal-stretch: 1;

                        HorizontalLayout {
                            spacing: 8px;
                            cross-axis-alignment: center;

                            Rectangle {
                                width: 18px;
                                height: 18px;
                                border-radius: 4px;
                                background: AppData.reporte_batch_edit_change_dias_cedula ? #2563eb : #ffffff;
                                border-width: 1px;
                                border-color: AppData.reporte_batch_edit_change_dias_cedula ? #2563eb : #94a3b8;

                                Text {
                                    text: "✓";
                                    font-size: 12px;
                                    font-weight: 800;
                                    color: #ffffff;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    visible: AppData.reporte_batch_edit_change_dias_cedula;
                                }

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        AppData.reporte_batch_edit_change_dias_cedula = !AppData.reporte_batch_edit_change_dias_cedula;
                                    }
                                }
                            }

                            Text {
                                text: "Modificar Días Cédula SUA:";
                                font-size: 13px;
                                font-weight: 700;
                                color: #334155;
                            }
                        }

                        Rectangle {
                            height: 38px;
                            border-radius: 6px;
                            background: #ffffff;
                            border-width: 1.5px;
                            border-color: AppData.reporte_batch_edit_change_dias_cedula ? #3b82f6 : #cbd5e1;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;

                                LineEdit {
                                    placeholder-text: "Ej. 30 (dejar vacío para no cambiar)";
                                    text <=> AppData.reporte_batch_edit_dias_cedula_val;
                                    edited(text) => {
                                        AppData.reporte_batch_edit_change_dias_cedula = (text != "");
                                        AppLogic.reporte_batch_edit_dias_cedula_changed(text);
                                    }
                                }
                            }
                        }
                    }

                    // Columna 2: Días Registro Obra
                    VerticalLayout {
                        spacing: 5px;
                        horizontal-stretch: 1;

                        HorizontalLayout {
                            spacing: 8px;
                            cross-axis-alignment: center;

                            Rectangle {
                                width: 18px;
                                height: 18px;
                                border-radius: 4px;
                                background: AppData.reporte_batch_edit_change_dias_obra ? #2563eb : #ffffff;
                                border-width: 1px;
                                border-color: AppData.reporte_batch_edit_change_dias_obra ? #2563eb : #94a3b8;

                                Text {
                                    text: "✓";
                                    font-size: 12px;
                                    font-weight: 800;
                                    color: #ffffff;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    visible: AppData.reporte_batch_edit_change_dias_obra;
                                }

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        AppData.reporte_batch_edit_change_dias_obra = !AppData.reporte_batch_edit_change_dias_obra;
                                    }
                                }
                            }

                            Text {
                                text: "Modificar Días Registro Obra:";
                                font-size: 13px;
                                font-weight: 700;
                                color: #1e40af;
                            }
                        }

                        Rectangle {
                            height: 38px;
                            border-radius: 6px;
                            background: #ffffff;
                            border-width: 1.5px;
                            border-color: AppData.reporte_batch_edit_change_dias_obra ? #3b82f6 : #cbd5e1;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;

                                LineEdit {
                                    placeholder-text: "Ej. 15 ó 0 (dejar vacío para tope máx)";
                                    text <=> AppData.reporte_batch_edit_dias_obra_val;
                                    edited(text) => {
                                        AppData.reporte_batch_edit_change_dias_obra = (text != "");
                                    }
                                }
                            }
                        }
                    }
                }

                // 5. Nota informativa sobre cálculo de límites
                Rectangle {
                    border-radius: 6px;
                    background: #fffbeb;
                    border-width: 1px;
                    border-color: #fde68a;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 6px;
                        padding-bottom: 6px;
                        spacing: 8px;
                        cross-axis-alignment: center;

                        Text { text: "ℹ️"; font-size: 13px; vertical-alignment: center; }
                        Text {
                            text: AppData.reporte_batch_edit_multi_obra_enabled ?
                                "El sistema calculará automáticamente los días aceptables para cada obra seleccionada en orden cronológico, respetando vigencias activas, movimientos de baja/alta e incidencias, sin superar los días cédula." :
                                "Los Días Obra se ajustarán automáticamente al límite permitido de cada trabajador según las fechas de vigencia de la obra y las incidencias (licencias, incapacidades, ausentismos) de su respectivo periodo.";
                            font-size: 11px;
                            font-weight: 600;
                            color: #92400e;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                }

                // 6. Separador visual nítido y Botones Cancelar y Aplicar Cambios
                Rectangle { height: 1px; background: #e2e8f0; }

                HorizontalLayout {
                    spacing: 12px;
                    alignment: end;
                    cross-axis-alignment: center;

                    Rectangle {
                        height: 38px;
                        width: 110px;
                        border-radius: 6px;
                        background: btn_batch_cancel.has-hover ? #e2e8f0 : #f1f5f9;
                        border-width: 1px;
                        border-color: #cbd5e1;

                        Text { text: "Cancelar"; font-size: 13px; font-weight: 700; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                        btn_batch_cancel := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_close_batch_edit_modal(); }
                        }
                    }

                    Rectangle {
                        height: 38px;
                        width: 270px;
                        border-radius: 6px;
                        background: btn_batch_save.has-hover ? #1d4ed8 : #2563eb;
                        drop-shadow-blur: 4px;
                        drop-shadow-color: #2563eb40;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;
                            cross-axis-alignment: center;
                            Text { text: "💾"; font-size: 13px; vertical-alignment: center; }
                            Text {
                                text: AppData.reporte_batch_edit_selected_obras_count > 0 ?
                                    ("Vincular " + AppData.reporte_batch_edit_selected_obras_count + " Obra(s) a " + AppData.reporte_batch_edit_worker_count + " Empleado(s)") :
                                    ("Aplicar a Seleccionados (" + AppData.reporte_batch_edit_worker_count + ")");
                                font-size: 13px;
                                font-weight: 700;
                                color: #ffffff;
                                vertical-alignment: center;
                            }
                        }

                        btn_batch_save := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                AppLogic.reporte_submit_batch_edit(
                                    AppData.reporte_batch_edit_selected_obra_id,
                                    AppData.reporte_batch_edit_change_obra,
                                    AppData.reporte_batch_edit_dias_cedula_val,
                                    AppData.reporte_batch_edit_change_dias_cedula,
                                    AppData.reporte_batch_edit_dias_obra_val,
                                    AppData.reporte_batch_edit_change_dias_obra
                                );
                            }
                        }
                    }
                }
            }
        }
    }

    // Modal de Confirmación: Igualar Días Cédula en Lote
    if AppData.show_reporte_confirm_batch_dias_modal : Rectangle {
        background: #00000088;
        width: 100%;
        height: 100%;

        TouchArea {}

        Rectangle {
            width: 480px;
            height: 220px;
            border-radius: 12px;
            background: #ffffff;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            drop-shadow-blur: 24px;
            drop-shadow-color: #00000040;

            VerticalLayout {
                padding: 24px;
                spacing: 16px;
                alignment: space-between;

                HorizontalLayout {
                    spacing: 14px;
                    alignment: start;

                    Rectangle {
                        width: 44px;
                        height: 44px;
                        border-radius: 22px;
                        background: #eff6ff;
                        border-width: 1px;
                        border-color: #bfdbfe;
                        Text { text: "📅"; font-size: 20px; horizontal-alignment: center; vertical-alignment: center; }
                    }

                    VerticalLayout {
                        spacing: 4px;
                        horizontal-stretch: 1;

                        Text {
                            text: "Confirmar Asignación de Días Máximos";
                            font-size: 15px;
                            font-weight: 800;
                            color: #0f172a;
                        }
                        Text {
                            text: AppData.reporte_confirm_batch_msg != "" ? AppData.reporte_confirm_batch_msg : "¿Estás seguro de asignar los Días de Obra máximos permitidos a los registros seleccionados en la base de datos?";
                            font-size: 12px;
                            color: #475569;
                            wrap: word-wrap;
                        }
                    }
                }

                HorizontalLayout {
                    spacing: 10px;
                    alignment: end;

                    Rectangle {
                        height: 36px;
                        width: 100px;
                        border-radius: 6px;
                        background: btn_cancel_batch_dias.has-hover ? #e2e8f0 : #f1f5f9;
                        border-width: 1px;
                        border-color: #cbd5e1;

                        Text { text: "Cancelar"; font-size: 12px; font-weight: 700; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                        btn_cancel_batch_dias := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_cancel_confirm_igualar_dias(); }
                        }
                    }

                    Rectangle {
                        height: 36px;
                        width: 155px;
                        border-radius: 6px;
                        background: btn_ok_batch_dias.has-hover ? #1d4ed8 : #2563eb;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            Text { text: "✓"; font-size: 12px; font-weight: 800; color: #ffffff; vertical-alignment: center; }
                            Text { text: "Sí, Asignar"; font-size: 12px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                        }

                        btn_ok_batch_dias := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                AppLogic.reporte_execute_confirm_igualar_dias();
                            }
                        }
                    }
                }
            }
        }
    }

    // Modal de Ordenamiento Multi-Criterio
    if AppData.show_reporte_sort_modal : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #00000066;

        TouchArea { }

        Rectangle {
            width: 420px;
            border-radius: 10px;
            background: #ffffff;
            border-width: 1px;
            border-color: #cbd5e1;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            VerticalLayout {
                padding: 14px;
                spacing: 8px;

                // Cabecera
                HorizontalLayout {
                    alignment: space-between;
                    cross-axis-alignment: center;

                    HorizontalLayout {
                        spacing: 8px;
                        cross-axis-alignment: center;
                        Text { text: "⇅"; font-size: 16px; font-weight: 800; color: #1e40af; vertical-alignment: center; }
                        Text {
                            text: "Ordenamiento Multi-Criterio";
                            font-size: 14px;
                            font-weight: 800;
                            color: #0f172a;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: btn_close_sort.has-hover ? #f1f5f9 : transparent;

                        Text { text: "✕"; font-size: 12px; font-weight: 700; color: #64748b; horizontal-alignment: center; vertical-alignment: center; }
                        btn_close_sort := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_close_sort_modal(); }
                        }
                    }
                }

                Text {
                    text: "Selecciona uno o más criterios de ordenamiento simultáneos (evaluados en cascada):";
                    font-size: 11px;
                    color: #64748b;
                    wrap: word-wrap;
                }

                // Criterio 1: Registro de Obra
                Rectangle {
                    height: 36px;
                    border-radius: 6px;
                    background: AppData.reporte_sort_by_obra ? #eff6ff : (touch_row_obra.has-hover ? #f1f5f9 : #f8fafc);
                    border-width: 1px;
                    border-color: AppData.reporte_sort_by_obra ? #3b82f6 : #e2e8f0;

                    touch_row_obra := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppLogic.reporte_toggle_sort_criterion("obra"); }
                    }

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: space-between;
                        cross-axis-alignment: center;

                        HorizontalLayout {
                            spacing: 8px;
                            cross-axis-alignment: center;

                            Rectangle {
                                width: 16px;
                                height: 16px;
                                border-radius: 3px;
                                background: AppData.reporte_sort_by_obra ? #2563eb : #ffffff;
                                border-width: 1px;
                                border-color: AppData.reporte_sort_by_obra ? #2563eb : #cbd5e1;

                                Text {
                                    text: "✓";
                                    font-size: 10px;
                                    font-weight: 800;
                                    color: #ffffff;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    visible: AppData.reporte_sort_by_obra;
                                }
                            }

                            Text {
                                text: "1. Registro de Obra (SIROC)";
                                font-size: 12px;
                                font-weight: 700;
                                color: AppData.reporte_sort_by_obra ? #1e40af : #334155;
                                vertical-alignment: center;
                            }
                        }

                        if AppData.reporte_sort_by_obra : Rectangle {
                            height: 22px;
                            border-radius: 4px;
                            background: btn_dir_obra.has-hover ? #dbeafe : #ffffff;
                            border-width: 1px;
                            border-color: #93c5fd;

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                cross-axis-alignment: center;
                                Text {
                                    text: AppData.reporte_sort_obra_asc ? "▲ A → Z" : "▼ Z → A";
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: #1d4ed8;
                                    vertical-alignment: center;
                                }
                            }

                            btn_dir_obra := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { AppLogic.reporte_toggle_sort_direction("obra"); }
                            }
                        }
                    }
                }

                // Criterio 2: Por Año
                Rectangle {
                    height: 36px;
                    border-radius: 6px;
                    background: AppData.reporte_sort_by_anio ? #eff6ff : (touch_row_anio.has-hover ? #f1f5f9 : #f8fafc);
                    border-width: 1px;
                    border-color: AppData.reporte_sort_by_anio ? #3b82f6 : #e2e8f0;

                    touch_row_anio := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppLogic.reporte_toggle_sort_criterion("anio"); }
                    }

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: space-between;
                        cross-axis-alignment: center;

                        HorizontalLayout {
                            spacing: 8px;
                            cross-axis-alignment: center;

                            Rectangle {
                                width: 16px;
                                height: 16px;
                                border-radius: 3px;
                                background: AppData.reporte_sort_by_anio ? #2563eb : #ffffff;
                                border-width: 1px;
                                border-color: AppData.reporte_sort_by_anio ? #2563eb : #cbd5e1;

                                Text {
                                    text: "✓";
                                    font-size: 10px;
                                    font-weight: 800;
                                    color: #ffffff;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    visible: AppData.reporte_sort_by_anio;
                                }
                            }

                            Text {
                                text: "2. Por Año del Periodo";
                                font-size: 12px;
                                font-weight: 700;
                                color: AppData.reporte_sort_by_anio ? #1e40af : #334155;
                                vertical-alignment: center;
                            }
                        }

                        if AppData.reporte_sort_by_anio : Rectangle {
                            height: 22px;
                            border-radius: 4px;
                            background: btn_dir_anio.has-hover ? #dbeafe : #ffffff;
                            border-width: 1px;
                            border-color: #93c5fd;

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                cross-axis-alignment: center;
                                Text {
                                    text: AppData.reporte_sort_anio_asc ? "▲ Menor a Mayor" : "▼ Mayor a Menor";
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: #1d4ed8;
                                    vertical-alignment: center;
                                }
                            }

                            btn_dir_anio := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { AppLogic.reporte_toggle_sort_direction("anio"); }
                            }
                        }
                    }
                }

                // Criterio 3: Por Mes
                Rectangle {
                    height: 36px;
                    border-radius: 6px;
                    background: AppData.reporte_sort_by_mes ? #eff6ff : (touch_row_mes.has-hover ? #f1f5f9 : #f8fafc);
                    border-width: 1px;
                    border-color: AppData.reporte_sort_by_mes ? #3b82f6 : #e2e8f0;

                    touch_row_mes := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppLogic.reporte_toggle_sort_criterion("mes"); }
                    }

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: space-between;
                        cross-axis-alignment: center;

                        HorizontalLayout {
                            spacing: 8px;
                            cross-axis-alignment: center;

                            Rectangle {
                                width: 16px;
                                height: 16px;
                                border-radius: 3px;
                                background: AppData.reporte_sort_by_mes ? #2563eb : #ffffff;
                                border-width: 1px;
                                border-color: AppData.reporte_sort_by_mes ? #2563eb : #cbd5e1;

                                Text {
                                    text: "✓";
                                    font-size: 10px;
                                    font-weight: 800;
                                    color: #ffffff;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    visible: AppData.reporte_sort_by_mes;
                                }
                            }

                            Text {
                                text: "3. Por Mes (Cronológico)";
                                font-size: 12px;
                                font-weight: 700;
                                color: AppData.reporte_sort_by_mes ? #1e40af : #334155;
                                vertical-alignment: center;
                            }
                        }

                        if AppData.reporte_sort_by_mes : Rectangle {
                            height: 22px;
                            border-radius: 4px;
                            background: btn_dir_mes.has-hover ? #dbeafe : #ffffff;
                            border-width: 1px;
                            border-color: #93c5fd;

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                cross-axis-alignment: center;
                                Text {
                                    text: AppData.reporte_sort_mes_asc ? "▲ Enero → Diciembre" : "▼ Diciembre → Enero";
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: #1d4ed8;
                                    vertical-alignment: center;
                                }
                            }

                            btn_dir_mes := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { AppLogic.reporte_toggle_sort_direction("mes"); }
                            }
                        }
                    }
                }

                // Criterio 4: RFC/CURP
                Rectangle {
                    height: 36px;
                    border-radius: 6px;
                    background: AppData.reporte_sort_by_rfc ? #eff6ff : (touch_row_rfc.has-hover ? #f1f5f9 : #f8fafc);
                    border-width: 1px;
                    border-color: AppData.reporte_sort_by_rfc ? #3b82f6 : #e2e8f0;

                    touch_row_rfc := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppLogic.reporte_toggle_sort_criterion("rfc"); }
                    }

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        alignment: space-between;
                        cross-axis-alignment: center;

                        HorizontalLayout {
                            spacing: 8px;
                            cross-axis-alignment: center;

                            Rectangle {
                                width: 16px;
                                height: 16px;
                                border-radius: 3px;
                                background: AppData.reporte_sort_by_rfc ? #2563eb : #ffffff;
                                border-width: 1px;
                                border-color: AppData.reporte_sort_by_rfc ? #2563eb : #cbd5e1;

                                Text {
                                    text: "✓";
                                    font-size: 10px;
                                    font-weight: 800;
                                    color: #ffffff;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    visible: AppData.reporte_sort_by_rfc;
                                }
                            }

                            Text {
                                text: "4. RFC / CURP";
                                font-size: 12px;
                                font-weight: 700;
                                color: AppData.reporte_sort_by_rfc ? #1e40af : #334155;
                                vertical-alignment: center;
                            }
                        }

                        if AppData.reporte_sort_by_rfc : Rectangle {
                            height: 22px;
                            border-radius: 4px;
                            background: btn_dir_rfc.has-hover ? #dbeafe : #ffffff;
                            border-width: 1px;
                            border-color: #93c5fd;

                            HorizontalLayout {
                                padding-left: 6px;
                                padding-right: 6px;
                                cross-axis-alignment: center;
                                Text {
                                    text: AppData.reporte_sort_rfc_asc ? "▲ A → Z" : "▼ Z → A";
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: #1d4ed8;
                                    vertical-alignment: center;
                                }
                            }

                            btn_dir_rfc := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { AppLogic.reporte_toggle_sort_direction("rfc"); }
                            }
                        }
                    }
                }

                // Botones de acción
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    cross-axis-alignment: center;

                    Rectangle {
                        height: 30px;
                        width: 110px;
                        border-radius: 5px;
                        background: btn_reset_sort.has-hover ? #fee2e2 : #f8fafc;
                        border-width: 1px;
                        border-color: #cbd5e1;

                        Text {
                            text: "Quitar Orden";
                            font-size: 11px;
                            font-weight: 700;
                            color: #dc2626;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        btn_reset_sort := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_reset_sorting(); }
                        }
                    }

                    Rectangle {
                        height: 30px;
                        width: 100px;
                        border-radius: 5px;
                        background: btn_ok_sort.has-hover ? #1d4ed8 : #2563eb;

                        Text {
                            text: "Listo / Cerrar";
                            font-size: 11px;
                            font-weight: 700;
                            color: #ffffff;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        btn_ok_sort := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_close_sort_modal(); }
                        }
                    }
                }
            }
        }
    }

    // Modal de Filtro y Selección de Empleados Seleccionados
    if AppData.show_reporte_emp_modal : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #00000066;

        TouchArea { }

        Rectangle {
            width: 530px;
            border-radius: 12px;
            background: #ffffff;
            border-width: 1px;
            border-color: #cbd5e1;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                // Cabecera
                HorizontalLayout {
                    alignment: space-between;
                    cross-axis-alignment: center;

                    HorizontalLayout {
                        spacing: 8px;
                        cross-axis-alignment: center;
                        Text { text: "👥"; font-size: 16px; vertical-alignment: center; }
                        Text {
                            text: "Explorar y Filtrar Empleados Seleccionados";
                            font-size: 15px;
                            font-weight: 800;
                            color: #0f172a;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: btn_close_emp_m.has-hover ? #f1f5f9 : transparent;

                        Text { text: "✕"; font-size: 13px; font-weight: 700; color: #64748b; horizontal-alignment: center; vertical-alignment: center; }
                        btn_close_emp_m := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_close_empleados_filter_modal(); }
                        }
                    }
                }

                // Resumen de trabajadores (compacto con ScrollView para no agrandar la ventana)
                Rectangle {
                    border-radius: 6px;
                    background: #f8fafc;
                    border-width: 1px;
                    border-color: #e2e8f0;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 3px;
                        Text {
                            text: "Trabajadores seleccionados (" + AppData.reporte_emp_modal_worker_count + "):";
                            font-size: 11px;
                            font-weight: 800;
                            color: #1e293b;
                        }
                        Rectangle {
                            height: 52px;
                            border-radius: 4px;
                            background: #ffffff;
                            border-width: 1px;
                            border-color: #cbd5e1;
                            clip: true;

                            ScrollView {
                                width: 100%;
                                height: 100%;
                                Text {
                                    text: AppData.reporte_emp_modal_worker_names_str;
                                    font-size: 11px;
                                    color: #334155;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }

                // Botón Acción Rápida: Seleccionar en Todos sus Meses
                Rectangle {
                    height: 32px;
                    border-radius: 5px;
                    background: btn_sel_all_months.has-hover ? #dbeafe : #eff6ff;
                    border-width: 1.5px;
                    border-color: #3b82f6;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        cross-axis-alignment: center;

                        Text { text: "📅"; font-size: 12px; vertical-alignment: center; }
                        Text {
                            text: "Seleccionar Todas sus Apariciones en Todos los Meses (" + AppData.reporte_emp_modal_total_occurrences + " filas)";
                            font-size: 11px;
                            font-weight: 800;
                            color: #1d4ed8;
                            vertical-alignment: center;
                        }
                    }

                    btn_sel_all_months := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            AppLogic.reporte_select_all_months_for_selected_employees();
                        }
                    }
                }

                // Sección 1: Filtro por Meses
                VerticalLayout {
                    spacing: 4px;
                    HorizontalLayout {
                        alignment: space-between;
                        cross-axis-alignment: center;
                        Text { text: "🗓 Meses en los que aparecen:"; font-size: 11px; font-weight: 800; color: #1e293b; }

                        HorizontalLayout {
                            spacing: 6px;
                            Rectangle {
                                height: 22px;
                                border-radius: 4px;
                                background: AppData.reporte_emp_filter_all_months ? #2563eb : #e2e8f0;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: "Todos los meses";
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: AppData.reporte_emp_filter_all_months ? #ffffff : #475569;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { AppLogic.reporte_set_emp_filter_all_months(true); }
                                }
                            }
                            Rectangle {
                                height: 22px;
                                border-radius: 4px;
                                background: !AppData.reporte_emp_filter_all_months ? #2563eb : #e2e8f0;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: "Algunos meses";
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: !AppData.reporte_emp_filter_all_months ? #ffffff : #475569;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { AppLogic.reporte_set_emp_filter_all_months(false); }
                                }
                            }
                        }
                    }

                    if !AppData.reporte_emp_filter_all_months : Rectangle {
                        height: 75px;
                        border-radius: 5px;
                        background: #f8fafc;
                        border-width: 1px;
                        border-color: #cbd5e1;

                        ScrollView {
                            VerticalLayout {
                                padding: 4px;
                                spacing: 3px;
                                for m_item in AppData.reporte_emp_modal_meses : Rectangle {
                                    height: 22px;
                                    border-radius: 4px;
                                    background: m_item.selected ? #dbeafe : transparent;

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        spacing: 6px;
                                        cross-axis-alignment: center;

                                        Rectangle {
                                            width: 14px;
                                            height: 14px;
                                            border-radius: 3px;
                                            background: m_item.selected ? #2563eb : #ffffff;
                                            border-width: 1px;
                                            border-color: m_item.selected ? #2563eb : #94a3b8;

                                            Text {
                                                text: "✓";
                                                font-size: 9px;
                                                font-weight: 800;
                                                color: #ffffff;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                visible: m_item.selected;
                                            }
                                        }

                                        Text {
                                            text: m_item.label + " (" + m_item.count + ")";
                                            font-size: 11px;
                                            font-weight: m_item.selected ? 700 : 500;
                                            color: #1e293b;
                                            vertical-alignment: center;
                                        }
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { AppLogic.reporte_toggle_emp_filter_month(m_item.id); }
                                    }
                                }
                            }
                        }
                    }
                }

                // Sección 2: Filtro por Registros de Obra
                VerticalLayout {
                    spacing: 4px;
                    HorizontalLayout {
                        alignment: space-between;
                        cross-axis-alignment: center;
                        Text { text: "🏗 Registros de Obra en los que aparecen:"; font-size: 11px; font-weight: 800; color: #1e293b; }

                        HorizontalLayout {
                            spacing: 6px;
                            Rectangle {
                                height: 22px;
                                border-radius: 4px;
                                background: AppData.reporte_emp_filter_all_obras ? #2563eb : #e2e8f0;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: "Todas las obras";
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: AppData.reporte_emp_filter_all_obras ? #ffffff : #475569;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { AppLogic.reporte_set_emp_filter_all_obras(true); }
                                }
                            }
                            Rectangle {
                                height: 22px;
                                border-radius: 4px;
                                background: !AppData.reporte_emp_filter_all_obras ? #2563eb : #e2e8f0;
                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    Text {
                                        text: "Algunas obras";
                                        font-size: 10px;
                                        font-weight: 700;
                                        color: !AppData.reporte_emp_filter_all_obras ? #ffffff : #475569;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { AppLogic.reporte_set_emp_filter_all_obras(false); }
                                }
                            }
                        }
                    }

                    if !AppData.reporte_emp_filter_all_obras : Rectangle {
                        height: 75px;
                        border-radius: 5px;
                        background: #f8fafc;
                        border-width: 1px;
                        border-color: #cbd5e1;

                        ScrollView {
                            VerticalLayout {
                                padding: 4px;
                                spacing: 3px;
                                for o_item in AppData.reporte_emp_modal_obras : Rectangle {
                                    height: 22px;
                                    border-radius: 4px;
                                    background: o_item.selected ? #dbeafe : transparent;

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        spacing: 6px;
                                        cross-axis-alignment: center;

                                        Rectangle {
                                            width: 14px;
                                            height: 14px;
                                            border-radius: 3px;
                                            background: o_item.selected ? #2563eb : #ffffff;
                                            border-width: 1px;
                                            border-color: o_item.selected ? #2563eb : #94a3b8;

                                            Text {
                                                text: "✓";
                                                font-size: 9px;
                                                font-weight: 800;
                                                color: #ffffff;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                visible: o_item.selected;
                                            }
                                        }

                                        Text {
                                            text: o_item.label + " (" + o_item.count + ")";
                                            font-size: 11px;
                                            font-weight: o_item.selected ? 700 : 500;
                                            color: #1e293b;
                                            vertical-alignment: center;
                                        }
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { AppLogic.reporte_toggle_emp_filter_obra(o_item.id); }
                                    }
                                }
                            }
                        }
                    }
                }

                // Botones Inferiores
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    cross-axis-alignment: center;

                    if AppData.reporte_emp_filter_active : Rectangle {
                        height: 32px;
                        width: 110px;
                        border-radius: 5px;
                        background: btn_clr_emp_f.has-hover ? #fee2e2 : #f8fafc;
                        border-width: 1px;
                        border-color: #cbd5e1;

                        Text { text: "Limpiar Filtro"; font-size: 11px; font-weight: 700; color: #dc2626; horizontal-alignment: center; vertical-alignment: center; }
                        btn_clr_emp_f := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_clear_emp_filter(); }
                        }
                    }

                    Rectangle {
                        height: 32px;
                        width: 80px;
                        border-radius: 5px;
                        background: btn_cancel_emp_m.has-hover ? #e2e8f0 : #f1f5f9;
                        border-width: 1px;
                        border-color: #cbd5e1;

                        Text { text: "Cancelar"; font-size: 11px; font-weight: 700; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                        btn_cancel_emp_m := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_close_empleados_filter_modal(); }
                        }
                    }

                    Rectangle {
                        height: 32px;
                        width: 125px;
                        border-radius: 5px;
                        background: btn_apply_emp_m.has-hover ? #1d4ed8 : #2563eb;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            cross-axis-alignment: center;
                            Text { text: "🔍"; font-size: 11px; vertical-alignment: center; }
                            Text { text: "Aplicar Filtro"; font-size: 11px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                        }

                        btn_apply_emp_m := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_apply_emp_filter(); }
                        }
                    }
                }
            }
        }
    }

    // Modal de Selección Rápida por Registro de Obra
    if AppData.show_reporte_select_obras_modal : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #00000066;

        TouchArea { }

        Rectangle {
            width: 460px;
            border-radius: 10px;
            background: #ffffff;
            border-width: 1px;
            border-color: #cbd5e1;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            VerticalLayout {
                padding: 14px;
                spacing: 10px;

                // Cabecera
                HorizontalLayout {
                    alignment: space-between;
                    cross-axis-alignment: center;

                    HorizontalLayout {
                        spacing: 8px;
                        cross-axis-alignment: center;
                        Text { text: "🏗️"; font-size: 16px; vertical-alignment: center; }
                        Text {
                            text: "Selección Rápida por Obra";
                            font-size: 14px;
                            font-weight: 800;
                            color: #0f172a;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: btn_close_sel_obras.has-hover ? #f1f5f9 : transparent;

                        Text { text: "✕"; font-size: 12px; font-weight: 700; color: #64748b; horizontal-alignment: center; vertical-alignment: center; }
                        btn_close_sel_obras := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_close_select_obras_modal(); }
                        }
                    }
                }

                Text {
                    text: "Elige uno o más registros de obra para seleccionar a los empleados asignados a ellas:";
                    font-size: 11px;
                    color: #64748b;
                    wrap: word-wrap;
                }

                // Botones rápidos: Marcar Todas / Desmarcar Todas
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;

                    Rectangle {
                        height: 26px;
                        border-radius: 4px;
                        background: btn_sel_all_obras_opt.has-hover ? #dbeafe : #eff6ff;
                        border-width: 1px;
                        border-color: #93c5fd;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            cross-axis-alignment: center;
                            Text {
                                text: "Marcar Todas";
                                font-size: 10px;
                                font-weight: 700;
                                color: #1d4ed8;
                                vertical-alignment: center;
                            }
                        }

                        btn_sel_all_obras_opt := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_quick_select_all_obras(true); }
                        }
                    }

                    Rectangle {
                        height: 26px;
                        border-radius: 4px;
                        background: btn_desel_all_obras_opt.has-hover ? #f1f5f9 : #ffffff;
                        border-width: 1px;
                        border-color: #cbd5e1;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            cross-axis-alignment: center;
                            Text {
                                text: "Desmarcar Todas";
                                font-size: 10px;
                                font-weight: 700;
                                color: #475569;
                                vertical-alignment: center;
                            }
                        }

                        btn_desel_all_obras_opt := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_quick_select_all_obras(false); }
                        }
                    }
                }

                // Lista de Obras con checkboxes
                Rectangle {
                    height: 210px;
                    border-radius: 6px;
                    background: #f8fafc;
                    border-width: 1px;
                    border-color: #e2e8f0;
                    clip: true;

                    ScrollView {
                        VerticalLayout {
                            padding: 6px;
                            spacing: 4px;

                            for item in AppData.reporte_quick_select_obras : Rectangle {
                                height: 34px;
                                border-radius: 4px;
                                background: item.selected ? #eff6ff : (touch_item_obra.has-hover ? #f1f5f9 : #ffffff);
                                border-width: 1px;
                                border-color: item.selected ? #3b82f6 : #e2e8f0;

                                touch_item_obra := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { AppLogic.reporte_toggle_quick_select_obra(item.id); }
                                }

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    alignment: space-between;
                                    cross-axis-alignment: center;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        cross-axis-alignment: center;

                                        Rectangle {
                                            width: 16px;
                                            height: 16px;
                                            border-radius: 3px;
                                            background: item.selected ? #2563eb : #ffffff;
                                            border-width: 1px;
                                            border-color: item.selected ? #2563eb : #cbd5e1;

                                            Text {
                                                text: "✓";
                                                font-size: 10px;
                                                font-weight: 800;
                                                color: #ffffff;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                visible: item.selected;
                                            }
                                        }

                                        Text {
                                            text: item.label;
                                            font-size: 11px;
                                            font-weight: item.selected ? 700 : 500;
                                            color: item.selected ? #1e40af : #1e293b;
                                            vertical-alignment: center;
                                        }
                                    }

                                    Rectangle {
                                        height: 20px;
                                        border-radius: 10px;
                                        background: item.selected ? #dbeafe : #f1f5f9;

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            cross-axis-alignment: center;
                                            Text {
                                                text: item.count + " empleados";
                                                font-size: 10px;
                                                font-weight: 600;
                                                color: item.selected ? #1d4ed8 : #64748b;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Botones de acción
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    cross-axis-alignment: center;

                    Rectangle {
                        height: 32px;
                        width: 80px;
                        border-radius: 5px;
                        background: btn_cancel_sel_obras.has-hover ? #e2e8f0 : #f1f5f9;
                        border-width: 1px;
                        border-color: #cbd5e1;

                        Text { text: "Cancelar"; font-size: 11px; font-weight: 700; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                        btn_cancel_sel_obras := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_close_select_obras_modal(); }
                        }
                    }

                    Rectangle {
                        height: 32px;
                        width: 145px;
                        border-radius: 5px;
                        background: btn_apply_sel_obras.has-hover ? #1d4ed8 : #2563eb;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            cross-axis-alignment: center;
                            Text { text: "☑️"; font-size: 11px; vertical-alignment: center; }
                            Text { text: "Aplicar Selección"; font-size: 11px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                        }

                        btn_apply_sel_obras := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_apply_quick_select_obras(); }
                        }
                    }
                }
            }
        }
    }

    // Modal de Exportación a SUA
    if AppData.show_reporte_export_sua_modal : Rectangle {
        x: 0;
        y: 0;
        width: 100%;
        height: 100%;
        background: #00000066;

        TouchArea { }

        Rectangle {
            width: 530px;
            border-radius: 10px;
            background: #ffffff;
            border-width: 1px;
            border-color: #cbd5e1;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;

                // Cabecera
                HorizontalLayout {
                    alignment: space-between;
                    cross-axis-alignment: center;

                    HorizontalLayout {
                        spacing: 8px;
                        cross-axis-alignment: center;
                        Text { text: "📄"; font-size: 18px; vertical-alignment: center; }
                        VerticalLayout {
                            spacing: 1px;
                            Text {
                                text: "Exportar Archivos para SUA (IMSS)";
                                font-size: 15px;
                                font-weight: 800;
                                color: #0f172a;
                            }
                            Text {
                                text: "Generación de archivos .TXT compatibles con el Sistema Único de Autodeterminación";
                                font-size: 11px;
                                color: #64748b;
                            }
                        }
                    }

                    Rectangle {
                        width: 24px;
                        height: 24px;
                        border-radius: 12px;
                        background: btn_close_export_sua.has-hover ? #f1f5f9 : transparent;

                        Text { text: "✕"; font-size: 12px; font-weight: 700; color: #64748b; horizontal-alignment: center; vertical-alignment: center; }
                        btn_close_export_sua := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_cerrar_modal_exportar_sua(); }
                        }
                    }
                }

                // Explicación
                Rectangle {
                    border-radius: 6px;
                    background: #f8fafc;
                    border-width: 1px;
                    border-color: #e2e8f0;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 4px;
                        Text {
                            text: "Selecciona los registros de obra para filtrar los empleados a exportar:";
                            font-size: 11.5px;
                            font-weight: 700;
                            color: #334155;
                        }
                        Text {
                            text: "Por defecto se encuentran seleccionadas las obras creadas por el usuario en esta revisión. Los empleados no vinculados a las obras seleccionadas serán excluidos.";
                            font-size: 11px;
                            color: #64748b;
                            wrap: word-wrap;
                        }
                    }
                }

                // Botones rápidos de selección
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;
                    cross-axis-alignment: center;

                    // Todas
                    Rectangle {
                        height: 26px;
                        border-radius: 4px;
                        background: btn_sel_all_sua.has-hover ? #dbeafe : #eff6ff;
                        border-width: 1px;
                        border-color: #93c5fd;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            cross-axis-alignment: center;
                            Text {
                                text: "Todas";
                                font-size: 10px;
                                font-weight: 700;
                                color: #1d4ed8;
                                vertical-alignment: center;
                            }
                        }

                        btn_sel_all_sua := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_sua_select_preset("all"); }
                        }
                    }

                    // Solo con Obra
                    Rectangle {
                        height: 26px;
                        border-radius: 4px;
                        background: btn_sel_obras_sua.has-hover ? #dcfce7 : #f0fdf4;
                        border-width: 1px;
                        border-color: #86efac;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            cross-axis-alignment: center;
                            Text {
                                text: "Solo con Obra";
                                font-size: 10px;
                                font-weight: 700;
                                color: #166534;
                                vertical-alignment: center;
                            }
                        }

                        btn_sel_obras_sua := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_sua_select_preset("obras"); }
                        }
                    }

                    // Solo sin Asignar
                    Rectangle {
                        height: 26px;
                        border-radius: 4px;
                        background: btn_sel_sin_obra_sua.has-hover ? #fef3c7 : #fffbeb;
                        border-width: 1px;
                        border-color: #fcd34d;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            cross-axis-alignment: center;
                            Text {
                                text: "Solo sin Asignar";
                                font-size: 10px;
                                font-weight: 700;
                                color: #b45309;
                                vertical-alignment: center;
                            }
                        }

                        btn_sel_sin_obra_sua := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_sua_select_preset("sin_obra"); }
                        }
                    }

                    // Desmarcar
                    Rectangle {
                        height: 26px;
                        border-radius: 4px;
                        background: btn_desel_all_sua.has-hover ? #f1f5f9 : #ffffff;
                        border-width: 1px;
                        border-color: #cbd5e1;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            cross-axis-alignment: center;
                            Text {
                                text: "Desmarcar";
                                font-size: 10px;
                                font-weight: 700;
                                color: #475569;
                                vertical-alignment: center;
                            }
                        }

                        btn_desel_all_sua := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_sua_select_preset("none"); }
                        }
                    }

                    Text {
                        text: "(" + AppData.reporte_sua_selected_count + " selecc. • " + AppData.reporte_sua_total_empleados_filtrados + " empleados)";
                        font-size: 11px;
                        font-weight: 600;
                        color: #1e3a8a;
                        vertical-alignment: center;
                    }
                }

                // Lista de Obras con checkboxes
                Rectangle {
                    height: 180px;
                    border-radius: 6px;
                    background: #f8fafc;
                    border-width: 1px;
                    border-color: #e2e8f0;
                    clip: true;

                    ScrollView {
                        VerticalLayout {
                            padding: 6px;
                            spacing: 4px;

                            for item in AppData.reporte_sua_obras : Rectangle {
                                height: 42px;
                                border-radius: 5px;
                                background: item.selected ? (item.id == "__SIN_OBRA__" ? #fffbeb : #eff6ff) : (touch_item_sua.has-hover ? #f1f5f9 : #ffffff);
                                border-width: 1px;
                                border-color: item.selected ? (item.id == "__SIN_OBRA__" ? #f59e0b : #3b82f6) : #e2e8f0;

                                touch_item_sua := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { AppLogic.reporte_toggle_sua_obra(item.id); }
                                }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    alignment: space-between;
                                    cross-axis-alignment: center;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        cross-axis-alignment: center;

                                        Rectangle {
                                            width: 16px;
                                            height: 16px;
                                            border-radius: 3px;
                                            background: item.selected ? (item.id == "__SIN_OBRA__" ? #d97706 : #2563eb) : #ffffff;
                                            border-width: 1px;
                                            border-color: item.selected ? (item.id == "__SIN_OBRA__" ? #d97706 : #2563eb) : #cbd5e1;

                                            Text {
                                                text: "✓";
                                                font-size: 10px;
                                                font-weight: 800;
                                                color: #ffffff;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                                visible: item.selected;
                                            }
                                        }

                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 1px;

                                            HorizontalLayout {
                                                spacing: 6px;
                                                cross-axis-alignment: center;
                                                Text {
                                                    text: item.numero;
                                                    font-size: 12px;
                                                    font-weight: 800;
                                                    color: item.selected ? (item.id == "__SIN_OBRA__" ? #b45309 : #1d4ed8) : #1e293b;
                                                }
                                                if item.tipo_obra != "" : Text {
                                                    text: "- " + item.tipo_obra;
                                                    font-size: 11px;
                                                    font-weight: 500;
                                                    color: #64748b;
                                                }
                                                if item.id == "__SIN_OBRA__" : Rectangle {
                                                    height: 16px;
                                                    border-radius: 3px;
                                                    background: #fef3c7;
                                                    border-width: 1px;
                                                    border-color: #fcd34d;
                                                    HorizontalLayout {
                                                        padding-left: 4px;
                                                        padding-right: 4px;
                                                        Text { text: "Sin Asignar"; font-size: 9px; font-weight: 700; color: #b45309; vertical-alignment: center; }
                                                    }
                                                }
                                                if item.creado_usuario && item.id != "__SIN_OBRA__" : Rectangle {
                                                    height: 16px;
                                                    border-radius: 3px;
                                                    background: #dcfce7;
                                                    border-width: 1px;
                                                    border-color: #86efac;
                                                    HorizontalLayout {
                                                        padding-left: 4px;
                                                        padding-right: 4px;
                                                        Text { text: "Obra Usuario"; font-size: 9px; font-weight: 700; color: #166534; vertical-alignment: center; }
                                                    }
                                                }
                                            }

                                            if item.vigencia != "" : Text {
                                                text: "📅 " + item.vigencia;
                                                font-size: 10px;
                                                font-weight: 500;
                                                color: #047857;
                                            }
                                        }
                                    }

                                    Rectangle {
                                        height: 20px;
                                        border-radius: 10px;
                                        background: item.selected ? #dbeafe : #f1f5f9;

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            cross-axis-alignment: center;
                                            Text {
                                                text: item.empleados_count + " empleados";
                                                font-size: 10px;
                                                font-weight: 600;
                                                color: item.selected ? #1d4ed8 : #64748b;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Resumen de archivos a generar
                Rectangle {
                    border-radius: 6px;
                    background: #fefce8;
                    border-width: 1px;
                    border-color: #fef08a;

                    VerticalLayout {
                        padding: 8px;
                        spacing: 2px;
                        Text {
                            text: "Archivos que se generarán en la carpeta de destino (ordenados para importación en SUA):";
                            font-size: 11px;
                            font-weight: 700;
                            color: #854d0e;
                        }
                        Text {
                            text: "• 1_ASEG_<Folio>.TXT (1. Altas/Trabajadores)   • 2_AFIL_<Folio>.TXT (2. Datos Afiliatorios)\n• 3_MOVT_<Folio>.TXT (3. Movimientos/Salarios)   • 4_CRED_<Folio>.TXT (4. Créditos INFONAVIT)\n• 5_INCAP_<Folio>.TXT (5. Incapacidades Médicas)";
                            font-size: 10px;
                            color: #713f12;
                        }
                    }
                }

                // Botones de acción
                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    cross-axis-alignment: center;

                    Rectangle {
                        height: 34px;
                        width: 90px;
                        border-radius: 5px;
                        background: btn_cancel_sua.has-hover ? #e2e8f0 : #f1f5f9;
                        border-width: 1px;
                        border-color: #cbd5e1;

                        Text { text: "Cancelar"; font-size: 12px; font-weight: 700; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                        btn_cancel_sua := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_cerrar_modal_exportar_sua(); }
                        }
                    }

                    Rectangle {
                        height: 34px;
                        width: 180px;
                        border-radius: 5px;
                        background: btn_submit_sua.has-hover ? #b45309 : #d97706;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;
                            cross-axis-alignment: center;
                            Text { text: "💾"; font-size: 12px; vertical-alignment: center; }
                            Text { text: "Generar Archivos SUA"; font-size: 12px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                        }

                        btn_submit_sua := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.reporte_generar_sua(); }
                        }
                    }
                }
            }
        }
    }
}
