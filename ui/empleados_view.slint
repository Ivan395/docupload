import { ScrollView, LineEdit, Button, Switch } from "std-widgets.slint";
import { AppData, AppLogic, EmpleadoData } from "models.slint";
import { HistorialEmpleadoModal } from "historial_empleado_modal.slint";
import { FormField, FormErrorBanner, LeyendaObligatorios } from "form_field.slint";

export component EmpleadosView inherits Rectangle {
    background: #f8fafc;

    // Columnas opcionales de la tabla según el ancho disponible. Sin esto, con el panel lateral
    // abierto la tabla no cabe en 1366px y empuja el panel fuera de la ventana. Umbrales = ancho
    // mínimo de la tabla con esas columnas (columnas + separaciones de 16px + 32px de padding de la
    // tabla + 32px de padding de la fila, reservando 220px al nombre); se ocultan en este orden y
    // la de CURP & NSS al final. Por debajo del último umbral el nombre cede hasta 150px (su
    // min-width), lo que deja ver el panel completo hasta 1024px de ventana.
    // La vista tiene min-width: 0 en main_view y los encabezados van en un Flickable, así que
    // root.width no depende de estas columnas (sin ciclo de enlaces).
    property <length> ancho-tabla: root.width - 48px - (AppData.show_edit_empleado_panel ? 400px : 0px);
    property <bool> col-ultima-obra: ancho-tabla >= 1306px;
    property <bool> col-sbc: ancho-tabla >= 1170px;
    property <bool> col-reg-patronal: ancho-tabla >= 1044px;
    property <bool> col-obras: ancho-tabla >= 898px;
    property <bool> col-curp: ancho-tabla >= 802px;

    VerticalLayout {
        padding: 24px;
        spacing: 18px;

        // Header Superior: Título, Breadcrumb de Cliente y Botón Nuevo
        HorizontalLayout {
            alignment: space-between;

            VerticalLayout {
                spacing: 4px;
                HorizontalLayout {
                    spacing: 10px;
                    alignment: center;

                    Text {
                        text: "Padrón de Empleados";
                        font-size: 22px;
                        font-weight: 800;
                        color: #0f172a;
                    }

                    Rectangle {
                        height: 24px;
                        border-radius: 4px;
                        background: #eff6ff;
                        border-width: 1px;
                        border-color: #bfdbfe;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: AppData.selected_cliente_nombre != "" ? AppData.selected_cliente_nombre : "Cliente";
                                font-size: 12px;
                                font-weight: 700;
                                color: #1d4ed8;
                                vertical-alignment: center;
                            }
                        }
                    }

                    if AppData.selected_cliente_rfc != "" : Rectangle {
                        height: 24px;
                        border-radius: 4px;
                        background: #f1f5f9;
                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            Text {
                                text: "RFC: " + AppData.selected_cliente_rfc;
                                font-size: 11px;
                                font-weight: 700;
                                color: #475569;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
                Text {
                    text: "Control de trabajadores registrados, números de seguridad social (NSS), RFC, CURP y estatus laboral activo.";
                    font-size: 12px;
                    color: #64748b;
                }
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: end;

                // Botón Posibles duplicados (revisión y fusión)
                Rectangle {
                    height: 38px;
                    border-radius: 8px;
                    background: btn_dup_emp.has-hover ? #fef3c7 : #ffffff;
                    border-width: 1px;
                    border-color: #fcd34d;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 6px;
                        alignment: center;
                        Image { source: @image-url("assets/icons/users.svg"); colorize: #b45309; width: 14px; height: 14px; y: (parent.height - self.height) / 2; }
                        Text {
                            text: "Posibles duplicados";
                            font-size: 12px;
                            font-weight: 700;
                            color: #92400e;
                            vertical-alignment: center;
                        }
                    }

                    btn_dup_emp := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppLogic.duplicados_abrir(""); }
                    }
                }

                // Botón Registrar Empleado
                Rectangle {
                    height: 38px;
                    border-radius: 8px;
                    background: btn_new_emp.has-hover ? #1e40af : #1e3a8a;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        alignment: center;

                        Text {
                            text: "+ Registrar Empleado";
                            font-size: 12px;
                            font-weight: 700;
                            color: #ffffff;
                            vertical-alignment: center;
                        }
                    }

                    btn_new_emp := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppLogic.open_new_empleado_dialog(); }
                    }
                }
            }
        }

        // Barra de Filtros y Búsqueda
        Rectangle {
            height: 52px;
            border-radius: 10px;
            background: #ffffff;
            border-width: 1px;
            border-color: #e2e8f0;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: space-between;

                // Buscador de Empleados
                HorizontalLayout {
                    spacing: 10px;
                    alignment: center;
                    Text { text: "🔍"; font-size: 13px; vertical-alignment: center; }
                    LineEdit {
                        width: 320px;
                        text <=> AppData.empleados_search;
                        placeholder-text: "Buscar por Nombre, RFC, CURP o NSS...";
                        edited => { AppLogic.filter_empleados_search(); }
                    }
                }

                // Filtro: Solo Activos
                HorizontalLayout {
                    spacing: 12px;
                    alignment: center;

                    Rectangle {
                        height: 32px;
                        border-radius: 6px;
                        background: AppData.empleados_filter_active_only ? #ecfdf5 : #f8fafc;
                        border-width: 1px;
                        border-color: AppData.empleados_filter_active_only ? #a7f3d0 : #cbd5e1;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            alignment: center;

                            Text {
                                text: AppData.empleados_filter_active_only ? "✓" : "○";
                                font-size: 11px;
                                font-weight: 800;
                                color: AppData.empleados_filter_active_only ? #059669 : #64748b;
                            }
                            Text {
                                text: "Solo Empleados Activos";
                                font-size: 11px;
                                font-weight: 700;
                                color: AppData.empleados_filter_active_only ? #065f46 : #475569;
                                vertical-alignment: center;
                            }
                        }

                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.toggle_empleados_filter_active(); }
                        }
                    }

                    // D-8: filtros por estado laboral y obras actuales
                    HorizontalLayout {
                        spacing: 4px;
                        alignment: center;

                        for etiqueta[idx] in ["Todos", "Dados de baja", "Sin obra actual", "Con 2+ obras"] : Rectangle {
                            height: 32px;
                            border-radius: 6px;
                            background: AppData.empleados_filtro == idx ? #1e3a8a : #f8fafc;
                            border-width: 1px;
                            border-color: AppData.empleados_filtro == idx ? #1e3a8a : #cbd5e1;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                alignment: center;
                                Text {
                                    text: etiqueta;
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: AppData.empleados_filtro == idx ? #ffffff : #475569;
                                    vertical-alignment: center;
                                }
                            }

                            TouchArea {
                                mouse-cursor: pointer;
                                clicked => { AppLogic.empleados_cambiar_filtro(idx); }
                            }
                        }
                    }

                    Text {
                        text: AppData.empleados_list.length + " Registros mostrados";
                        font-size: 11px;
                        font-weight: 600;
                        color: #64748b;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // Layout de Tabla de Empleados y Panel Lateral de Edición
        HorizontalLayout {
            spacing: 20px;
            vertical-stretch: 1;

            // Tabla / Listado de Empleados
            Rectangle {
                horizontal-stretch: 1;
                border-radius: 12px;
                background: #ffffff;
                border-width: 1px;
                border-color: #e2e8f0;
                clip: true;

                VerticalLayout {
                    padding: 16px;
                    spacing: 10px;

                    // Encabezados de Columna. Van dentro de un Flickable fijo (igual que las filas
                    // dentro del ScrollView) para que su ancho mínimo no se propague a la vista: las
                    // columnas visibles dependen de root.width y propagarlo formaría un ciclo.
                    Flickable {
                        height: 38px;
                        interactive: false;
                        content-width: self.width;
                        content-height: self.height;

                        Rectangle {
                            width: parent.width;
                            height: 38px;
                            background: #f8fafc;
                            border-radius: 6px;

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 16px;

                                Rectangle { horizontal-stretch: 1; min-width: 150px; Text { text: "EMPLEADO / RFC"; font-size: 11px; font-weight: 800; color: #475569; vertical-alignment: center; } }
                                if root.col-curp : Rectangle { width: 170px; Text { text: "CURP & NSS"; font-size: 11px; font-weight: 800; color: #475569; vertical-alignment: center; } }
                                if root.col-reg-patronal : Rectangle { width: 130px; Text { text: "REG. PATRONAL"; font-size: 11px; font-weight: 800; color: #475569; vertical-alignment: center; } }
                                if root.col-sbc : Rectangle { width: 110px; Text { text: "SBC DIARIO"; font-size: 11px; font-weight: 800; color: #475569; vertical-alignment: center; } }
                                Rectangle { width: 130px; Text { text: "ESTADO"; font-size: 11px; font-weight: 800; color: #475569; horizontal-alignment: center; vertical-alignment: center; } }
                                if root.col-obras : Rectangle { width: 80px; Text { text: "OBRAS ACT."; font-size: 11px; font-weight: 800; color: #475569; horizontal-alignment: center; vertical-alignment: center; } }
                                if root.col-ultima-obra : Rectangle { width: 120px; Text { text: "ÚLTIMA OBRA"; font-size: 11px; font-weight: 800; color: #475569; vertical-alignment: center; } }
                                Rectangle { width: 170px; Text { text: "ACCIÓN"; font-size: 11px; font-weight: 800; color: #475569; horizontal-alignment: center; vertical-alignment: center; } }
                            }
                        }
                    }

                    // Filas de Empleados
                    ScrollView {
                        content-width: self.width;
                        vertical-stretch: 1;

                        VerticalLayout {
                            spacing: 8px;
                            padding-bottom: 12px;

                            if AppData.empleados_list.length == 0 : Rectangle {
                                height: 160px;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 6px;
                                    Text { text: "👥"; font-size: 26px; horizontal-alignment: center; }
                                    Text {
                                        text: "No se encontraron empleados registrados";
                                        font-size: 14px;
                                        font-weight: 700;
                                        color: #0f172a;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "Cargue nóminas CFDI / cédulas SUA o registre un empleado manualmente.";
                                        font-size: 11px;
                                        color: #64748b;
                                        horizontal-alignment: center;
                                    }
                                }
                            }

                            for emp in AppData.empleados_list : Rectangle {
                                height: 58px;
                                border-radius: 8px;
                                background: #ffffff;
                                border-width: 1px;
                                border-color: #f1f5f9;

                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    spacing: 16px;

                                    // Columna 1: Nombre & RFC con Avatar de Iniciales
                                    Rectangle {
                                        horizontal-stretch: 1;
                                        min-width: 150px;

                                        HorizontalLayout {
                                            spacing: 12px;
                                            alignment: start;

                                            Rectangle {
                                                width: 36px;
                                                height: 36px;
                                                border-radius: 18px;
                                                background: #1e3a8a;
                                                y: (parent.height - self.height) / 2;

                                                Text {
                                                    text: "👤";
                                                    font-size: 14px;
                                                    color: #ffffff;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            VerticalLayout {
                                                alignment: center;
                                                spacing: 2px;
                                                HorizontalLayout {
                                                    spacing: 6px;
                                                    cross-axis-alignment: center;
                                                    Text {
                                                        text: emp.nombre;
                                                        font-size: 12.5px;
                                                        font-weight: 700;
                                                        color: #0f172a;
                                                        overflow: elide;
                                                    }
                                                    if emp.pensionado != "": Rectangle {
                                                        height: 16px;
                                                        border-radius: 3px;
                                                        background: #fef3c7;
                                                        border-width: 1px;
                                                        border-color: #f59e0b;
                                                        HorizontalLayout {
                                                            padding-left: 4px;
                                                            padding-right: 4px;
                                                            cross-axis-alignment: center;
                                                            Text {
                                                                text: emp.pensionado;
                                                                font-size: 9.5px;
                                                                font-weight: 700;
                                                                color: #b45309;
                                                            }
                                                        }
                                                    }
                                                }
                                                Text {
                                                    text: emp.rfc != "" ? ("RFC: " + emp.rfc) : "Sin RFC";
                                                    font-size: 10.5px;
                                                    font-weight: 600;
                                                    color: #64748b;
                                                    overflow: elide;
                                                }
                                            }
                                        }
                                    }

                                    // Columna 2: CURP & NSS
                                    if root.col-curp : Rectangle {
                                        width: 170px;
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;
                                            Text {
                                                text: emp.curp != "" ? emp.curp : "Sin CURP";
                                                font-size: 11.5px;
                                                font-weight: 700;
                                                color: #1e293b;
                                                overflow: elide;
                                            }
                                            Text {
                                                text: emp.nss != "" ? ("NSS: " + emp.nss) : "Sin NSS";
                                                font-size: 10.5px;
                                                font-weight: 600;
                                                color: #64748b;
                                                overflow: elide;
                                            }
                                        }
                                    }

                                    // Columna 3: Registro Patronal
                                    if root.col-reg-patronal : Rectangle {
                                        width: 130px;
                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: emp.registro_patronal != "" ? emp.registro_patronal : "General";
                                                font-size: 12px;
                                                font-weight: 700;
                                                color: #1d4ed8;
                                                overflow: elide;
                                            }
                                        }
                                    }

                                    // Columna 4: SBC Diario
                                    if root.col-sbc : Rectangle {
                                        width: 110px;
                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: emp.sbc_diario_str;
                                                font-size: 12.5px;
                                                font-weight: 700;
                                                color: #0f172a;
                                                overflow: elide;
                                            }
                                        }
                                    }

                                    // Columna 5: Estado laboral derivado de la cédula (D-8)
                                    Rectangle {
                                        width: 130px;
                                        VerticalLayout {
                                            alignment: center;
                                            spacing: 2px;

                                            HorizontalLayout {
                                                alignment: center;
                                                Rectangle {
                                                    height: 24px;
                                                    width: 124px;
                                                    border-radius: 12px;
                                                    background: emp.estado_es_baja ? #fef2f2 : #ecfdf5;
                                                    border-width: 1px;
                                                    border-color: emp.estado_es_baja ? #fecaca : #a7f3d0;

                                                    HorizontalLayout {
                                                        alignment: center;
                                                        spacing: 5px;
                                                        padding-left: 8px;
                                                        padding-right: 8px;
                                                        Rectangle {
                                                            width: 6px;
                                                            height: 6px;
                                                            border-radius: 3px;
                                                            background: emp.estado_es_baja ? #dc2626 : #059669;
                                                            y: (parent.height - self.height) / 2;
                                                        }
                                                        Text {
                                                            text: emp.estado_texto;
                                                            font-size: 10.5px;
                                                            font-weight: 700;
                                                            color: emp.estado_es_baja ? #991b1b : #065f46;
                                                            overflow: elide;
                                                            vertical-alignment: center;
                                                        }
                                                    }
                                                }
                                            }

                                            // Marcador: estado fijado a mano por el analista
                                            if emp.estado_manual : Text {
                                                text: "✎ manual";
                                                font-size: 9px;
                                                font-weight: 700;
                                                color: #64748b;
                                                horizontal-alignment: center;
                                            }
                                        }
                                    }

                                    // Columna 6: Obras actuales (obras con días en el último mes)
                                    if root.col-obras : Rectangle {
                                        width: 80px;
                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: emp.obras_actuales;
                                                font-size: 12.5px;
                                                font-weight: 700;
                                                color: emp.obras_actuales == 0 ? #94a3b8 : #0f172a;
                                                horizontal-alignment: center;
                                            }
                                        }
                                    }

                                    // Columna 7: Última obra
                                    if root.col-ultima-obra : Rectangle {
                                        width: 120px;
                                        VerticalLayout {
                                            alignment: center;
                                            Text {
                                                text: emp.ultima_obra != "" ? emp.ultima_obra : "—";
                                                font-size: 11.5px;
                                                font-weight: 700;
                                                color: #1e293b;
                                                overflow: elide;
                                            }
                                        }
                                    }

                                    // Columna 8: Acciones (Historial / Editar)
                                    Rectangle {
                                        width: 170px;
                                        HorizontalLayout {
                                            alignment: center;
                                            spacing: 6px;

                                            Rectangle {
                                                width: 80px;
                                                height: 28px;
                                                border-radius: 6px;
                                                background: hist_emp_btn.has-hover ? #f0fdf4 : #ffffff;
                                                border-width: 1px;
                                                border-color: #a7f3d0;
                                                y: (parent.height - self.height) / 2;

                                                HorizontalLayout {
                                                    alignment: center;
                                                    Text {
                                                        text: "Historial";
                                                        font-size: 11px;
                                                        font-weight: 700;
                                                        color: #047857;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                hist_emp_btn := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { AppLogic.historial_empleado_abrir(emp.id, emp.nombre); }
                                                }
                                            }

                                            Rectangle {
                                                width: 80px;
                                                height: 28px;
                                                border-radius: 6px;
                                                background: edit_emp_btn.has-hover ? #eff6ff : #ffffff;
                                                border-width: 1px;
                                                border-color: #bfdbfe;
                                                y: (parent.height - self.height) / 2;

                                                HorizontalLayout {
                                                    alignment: center;
                                                    spacing: 4px;
                                                    Text { text: "✏"; font-size: 10px; vertical-alignment: center; }
                                                    Text {
                                                        text: "Editar";
                                                        font-size: 11px;
                                                        font-weight: 700;
                                                        color: #1d4ed8;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                edit_emp_btn := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => { AppLogic.select_empleado_for_edit(emp.id); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Panel Lateral de Edición / Alta de Empleado (Aparece al seleccionar o crear)
            if AppData.show_edit_empleado_panel : Rectangle {
                width: 380px;
                border-radius: 12px;
                background: #ffffff;
                border-width: 1px;
                border-color: #cbd5e1;

                ScrollView {
                    content-width: self.width;
                    VerticalLayout {
                        padding: 20px;
                        spacing: 16px;

                        // Header del Panel
                        HorizontalLayout {
                            alignment: space-between;
                            VerticalLayout {
                                spacing: 2px;
                                Text {
                                    text: AppData.emp_edit_is_new ? "Nuevo Empleado" : "Edición de Empleado";
                                    font-size: 16px;
                                    font-weight: 800;
                                    color: #0f172a;
                                }
                                Text {
                                    text: "Actualizar datos patronales y RFC/CURP";
                                    font-size: 11px;
                                    color: #64748b;
                                }
                            }

                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 14px;
                                background: close_emp_panel.has-hover ? #fee2e2 : transparent;
                                Text {
                                    text: "✕";
                                    font-size: 13px;
                                    font-weight: 700;
                                    color: close_emp_panel.has-hover ? #dc2626 : #64748b;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                close_emp_panel := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { AppLogic.close_edit_empleado_panel(); }
                                }
                            }
                        }

                        Rectangle { height: 1px; background: #f1f5f9; }

                        VerticalLayout {
                            spacing: 2px;
                            LeyendaObligatorios { }
                            Text {
                                text: "RFC, NSS y CURP son opcionales, pero se requiere al menos uno.";
                                font-size: 10px;
                                color: #64748b;
                                wrap: word-wrap;
                            }
                        }
                        FormErrorBanner { }

                        // 1. Nombre Completo
                        FormField {
                            label: "Nombre Completo del Empleado";
                            label-size: 11px;
                            campo: "nombre";
                            required: true;
                            LineEdit {
                                text <=> AppData.emp_edit_nombre;
                                placeholder-text: "Ej. JUAN PÉREZ GONZÁLEZ";
                                edited => { AppLogic.limpiar_error_campo("nombre"); }
                            }
                        }

                        // 2. RFC
                        FormField {
                            label: "RFC SAT (13 posiciones, persona física)";
                            label-size: 11px;
                            campo: "rfc";
                            error-vivo: AppData.emp_edit_rfc_status == "invalid" ? AppData.emp_edit_rfc_msg : "";
                            ayuda: AppData.emp_edit_rfc_status == "valid" ? AppData.emp_edit_rfc_msg : "";
                            LineEdit {
                                text <=> AppData.emp_edit_rfc;
                                placeholder-text: "Ej. PEGJ800101XYZ";
                                edited => {
                                    AppLogic.limpiar_error_campo("rfc");
                                    AppLogic.validate_empleado_input();
                                }
                            }
                        }

                        // 3. NSS
                        FormField {
                            label: "NSS IMSS (11 dígitos)";
                            label-size: 11px;
                            campo: "nss";
                            error-vivo: AppData.emp_edit_nss_status == "invalid" ? AppData.emp_edit_nss_msg : "";
                            ayuda: AppData.emp_edit_nss_status == "valid" ? AppData.emp_edit_nss_msg : "";
                            LineEdit {
                                text <=> AppData.emp_edit_nss;
                                placeholder-text: "Ej. 12345678901";
                                edited => {
                                    AppLogic.limpiar_error_campo("nss");
                                    AppLogic.validate_empleado_input();
                                }
                            }
                        }

                        // 3b. NSS alternos: cédulas/nóminas con estos NSS se cargan a este empleado
                        if !AppData.emp_edit_is_new : VerticalLayout {
                            spacing: 6px;
                            Text { text: "NSS alternos (equivalencias)"; font-size: 11px; font-weight: 700; color: #475569; }
                            Text {
                                text: "Las cédulas y nóminas que traigan estos NSS se asignan a este empleado en lugar de crear uno nuevo.";
                                font-size: 10px;
                                color: #64748b;
                                wrap: word-wrap;
                            }

                            if AppData.emp_equivalencias.length == 0 : Text {
                                text: "Sin NSS alternos";
                                font-size: 10.5px;
                                font-weight: 600;
                                color: #94a3b8;
                            }

                            for eq in AppData.emp_equivalencias : Rectangle {
                                border-radius: 6px;
                                background: #f8fafc;
                                border-width: 1px;
                                border-color: #e2e8f0;
                                HorizontalLayout {
                                    padding: 6px;
                                    spacing: 8px;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 1px;
                                        Text { text: eq.nss; font-size: 12px; font-weight: 800; color: #0f172a; }
                                        Text {
                                            text: (eq.motivo != "" ? eq.motivo + " · " : "") + eq.creada;
                                            font-size: 10px;
                                            color: #64748b;
                                            wrap: word-wrap;
                                        }
                                    }
                                    Rectangle {
                                        width: 56px;
                                        height: 24px;
                                        border-radius: 6px;
                                        background: quitar_eq.has-hover ? #fee2e2 : #ffffff;
                                        border-width: 1px;
                                        border-color: #fecaca;
                                        y: (parent.height - self.height) / 2;
                                        Text {
                                            text: "Quitar";
                                            font-size: 10.5px;
                                            font-weight: 700;
                                            color: #b91c1c;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                        quitar_eq := TouchArea {
                                            mouse-cursor: pointer;
                                            enabled: !AppData.emp_equiv_ocupado;
                                            clicked => { AppLogic.equivalencia_nss_eliminar(eq.id); }
                                        }
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 6px;
                                LineEdit {
                                    horizontal-stretch: 1;
                                    text <=> AppData.emp_equiv_nuevo_nss;
                                    placeholder-text: "NSS alterno (11 dígitos)";
                                    enabled: !AppData.emp_equiv_ocupado;
                                    accepted => { AppLogic.equivalencia_nss_agregar(); }
                                }
                                Button {
                                    text: "Agregar";
                                    enabled: !AppData.emp_equiv_ocupado && AppData.emp_equiv_nuevo_nss != "";
                                    clicked => { AppLogic.equivalencia_nss_agregar(); }
                                }
                            }
                            LineEdit {
                                text <=> AppData.emp_equiv_nuevo_motivo;
                                placeholder-text: "Motivo (opcional)";
                                enabled: !AppData.emp_equiv_ocupado;
                                accepted => { AppLogic.equivalencia_nss_agregar(); }
                            }
                            if AppData.emp_equiv_msg != "" : Text {
                                text: AppData.emp_equiv_msg;
                                font-size: 10px;
                                font-weight: 600;
                                color: AppData.emp_equiv_msg_error ? #dc2626 : #16a34a;
                                wrap: word-wrap;
                            }
                        }

                        // 4. CURP
                        FormField {
                            label: "CURP RENAPO (18 posiciones)";
                            label-size: 11px;
                            campo: "curp";
                            error-vivo: AppData.emp_edit_curp_status == "invalid" ? AppData.emp_edit_curp_msg : "";
                            ayuda: AppData.emp_edit_curp_status == "valid" ? AppData.emp_edit_curp_msg : "";
                            LineEdit {
                                text <=> AppData.emp_edit_curp;
                                placeholder-text: "Ej. PEGJ800101HDFRRN01";
                                edited => {
                                    AppLogic.limpiar_error_campo("curp");
                                    AppLogic.validate_empleado_input();
                                }
                            }
                        }

                        // Banner de alerta por inconsistencia cruzada (ej. NSS año nacimiento != CURP o RFC)
                        if AppData.emp_edit_cross_warning != "" : Rectangle {
                            border-radius: 6px;
                            background: #fef2f2;
                            border-width: 1px;
                            border-color: #fecaca;
                            HorizontalLayout {
                                padding: 8px;
                                spacing: 6px;
                                Text { text: "⚠"; font-size: 12px; color: #b91c1c; }
                                Text {
                                    text: AppData.emp_edit_cross_warning;
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: #991b1b;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        // 5. Toggle Switch: esta_activo
                        Rectangle {
                            height: 48px;
                            border-radius: 8px;
                            background: #f8fafc;
                            border-width: 1px;
                            border-color: #e2e8f0;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                alignment: space-between;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 1px;
                                    Text {
                                        text: "Empleado Activo en Obra / Nómina";
                                        font-size: 11px;
                                        font-weight: 700;
                                        color: #0f172a;
                                    }
                                    Text {
                                        text: "Incluye aportaciones en cédula SUA y obra activa.";
                                        font-size: 9px;
                                        color: #64748b;
                                    }
                                }

                                Switch {
                                    checked <=> AppData.emp_edit_esta_activo;
                                }
                            }
                        }

                        // Botones Cancelar / Actualizar
                        HorizontalLayout {
                            spacing: 12px;
                            padding-top: 8px;

                            Button {
                                text: "Cancelar";
                                clicked => { AppLogic.close_edit_empleado_panel(); }
                            }

                            Rectangle {
                                height: 38px;
                                border-radius: 6px;
                                background: emp_submit_ta.has-hover ? #1e40af : #1e3a8a;
                                horizontal-stretch: 1;

                                HorizontalLayout {
                                    alignment: center;
                                    Text {
                                        text: AppData.emp_edit_is_new ? "Registrar Empleado" : "Actualizar Empleado";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: #ffffff;
                                        vertical-alignment: center;
                                    }
                                }

                                emp_submit_ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        AppLogic.submit_edit_empleado(
                                            AppData.emp_edit_id,
                                            AppData.selected_cliente_id,
                                            AppData.emp_edit_nombre,
                                            AppData.emp_edit_rfc,
                                            AppData.emp_edit_curp,
                                            AppData.emp_edit_nss,
                                            AppData.emp_edit_esta_activo
                                        );
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Histórico empleado × obra (D-10 b)
    if AppData.show_historial_empleado : HistorialEmpleadoModal { }
}
