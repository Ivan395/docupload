import { AppData } from "models.slint";

export component BottomBar inherits Rectangle {
    height: 38px;
    background: #ffffff;
    border-width: 1px;
    border-color: #e2e8f0;

    // Ancho rastreado por evento (evita binding loop al decidir el layout con root.width)
    // Por debajo de 1150px las etiquetas de los contadores se abrevian (Cli:, RP:, Rev:, Obras:, Emp:)
    property <length> ancho_barra: 1200px;
    changed width => {
        root.ancho_barra = root.width;
    }
    init => {
        root.ancho_barra = root.width;
    }

    HorizontalLayout {
        padding-left: 20px;
        padding-right: 20px;
        alignment: space-between;

        // Bloque izquierdo: motor y latencia; no se encoge por debajo de su contenido natural
        HorizontalLayout {
            spacing: 16px;
            alignment: start;
            horizontal-stretch: 0;
            min-width: 0px;

            // Motor
            HorizontalLayout {
                spacing: 6px;
                alignment: center;
                cross-axis-alignment: center;
                horizontal-stretch: 0;
                Image { source: @image-url("assets/icons/database.svg"); colorize: #475569; width: 14px; height: 14px; }
                Text {
                    text: "Motor: PostgreSQL (Pool R2D2 Concurrente)";
                    font-size: 12px;
                    color: #475569;
                    vertical-alignment: center;
                    overflow: elide;
                    min-width: 0px;
                }
            }

            // Latencia
            HorizontalLayout {
                spacing: 6px;
                alignment: center;
                horizontal-stretch: 0;
                Text {
                    text: "Latencia: 5ms";
                    font-size: 12px;
                    color: #475569;
                    vertical-alignment: center;
                    overflow: elide;
                    min-width: 0px;
                }
            }
        }

        // Bloque derecho: contadores y catálogos; se encoge con elipsis antes de montarse sobre el bloque izquierdo
        HorizontalLayout {
            spacing: 16px;
            alignment: end;
            horizontal-stretch: 1;
            min-width: 0px;

            // Clientes
            HorizontalLayout {
                spacing: 6px;
                alignment: center;
                horizontal-stretch: 0;
                if root.ancho_barra >= 1150px : Text {
                    text: "Clientes:";
                    font-size: 12px;
                    color: #64748b;
                    vertical-alignment: center;
                    overflow: elide;
                    min-width: 0px;
                }
                if root.ancho_barra < 1150px : Text {
                    text: "Cli:";
                    font-size: 12px;
                    color: #64748b;
                    vertical-alignment: center;
                    overflow: elide;
                    min-width: 0px;
                }
                Text {
                    text: AppData.total_clientes_count;
                    font-size: 12px;
                    font-weight: 800;
                    color: #0f172a;
                    vertical-alignment: center;
                    min-width: 0px;
                }
            }

            // Reg. Patronales
            HorizontalLayout {
                spacing: 6px;
                alignment: center;
                horizontal-stretch: 0;
                if root.ancho_barra >= 1150px : Text {
                    text: "Reg. Patronales:";
                    font-size: 12px;
                    color: #64748b;
                    vertical-alignment: center;
                    overflow: elide;
                    min-width: 0px;
                }
                if root.ancho_barra < 1150px : Text {
                    text: "RP:";
                    font-size: 12px;
                    color: #64748b;
                    vertical-alignment: center;
                    overflow: elide;
                    min-width: 0px;
                }
                Text {
                    text: AppData.total_rp_count;
                    font-size: 12px;
                    font-weight: 800;
                    color: #0f172a;
                    vertical-alignment: center;
                    min-width: 0px;
                }
            }

            // Revisiones
            HorizontalLayout {
                spacing: 6px;
                alignment: center;
                horizontal-stretch: 0;
                if root.ancho_barra >= 1150px : Text {
                    text: "Revisiones:";
                    font-size: 12px;
                    color: #64748b;
                    vertical-alignment: center;
                    overflow: elide;
                    min-width: 0px;
                }
                if root.ancho_barra < 1150px : Text {
                    text: "Rev:";
                    font-size: 12px;
                    color: #64748b;
                    vertical-alignment: center;
                    overflow: elide;
                    min-width: 0px;
                }
                Text {
                    text: AppData.total_revisiones_count;
                    font-size: 12px;
                    font-weight: 800;
                    color: #0f172a;
                    vertical-alignment: center;
                    min-width: 0px;
                }
            }

            // Obras
            HorizontalLayout {
                spacing: 6px;
                alignment: center;
                horizontal-stretch: 0;
                if root.ancho_barra >= 1150px : Text {
                    text: "Obras:";
                    font-size: 12px;
                    color: #64748b;
                    vertical-alignment: center;
                    overflow: elide;
                    min-width: 0px;
                }
                if root.ancho_barra < 1150px : Text {
                    text: "Obras:";
                    font-size: 12px;
                    color: #64748b;
                    vertical-alignment: center;
                    overflow: elide;
                    min-width: 0px;
                }
                Text {
                    text: AppData.total_obras_count;
                    font-size: 12px;
                    font-weight: 800;
                    color: #0f172a;
                    vertical-alignment: center;
                    min-width: 0px;
                }
            }

            // Empleados Activos
            HorizontalLayout {
                spacing: 6px;
                alignment: center;
                horizontal-stretch: 0;
                if root.ancho_barra >= 1150px : Text {
                    text: "Empleados Activos:";
                    font-size: 12px;
                    color: #64748b;
                    vertical-alignment: center;
                    overflow: elide;
                    min-width: 0px;
                }
                if root.ancho_barra < 1150px : Text {
                    text: "Emp:";
                    font-size: 12px;
                    color: #64748b;
                    vertical-alignment: center;
                    overflow: elide;
                    min-width: 0px;
                }
                Text {
                    text: AppData.total_empleados_activos_count;
                    font-size: 12px;
                    font-weight: 800;
                    color: #059669;
                    vertical-alignment: center;
                    min-width: 0px;
                }
            }

            // Catálogos
            HorizontalLayout {
                spacing: 6px;
                alignment: center;
                horizontal-stretch: 0;
                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: #10b981;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: "Catálogos Cargados (" + AppData.catalogos_loaded_str + ")";
                    font-size: 12px;
                    font-weight: 600;
                    color: #065f46;
                    vertical-alignment: center;
                    overflow: elide;
                    min-width: 0px;
                }
            }
        }
    }
}
