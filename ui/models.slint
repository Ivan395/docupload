    in-out property <bool> nominas_only_sin_cedula: false;
    in-out property <bool> nominas_mostrar_detalle: true;
    // Paginación
    in-out property <int> nominas_page_current: 0;
    in-out property <int> nominas_page_total: 0;
    in-out property <int> nominas_page_start_row: 0;
    in-out property <int> nominas_page_end_row: 0;
    in-out property <int> nominas_total_filtered: 0;

    // Panel de percepciones de la fila seleccionada
    in-out property <bool> nominas_show_percepciones: false;
    in-out property <string> nominas_percepciones_empleado: "";
    in-out property <string> nominas_percepciones_periodo: "";
    in-out property <string> nominas_percepciones_total_str: "$0.00";
}

