// ─── NÓMINAS ────────────────────────────────────────────────────────────────
// Una fila por nómina (trabajador + periodo). El total de días del trabajador
// viaja desglosado por mes para poder contrastarlo contra la cédula sin abrir
// otra vista.

export struct NominaEmpleadoDiaItem {
    periodo: string,
    anio: int,
    dias_nomina: string,
    dias_cedula: string,
    delta_str: string,
    coincide: bool,
}

export struct NominaPercepcionItem {
    clave: string,
    concepto: string,
    tipo_sat: string,
    importe_str: string,
    gravado_str: string,
    exento_str: string,
}

export struct NominaRow {
    idx: int,
    id_nomina: string,
    id_empleado: string,
    nombre_trabajador: string,
    nss: string,
    rfc_curp: string,
    registro_patronal: string,

    periodo_str: string,
    semana_fiscal: int,
    semana_fiscal_str: string,

    // Todas las fechas de pago del CFDI
    fecha_inicial_pago_str: string,
    fecha_final_pago_str: string,
    fecha_pago_str: string,
    fecha_inicio_rel_str: string,
    fecha_emision_str: string,
    fecha_timbrado_str: string,

    // Días: nómina vs cédula del mismo periodo
    num_dias_pagados_str: string,
    dias_cedula_str: string,
    dias_delta_str: string,
    dias_coinciden: bool,
    sin_cedula: bool,

    // Percepciones (sin deducciones)
    total_percepciones_str: string,
    total_gravado_str: string,
    total_exento_str: string,
    num_percepciones: int,
    percepcion_detalle_str: string,

    salario_diario_str: string,
    tipo_nomina: string,
    periodicidad: string,

    // Total de días del trabajador, desglosado por mes
    total_dias_empleado: string,
    total_dias_meses: int,
    meses: [NominaEmpleadoDiaItem],

    // Montos por concepto de percepción (columnas dinámicas),
    // alineados con AppData.nominas_percepcion_headers
    percepciones_cols: [string],

    row_bg_color: color,
    row_hover_color: color,
}

export struct NominaMesTotalItem {
    periodo: string,
    nominas: int,
    dias_pagados_str: string,
    dias_cedula_str: string,
    percepciones_str: string,
}

export struct EmpleadoMesStatsRow {
    nombre: string,
    nss: string,
    dias_pagados: string,
    total_percepciones: string,
    dias_cedula: string,
}

export struct MesStatsRow {
    mes: string,
    anio: int,
    total_nominas: int,
    empleados_unicos: int,
    dias_pagados: string,
    dias_cedula: string,
    total_percepciones: string,
    nominas_sin_cedula: int,
    // Empleados en este mes
    empleados: [EmpleadoMesStatsRow],
}

