export global AppData {
    // Vista actual: 0: Auditoría/Carga, 1: Clientes, 2: Registros Patronales, 3: Empleados
    in-out property <int> current_view: 1;

    // Navegación contextual
    in-out property <string> selected_cliente_id: "";
    in-out property <string> selected_cliente_nombre: "Todos los Clientes";
    in-out property <string> selected_cliente_rfc: "";
    in-out property <bool> selected_cliente_has_data: false;

    // Listados principales
    in-out property <[ClienteCardData]> clientes_list: [];
    in-out property <[RegistroPatronalData]> registros_patronales_list: [];
    in-out property <[EmpleadoData]> empleados_list: [];

    // Filtros de búsqueda
    in-out property <string> clientes_search: "";
    in-out property <int> clientes_filter_tab: 0; // 0: Todos, 1: Con Cédulas, 2: Nuevos / En espera
    in-out property <string> rp_search: "";
    in-out property <string> empleados_search: "";
    in-out property <bool> empleados_filter_active_only: false;

    // Estadísticas globales para Barra Inferior
    in-out property <int> total_clientes_count: 0;
    in-out property <int> total_rp_count: 0;
    in-out property <int> total_empleados_activos_count: 0;
    in-out property <string> catalogos_loaded_str: "100% (9 Catálogos)";

    // Catálogos para Combos
    in-out property <[string]> tipos_personas_combo: ["-- Seleccionar Tipo Persona --", "FÍSICA", "MORAL"];
    in-out property <[string]> regimenes_fiscales_combo: ["-- Seleccione primero Tipo Persona --"];
    in-out property <[string]> clases_combo: ["-- Seleccionar Clase --", "I", "II", "III", "IV", "V"];
    in-out property <[string]> fracciones_combo: ["-- Seleccione primero Clase --"];

    // Modal: Nuevo Cliente
    in-out property <bool> show_new_cliente_modal: false;
    in-out property <string> new_cliente_nombre: "";
    in-out property <string> new_cliente_rfc: "";
    in-out property <string> new_cliente_razon_social: "";
    in-out property <string> new_cliente_curp: "";
    in-out property <string> new_cliente_tipo_persona_val: "-- Seleccionar Tipo Persona --";
    in-out property <string> new_cliente_regimen_val: "-- Seleccione primero Tipo Persona --";
    in-out property <bool> new_cliente_regimen_enabled: false;
    in-out property <[string]> new_cliente_regimenes_combo: ["-- Seleccione primero Tipo Persona --"];
    in-out property <string> new_cliente_rfc_status: "";
    in-out property <string> new_cliente_rfc_msg: "";
    in-out property <string> new_cliente_curp_status: "";
    in-out property <string> new_cliente_curp_msg: "";

    // Modal: Editar Cliente
    in-out property <bool> show_edit_cliente_modal: false;
    in-out property <string> edit_cliente_id: "";
    in-out property <string> edit_cliente_nombre: "";
    in-out property <string> edit_cliente_razon_social: "";
    in-out property <string> edit_cliente_rfc: "";
    in-out property <string> edit_cliente_curp: "";
    in-out property <string> edit_cliente_tipo_persona_val: "-- Seleccionar Tipo Persona --";
    in-out property <string> edit_cliente_regimen_val: "-- Seleccione primero Tipo Persona --";
    in-out property <bool> edit_cliente_regimen_enabled: false;
    in-out property <bool> edit_cliente_has_data: false;
    in-out property <string> edit_cliente_rfc_status: "";
    in-out property <string> edit_cliente_rfc_msg: "";
    in-out property <string> edit_cliente_curp_status: "";
    in-out property <string> edit_cliente_curp_msg: "";

    // Modal: Eliminar Cliente
    in-out property <bool> show_delete_cliente_modal: false;
    in-out property <string> delete_cliente_id: "";
    in-out property <string> delete_cliente_nombre: "";

    // Formulario: Registro Patronal
    in-out property <string> rp_form_id: "";
    in-out property <bool> rp_form_is_editing: false;
    in-out property <string> rp_form_registro: "";
    in-out property <string> rp_form_registro_status: "";
    in-out property <string> rp_form_registro_msg: "";
    in-out property <string> rp_form_actividad: "";
    changed rp_form_actividad => {
        AppLogic.update_rp_actividad(self.rp_form_actividad);
    }
    in-out property <int> rp_form_char_count: 0;
    in-out property <string> rp_form_domicilio: "";
    in-out property <string> rp_form_codigo_postal: "";
    in-out property <string> rp_form_entidad: "";
    in-out property <string> rp_form_area_geografica: "";
    in-out property <string> rp_form_delegacion: "";
    in-out property <string> rp_form_subdelegacion: "";
    in-out property <string> rp_form_prima_riesgo: "";
    in-out property <string> rp_form_clase_val: "-- Seleccionar Clase --";
    in-out property <string> rp_form_fraccion_val: "-- Seleccione primero Clase --";
    in-out property <bool> rp_form_complementary_enabled: false;
    in-out property <bool> show_rp_modal: false;

    // Modal: Eliminar Registro Patronal
    in-out property <bool> show_delete_rp_modal: false;
    in-out property <string> delete_rp_id: "";
    in-out property <string> delete_rp_registro: "";

    // Panel Lateral: Edición de Empleado
    in-out property <bool> show_edit_empleado_panel: false;
    in-out property <bool> emp_edit_is_new: false;
    in-out property <string> emp_edit_id: "";
    in-out property <string> emp_edit_nombre: "";
    in-out property <string> emp_edit_rfc: "";
    in-out property <string> emp_edit_curp: "";
    in-out property <string> emp_edit_nss: "";
    in-out property <bool> emp_edit_esta_activo: true;
    in-out property <string> emp_edit_sbc: "$0.00";
    in-out property <string> emp_edit_rp: "";
    in-out property <string> emp_edit_rfc_status: "";
    in-out property <string> emp_edit_rfc_msg: "";
    in-out property <string> emp_edit_curp_status: "";
    in-out property <string> emp_edit_curp_msg: "";
    in-out property <string> emp_edit_nss_status: "";
    in-out property <string> emp_edit_nss_msg: "";
    in-out property <string> emp_edit_cross_warning: "";

    // Navegación contextual de Revisiones y Obras
    in-out property <string> selected_rp_id: "";
    in-out property <string> selected_rp_registro: "";
    in-out property <bool> selected_rp_is_valid_structure: true;
    in-out property <string> selected_rp_delegacion: "";
    in-out property <string> selected_rp_subdelegacion: "";
    in-out property <string> selected_revision_id: "";
    in-out property <string> selected_revision_nombre: "";
    in-out property <string> selected_revision_folio: "";

    // Listados de Revisiones y Registros de Obras
    in-out property <[RevisionData]> revisiones_list: [];
    in-out property <[RegistroObraData]> obras_list: [];

    // Filtros de Revisiones y Obras
    in-out property <string> revisiones_search: "";
    in-out property <int> revisiones_filter_tab: 0; // 0: Todos, 1: En Proceso, 2: Aprobadas IMSS, 3: Con Prórroga
    in-out property <string> obras_search: "";
    in-out property <int> obras_filter_tab: 0; // 0: Todas, 1: Privadas, 2: Públicas

    // Contadores para BottomBar y KPIs
    in-out property <int> total_revisiones_count: 0;
    in-out property <int> total_obras_count: 0;
    in-out property <int> revisiones_vigentes_count: 0;
    in-out property <int> revisiones_prorrogas_count: 0;
    in-out property <float> obras_superficie_total: 0.0;
    in-out property <float> obras_monto_total: 0.0;
    in-out property <string> obras_superficie_total_str: "0.00 m²";
    in-out property <string> obras_monto_total_str: "$0.00 MXN";

    // Combos para Revisiones y Obras
    in-out property <[string]> estatus_combo: ["-- Seleccionar Estatus --", "INICIADA", "EN REVISIÓN", "EN PROCESO DE ACLARACIÓN", "APROBADA POR EMPRESA", "RECHAZADA", "FINALIZADA"];
    in-out property <[string]> estatus_imss_combo: ["-- Seleccionar Estatus IMSS --", "PENDIENTE DICTAMEN IMSS", "EN ESTUDIO", "APROBADA POR IMSS", "RECHAZADA POR IMSS"];
    in-out property <[string]> conceptos_combo: ["-- Seleccionar Concepto Diferencia --"];
    in-out property <[string]> clases_obra_combo: ["-- Seleccionar Clase --", "PRIVADA", "PUBLICA", "MIXTA"];

    // Modal: Formulario Revisión
    in-out property <bool> show_revision_modal: false;
    in-out property <bool> revision_form_is_editing: false;
    in-out property <string> rev_form_id: "";
    in-out property <string> rev_form_nombre: "";
    in-out property <string> rev_form_folio: "";
    in-out property <string> rev_form_concepto_val: "-- Seleccionar Concepto Diferencia --";
    in-out property <string> rev_form_estatus_val: "EN PROCESO DE ACLARACIÓN";
    in-out property <string> rev_form_estatus_imss_val: "PENDIENTE DICTAMEN IMSS";
    in-out property <string> rev_form_fecha_entrega_rev: "";
    in-out property <string> rev_form_fecha_max_entrega_rev: "";
    in-out property <string> rev_form_fecha_entrega_imss: "";
    in-out property <string> rev_form_fecha_max_entrega_imss: "";
    in-out property <string> rev_form_fecha_aprobacion_imss: "";
    in-out property <string> rev_form_fecha_max_aprobacion_imss: "";
    in-out property <bool> rev_form_pidio_prorroga: false;
    in-out property <string> rev_form_fecha_aprobacion_prorroga: "";
    in-out property <string> rev_form_fecha_entrega_con_prorroga: "";

    // Modal: Confirmación Eliminar Revisión
    in-out property <bool> show_delete_revision_modal: false;
    in-out property <string> delete_revision_id: "";
    in-out property <string> delete_revision_nombre: "";
    in-out property <string> delete_revision_folio: "";

    // Modal: Formulario Registro de Obra
    in-out property <bool> show_obra_modal: false;
    in-out property <bool> obra_form_is_editing: false;
    in-out property <string> obra_form_id: "";
