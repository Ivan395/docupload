import { ScrollView, LineEdit, Button, ComboBox } from "std-widgets.slint";
import { AppData, AppLogic, RevisionData } from "models.slint";
import { DatePickerField } from "date_picker.slint";

export component RevisionesView inherits Rectangle {
    background: #f8fafc;

    VerticalLayout {
        padding: 24px;
        spacing: 18px;

        // 1. Sub-Breadcrumb & Context Banner
        HorizontalLayout {
            spacing: 10px;
            alignment: start;

            // Botón Volver a Registros Patronales
            Rectangle {
                height: 26px;
                border-radius: 4px;
                background: btn_back_rp.has-hover ? #e2e8f0 : #f1f5f9;
                border-width: 1px;
                border-color: #cbd5e1;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 4px;
                    alignment: center;
                    Text { text: "←"; font-size: 11px; font-weight: 800; color: #334155; vertical-alignment: center; }
                    Text { text: "Registros Patronales (F3)"; font-size: 11px; font-weight: 700; color: #334155; vertical-alignment: center; }
                }
                btn_back_rp := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { AppLogic.navigate_view(2); }
                }
            }

            // Badge RP
            Rectangle {
                height: 26px;
                border-radius: 4px;
                background: AppData.selected_rp_is_valid_structure ? #eff6ff : #fee2e2;
                border-width: 1px;
                border-color: AppData.selected_rp_is_valid_structure ? #bfdbfe : #fca5a5;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 4px;
                    Text {
                        text: "RP: " + (AppData.selected_rp_registro != "" ? AppData.selected_rp_registro : "General");
                        font-size: 11px;
                        font-weight: 800;
                        color: AppData.selected_rp_is_valid_structure ? #1d4ed8 : #dc2626;
                        vertical-alignment: center;
                    }
                    if !AppData.selected_rp_is_valid_structure : Text {
                        text: "⚠️ Estructura Inválida";
                        font-size: 10px;
                        font-weight: 700;
                        color: #dc2626;
                        vertical-alignment: center;
                    }
                }
            }

            Text { text: "·"; font-size: 14px; font-weight: 800; color: #94a3b8; vertical-alignment: center; }

            // Badge Cliente & RFC
            Rectangle {
                height: 26px;
                border-radius: 4px;
                background: #f8fafc;
                border-width: 1px;
                border-color: #e2e8f0;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    Text {
                        text: AppData.selected_cliente_nombre + (AppData.selected_cliente_rfc != "" ? (" (RFC: " + AppData.selected_cliente_rfc + ")") : "");
                        font-size: 11px;
                        font-weight: 700;
                        color: #475569;
                        vertical-alignment: center;
                    }
                }
            }

            Text { text: "·"; font-size: 14px; font-weight: 800; color: #94a3b8; vertical-alignment: center; }

            // Badge Vía Corrección Patronal
            Rectangle {
                height: 26px;
                border-radius: 4px;
                background: #ecfdf5;
                border-width: 1px;
                border-color: #a7f3d0;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 4px;
                    Text { text: "✓"; font-size: 11px; font-weight: 800; color: #059669; vertical-alignment: center; }
                    Text {
                        text: "Vía Corrección Patronal Art. 173 RGGIT";
                        font-size: 11px;
                        font-weight: 700;
                        color: #065f46;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // 2. Header Superior: Título y Acciones
        HorizontalLayout {
            alignment: space-between;

            VerticalLayout {
                spacing: 4px;
                Text {
                    text: "Revisiones Patronales IMSS";
                    font-size: 22px;
                    font-weight: 800;
                    color: #0f172a;
                }
                Text {
                    text: "Control de correcciones patronales, seguimiento de plazos IMSS, prórrogas y vinculación con obras.";
                    font-size: 12px;
                    color: #64748b;
                }
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: center;


                // Botón + Nueva Revisión (F7)
                Rectangle {
                    height: 38px;
                    border-radius: 6px;
                    background: !AppData.selected_rp_is_valid_structure ? #94a3b8 : (btn_new_rev.has-hover ? #1d4ed8 : #1e3a8a);

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 8px;
                        alignment: center;
                        Text { text: "＋"; font-size: 13px; color: #ffffff; font-weight: 800; vertical-alignment: center; }
                        Text {
                            text: "Nueva Revisión";
                            font-size: 12px;
                            font-weight: 700;
                            color: #ffffff;
                            vertical-alignment: center;
                        }
                        Rectangle {
                            height: 18px;
                            border-radius: 3px;
                            background: !AppData.selected_rp_is_valid_structure ? #64748b : #2563eb;
                            HorizontalLayout {
                                padding-left: 5px;
                                padding-right: 5px;
                                Text { text: "F7"; font-size: 9px; font-weight: 700; color: #ffffff; vertical-alignment: center; }
                            }
                        }
                    }

                    btn_new_rev := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppLogic.open_new_revision_dialog(); }
                    }
                }
            }
        }

        // Banner de Alerta por Registro Patronal con Estructura Inválida
        if !AppData.selected_rp_is_valid_structure && AppData.selected_rp_registro != "" : Rectangle {
            height: 46px;
            border-radius: 6px;
            background: #fef2f2;
            border-width: 1px;
            border-color: #fca5a5;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 10px;
                alignment: start;

                Text { text: "⚠️"; font-size: 14px; vertical-alignment: center; }
                Text {
                    text: "El Registro Patronal seleccionado '" + AppData.selected_rp_registro + "' no cumple con el formato oficial IMSS (11 caracteres: 1 letra y 10 dígitos). Corríjalo en Registros Patronales (F3) para habilitar revisiones.";
                    font-size: 12px;
                    font-weight: 700;
                    color: #b91c1c;
                    vertical-alignment: center;
                }
            }
        }

        // 3. KPI Cards (4 Métricas)
        HorizontalLayout {
            spacing: 14px;

            // KPI 1: Total Revisiones
            Rectangle {
                horizontal-stretch: 1;
                height: 72px;
                border-radius: 8px;
                background: #ffffff;
                border-width: 1px;
                border-color: #e2e8f0;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        Text { text: "TOTAL REVISIONES"; font-size: 10px; font-weight: 800; color: #64748b; letter-spacing: 0.5px; }
                        Text {
                            text: AppData.revisiones_list.length + " Expedientes";
                            font-size: 16px;
                            font-weight: 800;
                            color: #0f172a;
                        }
                    }

                    Text { text: "📁"; font-size: 22px; vertical-alignment: center; }
                }
            }

            // KPI 2: En Término Legal
            Rectangle {
                horizontal-stretch: 1;
                height: 72px;
                border-radius: 8px;
                background: #ffffff;
                border-width: 1px;
                border-color: #e2e8f0;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        Text { text: "EN TÉRMINO LEGAL"; font-size: 10px; font-weight: 800; color: #64748b; letter-spacing: 0.5px; }
                        Text {
                            text: AppData.revisiones_vigentes_count + " Vigentes";
                            font-size: 16px;
                            font-weight: 800;
                            color: #0f172a;
                        }
                    }

                    Text { text: "⏱"; font-size: 22px; vertical-alignment: center; }
                }
            }

            // KPI 3: Prórrogas Autorizadas
            Rectangle {
                horizontal-stretch: 1;
                height: 72px;
                border-radius: 8px;
                background: #ffffff;
                border-width: 1px;
                border-color: #e2e8f0;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        Text { text: "PRÓRROGAS AUTORIZADAS"; font-size: 10px; font-weight: 800; color: #64748b; letter-spacing: 0.5px; }
                        Text {
                            text: AppData.revisiones_prorrogas_count + " Concedida" + (AppData.revisiones_prorrogas_count == 1 ? "" : "s");
                            font-size: 16px;
                            font-weight: 800;
                            color: #0f172a;
                        }
                    }

                    Text { text: "🕒"; font-size: 22px; vertical-alignment: center; }
                }
            }

            // KPI 4: Subdelegación
            Rectangle {
                horizontal-stretch: 1;
                height: 72px;
                border-radius: 8px;
                background: #ffffff;
                border-width: 1px;
                border-color: #e2e8f0;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        Text { text: "SUBDELEGACIÓN"; font-size: 10px; font-weight: 800; color: #64748b; letter-spacing: 0.5px; }
                        Text {
                            text: AppData.selected_rp_subdelegacion != "" ? AppData.selected_rp_subdelegacion : "01 Hidalgo Sur";
                            font-size: 15px;
                            font-weight: 800;
                            color: #0f172a;
                        }
                    }

                    Text { text: "🏛"; font-size: 22px; vertical-alignment: center; }
                }
            }
        }

        // 4. Barra de Búsqueda y Pestañas de Filtro
        HorizontalLayout {
            spacing: 14px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                // Buscador
                Rectangle {
                    width: 320px;
                    height: 38px;
                    border-radius: 6px;
                    background: #ffffff;
                    border-width: 1px;
                    border-color: #cbd5e1;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        alignment: center;

                        Text { text: "🔍"; font-size: 12px; vertical-alignment: center; }
                        LineEdit {
                            text <=> AppData.revisiones_search;
                            placeholder-text: "Buscar por Folio IMSS, Nombre...";
                            edited => { AppLogic.filter_revisiones_search(); }
                        }
                        Rectangle {
                            height: 18px;
                            border-radius: 3px;
                            background: #f1f5f9;
                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                Text { text: "Ctrl+K"; font-size: 9px; font-weight: 700; color: #94a3b8; vertical-alignment: center; }
                            }
                        }
                    }
                }

                // Filtro: Todos
                Rectangle {
                    height: 38px;
                    border-radius: 6px;
                    background: AppData.revisiones_filter_tab == 0 ? #1e3a8a : #ffffff;
                    border-width: 1px;
                    border-color: AppData.revisiones_filter_tab == 0 ? #1e3a8a : #cbd5e1;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        Text {
                            text: "Todos (" + AppData.revisiones_list.length + ")";
                            font-size: 11px;
                            font-weight: 700;
                            color: AppData.revisiones_filter_tab == 0 ? #ffffff : #475569;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppLogic.filter_revisiones_tab(0); }
                    }
                }

                // Filtro: En Proceso
                Rectangle {
                    height: 38px;
                    border-radius: 6px;
                    background: AppData.revisiones_filter_tab == 1 ? #1e3a8a : #ffffff;
                    border-width: 1px;
                    border-color: AppData.revisiones_filter_tab == 1 ? #1e3a8a : #cbd5e1;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        Text {
                            text: "En Proceso";
                            font-size: 11px;
                            font-weight: 700;
                            color: AppData.revisiones_filter_tab == 1 ? #ffffff : #475569;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppLogic.filter_revisiones_tab(1); }
                    }
                }

                // Filtro: Aprobadas IMSS
                Rectangle {
                    height: 38px;
                    border-radius: 6px;
                    background: AppData.revisiones_filter_tab == 2 ? #1e3a8a : #ffffff;
                    border-width: 1px;
                    border-color: AppData.revisiones_filter_tab == 2 ? #1e3a8a : #cbd5e1;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        Text {
                            text: "Aprobadas IMSS";
                            font-size: 11px;
                            font-weight: 700;
                            color: AppData.revisiones_filter_tab == 2 ? #ffffff : #475569;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppLogic.filter_revisiones_tab(2); }
                    }
                }

                // Filtro: Con Prórroga
                Rectangle {
                    height: 38px;
                    border-radius: 6px;
                    background: AppData.revisiones_filter_tab == 3 ? #1e3a8a : #ffffff;
                    border-width: 1px;
                    border-color: AppData.revisiones_filter_tab == 3 ? #1e3a8a : #cbd5e1;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        Text {
                            text: "Con Prórroga (" + AppData.revisiones_prorrogas_count + ")";
                            font-size: 11px;
                            font-weight: 700;
                            color: AppData.revisiones_filter_tab == 3 ? #ffffff : #475569;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppLogic.filter_revisiones_tab(3); }
                    }
                }
            }

            // Orden indicador
            HorizontalLayout {
                spacing: 6px;
                alignment: center;
                Text { text: "⇅"; font-size: 12px; color: #64748b; vertical-alignment: center; }
                Text {
                    text: "Orden: Fecha de Creación (Desc)";
                    font-size: 11px;
                    font-weight: 700;
                    color: #64748b;
                    vertical-alignment: center;
                }
            }
        }

        // 5. Lista de Revisiones en ScrollView
        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                alignment: start;
                spacing: 14px;
                padding-bottom: 24px;

                if AppData.revisiones_list.length == 0 : Rectangle {
                    height: 220px;
                    border-radius: 8px;
                    background: #ffffff;
                    border-width: 1px;
                    border-color: #e2e8f0;

                    VerticalLayout {
                        alignment: center;
                        spacing: 10px;

                        Text { text: "📁"; font-size: 36px; horizontal-alignment: center; }
                        Text {
                            text: "No hay revisiones patronales registradas para este Registro Patronal.";
                            font-size: 14px;
                            font-weight: 700;
                            color: #334155;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Haz clic en \"+ Nueva Revisión\" para crear un expediente o expedir la Cédula.";
                            font-size: 12px;
                            color: #64748b;
                            horizontal-alignment: center;
                        }
                    }
                }

                for rev in AppData.revisiones_list : Rectangle {
                    border-radius: 8px;
                    background: #ffffff;
                    border-width: 1px;
                    border-color: #e2e8f0;

                    VerticalLayout {
                        alignment: start;
                        padding: 18px;
                        spacing: 12px;

                        // Línea 1: Icono + Título + Badges de Estatus
                        HorizontalLayout {
                            alignment: space-between;

                            HorizontalLayout {
                                spacing: 14px;
                                alignment: start;

                                // Icon Box
                                Rectangle {
                                    width: 44px;
                                    height: 44px;
                                    border-radius: 8px;
                                    background: #eff6ff;
                                    border-width: 1px;
                                    border-color: #dbeafe;
                                    Text {
                                        text: "📄";
                                        font-size: 20px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                VerticalLayout {
                                    spacing: 4px;

                                    Text {
                                        text: rev.nombre;
                                        font-size: 16px;
                                        font-weight: 800;
                                        color: #0f172a;
                                    }

                                    HorizontalLayout {
                                        spacing: 8px;

                                        // Badge Folio
                                        Rectangle {
                                            height: 22px;
                                            border-radius: 4px;
                                            background: #eff6ff;
                                            border-width: 1px;
                                            border-color: #bfdbfe;
                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                Text {
                                                    text: "FOLIO: " + rev.folio;
                                                    font-size: 11px;
                                                    font-weight: 800;
                                                    color: #1d4ed8;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        // Badge ID DB
                                        Rectangle {
                                            height: 22px;
                                            border-radius: 4px;
                                            background: #f1f5f9;
                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                Text {
                                                    text: "ID DB: " + rev.id_db_label;
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                    color: #64748b;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Estatus Pills a la derecha
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: center;

                                // Estatus Usuario
                                Rectangle {
                                    height: 28px;
                                    border-radius: 14px;
                                    background: rev.estatus == "APROBADA POR EMPRESA" ? #dcfce7 : (rev.estatus == "RECHAZADA" ? #fee2e2 : #ede9fe);
                                    border-width: 1px;
                                    border-color: rev.estatus == "APROBADA POR EMPRESA" ? #bbf7d0 : (rev.estatus == "RECHAZADA" ? #fca5a5 : #ddd6fe);
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        Text {
                                            text: "● " + rev.estatus;
                                            font-size: 12px;
                                            font-weight: 800;
                                            color: rev.estatus == "APROBADA POR EMPRESA" ? #15803d : (rev.estatus == "RECHAZADA" ? #b91c1c : #6d28d9);
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Estatus IMSS
                                Rectangle {
                                    height: 28px;
                                    border-radius: 14px;
                                    background: rev.estatus_imss == "APROBADA POR IMSS" ? #064e3b : #0f172a;
                                    HorizontalLayout {
                                        padding-left: 10px;
                                        padding-right: 10px;
                                        spacing: 4px;
                                        Text {
                                            text: rev.estatus_imss == "APROBADA POR IMSS" ? "✓" : "⚖";
                                            font-size: 12px;
                                            color: #ffffff;
                                            font-weight: 800;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: rev.estatus_imss;
                                            font-size: 12px;
                                            font-weight: 700;
                                            color: #ffffff;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }

                        // Línea 2: Concepto Diferencia
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            Text { text: "🔀"; font-size: 13px; color: #475569; vertical-alignment: center; }
                            Text {
                                text: "Concepto Diferencia:";
                                font-size: 12px;
                                font-weight: 800;
                                color: #334155;
                                vertical-alignment: center;
                            }
                            Text {
                                text: (rev.concepto_diferencia != "" && rev.concepto_diferencia != "-- Seleccionar Concepto Diferencia --") ? rev.concepto_diferencia : "Sin Concepto Asignado";
                                font-size: 12px;
                                color: #475569;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: #f1f5f9;
                        }

                        // Línea 3: Grid de 6 Fechas Reglamentarias
                        HorizontalLayout {
                            spacing: 10px;

                            // 1. F. Entrega Revisión
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "F. Entrega Revisión"; font-size: 11px; font-weight: 700; color: #64748b; }
                                Text { text: rev.fecha_entrega_revision; font-size: 13px; font-weight: 800; color: #0f172a; }
                                Text { text: "Realizada patrón"; font-size: 10px; color: #94a3b8; }
                            }

                            // 2. F. Máx Entrega Rev.
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "F. Máx Entrega Rev."; font-size: 11px; font-weight: 700; color: #64748b; }
                                Text { text: rev.fecha_maxima_entrega_revision; font-size: 13px; font-weight: 800; color: #0f172a; }
                                Text { text: "En plazo"; font-size: 10px; color: #059669; }
                            }

                            // 3. F. Entrega IMSS
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "F. Entrega IMSS"; font-size: 11px; font-weight: 700; color: #64748b; }
                                Text { text: rev.fecha_entrega_imss; font-size: 13px; font-weight: 800; color: #0f172a; }
                                Text { text: "Oficialía de partes"; font-size: 10px; color: #94a3b8; }
                            }

                            // 4. F. Máx Entrega IMSS
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "F. Máx Entrega IMSS"; font-size: 11px; font-weight: 700; color: #64748b; }
                                Text { text: rev.fecha_maxima_entrega_imss; font-size: 13px; font-weight: 800; color: #0f172a; }
                                Text { text: "Cumplido"; font-size: 10px; color: #059669; }
                            }

                            // 5. F. Aprobación IMSS
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "F. Aprobación IMSS"; font-size: 11px; font-weight: 700; color: #64748b; }
                                Text {
                                    text: rev.fecha_aprobacion_imss;
                                    font-size: 13px;
                                    font-weight: 800;
                                    color: rev.fecha_aprobacion_imss == "-- / -- / ----" ? #94a3b8 : #0f172a;
                                }
                                Text { text: rev.fecha_aprobacion_imss == "-- / -- / ----" ? "En estudio" : "Oficio Definitivo"; font-size: 10px; color: #2563eb; }
                            }

                            // 6. F. Máx Aprobación IMSS
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "F. Máx Aprobación IMSS"; font-size: 11px; font-weight: 700; color: #64748b; }
                                Text { text: rev.fecha_maxima_aprobacion_imss; font-size: 13px; font-weight: 800; color: #b91c1c; }
                                Text { text: "Término legal"; font-size: 10px; color: #b91c1c; }
                            }
                        }

                        // Línea 4: Barra de Prórroga
                        Rectangle {
                            height: 38px;
                            border-radius: 6px;
                            background: #f8fafc;
                            border-width: 1px;
                            border-color: #f1f5f9;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 10px;
                                alignment: start;

                                Text { text: "🕒"; font-size: 13px; vertical-alignment: center; }
                                Text {
                                    text: "¿Pidió Prórroga?:";
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: #475569;
                                    vertical-alignment: center;
                                }

                                Rectangle {
                                    height: 20px;
                                    border-radius: 3px;
                                    background: rev.pidio_prorroga ? #ede9fe : #f1f5f9;
                                    y: (parent.height - self.height) / 2;
                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        Text {
                                            text: rev.pidio_prorroga ? "SÍ" : "NO";
                                            font-size: 10px;
                                            font-weight: 800;
                                            color: rev.pidio_prorroga ? #6d28d9 : #64748b;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                if rev.pidio_prorroga : HorizontalLayout {
                                    spacing: 12px;
                                    alignment: center;
                                    Text {
                                        text: "F. Aprobación Prórroga: " + rev.fecha_aprobacion_prorroga;
                                        font-size: 12px;
                                        color: #475569;
                                        vertical-alignment: center;
                                    }
                                    Text { text: "•"; font-size: 12px; color: #cbd5e1; vertical-alignment: center; }
                                    Text {
                                        text: "F. Entrega con Prórroga: " + rev.fecha_entrega_con_prorroga;
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: #1d4ed8;
                                        vertical-alignment: center;
                                    }
                                }

                                if !rev.pidio_prorroga : Text {
                                    text: "• Sin extensiones computadas / Disponible para trámite extraordinario";
                                    font-size: 12px;
                                    color: #94a3b8;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Línea 5: Acciones Inferiores
                        HorizontalLayout {
                            alignment: end;
                            spacing: 10px;

                            // Botón: Ver Registros de Obras
                            Rectangle {
                                height: 34px;
                                border-radius: 6px;
                                background: btn_obras.has-hover ? #065f46 : #064e3b;

                                HorizontalLayout {
                                    padding-left: 14px;
                                    padding-right: 14px;
                                    spacing: 6px;
                                    alignment: center;
                                    Text { text: "🏗"; font-size: 13px; color: #ffffff; vertical-alignment: center; }
                                    Text {
                                        text: "Ver Registros de Obras (" + rev.obras_count + ")";
                                        font-size: 12px;
                                        font-weight: 800;
                                        color: #ffffff;
                                        vertical-alignment: center;
                                    }
                                }

                                btn_obras := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        AppLogic.select_revision_for_obras(rev.id, rev.nombre, rev.folio);
                                    }
                                }
                            }

                            // Botón: Editar
                            Rectangle {
                                height: 34px;
                                border-radius: 6px;
                                background: btn_edit_rev.has-hover ? #eff6ff : #ffffff;
                                border-width: 1px;
                                border-color: #bfdbfe;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 6px;
                                    alignment: center;
                                    Text { text: "✏"; font-size: 12px; color: #1d4ed8; vertical-alignment: center; }
                                    Text {
                                        text: "Editar";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: #1d4ed8;
                                        vertical-alignment: center;
                                    }
                                }

                                btn_edit_rev := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        AppLogic.select_revision_for_edit(rev.id);
                                    }
                                }
                            }

                            // Botón: Eliminar
                            Rectangle {
                                height: 34px;
                                width: 36px;
                                border-radius: 6px;
                                background: btn_del_rev.has-hover ? #fef2f2 : #ffffff;
                                border-width: 1px;
                                border-color: #fecaca;

                                Text {
                                    text: "🗑";
                                    font-size: 13px;
                                    color: #dc2626;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                btn_del_rev := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        AppLogic.open_delete_revision_dialog(rev.id, rev.nombre, rev.folio);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ==========================================
    // MODAL: NUEVA / EDITAR REVISIÓN
    // ==========================================
    if AppData.show_revision_modal : Rectangle {
        background: #00000077;
        width: 100%;
        height: 100%;

        Rectangle {
            width: 640px;
            height: 490px;
            border-radius: 12px;
            background: #ffffff;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                // Header Modal
                HorizontalLayout {
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: AppData.revision_form_is_editing ? "Editar Revisión Patronal IMSS" : "Nueva Revisión Patronal IMSS";
                            font-size: 15px;
                            font-weight: 800;
                            color: #0f172a;
                        }
                        Text {
                            text: "Expediente de aclaración, seguimiento de plazos legales y prórrogas.";
                            font-size: 11px;
                            color: #64748b;
                        }
                    }

                    Rectangle {
                        width: 26px;
                        height: 26px;
                        border-radius: 13px;
                        background: btn_close_rev.has-hover ? #fee2e2 : #f1f5f9;
                        Text {
                            text: "✕";
                            font-size: 12px;
                            font-weight: 800;
                            color: btn_close_rev.has-hover ? #b91c1c : #64748b;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        btn_close_rev := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.close_revision_dialog(); }
                        }
                    }
                }

                Rectangle { height: 1px; background: #e2e8f0; }

                // Form Scrollable
                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 8px;

                        // Campo: Nombre de la Revisión
                        VerticalLayout {
                            spacing: 2px;
                            Text { text: "Nombre del Expediente / Revisión *"; font-size: 10px; font-weight: 700; color: #334155; }
                            LineEdit {
                                text <=> AppData.rev_form_nombre;
                                placeholder-text: "Ej. Revisión Ordinaria Ejercicio Fiscal 2023 - Obra Insurgentes";
                            }
                        }

                        // Línea 2: Folio IMSS + Concepto Diferencia
                        HorizontalLayout {
                            spacing: 10px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "Folio IMSS (Opcional)"; font-size: 10px; font-weight: 700; color: #334155; }
                                LineEdit {
                                    text <=> AppData.rev_form_folio;
                                    placeholder-text: "Ej. REV-IMSS-2023-0891 (Opcional)";
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 2;
                                spacing: 2px;
                                Text { text: "Concepto de Diferencia"; font-size: 10px; font-weight: 700; color: #334155; }
                                ComboBox {
                                    model: AppData.conceptos_combo;
                                    current-value <=> AppData.rev_form_concepto_val;
                                }
                            }
                        }

                        // Línea 3: Estatus + Estatus IMSS
                        HorizontalLayout {
                            spacing: 10px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "Estatus de la Revisión"; font-size: 10px; font-weight: 700; color: #334155; }
                                ComboBox {
                                    model: AppData.estatus_combo;
                                    current-value <=> AppData.rev_form_estatus_val;
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "Estatus Dictamen IMSS"; font-size: 10px; font-weight: 700; color: #334155; }
                                ComboBox {
                                    model: AppData.estatus_imss_combo;
                                    current-value <=> AppData.rev_form_estatus_imss_val;
                                }
                            }
                        }

                        Rectangle { height: 1px; background: #f1f5f9; }

                        // Título de Sección: Fechas de Cumplimiento
                        Text { text: "Calendario de Términos y Plazos Legales (DD/MM/YYYY):"; font-size: 10px; font-weight: 800; color: #1e3a8a; }

                        // 1. Fila 1: Fecha Entrega IMSS & Fecha Máx Aprobación IMSS (Auto +15 días hábiles L-V)
                        HorizontalLayout {
                            spacing: 10px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "Fecha Entrega IMSS"; font-size: 10px; font-weight: 700; color: #475569; }
                                DatePickerField {
                                    date-val <=> AppData.rev_form_fecha_entrega_imss;
                                    placeholder-text: "DD/MM/YYYY (ej. 15/10/2023)";
                                    enabled: true;
                                    date-changed(val) => {
                                        AppLogic.on_fecha_entrega_imss_changed(val);
                                    }
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "Fecha Máx Aprobación IMSS (Auto)"; font-size: 10px; font-weight: 700; color: #475569; }
                                DatePickerField {
                                    date-val <=> AppData.rev_form_fecha_max_aprobacion_imss;
                                    placeholder-text: "Cálculo automático (+15 días hábiles L-V)";
                                    enabled: false;
                                    label-badge: "+15 días hábiles";
                                }
                            }
                        }

                        // 2. Fila 2: Fecha Aprobación IMSS & Fecha Máx Entrega Revisión (Auto +40 días)
                        HorizontalLayout {
                            spacing: 10px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "Fecha Aprobación IMSS"; font-size: 10px; font-weight: 700; color: #475569; }
                                DatePickerField {
                                    date-val <=> AppData.rev_form_fecha_aprobacion_imss;
                                    placeholder-text: "DD/MM/YYYY (opcional si pendiente)";
                                    enabled: true;
                                    date-changed(val) => {
                                        AppLogic.on_fecha_aprobacion_imss_changed(val);
                                    }
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "Fecha Máx Entrega Revisión (Auto)"; font-size: 10px; font-weight: 700; color: #475569; }
                                DatePickerField {
                                    date-val <=> AppData.rev_form_fecha_max_entrega_rev;
                                    placeholder-text: "Cálculo automático (+40 días hábiles post-aprobación)";
                                    enabled: false;
                                    label-badge: "+40 días hábiles";
                                }
                            }
                        }

                        // 3. Fila 3: Fecha Entrega Revisión & Fecha Máx Entrega IMSS (Auto +120 días)
                        HorizontalLayout {
                            spacing: 10px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "Fecha Entrega Revisión"; font-size: 10px; font-weight: 700; color: #475569; }
                                DatePickerField {
                                    date-val <=> AppData.rev_form_fecha_entrega_rev;
                                    placeholder-text: "DD/MM/YYYY (ej. 01/10/2023)";
                                    enabled: true;
                                    date-changed(val) => {
                                        AppLogic.on_fecha_entrega_rev_changed(val);
                                    }
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "Fecha Máx Entrega IMSS (Auto)"; font-size: 10px; font-weight: 700; color: #475569; }
                                DatePickerField {
                                    date-val <=> AppData.rev_form_fecha_max_entrega_imss;
                                    placeholder-text: "Cálculo automático (+120 días post-entrega)";
                                    enabled: false;
                                    label-badge: "+120 días";
                                }
                            }
                        }

                        Rectangle { height: 1px; background: #f1f5f9; }

                        // Sección: Prórrogas
                        HorizontalLayout {
                            alignment: space-between;
                            Text { text: "Trámite Extraordinario de Prórroga:"; font-size: 10px; font-weight: 800; color: #1e3a8a; vertical-alignment: center; }

                            // Toggle Button ¿Pidió Prórroga?
                            Rectangle {
                                height: 26px;
                                border-radius: 6px;
                                background: AppData.rev_form_pidio_prorroga ? #ede9fe : #f1f5f9;
                                border-width: 1px;
                                border-color: AppData.rev_form_pidio_prorroga ? #c4b5fd : #cbd5e1;

                                HorizontalLayout {
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 4px;
                                    alignment: center;
                                    Text {
                                        text: AppData.rev_form_pidio_prorroga ? "✓ Pidió Prórroga: SÍ" : "✕ Pidió Prórroga: NO";
                                        font-size: 10px;
                                        font-weight: 800;
                                        color: AppData.rev_form_pidio_prorroga ? #6d28d9 : #64748b;
                                        vertical-alignment: center;
                                    }
                                }

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { AppLogic.toggle_rev_prorroga(); }
                                }
                            }
                        }

                        if AppData.rev_form_pidio_prorroga : HorizontalLayout {
                            spacing: 10px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "Fecha Aprobación Prórroga"; font-size: 10px; font-weight: 700; color: #475569; }
                                DatePickerField {
                                    date-val <=> AppData.rev_form_fecha_aprobacion_prorroga;
                                    placeholder-text: "DD/MM/YYYY (ej. 05/11/2023)";
                                    enabled: true;
                                    date-changed(val) => {
                                        AppLogic.on_fecha_aprobacion_prorroga_changed(val);
                                    }
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "Fecha Entrega con Prórroga (Auto)"; font-size: 10px; font-weight: 700; color: #475569; }
                                DatePickerField {
                                    date-val <=> AppData.rev_form_fecha_entrega_con_prorroga;
                                    placeholder-text: "Cálculo automático (+10 días hábiles post-fecha máxima)";
                                    enabled: false;
                                    label-badge: "+10 días hábiles";
                                }
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: #e2e8f0; }

                // Footer Modal
                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;

                    // Botón Cancelar
                    Rectangle {
                        height: 32px;
                        border-radius: 6px;
                        background: btn_cancel_rev.has-hover ? #f1f5f9 : #ffffff;
                        border-width: 1px;
                        border-color: #cbd5e1;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            alignment: center;
                            Text {
                                text: "Cancelar";
                                font-size: 11px;
                                font-weight: 700;
                                color: #475569;
                                vertical-alignment: center;
                            }
                        }

                        btn_cancel_rev := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.close_revision_dialog(); }
                        }
                    }

                    // Botón Guardar
                    Rectangle {
                        height: 32px;
                        border-radius: 6px;
                        background: btn_submit_rev.has-hover ? #1d4ed8 : #1e3a8a;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 6px;
                            alignment: center;
                            Text { text: "💾"; font-size: 11px; vertical-alignment: center; }
                            Text {
                                text: AppData.revision_form_is_editing ? "Actualizar Revisión" : "Guardar Revisión";
                                font-size: 11px;
                                font-weight: 700;
                                color: #ffffff;
                                vertical-alignment: center;
                            }
                        }

                        btn_submit_rev := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                AppLogic.submit_revision(
                                    AppData.rev_form_id,
                                    AppData.rev_form_nombre,
                                    AppData.rev_form_folio,
                                    AppData.rev_form_concepto_val,
                                    AppData.rev_form_estatus_val,
                                    AppData.rev_form_estatus_imss_val,
                                    AppData.rev_form_fecha_entrega_rev,
                                    AppData.rev_form_fecha_max_entrega_rev,
                                    AppData.rev_form_fecha_entrega_imss,
                                    AppData.rev_form_fecha_max_entrega_imss,
                                    AppData.rev_form_fecha_aprobacion_imss,
                                    AppData.rev_form_pidio_prorroga,
                                    AppData.rev_form_fecha_aprobacion_prorroga,
                                    AppData.rev_form_fecha_entrega_con_prorroga
                                );
                            }
                        }
                    }
                }
            }
        }
    }

    // ==========================================
    // MODAL CARD: CONFIRMAR ELIMINACIÓN REVISIÓN
    // ==========================================
    // ==========================================
    // MODAL CARD: CONFIRMAR ELIMINACIÓN REVISIÓN
    // ==========================================
    if AppData.show_delete_revision_modal : Rectangle {
        background: #00000077;
        width: 100%;
        height: 100%;

        TouchArea {
            // Prevent clicks from falling through
        }

        Rectangle {
            width: 480px;
            height: 230px;
            border-radius: 12px;
            background: #ffffff;
            border-width: 1px;
            border-color: #fecaca;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                HorizontalLayout {
                    spacing: 14px;
                    alignment: start;

                    Rectangle {
                        width: 44px;
                        height: 44px;
                        border-radius: 22px;
                        background: #fef2f2;
                        border-width: 1px;
                        border-color: #fecaca;
                        Text {
                            text: "⚠️";
                            font-size: 20px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: "¿Eliminar Revisión Patronal?";
                            font-size: 16px;
                            font-weight: 800;
                            color: #991b1b;
                        }
                        Text {
                            text: "Esta acción eliminará permanentemente la revisión patronal seleccionada y todos sus datos asociados.";
                            font-size: 12px;
                            color: #475569;
                            wrap: word-wrap;
                        }
                    }
                }

                // Card resumen
                Rectangle {
                    border-radius: 6px;
                    background: #f8fafc;
                    border-width: 1px;
                    border-color: #e2e8f0;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 4px;
                        Text {
                            text: "REVISIÓN:";
                            font-size: 10px;
                            font-weight: 800;
                            color: #065f46;
                        }
                        Text {
                            text: AppData.delete_revision_nombre;
                            font-size: 14px;
                            font-weight: 800;
                            color: #0f172a;
                            wrap: word-wrap;
                        }
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;

                    // Cancelar
                    Rectangle {
                        height: 36px;
                        border-radius: 6px;
                        background: btn_cancel_del.has-hover ? #f1f5f9 : #ffffff;
                        border-width: 1px;
                        border-color: #cbd5e1;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            alignment: center;
                            Text {
                                text: "Cancelar";
                                font-size: 12px;
                                font-weight: 700;
                                color: #475569;
                                vertical-alignment: center;
                            }
                        }

                        btn_cancel_del := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.close_delete_revision_dialog(); }
                        }
                    }

                    // Sí, Eliminar
                    Rectangle {
                        height: 36px;
                        border-radius: 6px;
                        background: btn_confirm_del.has-hover ? #b91c1c : #dc2626;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            spacing: 6px;
                            alignment: center;
                            Text {
                                text: "🗑";
                                font-size: 12px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "Sí, Eliminar Revisión";
                                font-size: 12px;
                                font-weight: 700;
                                color: #ffffff;
                                vertical-alignment: center;
                            }
                        }

                        btn_confirm_del := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                AppLogic.confirm_delete_revision(AppData.delete_revision_id);
                            }
                        }
                    }
                }
            }
        }
    }
}
