import { ScrollView, LineEdit, ComboBox } from "std-widgets.slint";
import { AppData, AppLogic, NominaRow, NominaPercepcionItem, NominaMesTotalItem, NominaEmpleadoDiaItem, NominaRegistroPatronalTotalItem, NominaEditableConceptoItem, NominaTemplateOptionItem, NominaFaltanteItem } from "models.slint";

// Tarjeta de KPI del encabezado.
component KpiCard inherits Rectangle {
    in property <string> label;
    in property <string> value;
    in property <color> accent: #1e3a8a;
    in property <color> value_bg: transparent;

    background: #ffffff;
    border-width: 1px;
    border-color: #e2e8f0;
    border-radius: 8px;

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 14px;
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 10px;

        Rectangle {
            width: 3px;
            border-radius: 2px;
            background: root.accent;
        }

        VerticalLayout {
            spacing: 2px;
            horizontal-stretch: 1;

            Text {
                text: root.label;
                font-size: 10.5px;
                font-weight: 600;
                color: #64748b;
                overflow: elide;
            }
            Text {
                text: root.value;
                font-size: 17px;
                font-weight: 800;
                color: root.accent;
                overflow: elide;
            }
        }
    }
}

// Chip compacto de un mes dentro del desglose de días del trabajador.
// El color comunica el contraste con la cédula sin agregar una columna más.
component MesDiaChip inherits Rectangle {
    in property <NominaEmpleadoDiaItem> mes;

    height: 22px;
    width: 108px;
    border-radius: 6px;
    background: root.mes.coincide ? #dcfce7 : #fef3c7;
    border-width: 1px;
    border-color: root.mes.coincide ? #86efac : #fcd34d;

    HorizontalLayout {
        padding-left: 8px;
        padding-right: 8px;
        spacing: 4px;

        Text {
            text: root.mes.coincide ? "✓" : "≠";
            font-size: 11px;
            font-weight: 800;
            color: root.mes.coincide ? #166534 : #92400e;
            vertical-alignment: center;
        }

        VerticalLayout {
            spacing: 0px;
            horizontal-stretch: 1;

            Text {
                text: root.mes.periodo;
                font-size: 10px;
                font-weight: 600;
                color: #475569;
                overflow: elide;
            }
            Text {
                text: root.mes.dias_nomina + "d / " + root.mes.dias_cedula + "d";
                font-size: 10px;
                font-weight: 700;
                color: #1e293b;
                overflow: elide;
            }
        }
    }
}

export component NominasView inherits Rectangle {
    background: #f8fafc;

    // ─── Adaptación al ancho disponible ─────────────────────────────────
    // La tabla se adapta al ancho del área de contenido publicado en
    // `AppData.window_width`, NO a `self.width`. Si el ancho se derivara de este
    // componente, el layout de las columnas alimentaría su propia medida y Slint
    // lo marcaría como ciclo de binding (potencialmente pánico en ejecución).
    // `window_width` lo publica un observador en main_view.slint y es
    // independiente de esta tabla. El orden de
    // descarte es: primero columnas de importe, luego fechas secundarias y
    // luego identificadores; nunca se oculta Periodo, Trabajador, los días ni
    // las percepciones, que son el propósito del reporte.
    in property <length> table_w: AppData.window_width - 40px;
    in property <bool> wide: self.table_w >= 1500px;
    in property <bool> medium: self.table_w >= 1250px;
    in property <bool> narrow: self.table_w >= 1020px;

    VerticalLayout {
        padding: 20px;
        spacing: 14px;

        // ─── 1. Encabezado ────────────────────────────────────────────────
        HorizontalLayout {
            alignment: space-between;
            spacing: 16px;

            VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;

                HorizontalLayout {
                    spacing: 10px;
                    alignment: start;

                    Text {
                        text: "💵";
                        font-size: 24px;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "Reporte de Nóminas";
                        font-size: 22px;
                        font-weight: 800;
                        color: #0f172a;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        height: 26px;
                        border-radius: 13px;
                        background: #eff6ff;
                        border-width: 1px;
                        border-color: #bfdbfe;
                        y: (parent.height - self.height) / 2;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            alignment: center;
                            Text {
                                text: "Comparativo días Nómina vs Cédula";
                                font-size: 12px;
                                font-weight: 700;
                                color: #1d4ed8;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // El reporte solo contiene nóminas de
                    // empleados con obras creadas por el
                    // usuario y fechas coincidentes.
                    Rectangle {
                        height: 26px;
                        border-radius: 13px;
                        background: #fef3c7;
                        border-width: 1px;
                        border-color: #fcd34d;
                        y: (parent.height - self.height) / 2;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            alignment: center;
                            Text {
                                text: "⚠ Solo obras creadas por el usuario";
                                font-size: 12px;
                                font-weight: 700;
                                color: #92400e;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                Text {
                    text: AppData.nominas_subtitle != "" ? AppData.nominas_subtitle : "Percepciones, días pagados y fechas de pago por trabajador.";
                    font-size: 13px;
                    font-weight: 500;
                    color: #64748b;
                    wrap: word-wrap;
                }
            }

            HorizontalLayout {
                spacing: 8px;
                alignment: end;

                // Botón Detector de Nóminas Faltantes
                Rectangle {
                    height: 38px;
                    width: 220px;
                    border-radius: 6px;
                    background: btn_falt.has-hover ? #d97706 : #f59e0b;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        Text { text: "🔍"; font-size: 13px; vertical-alignment: center; }
                        Text {
                            text: AppData.nominas_faltantes_count > 0 ? ("Faltan " + AppData.nominas_faltantes_count + " Nóminas") : "Detectar Faltantes";
                            font-size: 13px;
                            font-weight: 700;
                            color: #ffffff;
                            vertical-alignment: center;
                        }
                    }

                    btn_falt := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppLogic.nominas_open_faltantes_modal(); }
                    }
                }

                Rectangle {
                    height: 38px;
                    width: 168px;
                    border-radius: 6px;
                    background: btn_excel.has-hover ? #15803d : #16a34a;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 6px;
                        Text { text: "📥"; font-size: 13px; vertical-alignment: center; }
                        Text {
                            text: "Exportar a Excel (.xlsx)";
                            font-size: 13px;
                            font-weight: 700;
                            color: #ffffff;
                            vertical-alignment: center;
                        }
                    }

                    btn_excel := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppLogic.nominas_export_excel(); }
                    }
                }
            }
        }

        // ─── 2. KPIs ──────────────────────────────────────────────────────
        HorizontalLayout {
            spacing: 10px;

            KpiCard { label: "NÓMINAS"; value: AppData.nominas_kpi_total_str; accent: #1e3a8a; }
            KpiCard { label: "TRABAJADORES"; value: AppData.nominas_kpi_empleados_str; accent: #2563eb; }
            KpiCard { label: "DÍAS PAGADOS (NÓMINA)"; value: AppData.nominas_kpi_dias_pagados_str; accent: #0891b2; }
            KpiCard { label: "DÍAS CÉDULA"; value: AppData.nominas_kpi_dias_cedula_str; accent: #7c3aed; }
            KpiCard { label: "DIFERENCIA"; value: AppData.nominas_kpi_dias_delta_str; accent: #c2410c; }
            KpiCard { label: "TOTAL PERCEPCIONES"; value: AppData.nominas_kpi_percepciones_str; accent: #15803d; }
        }

        // ─── 3. Filtros ───────────────────────────────────────────────────
        Rectangle {
            height: 54px;
            background: #ffffff;
            border-width: 1px;
            border-color: #e2e8f0;
            border-radius: 8px;

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                padding-top: 8px;
                padding-bottom: 8px;
                spacing: 10px;

                LineEdit {
                    horizontal-stretch: 1;
                    min-width: 190px;
                    max-width: 420px;
                    height: 34px;
                    placeholder-text: "🔍  Buscar por nombre, NSS, RFC/CURP o periodo...";
                    text: AppData.nominas_search_query;
                    edited => { AppLogic.nominas_set_search(self.text); }
                }

                Rectangle {
                    width: 36px;
                    height: 34px;
                    border-radius: 6px;
                    background: btn_clear.has-hover ? #fee2e2 : #fef2f2;
                    border-width: 1px;
                    border-color: #fecaca;
                    visible: AppData.nominas_search_query != "";

                    Text {
                        text: "✕";
                        font-size: 14px;
                        font-weight: 800;
                        color: #b91c1c;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    btn_clear := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppLogic.nominas_clear_search(); }
                    }
                }

                VerticalLayout {
                    spacing: 1px;
                    Text { text: "Periodo"; font-size: 9.5px; color: #94a3b8; font-weight: 600; visible: root.narrow; }
                    ComboBox {
                        width: root.narrow ? 170px : 130px;
                        height: 30px;
                        model: AppData.nominas_periodo_options;
                        current-index <=> AppData.nominas_filter_periodo_idx;
                        selected(val) => { AppLogic.nominas_filter_periodo(self.current-index); }
                    }
                }

                VerticalLayout {
                    spacing: 1px;
                    Text { text: "Año"; font-size: 9.5px; color: #94a3b8; font-weight: 600; visible: root.narrow; }
                    ComboBox {
                        width: 95px;
                        height: 30px;
                        model: AppData.nominas_anio_options;
                        current-index <=> AppData.nominas_filter_anio_idx;
                        selected(val) => { AppLogic.nominas_filter_anio(self.current-index); }
                    }
                }

                VerticalLayout {
                    spacing: 1px;
                    Text { text: "Días"; font-size: 9.5px; color: #94a3b8; font-weight: 600; }
                    ComboBox {
                        width: 160px;
                        height: 30px;
                        model: ["Todos", "Coinciden", "Difieren", "Sin cédula"];
                        current-index <=> AppData.nominas_filter_dias_idx;
                        selected(val) => { AppLogic.nominas_filter_dias(self.current-index); }
                    }
                }

                Rectangle {
                    height: 34px;
                    width: 150px;
                    visible: root.narrow;
                    border-radius: 6px;
                    background: AppData.nominas_only_sin_cedula ? #fef3c7 : #f8fafc;
                    border-width: 1px;
                    border-color: AppData.nominas_only_sin_cedula ? #f59e0b : #e2e8f0;
                    y: (parent.height - self.height) / 2;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 6px;
                        Text {
                            text: AppData.nominas_only_sin_cedula ? "☑" : "☐";
                            font-size: 13px;
                            vertical-alignment: center;
                            color: #92400e;
                        }
                        Text {
                            text: "Solo sin cédula";
                            font-size: 11.5px;
                            font-weight: 600;
                            color: #334155;
                            vertical-alignment: center;
                        }
                    }

                    btn_sinc := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppLogic.nominas_toggle_only_sin_cedula(); }
                    }
                }

                Rectangle {
                    horizontal-stretch: 1;
                }

                // Desglose mensual por trabajador: la pieza que hace posible
                // comparar sin salir de la vista.
                Rectangle {
                    height: 34px;
                    width: root.narrow ? 176px : 116px;
                    border-radius: 6px;
                    background: btn_detalle.has-hover ? #dbeafe : #eff6ff;
                    border-width: 1px;
                    border-color: #bfdbfe;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 6px;
                        Text { text: "🗓"; font-size: 12px; vertical-alignment: center; color: #1d4ed8; }
                        Text {
                            text: !root.narrow ? (AppData.nominas_mostrar_detalle ? "Ocultar" : "Ver") : (AppData.nominas_mostrar_detalle ? "Ocultar días/mes" : "Ver días/mes");
                            font-size: 11.5px;
                            font-weight: 700;
                            color: #1e3a8a;
                            vertical-alignment: center;
                        }
                    }

                    btn_detalle := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppLogic.nominas_toggle_detalle(); }
                    }
                }
            }
        }

        // ─── 4. Tabla ─────────────────────────────────────────────────────
        Rectangle {
            vertical-stretch: 1;
            background: #ffffff;
            border-width: 1px;
            border-color: #e2e8f0;
            border-radius: 8px;
            clip: true;

            VerticalLayout {
                spacing: 0px;

                // Cuerpo: la cabecera va DENTRO del ScrollView
                // para que encabezados y datos se desplacen
                // juntos (scroll horizontal solo cuando las
                // columnas no caben en el area visible).
                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 0px;
                        min-width: AppData.nominas_table_min_width;

                        // Encabezado
                        Rectangle {
                            height: 42px;
                            background: #f1f5f9;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 0px;

                                // Las columnas del encabezado
                                // coinciden 1:1 con las de las
                                // filas, en el mismo orden.
                                Text { width: 34px; text: "#"; font-size: 12px; font-weight: 700; color: #64748b; horizontal-alignment: center; vertical-alignment: center; }
                                Text { width: 108px; text: "Periodo"; font-size: 11px; font-weight: 700; color: #475569; vertical-alignment: center; }
                                Text { width: 46px; text: "Sem."; font-size: 11px; font-weight: 700; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                                Text { width: 170px; text: "Trabajador"; font-size: 11px; font-weight: 700; color: #475569; vertical-alignment: center; }
                                Text { width: 92px; text: "NSS"; font-size: 11px; font-weight: 700; color: #475569; vertical-alignment: center; }
                                Text { width: 128px; text: "RFC / CURP"; font-size: 11px; font-weight: 700; color: #475569; vertical-alignment: center; }
                                Text { width: 88px; text: "F. Inicio"; font-size: 11px; font-weight: 700; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                                Text { width: 88px; text: "F. Fin"; font-size: 11px; font-weight: 700; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                                Text { width: 88px; text: "F. Pago"; font-size: 11px; font-weight: 700; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                                Text { width: 82px; text: "F. CFDI"; font-size: 11px; font-weight: 700; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                                Text { width: 92px; text: "Días Nóm. ✏"; font-size: 11px; font-weight: 700; color: #1d4ed8; horizontal-alignment: center; vertical-alignment: center; }
                                Text { width: 70px; text: "Días Céd."; font-size: 11px; font-weight: 700; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                                Text { width: 60px; text: "Dif."; font-size: 11px; font-weight: 700; color: #475569; horizontal-alignment: center; vertical-alignment: center; }

                                // Columnas dinamicas: un encabezado por cada concepto de percepcion
                                for h in AppData.nominas_percepcion_headers : Text {
                                    width: 110px;
                                    text: h;
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #7c3aed;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                Text { width: 110px; text: "Percepciones"; font-size: 11px; font-weight: 700; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                                Text { width: 80px; text: "Gravado"; font-size: 11px; font-weight: 700; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                                Text { width: 80px; text: "Exento"; font-size: 11px; font-weight: 700; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                                Text { width: 80px; text: "S. Diario"; font-size: 11px; font-weight: 700; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                                Text { width: 120px; text: "Acciones"; font-size: 11px; font-weight: 700; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                                Text { width: 190px; text: "Días por mes del trabajador"; font-size: 11px; font-weight: 700; color: #475569; vertical-alignment: center; }
                            }
                        }

                        Rectangle { height: 1px; background: #cbd5e1; }

                        if AppData.nominas_list.length == 0 : Rectangle {
                            height: 180px;

                            VerticalLayout {
                                alignment: center;
                                spacing: 8px;
                                Text { text: "📭"; font-size: 32px; horizontal-alignment: center; }
                                Text {
                                    text: "No hay nóminas para mostrar";
                                    font-size: 14px;
                                    font-weight: 700;
                                    color: #64748b;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Importa nóminas CFDI en la vista de Auditoría General para poblar este reporte.";
                                    font-size: 12px;
                                    color: #94a3b8;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        for item in AppData.nominas_list : Rectangle {
                            height: 44px;
                            background: row_area.has-hover ? item.row_hover_color : item.row_bg_color;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 0px;

                                Text { width: 34px; text: item.idx; font-size: 11px; color: #94a3b8; horizontal-alignment: center; vertical-alignment: center; }
                                Text { width: 108px; text: item.periodo_str; font-size: 12px; font-weight: 700; color: #0f172a; vertical-alignment: center; overflow: elide; }
                                Text { width: 46px; text: item.semana_fiscal_str; font-size: 11px; font-weight: 700; color: #7c3aed; horizontal-alignment: center; vertical-alignment: center; }
                                Text { width: 170px; text: item.nombre_trabajador; font-size: 12px; font-weight: 600; color: #0f172a; vertical-alignment: center; overflow: elide; }
                                Text { width: 92px; text: item.nss; font-size: 11px; font-family: "monospace"; color: #334155; vertical-alignment: center; overflow: elide; }
                                Text { width: 128px; text: item.rfc_curp; font-size: 10.5px; font-family: "monospace"; color: #475569; vertical-alignment: center; overflow: elide; }
                                Text { width: 88px; text: item.fecha_inicial_pago_str; font-size: 11px; color: #334155; horizontal-alignment: center; vertical-alignment: center; }
                                Text { width: 88px; text: item.fecha_final_pago_str; font-size: 11px; font-weight: 600; color: #0f172a; horizontal-alignment: center; vertical-alignment: center; }
                                Text { width: 88px; text: item.fecha_pago_str; font-size: 11px; color: #334155; horizontal-alignment: center; vertical-alignment: center; }
                                Text { width: 82px; text: item.fecha_emision_str; font-size: 11px; color: #64748b; horizontal-alignment: center; vertical-alignment: center; }

                                // Días Nóm. Editable
                                Rectangle {
                                    width: 92px;
                                    height: 28px;
                                    border-radius: 5px;
                                    background: btn_dias.has-hover ? #dbeafe : #eff6ff;
                                    border-width: 1px;
                                    border-color: #93c5fd;
                                    y: (parent.height - self.height) / 2;

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        Text {
                                            text: item.num_dias_pagados_str + "d";
                                            font-size: 12px;
                                            font-weight: 800;
                                            color: #1d4ed8;
                                            vertical-alignment: center;
                                        }
                                        Text { text: "✏"; font-size: 9px; color: #3b82f6; vertical-alignment: center; }
                                    }

                                    btn_dias := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { AppLogic.nominas_open_edit(item.id_nomina); }
                                    }
                                }

                                Text {
                                    width: 70px;
                                    text: item.dias_cedula_str;
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: item.sin_cedula ? #94a3b8 : #0f172a;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                Rectangle {
                                    width: 60px;
                                    height: 22px;
                                    border-radius: 5px;
                                    background: item.sin_cedula ? #f1f5f9 : (item.dias_coinciden ? #dcfce7 : #fef3c7);
                                    y: (parent.height - self.height) / 2;

                                    Text {
                                        text: item.dias_delta_str;
                                        font-size: 10.5px;
                                        font-weight: 800;
                                        color: item.sin_cedula ? #94a3b8 : (item.dias_coinciden ? #166534 : #92400e);
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                // Columnas dinámicas de percepciones
                                for v in item.percepciones_cols : Text {
                                    width: 110px;
                                    text: v;
                                    font-size: 11px;
                                    font-weight: 600;
                                    color: #6d28d9;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                // Percepciones: clic abre el detalle.
                                Rectangle {
                                    width: 110px;
                                    height: 26px;
                                    border-radius: 5px;
                                    background: btn_perc.has-hover ? #dcfce7 : #f0fdf4;
                                    border-width: 1px;
                                    border-color: #bbf7d0;
                                    y: (parent.height - self.height) / 2;

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        spacing: 4px;
                                        Text { text: "▸"; font-size: 9px; color: #15803d; vertical-alignment: center; }
                                        Text {
                                            text: item.total_percepciones_str;
                                            font-size: 11.5px;
                                            font-weight: 800;
                                            color: #166534;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }
                                    }

                                    btn_perc := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            AppLogic.nominas_open_percepciones(
                                                item.id_nomina,
                                                item.nombre_trabajador,
                                                item.periodo_str);
                                        }
                                    }
                                }

                                Text { width: 80px; text: item.total_gravado_str; font-size: 11px; color: #334155; horizontal-alignment: right; vertical-alignment: center; }
                                Text { width: 80px; text: item.total_exento_str; font-size: 11px; color: #334155; horizontal-alignment: right; vertical-alignment: center; }
                                Text { width: 80px; text: item.salario_diario_str; font-size: 11px; color: #475569; horizontal-alignment: right; vertical-alignment: center; }

                                // Acciones: Editar Días / Copiar Plantilla
                                HorizontalLayout {
                                    width: 120px;
                                    alignment: center;
                                    spacing: 6px;

                                    Rectangle {
                                        width: 50px;
                                        height: 24px;
                                        border-radius: 4px;
                                        background: btn_act_ed.has-hover ? #dbeafe : #eff6ff;
                                        border-width: 1px;
                                        border-color: #bfdbfe;
                                        y: (parent.height - self.height) / 2;

                                        Text {
                                            text: "✏ Días";
                                            font-size: 9.5px;
                                            font-weight: 700;
                                            color: #1d4ed8;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        btn_act_ed := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { AppLogic.nominas_open_edit(item.id_nomina); }
                                        }
                                    }

                                    Rectangle {
                                        width: 58px;
                                        height: 24px;
                                        border-radius: 4px;
                                        background: btn_act_cp.has-hover ? #f3e8ff : #faf5ff;
                                        border-width: 1px;
                                        border-color: #e9d5ff;
                                        y: (parent.height - self.height) / 2;

                                        Text {
                                            text: "📋 Copiar";
                                            font-size: 9.5px;
                                            font-weight: 700;
                                            color: #7e22ce;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }

                                        btn_act_cp := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => { AppLogic.nominas_open_copy_modal(item.id_empleado, item.id_nomina); }
                                        }
                                    }
                                }

                                // Desglose por mes del trabajador
                                HorizontalLayout {
                                    width: 190px;
                                    padding-left: 8px;
                                    spacing: 4px;

                                    if !AppData.nominas_mostrar_detalle : Text {
                                        text: "—";
                                        font-size: 11px;
                                        color: #cbd5e1;
                                        vertical-alignment: center;
                                    }

                                    for m in item.meses : MesDiaChip { mes: m; }
                                }
                            }

                            row_area := TouchArea {
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }

                // Totales por mes
                if AppData.nominas_totales_por_mes.length > 0 : Rectangle {
                    height: 36px;
                    background: #f1f5f9;
                    border-width: 1px;
                    border-color: #cbd5e1;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;

                        Text {
                            text: "TOTALES POR MES";
                            font-size: 10.5px;
                            font-weight: 800;
                            color: #475569;
                            vertical-alignment: center;
                        }

                        for t in AppData.nominas_totales_por_mes : Rectangle {
                            height: 24px;
                            border-radius: 5px;
                            background: #ffffff;
                            border-width: 1px;
                            border-color: #cbd5e1;

                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 5px;
                                Text { text: t.periodo; font-size: 10px; font-weight: 700; color: #0f172a; vertical-alignment: center; }
                                Text { text: t.nominas + "n"; font-size: 10px; color: #64748b; vertical-alignment: center; }
                                Text { text: t.dias_pagados_str + "d"; font-size: 10px; font-weight: 700; color: #0891b2; vertical-alignment: center; }
                                Text { text: "vs " + t.dias_cedula_str + "d"; font-size: 10px; font-weight: 700; color: #7c3aed; vertical-alignment: center; }
                                Text { text: t.percepciones_str; font-size: 10px; font-weight: 700; color: #166534; vertical-alignment: center; }
                            }
                        }

                        Rectangle { horizontal-stretch: 1; }
                    }
                }

                // Paginación
                Rectangle {
                    height: 44px;
                    background: #ffffff;
                    border-width: 1px;
                    border-color: #e2e8f0;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 10px;

                        Text {
                            text: "Mostrando " + (AppData.nominas_total_filtered > 0 ? (AppData.nominas_page_start_row + "–" + AppData.nominas_page_end_row) : "0") + " de " + AppData.nominas_total_filtered + " nómina(s)";
                            font-size: 12px;
                            color: #64748b;
                            vertical-alignment: center;
                        }

                        Rectangle { horizontal-stretch: 1; }

                        Rectangle {
                            height: 30px;
                            width: 34px;
                            border-radius: 6px;
                            background: prev.has-hover && AppData.nominas_page_current > 1 ? #eff6ff : #f8fafc;
                            border-width: 1px;
                            border-color: #e2e8f0;
                            opacity: AppData.nominas_page_current > 1 ? 1.0 : 0.4;

                            Text {
                                text: "‹";
                                font-size: 17px;
                                font-weight: 700;
                                color: #1e3a8a;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            prev := TouchArea {
                                enabled: AppData.nominas_page_current > 1;
                                mouse-cursor: pointer;
                                clicked => { AppLogic.nominas_prev_page(); }
                            }
                        }

                        Text {
                            text: AppData.nominas_page_current + " / " + AppData.nominas_page_total;
                            font-size: 12px;
                            font-weight: 700;
                            color: #0f172a;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            height: 30px;
                            width: 34px;
                            border-radius: 6px;
                            background: next.has-hover && AppData.nominas_page_current < AppData.nominas_page_total ? #eff6ff : #f8fafc;
                            border-width: 1px;
                            border-color: #e2e8f0;
                            opacity: AppData.nominas_page_current < AppData.nominas_page_total ? 1.0 : 0.4;

                            Text {
                                text: "›";
                                font-size: 17px;
                                font-weight: 700;
                                color: #1e3a8a;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            next := TouchArea {
                                enabled: AppData.nominas_page_current < AppData.nominas_page_total;
                                mouse-cursor: pointer;
                                clicked => { AppLogic.nominas_next_page(); }
                            }
                        }
                    }
                }
            }
        }
    }

    // ─── 5. Modal de percepciones ────────────────────────────────────────
    if AppData.nominas_show_percepciones : Rectangle {
        background: #00000030;

        TouchArea {
            clicked => { AppLogic.nominas_close_percepciones(); }
        }

        Rectangle {
            width: 720px;
            height: 520px;
            border-radius: 12px;
            background: #ffffff;
            border-width: 1px;
            border-color: #cbd5e1;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            drop-shadow-color: #0f172a33;
            drop-shadow-blur: 24px;

            VerticalLayout {
                padding: 18px;
                spacing: 12px;

                HorizontalLayout {
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: "Percepciones de la Nómina";
                            font-size: 16px;
                            font-weight: 800;
                            color: #0f172a;
                        }
                        Text {
                            text: AppData.nominas_percepciones_empleado + " · " + AppData.nominas_percepciones_periodo;
                            font-size: 12px;
                            color: #64748b;
                        }
                    }

                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 6px;
                        background: close.has-hover ? #fee2e2 : #f8fafc;
                        border-width: 1px;
                        border-color: #e2e8f0;

                        Text {
                            text: "✕";
                            font-size: 14px;
                            font-weight: 800;
                            color: #b91c1c;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        close := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.nominas_close_percepciones(); }
                        }
                    }
                }

                // Encabezado del detalle
                Rectangle {
                    height: 32px;
                    background: #f1f5f9;
                    border-radius: 6px;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Text { width: 70px; text: "Clave"; font-size: 11px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { width: 40px; text: "SAT"; font-size: 11px; font-weight: 700; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: "Concepto"; font-size: 11px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { width: 110px; text: "Gravado"; font-size: 11px; font-weight: 700; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                        Text { width: 110px; text: "Exento"; font-size: 11px; font-weight: 700; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                        Text { width: 110px; text: "Importe"; font-size: 11px; font-weight: 700; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 0px;

                        if AppData.nominas_percepciones_detalle.length == 0 : Text {
                            text: "Esta nómina no tiene percepciones registradas.";
                            font-size: 12px;
                            color: #94a3b8;
                            letter-spacing: 16px;
                        }

                        for p in AppData.nominas_percepciones_detalle : Rectangle {
                            height: 34px;
                            background: p_row.has-hover ? #f8fafc : transparent;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                Text { width: 70px; text: p.clave; font-size: 11px; font-family: "monospace"; color: #334155; vertical-alignment: center; }
                                Text { width: 40px; text: p.tipo_sat; font-size: 11px; font-family: "monospace"; color: #64748b; horizontal-alignment: center; vertical-alignment: center; }
                                Text { horizontal-stretch: 1; text: p.concepto; font-size: 12px; color: #0f172a; vertical-alignment: center; overflow: elide; }
                                Text { width: 110px; text: p.gravado_str; font-size: 11.5px; color: #334155; horizontal-alignment: right; vertical-alignment: center; }
                                Text { width: 110px; text: p.exento_str; font-size: 11.5px; color: #334155; horizontal-alignment: right; vertical-alignment: center; }
                                Text { width: 110px; text: p.importe_str; font-size: 12px; font-weight: 800; color: #166534; horizontal-alignment: right; vertical-alignment: center; }
                            }

                            p_row := TouchArea { horizontal-stretch: 1; }
                        }
                    }
                }

                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: "Solo percepciones; las deducciones no se incluyen en este reporte.";
                        font-size: 11px;
                        color: #94a3b8;
                    }

                    Rectangle {
                        height: 32px;
                        width: 210px;
                        border-radius: 6px;
                        background: #f0fdf4;
                        border-width: 1px;
                        border-color: #bbf7d0;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;
                            Text { text: "TOTAL PERCEPCIONES"; font-size: 11px; font-weight: 700; color: #166534; vertical-alignment: center; }
                            Text { text: AppData.nominas_percepciones_total_str; font-size: 13px; font-weight: 800; color: #15803d; vertical-alignment: center; }
                        }
                    }
                }
            }
        }
    }

    // ─── 6. Modal de Edición de Días y Percepciones (Fórmula) ────────────
    if AppData.nominas_show_edit_modal : Rectangle {
        background: #00000045;

        TouchArea {
            // bloquear clics de fondo
        }

        Rectangle {
            width: 700px;
            height: 560px;
            border-radius: 12px;
            background: #ffffff;
            border-width: 1px;
            border-color: #cbd5e1;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            drop-shadow-color: #0f172a33;
            drop-shadow-blur: 24px;

            VerticalLayout {
                padding: 20px;
                spacing: 12px;

                HorizontalLayout {
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: "✏ Modificar Días de Nómina y Percepciones";
                            font-size: 16px;
                            font-weight: 800;
                            color: #0f172a;
                        }
                        Text {
                            text: AppData.nominas_edit_empleado + " · " + AppData.nominas_edit_periodo;
                            font-size: 12px;
                            color: #64748b;
                        }
                    }

                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 6px;
                        background: close_ed.has-hover ? #fee2e2 : #f8fafc;
                        border-width: 1px;
                        border-color: #e2e8f0;

                        Text {
                            text: "✕";
                            font-size: 14px;
                            font-weight: 800;
                            color: #b91c1c;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        close_ed := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.nominas_close_edit(); }
                        }
                    }
                }

                // Banner de advertencia si tiene baja
                if AppData.nominas_edit_is_baja : Rectangle {
                    height: 48px;
                    border-radius: 6px;
                    background: #fef2f2;
                    border-width: 1px;
                    border-color: #fca5a5;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        alignment: start;

                        Text { text: "⚠"; font-size: 16px; vertical-alignment: center; color: #b91c1c; }
                        Text {
                            text: AppData.nominas_edit_baja_warning != "" ? AppData.nominas_edit_baja_warning : "Empleado con BAJA en cédula de liquidaciones. Esta nómina no debe modificarse según días trabajados en obra y días pagados.";
                            font-size: 11px;
                            font-weight: 600;
                            color: #991b1b;
                            vertical-alignment: center;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }
                    }
                }

                // Panel de Días: Originales vs Modificados y Fórmula
                Rectangle {
                    height: 60px;
                    background: #f8fafc;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #e2e8f0;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 16px;

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text { text: "DÍAS ORIGINALES"; font-size: 10px; font-weight: 700; color: #64748b; }
                            Text { text: AppData.nominas_edit_dias_original_str + " días"; font-size: 15px; font-weight: 800; color: #1e293b; }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text { text: "NUEVOS DÍAS A MODIFICAR"; font-size: 10px; font-weight: 700; color: #2563eb; }
                            LineEdit {
                                width: 120px;
                                height: 32px;
                                text: AppData.nominas_edit_dias_input;
                                enabled: !AppData.nominas_edit_is_baja;
                                edited(val) => { AppLogic.nominas_edit_recalc_dias(val); }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            horizontal-stretch: 1;
                            Text {
                                text: "💡 Fórmula de Recálculo:";
                                font-size: 10px;
                                font-weight: 700;
                                color: #475569;
                            }
                            Text {
                                text: "Concepto = (Importe Original / Días Originales) * Nuevos Días";
                                font-size: 10px;
                                color: #64748b;
                            }
                        }
                    }
                }

                // Tabla de conceptos de percepción
                Rectangle {
                    height: 28px;
                    background: #f1f5f9;
                    border-radius: 6px;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Text { width: 70px; text: "Clave"; font-size: 10.5px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: "Concepto Percepción"; font-size: 10.5px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { width: 110px; text: "Importe Original"; font-size: 10.5px; font-weight: 700; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                        Text { width: 130px; text: "Importe Recalculado"; font-size: 10.5px; font-weight: 700; color: #2563eb; horizontal-alignment: right; vertical-alignment: center; }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 4px;

                        for cp[idx] in AppData.nominas_edit_conceptos : Rectangle {
                            height: 36px;
                            background: #ffffff;
                            border-radius: 5px;
                            border-width: 1px;
                            border-color: #e2e8f0;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                Text { width: 70px; text: cp.clave; font-size: 11px; font-family: "monospace"; color: #475569; vertical-alignment: center; }
                                Text { horizontal-stretch: 1; text: cp.concepto; font-size: 11px; font-weight: 600; color: #0f172a; vertical-alignment: center; overflow: elide; }
                                Text { width: 110px; text: cp.importe_original_str; font-size: 11px; color: #64748b; horizontal-alignment: right; vertical-alignment: center; }
                                LineEdit {
                                    width: 130px;
                                    height: 28px;
                                    text: cp.importe_actual_str;
                                    enabled: !AppData.nominas_edit_is_baja;
                                    edited(val) => { AppLogic.nominas_edit_update_concepto(idx, val); }
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "TOTAL PERCEPCIONES:"; font-size: 12px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { text: AppData.nominas_edit_total_str; font-size: 14px; font-weight: 800; color: #16a34a; vertical-alignment: center; }
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        Rectangle {
                            height: 36px;
                            width: 100px;
                            border-radius: 6px;
                            background: btn_c_can.has-hover ? #f1f5f9 : #f8fafc;
                            border-width: 1px;
                            border-color: #cbd5e1;

                            Text {
                                text: "Cancelar";
                                font-size: 12px;
                                font-weight: 600;
                                color: #475569;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            btn_c_can := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { AppLogic.nominas_close_edit(); }
                            }
                        }

                        Rectangle {
                            height: 36px;
                            width: 140px;
                            border-radius: 6px;
                            background: AppData.nominas_edit_is_baja ? #cbd5e1 : (btn_c_save.has-hover ? #1d4ed8 : #2563eb);
                            opacity: AppData.nominas_edit_is_baja ? 0.5 : 1.0;

                            Text {
                                text: "Guardar Cambios";
                                font-size: 12px;
                                font-weight: 700;
                                color: #ffffff;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            btn_c_save := TouchArea {
                                enabled: !AppData.nominas_edit_is_baja;
                                mouse-cursor: pointer;
                                clicked => { AppLogic.nominas_save_edit(); }
                            }
                        }
                    }
                }
            }
        }
    }

    // ─── 7. Modal de Copiar Plantilla / Crear Nómina ─────────────────────
    if AppData.nominas_show_copy_modal : Rectangle {
        background: #00000045;

        TouchArea {
            // bloquear clics
        }

        Rectangle {
            width: 720px;
            height: 580px;
            border-radius: 12px;
            background: #ffffff;
            border-width: 1px;
            border-color: #cbd5e1;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            drop-shadow-color: #0f172a33;
            drop-shadow-blur: 24px;

            VerticalLayout {
                padding: 20px;
                spacing: 12px;

                HorizontalLayout {
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: "📋 Crear Nómina a partir de Plantilla";
                            font-size: 16px;
                            font-weight: 800;
                            color: #0f172a;
                        }
                        Text {
                            text: "Empleado: " + AppData.nominas_copy_empleado;
                            font-size: 12px;
                            font-weight: 600;
                            color: #64748b;
                        }
                    }

                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 6px;
                        background: close_cp.has-hover ? #fee2e2 : #f8fafc;
                        border-width: 1px;
                        border-color: #e2e8f0;

                        Text {
                            text: "✕";
                            font-size: 14px;
                            font-weight: 800;
                            color: #b91c1c;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        close_cp := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.nominas_close_copy_modal(); }
                        }
                    }
                }

                // Selección de Plantilla Origen
                Rectangle {
                    height: 52px;
                    background: #f8fafc;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #e2e8f0;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 12px;
                        alignment: center;

                        Text { text: "Nómina a Copiar (Plantilla):"; font-size: 11px; font-weight: 700; color: #475569; vertical-alignment: center; }

                        ComboBox {
                            horizontal-stretch: 1;
                            height: 32px;
                            model: AppData.nominas_copy_template_labels;
                            current-index <=> AppData.nominas_copy_selected_template_idx;
                            selected(idx) => { AppLogic.nominas_copy_select_template(self.current-index); }
                        }
                    }
                }

                // Periodo Destino y Días
                Rectangle {
                    height: 60px;
                    background: #f8fafc;
                    border-radius: 6px;
                    border-width: 1px;
                    border-color: #e2e8f0;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 14px;

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text { text: "Mes Destino"; font-size: 10px; font-weight: 700; color: #475569; }
                            ComboBox {
                                width: 140px;
                                height: 30px;
                                model: AppData.nominas_copy_mes_options;
                                current-index <=> AppData.nominas_copy_target_mes_idx;
                                selected(idx) => { AppLogic.nominas_copy_select_mes(self.current-index); }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text { text: "Año Destino"; font-size: 10px; font-weight: 700; color: #475569; }
                            LineEdit {
                                width: 80px;
                                height: 30px;
                                text: AppData.nominas_copy_target_anio;
                                edited(val) => { AppLogic.nominas_copy_set_anio(val); }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;
                            Text { text: "Días Nómina Destino"; font-size: 10px; font-weight: 700; color: #2563eb; }
                            LineEdit {
                                width: 110px;
                                height: 30px;
                                text: AppData.nominas_copy_dias_input;
                                edited(val) => { AppLogic.nominas_copy_recalc_dias(val); }
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 1px;
                            horizontal-stretch: 1;
                            Text {
                                text: "Plantilla original: " + AppData.nominas_copy_dias_original_str + " días";
                                font-size: 10px;
                                font-weight: 600;
                                color: #64748b;
                            }
                            Text {
                                text: "Los valores se recalculan proporcionalmente.";
                                font-size: 9.5px;
                                color: #94a3b8;
                            }
                        }
                    }
                }

                // Lista de Percepciones Calculadas
                Rectangle {
                    height: 28px;
                    background: #f1f5f9;
                    border-radius: 6px;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Text { width: 70px; text: "Clave"; font-size: 10.5px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: "Concepto Percepción"; font-size: 10.5px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { width: 110px; text: "Monto Plantilla"; font-size: 10.5px; font-weight: 700; color: #475569; horizontal-alignment: right; vertical-alignment: center; }
                        Text { width: 130px; text: "Monto Destino (Editable)"; font-size: 10.5px; font-weight: 700; color: #2563eb; horizontal-alignment: right; vertical-alignment: center; }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 4px;

                        for cp[idx] in AppData.nominas_copy_conceptos : Rectangle {
                            height: 36px;
                            background: #ffffff;
                            border-radius: 5px;
                            border-width: 1px;
                            border-color: #e2e8f0;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;
                                Text { width: 70px; text: cp.clave; font-size: 11px; font-family: "monospace"; color: #475569; vertical-alignment: center; }
                                Text { horizontal-stretch: 1; text: cp.concepto; font-size: 11px; font-weight: 600; color: #0f172a; vertical-alignment: center; overflow: elide; }
                                Text { width: 110px; text: cp.importe_original_str; font-size: 11px; color: #64748b; horizontal-alignment: right; vertical-alignment: center; }
                                LineEdit {
                                    width: 130px;
                                    height: 28px;
                                    text: cp.importe_actual_str;
                                    edited(val) => { AppLogic.nominas_copy_update_concepto(idx, val); }
                                }
                            }
                        }
                    }
                }

                HorizontalLayout {
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px;
                        Text { text: "TOTAL NUEVA NÓMINA:"; font-size: 12px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { text: AppData.nominas_copy_total_str; font-size: 14px; font-weight: 800; color: #16a34a; vertical-alignment: center; }
                    }

                    HorizontalLayout {
                        spacing: 8px;

                        Rectangle {
                            height: 36px;
                            width: 100px;
                            border-radius: 6px;
                            background: btn_cp_can.has-hover ? #f1f5f9 : #f8fafc;
                            border-width: 1px;
                            border-color: #cbd5e1;

                            Text {
                                text: "Cancelar";
                                font-size: 12px;
                                font-weight: 600;
                                color: #475569;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            btn_cp_can := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { AppLogic.nominas_close_copy_modal(); }
                            }
                        }

                        Rectangle {
                            height: 36px;
                            width: 180px;
                            border-radius: 6px;
                            background: btn_cp_submit.has-hover ? #15803d : #16a34a;

                            Text {
                                text: "Crear Nómina en Reporte";
                                font-size: 12px;
                                font-weight: 700;
                                color: #ffffff;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                            btn_cp_submit := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { AppLogic.nominas_submit_create_nomina(); }
                            }
                        }
                    }
                }
            }
        }
    }

    // ─── 8. Modal de Detector de Nóminas Faltantes y Creación Masiva ──────
    if AppData.nominas_show_faltantes_modal : Rectangle {
        background: #00000045;

        TouchArea {
            // bloquear clics
        }

        Rectangle {
            width: 860px;
            height: 620px;
            border-radius: 12px;
            background: #ffffff;
            border-width: 1px;
            border-color: #cbd5e1;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            drop-shadow-color: #0f172a33;
            drop-shadow-blur: 24px;

            VerticalLayout {
                padding: 20px;
                spacing: 12px;

                HorizontalLayout {
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: "🔍 Detector de Nóminas Faltantes (según Cédulas de Cuotas)";
                            font-size: 17px;
                            font-weight: 800;
                            color: #0f172a;
                        }
                        Text {
                            text: "Identifica a qué empleados les hace falta nómina en base a las cédulas de cuotas y su clave (Alta, Baja, Reing).";
                            font-size: 11.5px;
                            color: #64748b;
                        }
                    }

                    Rectangle {
                        width: 32px;
                        height: 32px;
                        border-radius: 6px;
                        background: close_fl.has-hover ? #fee2e2 : #f8fafc;
                        border-width: 1px;
                        border-color: #e2e8f0;

                        Text {
                            text: "✕";
                            font-size: 14px;
                            font-weight: 800;
                            color: #b91c1c;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        close_fl := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.nominas_close_faltantes_modal(); }
                        }
                    }
                }

                // Barra de Acciones Masivas
                Rectangle {
                    height: 50px;
                    background: #f8fafc;
                    border-radius: 8px;
                    border-width: 1px;
                    border-color: #e2e8f0;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 12px;
                        alignment: center;

                        Rectangle {
                            width: 150px;
                            height: 32px;
                            border-radius: 6px;
                            background: btn_sel_all.has-hover ? #e2e8f0 : #f1f5f9;
                            border-width: 1px;
                            border-color: #cbd5e1;

                            HorizontalLayout {
                                alignment: center;
                                spacing: 6px;
                                Text {
                                    text: AppData.nominas_faltantes_all_selected ? "☑" : "☐";
                                    font-size: 13px;
                                    color: #1e293b;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: AppData.nominas_faltantes_all_selected ? "Deseleccionar" : "Seleccionar Todas";
                                    font-size: 11.5px;
                                    font-weight: 600;
                                    color: #334155;
                                    vertical-alignment: center;
                                }
                            }

                            btn_sel_all := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { AppLogic.nominas_faltantes_toggle_all(!AppData.nominas_faltantes_all_selected); }
                            }
                        }

                        Text {
                            text: "Seleccionadas: " + AppData.nominas_faltantes_selected_count + " de " + AppData.nominas_faltantes_list.length;
                            font-size: 12px;
                            font-weight: 600;
                            color: #475569;
                            vertical-alignment: center;
                        }

                        Rectangle { horizontal-stretch: 1; }

                        // Botón Creación Masiva
                        Rectangle {
                            height: 34px;
                            width: 260px;
                            border-radius: 6px;
                            background: AppData.nominas_faltantes_selected_count > 0 ? (btn_bulk.has-hover ? #1d4ed8 : #2563eb) : #cbd5e1;
                            opacity: AppData.nominas_faltantes_selected_count > 0 ? 1.0 : 0.6;

                            HorizontalLayout {
                                alignment: center;
                                spacing: 6px;
                                Text { text: "⚡"; font-size: 12px; vertical-alignment: center; }
                                Text {
                                    text: "Crear Faltantes de Forma Masiva";
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: #ffffff;
                                    vertical-alignment: center;
                                }
                            }

                            btn_bulk := TouchArea {
                                enabled: AppData.nominas_faltantes_selected_count > 0;
                                mouse-cursor: pointer;
                                clicked => { AppLogic.nominas_faltantes_crear_masivo(); }
                            }
                        }
                    }
                }

                // Encabezado de la tabla de faltantes
                Rectangle {
                    height: 30px;
                    background: #f1f5f9;
                    border-radius: 6px;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        spacing: 8px;
                        Text { width: 30px; text: "Sel."; font-size: 10.5px; font-weight: 700; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                        Text { horizontal-stretch: 1; text: "Trabajador"; font-size: 10.5px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { width: 90px; text: "NSS"; font-size: 10.5px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { width: 100px; text: "Periodo Faltante"; font-size: 10.5px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { width: 65px; text: "Clave"; font-size: 10.5px; font-weight: 700; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                        Text { width: 105px; text: "Días (Céd / Nóm)"; font-size: 10.5px; font-weight: 700; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                        Text { width: 120px; text: "Plantilla Sugerida"; font-size: 10.5px; font-weight: 700; color: #475569; vertical-alignment: center; }
                        Text { width: 110px; text: "Acción"; font-size: 10.5px; font-weight: 700; color: #475569; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }

                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 2px;

                        if AppData.nominas_faltantes_list.length == 0 : Rectangle {
                            height: 140px;

                            VerticalLayout {
                                alignment: center;
                                spacing: 6px;
                                Text { text: "🎉"; font-size: 28px; horizontal-alignment: center; }
                                Text {
                                    text: "¡No se detectaron nóminas faltantes!";
                                    font-size: 13.5px;
                                    font-weight: 700;
                                    color: #166534;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Todos los empleados con obras creadas por el usuario tienen cubiertos sus días según las cédulas de cuotas.";
                                    font-size: 11px;
                                    color: #64748b;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        for f[idx] in AppData.nominas_faltantes_list : Rectangle {
                            height: 40px;
                            background: f_row.has-hover ? #f8fafc : (f.selected ? #eff6ff : #ffffff);
                            border-radius: 4px;
                            border-width: 1px;
                            border-color: f.selected ? #bfdbfe : #f1f5f9;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 8px;

                                // Checkbox individual
                                Rectangle {
                                    width: 30px;
                                    height: 24px;
                                    y: (parent.height - self.height) / 2;

                                    Text {
                                        text: f.selected ? "☑" : "☐";
                                        font-size: 14px;
                                        color: f.selected ? #2563eb : #94a3b8;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { AppLogic.nominas_faltantes_toggle_item(idx); }
                                    }
                                }

                                Text { horizontal-stretch: 1; text: f.nombre_trabajador; font-size: 11.5px; font-weight: 600; color: #0f172a; vertical-alignment: center; overflow: elide; }
                                Text { width: 90px; text: f.nss; font-size: 10.5px; font-family: "monospace"; color: #475569; vertical-alignment: center; }
                                Text { width: 100px; text: f.periodo_str; font-size: 11px; font-weight: 700; color: #1e3a8a; vertical-alignment: center; }

                                // Badge Clave
                                Rectangle {
                                    width: 65px;
                                    height: 22px;
                                    border-radius: 4px;
                                    background: f.clave == "ALTA" ? #dcfce7 : (f.clave == "BAJA" ? #fee2e2 : (f.clave == "REING" ? #f3e8ff : #f1f5f9));
                                    border-width: 1px;
                                    border-color: f.clave == "ALTA" ? #86efac : (f.clave == "BAJA" ? #fca5a5 : (f.clave == "REING" ? #d8b4fe : #cbd5e1));
                                    y: (parent.height - self.height) / 2;

                                    Text {
                                        text: f.clave;
                                        font-size: 9.5px;
                                        font-weight: 800;
                                        color: f.clave == "ALTA" ? #166534 : (f.clave == "BAJA" ? #991b1b : (f.clave == "REING" ? #6b21a8 : #475569));
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    width: 105px;
                                    text: f.dias_cedula_str + "d / " + f.dias_nomina_str + "d (+" + f.dias_faltantes_str + "d)";
                                    font-size: 10px;
                                    font-weight: 700;
                                    color: #b45309;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                Text {
                                    width: 120px;
                                    text: f.template_label;
                                    font-size: 10px;
                                    color: f.tiene_plantilla ? #475569 : #94a3b8;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                // Botón Crear individual
                                Rectangle {
                                    width: 110px;
                                    height: 26px;
                                    border-radius: 4px;
                                    background: btn_f_cr.has-hover ? #dbeafe : #eff6ff;
                                    border-width: 1px;
                                    border-color: #93c5fd;
                                    y: (parent.height - self.height) / 2;

                                    HorizontalLayout {
                                        alignment: center;
                                        spacing: 4px;
                                        Text { text: "📋"; font-size: 9px; vertical-alignment: center; }
                                        Text {
                                            text: "Crear / Copiar";
                                            font-size: 10px;
                                            font-weight: 700;
                                            color: #1d4ed8;
                                            vertical-alignment: center;
                                        }
                                    }

                                    btn_f_cr := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { AppLogic.nominas_faltantes_crear_individual(idx); }
                                    }
                                }
                            }

                            f_row := TouchArea { horizontal-stretch: 1; }
                        }
                    }
                }

                HorizontalLayout {
                    alignment: space-between;

                    Text {
                        text: AppData.nominas_faltantes_status_msg != "" ? AppData.nominas_faltantes_status_msg : "Para crear nóminas individuales o masivas, se utiliza la nómina más reciente del empleado como plantilla.";
                        font-size: 11px;
                        color: #64748b;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        height: 36px;
                        width: 110px;
                        border-radius: 6px;
                        background: btn_f_close.has-hover ? #f1f5f9 : #ffffff;
                        border-width: 1px;
                        border-color: #cbd5e1;

                        Text {
                            text: "Cerrar";
                            font-size: 12px;
                            font-weight: 600;
                            color: #475569;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        btn_f_close := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.nominas_close_faltantes_modal(); }
                        }
                    }
                }
            }
        }
    }
}