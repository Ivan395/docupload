import { StatusPill } from "common.slint";
import { AppData } from "models.slint";

export component NavBar inherits Rectangle {
    height: 70px;
    background: #ffffff;
    border-width: 1px;
    border-color: #e2e8f0;

    HorizontalLayout {
        padding-left: 32px;
        padding-right: 32px;
        alignment: space-between;

        // Izquierda: Logo y Título
        HorizontalLayout {
            spacing: 16px;
            alignment: center;

            HorizontalLayout {
                spacing: 10px;

                VerticalLayout {
                    alignment: center;

                    Image {
                        source: @image-url("assets/app_icon.png");
                        width: 32px;
                        height: 32px;
                    }
                }

                VerticalLayout {
                    alignment: center;
                    spacing: 2px;
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text {
                            text: "DocuUpload Fiscal & Nóminas";
                            font-size: 18px;
                            font-weight: 800;
                            color: #0f172a;
                        }
                        Rectangle {
                            height: 20px;
                            background: #e0f2fe;
                            border-radius: 10px;
                            y: 2px;
                            HorizontalLayout {
                                padding-left: 7px;
                                padding-right: 7px;
                                Text {
                                    text: "v0.5.0";
                                    font-size: 11px;
                                    font-weight: 700;
                                    color: #0369a1;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                    Text {
                        text: "Validación SAT SOAP y Procesamiento SUA IMSS";
                        font-size: 12.5px;
                        color: #64748b;
                    }
                }
            }
        }

        // Centro: Estado actual
        VerticalLayout {
            alignment: center;
            StatusPill {
                text: AppData.status_message;
                dot-color: AppData.is_processing ? #3b82f6 : (AppData.has_results ? #10b981 : #64748b);
                text-color: AppData.is_processing ? #1e40af : (AppData.has_results ? #065f46 : #334155);
                pill-background: AppData.is_processing ? #dbeafe : (AppData.has_results ? #d1fae5 : #f1f5f9);
            }
        }

        // Derecha: Badge de Usuario
        VerticalLayout {
            alignment: center;

            Rectangle {
                height: 40px;
                background: #f8fafc;
                border-radius: 20px;
                border-width: 1px;
                border-color: #e2e8f0;

                HorizontalLayout {
                    padding-left: 14px;
                    padding-right: 6px;
                    spacing: 10px;
                    alignment: center;

                    Text {
                        text: "Firma Fiscal ACD";
                        font-size: 13px;
                        font-weight: 700;
                        color: #1e293b;
                        vertical-alignment: center;
                    }

                    Rectangle {
                        width: 30px;
                        height: 30px;
                        border-radius: 15px;
                        background: #1d4ed8;
                        Text {
                            text: "👤";
                            color: #ffffff;
                            font-size: 14px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
