import { ScrollView } from "std-widgets.slint";
import { NavBar } from "navbar.slint";
import { Sidebar } from "sidebar.slint";
import { TopBar } from "topbar.slint";
import { BottomBar } from "bottom_bar.slint";
import { ClientesView } from "clientes_view.slint";
import { RegistrosPatronalesView } from "registros_patronales_view.slint";
import { RevisionesView } from "revisiones_view.slint";
import { RegistrosObrasView } from "registros_obras_view.slint";
import { EmpleadosView } from "empleados_view.slint";
import { CedulaCuotasView } from "cedula_cuotas_view.slint";
import { ReporteLiquidacionesView } from "reporte_liquidaciones_view.slint";
import { CalendarioView } from "calendario_view.slint";
import { NominasView } from "nominas_view.slint";
import { NominasUploadView } from "nominas_upload_view.slint";

import { UploadCard } from "upload_card.slint";
import { ActionPanel } from "action_panel.slint";
import { ResultsPanel } from "results_panel.slint";
import { UpdateModal } from "update_modal.slint";
export { AppData, AppLogic, DateHelper, DateDmy, FileItemData, UnprocessedItemData, MismatchDetailItem, ProcessingSummary, ClienteCardData, RegistroPatronalData, EmpleadoData, RevisionData, RegistroObraData, CedulaFileItem, CedulaDetalleRow, CedulaSumatoriaRow, ReporteObraItem, ReporteLiquidacionRow, CalendarDayCell, CalendarHolidayItem, CalendarRevisionItem } from "models.slint";
import { AppData, AppLogic } from "models.slint";

export component MainWindow inherits Window {
    title: "Firma Fiscal ACD v0.5.0 - IMSS Correcciones Patronales";
    icon: @image-url("assets/app_icon.png");
    min-width: 1240px;
    min-height: 820px;
    preferred-width: 1440px;
    preferred-height: 900px;
    background: #f4f6fa;
    default-font-family: "Segoe UI, sans-serif";

    HorizontalLayout {
        padding: 0px;
        spacing: 0px;

        // 1. Barra Lateral de Navegación (Sidebar Colapsable)
        if AppData.is_sidebar_open : Sidebar {}

        // 2. Contenedor Principal Derecho (TopBar + Vista Activa + BottomBar)
        VerticalLayout {
            horizontal-stretch: 1;
            min-width: 0px;
            padding: 0px;
            spacing: 0px;

            // Publica el ancho del área de contenido para que las vistas con
            // tabla adaptativa (nóminas) decidan qué columnas caben. Mide este
            // elemento en lugar de `self.width` de la ventana para no crear un
            // ciclo de binding con el layout de la propia tabla.
            Rectangle {
                height: 0px;
                background: transparent;
                in property <length> avail_w: self.width;
                changed avail_w => { AppLogic.view_resized(avail_w); }
            }

            // Barra Superior de Contexto y Breadcrumbs
            TopBar {}

            // VISTA 0: Carga y Procesamiento de Nóminas y Cédulas (Auditoría General)
            if AppData.current_view == 0 : ScrollView {
                content-width: self.width;
                vertical-stretch: 1;

                VerticalLayout {
                    padding: 28px;
                    spacing: 20px;

                    // Títulos
                    HorizontalLayout {
                        alignment: space-between;

                        VerticalLayout {
                            spacing: 6px;
                            Text {
                                text: "Auditoría General: Carga de Nóminas y Cédulas SUA";
                                font-size: 24px;
                                font-weight: 800;
                                color: #0f172a;
                            }
                            Text {
                                text: "Valida UUIDs vigentes ante el SAT (SOAP), extrae cuotas IMSS e inserta concurrentemente en PostgreSQL.";
                                font-size: 13px;
                                color: #475569;
                            }
                        }
                    }

                    // Banner Informativo
                    Rectangle {
                        height: 52px;
                        background: #ebf5ff;
                        border-radius: 10px;
                        border-width: 1px;
                        border-color: #bfdbfe;

                        HorizontalLayout {
                            padding-left: 18px;
                            padding-right: 18px;
                            spacing: 12px;
                            alignment: start;

                            Rectangle {
                                width: 26px;
                                height: 26px;
                                border-radius: 13px;
                                background: #dbeafe;
                                y: (parent.height - self.height) / 2;

                                Text {
                                    text: "ℹ";
                                    font-size: 13px;
                                    font-weight: 800;
                                    color: #1d4ed8;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            Text {
                                text: "Puedes ingresar Nóminas (.XML, .ZIP, .RAR) y/o Cédulas SUA (.PDF, .ZIP, .RAR). Se vincularán automáticamente a los Clientes.";
                                font-size: 13px;
                                font-weight: 600;
                                color: #1e3a8a;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Tarjetas de Carga
                    HorizontalLayout {
                        width: 100%;
                        spacing: 20px;

                        // Nóminas
                        UploadCard {
                            horizontal-stretch: 1;
                            step-number: "1";
                            step-color-bg: #e0e7ff;
                            step-color-fg: #1d4ed8;
                            title: "Nóminas de Sueldos y Salarios";
                            subtitle: "Archivos XML timbrados. Validados ante el WS SOAP del SAT.";
                            drop-icon: "☁";
                            drop-icon-bg: #e0e7ff;
                            drop-icon-fg: #2563eb;
                            drop-action-text: "haz clic para explorar";
                            drop-info-text: "Valida UUID vigente en el SAT y filtra cancelados";
                            primary-format: ".XML";
                            total-badge: AppData.nominas_total_size;
                            count-label: AppData.nominas_files.length + " archivos cargados";
                            files: AppData.nominas_files;

                            is-processing: AppData.nominas_is_processing;
                            progress-fraction: AppData.nominas_progress_fraction;
                            progress-text: AppData.nominas_progress_text;
                            ready-to-download: AppData.nominas_ready_to_download;
                            download-button-text: "Descargar Excel Nóminas";
                            process-button-text: "Procesar Nóminas";

                            add-files => { AppLogic.select_nominas_files(); }
                            add-folder => { AppLogic.select_nominas_folder(); }
                            clear-files => { AppLogic.clear_nominas(); }
                            remove-file(id) => { AppLogic.remove_nomina_file(id); }
                            download => { AppLogic.download_nominas_excel(); }
                            process => { AppLogic.process_nominas(); }
                            open-folder => { AppLogic.open_nominas_folder(); }
                        }

                        // Cédulas
                        UploadCard {
                            horizontal-stretch: 1;
                            step-number: "2";
                            step-color-bg: #ccfbf1;
                            step-color-fg: #0f766e;
                            title: "Cédulas de Determinación de Cuotas";
                            subtitle: "Cédulas generadas por el SUA en formato PDF (mensuales/bimestrales).";
                            drop-icon: "📥";
                            drop-icon-bg: #ccfbf1;
                            drop-icon-fg: #0f766e;
                            drop-action-text: "haz clic para examinar";
                            drop-info-text: "Extracción automática mediante motor de layout SUA";
                            primary-format: ".PDF";
                            total-badge: AppData.cedulas_total_size;
                            count-label: AppData.cedulas_files.length + " archivos cargados";
                            files: AppData.cedulas_files;

                            is-processing: AppData.cedulas_is_processing;
                            progress-fraction: AppData.cedulas_progress_fraction;
                            progress-text: AppData.cedulas_progress_text;
                            ready-to-download: AppData.cedulas_ready_to_download;
                            download-button-text: "Descargar Excel Cédulas";
                            process-button-text: "Procesar Cédulas";

                            add-files => { AppLogic.select_cedulas_files(); }
                            add-folder => { AppLogic.select_cedulas_folder(); }
                            clear-files => { AppLogic.clear_cedulas(); }
                            remove-file(id) => { AppLogic.remove_cedula_file(id); }
                            download => { AppLogic.download_cedulas_excel(); }
                            process => { AppLogic.process_cedulas(); }
                            open-folder => { AppLogic.open_cedulas_folder(); }
                        }
                    }

                    // Panel de Acción
                    ActionPanel {}

                    // Panel de Resultados
                    if AppData.has_results : ResultsPanel {}
                }
            }

            // VISTA 1: Catálogo Maestro de Clientes (F2)
            if AppData.current_view == 1 : ClientesView {
                vertical-stretch: 1;
                horizontal-stretch: 1;
                min-width: 0px;
            }

            // VISTA 2: Registros Patronales IMSS (F3)
            if AppData.current_view == 2 : RegistrosPatronalesView {
                vertical-stretch: 1;
                horizontal-stretch: 1;
                min-width: 0px;
            }

            // VISTA 3: Revisiones Patronales IMSS (F4)
            if AppData.current_view == 3 : RevisionesView {
                vertical-stretch: 1;
                horizontal-stretch: 1;
                min-width: 0px;
            }

            // VISTA 4: Registros de Obras (F5)
            if AppData.current_view == 4 : RegistrosObrasView {
                vertical-stretch: 1;
                horizontal-stretch: 1;
                min-width: 0px;
            }

            // VISTA 5: Padrón de Empleados (F6)
            if AppData.current_view == 5 : EmpleadosView {
                vertical-stretch: 1;
                horizontal-stretch: 1;
                min-width: 0px;
            }

            // VISTA 6: Cédula de Determinación de Cuotas SUA (F7)
            if AppData.current_view == 6 : CedulaCuotasView {
                vertical-stretch: 1;
                horizontal-stretch: 1;
                min-width: 0px;
            }

            // VISTA 7: Reporte de Liquidaciones y Prorrateo por Obra (F8)
            if AppData.current_view == 7 : ReporteLiquidacionesView {
                vertical-stretch: 1;
                horizontal-stretch: 1;
                min-width: 0px;
            }

            // VISTA 8: Calendario Fiscal & Revisiones Patronales IMSS (F9)
            if AppData.current_view == 8 : CalendarioView {
                vertical-stretch: 1;
                horizontal-stretch: 1;
                min-width: 0px;
            }

            // VISTA 9: Reporte de Nóminas (F10)
            if AppData.current_view == 9 : NominasView {
                vertical-stretch: 1;
                horizontal-stretch: 1;
                min-width: 0px;
            }

            // VISTA 10: Carga y Procesamiento de Nóminas
            if AppData.current_view == 10 : NominasUploadView {
                vertical-stretch: 1;
                horizontal-stretch: 1;
                min-width: 0px;
            }

            // 3. Barra Inferior de Estado Global (BottomBar)
            BottomBar {}
        }
    }

    // TOAST FLOTANTE GLOBAL PARA NOTIFICACIONES Y ALERTAS (Visible por encima de todas las vistas y modales)
    if AppData.show_toast : Rectangle {
        y: 20px;
        x: (parent.width - self.width) / 2;
        width: Math.min(parent.width - 60px, Math.max(420px, toast_text.preferred-width + 90px));
        height: Math.max(48px, toast_text.preferred-height + 22px);
        border-radius: 10px;
        background: AppData.toast_type == "error" ? #991b1b : (AppData.toast_type == "warning" ? #b45309 : (AppData.toast_type == "success" ? #065f46 : #0f172a));
        border-width: 1.5px;
        border-color: AppData.toast_type == "error" ? #f87171 : (AppData.toast_type == "warning" ? #fbbf24 : (AppData.toast_type == "success" ? #34d399 : #38bdf8));
        drop-shadow-blur: 24px;
        drop-shadow-color: #00000070;
        drop-shadow-offset-y: 6px;

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 12px;
            spacing: 12px;
            alignment: space-between;

            HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 10px;
                alignment: start;

                Text {
                    text: AppData.toast_icon != "" ? AppData.toast_icon : (AppData.toast_type == "error" ? "⛔" : (AppData.toast_type == "warning" ? "⚠️" : (AppData.toast_type == "success" ? "✓" : "ℹ")));
                    font-size: 16px;
                    font-weight: 800;
                    color: AppData.toast_type == "error" ? #fecaca : (AppData.toast_type == "warning" ? #fef08a : (AppData.toast_type == "success" ? #a7f3d0 : #bae6fd));
                    vertical-alignment: center;
                }

                toast_text := Text {
                    horizontal-stretch: 1;
                    text: AppData.toast_message;
                    font-size: 13px;
                    font-weight: 700;
                    color: #ffffff;
                    vertical-alignment: center;
                    wrap: word-wrap;
                }
            }

            Rectangle {
                width: 24px;
                height: 24px;
                border-radius: 12px;
                background: btn_toast_close.has-hover ? #ffffff33 : transparent;
                y: (parent.height - self.height) / 2;

                Text {
                    text: "✕";
                    font-size: 13px;
                    font-weight: 800;
                    color: #ffffffcc;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }

                btn_toast_close := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { AppData.show_toast = false; }
                }
            }
        }
    }

    // MODAL DE ACTUALIZACIÓN DE SOFTWARE
    if AppData.show_update_modal : UpdateModal {}
}
