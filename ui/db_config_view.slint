import { ScrollView, LineEdit, Button, ComboBox } from "std-widgets.slint";
import { AppData, AppLogic } from "models.slint";

export component DbConfigView inherits Rectangle {
    background: #f8fafc;
    min-width: 800px;
    preferred-width: 1100px;
    preferred-height: 850px;

    ScrollView {
        width: 100%;
        height: 100%;
        content-width: root.width;

        VerticalLayout {
            padding: 24px;
            spacing: 20px;

            // 1. Header: Título, Contexto y Botón de Regreso
            HorizontalLayout {
                alignment: space-between;
                spacing: 16px;

                VerticalLayout {
                    horizontal-stretch: 1;
                    spacing: 4px;

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: start;

                        Rectangle {
                            width: 36px;
                            height: 36px;
                            border-radius: 8px;
                            background: #1e3a8a;

                            Text {
                                text: "🗄️";
                                font-size: 18px;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        VerticalLayout {
                            alignment: center;
                            spacing: 2px;

                            Text {
                                text: "Configuración de Base de Datos PostgreSQL";
                                font-size: 22px;
                                font-weight: 800;
                                color: #0f172a;
                            }
                        }

                        Rectangle {
                            height: 24px;
                            border-radius: 12px;
                            background: AppData.db_connected ? #ecfdf5 : #fef2f2;
                            border-width: 1px;
                            border-color: AppData.db_connected ? #a7f3d0 : #fecaca;
                            y: (parent.height - self.height) / 2;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 10px;
                                spacing: 6px;
                                alignment: center;

                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: AppData.db_connected ? #059669 : #dc2626;
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    text: AppData.db_connected ? "EN LÍNEA" : "DESCONECTADO";
                                    font-size: 11px;
                                    font-weight: 800;
                                    color: AppData.db_connected ? #065f46 : #991b1b;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    Text {
                        text: "Configure las credenciales de conexión al servidor de PostgreSQL (local o remoto). Los cambios se guardan en el archivo de configuración y se aplican inmediatamente.";
                        font-size: 12.5px;
                        color: #64748b;
                    }
                }

                // Botón Regresar a Auditoría
                Rectangle {
                    height: 38px;
                    border-radius: 8px;
                    background: btn_back_touch.has-hover ? #f1f5f9 : #ffffff;
                    border-width: 1px;
                    border-color: #cbd5e1;
                    y: (parent.height - self.height) / 2;

                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        spacing: 8px;
                        alignment: center;

                        Text {
                            text: "←";
                            font-size: 14px;
                            font-weight: 800;
                            color: #334155;
                            vertical-alignment: center;
                        }

                        Text {
                            text: "Volver a Inicio";
                            font-size: 12.5px;
                            font-weight: 700;
                            color: #334155;
                            vertical-alignment: center;
                        }
                    }

                    btn_back_touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            AppLogic.navigate_view(0);
                        }
                    }
                }
            }

            // 2. Banner de Estado y Diagnóstico Actual
            Rectangle {
                border-radius: 12px;
                background: AppData.db_connected ? #f0fdf4 : #fef2f2;
                border-width: 1.5px;
                border-color: AppData.db_connected ? #bbf7d0 : #fecaca;
                drop-shadow-blur: 8px;
                drop-shadow-color: #0000000a;
                drop-shadow-offset-y: 2px;

                VerticalLayout {
                    padding: 16px;
                    spacing: 12px;

                    HorizontalLayout {
                        alignment: space-between;
                        spacing: 16px;

                        HorizontalLayout {
                            spacing: 14px;
                            alignment: start;

                            Rectangle {
                                width: 42px;
                                height: 42px;
                                border-radius: 21px;
                                background: AppData.db_connected ? #dcfce7 : #fee2e2;

                                Text {
                                    text: AppData.db_connected ? "✓" : "⚠️";
                                    font-size: 18px;
                                    font-weight: 800;
                                    color: AppData.db_connected ? #16a34a : #dc2626;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            VerticalLayout {
                                spacing: 3px;
                                alignment: center;

                                Text {
                                    text: AppData.db_status_text;
                                    font-size: 15px;
                                    font-weight: 800;
                                    color: AppData.db_connected ? #14532d : #7f1d1d;
                                }

                                Text {
                                    text: AppData.db_status_detail != "" ? AppData.db_status_detail : (AppData.db_connected ? "Servicio en ejecución y connection pool listo para operaciones de nóminas, cédulas y clientes." : "No se puede establecer comunicación con el motor de base de datos.");
                                    font-size: 12px;
                                    color: AppData.db_connected ? #166534 : #991b1b;
                                    wrap: word-wrap;
                                }
                            }
                        }

                        // Botón de reconexión rápida
                        Rectangle {
                            height: 36px;
                            border-radius: 8px;
                            background: btn_diag_touch.has-hover ? (AppData.db_connected ? #dcfce7 : #fee2e2) : #ffffff;
                            border-width: 1px;
                            border-color: AppData.db_connected ? #86efac : #fca5a5;
                            y: (parent.height - self.height) / 2;

                            HorizontalLayout {
                                padding-left: 12px;
                                padding-right: 12px;
                                spacing: 6px;
                                alignment: center;

                                Text {
                                    text: "🔄";
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: "Verificar Estado";
                                    font-size: 12px;
                                    font-weight: 700;
                                    color: AppData.db_connected ? #166534 : #991b1b;
                                    vertical-alignment: center;
                                }
                            }

                            btn_diag_touch := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    AppLogic.reconnect_db();
                                }
                            }
                        }
                    }
                }
            }

            // 3. Tarjeta Principal: Formulario de Configuración
            Rectangle {
                border-radius: 12px;
                background: #ffffff;
                border-width: 1px;
                border-color: #e2e8f0;
                drop-shadow-blur: 12px;
                drop-shadow-color: #0000000a;
                drop-shadow-offset-y: 2px;

                VerticalLayout {
                    padding: 24px;
                    spacing: 20px;

                    // Encabezado de la Tarjeta con indicador de archivo
                    HorizontalLayout {
                        alignment: space-between;
                        spacing: 16px;

                        VerticalLayout {
                            spacing: 4px;

                            Text {
                                text: "Credenciales y Parámetros de Conexión";
                                font-size: 16px;
                                font-weight: 800;
                                color: #0f172a;
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;

                                Text {
                                    text: "Archivo persistente:";
                                    font-size: 12px;
                                    font-weight: 600;
                                    color: #64748b;
                                    vertical-alignment: center;
                                }

                                Rectangle {
                                    height: 22px;
                                    border-radius: 4px;
                                    background: #f1f5f9;
                                    border-width: 1px;
                                    border-color: #e2e8f0;

                                    HorizontalLayout {
                                        padding-left: 8px;
                                        padding-right: 8px;
                                        spacing: 4px;
                                        alignment: center;

                                        Text { text: "📄"; font-size: 11px; vertical-alignment: center; }
                                        Text {
                                            text: AppData.db_cfg_file_path;
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: #1e3a8a;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Botón abrir ubicación
                                Rectangle {
                                    height: 22px;
                                    border-radius: 4px;
                                    background: btn_open_path.has-hover ? #e2e8f0 : transparent;

                                    HorizontalLayout {
                                        padding-left: 6px;
                                        padding-right: 6px;
                                        alignment: center;

                                        Text {
                                            text: "Abrir carpeta ↗";
                                            font-size: 11px;
                                            font-weight: 700;
                                            color: #2563eb;
                                            vertical-alignment: center;
                                        }
                                    }

                                    btn_open_path := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => {
                                            AppLogic.open_db_config_folder();
                                        }
                                    }
                                }
                            }
                        }

                        // Selector de modo: Parámetros individuales vs URL directa
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: end;
                            y: (parent.height - self.height) / 2;

                            Rectangle {
                                height: 32px;
                                border-radius: 6px;
                                background: !AppData.db_cfg_use_custom_url ? #1e3a8a : #f1f5f9;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: center;
                                    Text {
                                        text: "Campos Individuales";
                                        font-size: 11.5px;
                                        font-weight: 700;
                                        color: !AppData.db_cfg_use_custom_url ? #ffffff : #475569;
                                        vertical-alignment: center;
                                    }
                                }

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        AppData.db_cfg_use_custom_url = false;
                                    }
                                }
                            }

                            Rectangle {
                                height: 32px;
                                border-radius: 6px;
                                background: AppData.db_cfg_use_custom_url ? #1e3a8a : #f1f5f9;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    alignment: center;
                                    Text {
                                        text: "Cadena de Conexión (URL)";
                                        font-size: 11.5px;
                                        font-weight: 700;
                                        color: AppData.db_cfg_use_custom_url ? #ffffff : #475569;
                                        vertical-alignment: center;
                                    }
                                }

                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        AppData.db_cfg_use_custom_url = true;
                                    }
                                }
                            }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: #f1f5f9;
                    }

                    // Formulario Modo 1: Campos Individuales
                    if !AppData.db_cfg_use_custom_url : VerticalLayout {
                        spacing: 16px;

                        // Fila 1: Servidor (Host) y Puerto
                        HorizontalLayout {
                            spacing: 20px;

                            // Servidor / Host
                            VerticalLayout {
                                horizontal-stretch: 3;
                                spacing: 6px;

                                HorizontalLayout {
                                    alignment: space-between;

                                    Text {
                                        text: "Servidor / Host (IP o Dominio):";
                                        font-size: 12.5px;
                                        font-weight: 700;
                                        color: #334155;
                                    }

                                    // Chips de acceso rápido para Host
                                    HorizontalLayout {
                                        spacing: 6px;

                                        Rectangle {
                                            height: 20px;
                                            border-radius: 4px;
                                            background: btn_local.has-hover ? #dbeafe : #eff6ff;
                                            border-width: 1px;
                                            border-color: #bfdbfe;

                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                Text {
                                                    text: "Localhost";
                                                    font-size: 10.5px;
                                                    font-weight: 700;
                                                    color: #1d4ed8;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            btn_local := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    AppData.db_cfg_host = "localhost";
                                                }
                                            }
                                        }

                                        Rectangle {
                                            height: 20px;
                                            border-radius: 4px;
                                            background: btn_ip.has-hover ? #dbeafe : #eff6ff;
                                            border-width: 1px;
                                            border-color: #bfdbfe;

                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                Text {
                                                    text: "127.0.0.1";
                                                    font-size: 10.5px;
                                                    font-weight: 700;
                                                    color: #1d4ed8;
                                                    vertical-alignment: center;
                                                }
                                            }

                                            btn_ip := TouchArea {
                                                mouse-cursor: pointer;
                                                clicked => {
                                                    AppData.db_cfg_host = "127.0.0.1";
                                                }
                                            }
                                        }
                                    }
                                }

                                LineEdit {
                                    text <=> AppData.db_cfg_host;
                                    placeholder-text: "Ej. localhost, 192.168.1.50, db.empresa.com";
                                    height: 38px;
                                }
                            }

                            // Puerto
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 6px;

                                Text {
                                    text: "Puerto:";
                                    font-size: 12.5px;
                                    font-weight: 700;
                                    color: #334155;
                                }

                                LineEdit {
                                    text <=> AppData.db_cfg_port;
                                    placeholder-text: "5432";
                                    height: 38px;
                                }
                            }
                        }

                        // Fila 2: Base de Datos y Modo SSL
                        HorizontalLayout {
                            spacing: 20px;

                            // Nombre de BD
                            VerticalLayout {
                                horizontal-stretch: 3;
                                spacing: 6px;

                                Text {
                                    text: "Nombre de la Base de Datos:";
                                    font-size: 12.5px;
                                    font-weight: 700;
                                    color: #334155;
                                }

                                LineEdit {
                                    text <=> AppData.db_cfg_database;
                                    placeholder-text: "firma_fiscal_acd";
                                    height: 38px;
                                }
                            }

                            // Modo SSL
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 6px;

                                Text {
                                    text: "Modo SSL:";
                                    font-size: 12.5px;
                                    font-weight: 700;
                                    color: #334155;
                                }

                                LineEdit {
                                    text <=> AppData.db_cfg_ssl_mode;
                                    placeholder-text: "disable, prefer, require";
                                    height: 38px;
                                }
                            }
                        }

                        // Fila 3: Usuario y Contraseña
                        HorizontalLayout {
                            spacing: 20px;

                            // Usuario
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 6px;

                                Text {
                                    text: "Usuario de PostgreSQL:";
                                    font-size: 12.5px;
                                    font-weight: 700;
                                    color: #334155;
                                }

                                LineEdit {
                                    text <=> AppData.db_cfg_user;
                                    placeholder-text: "postgres o usuario asignado";
                                    height: 38px;
                                }
                            }

                            // Contraseña con botón mostrar/ocultar
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 6px;

                                HorizontalLayout {
                                    alignment: space-between;

                                    Text {
                                        text: "Contraseña:";
                                        font-size: 12.5px;
                                        font-weight: 700;
                                        color: #334155;
                                    }

                                    Rectangle {
                                        height: 20px;
                                        border-radius: 4px;
                                        background: btn_eye.has-hover ? #f1f5f9 : transparent;

                                        HorizontalLayout {
                                            padding-left: 6px;
                                            padding-right: 6px;
                                            spacing: 4px;
                                            alignment: center;

                                            Text {
                                                text: AppData.db_cfg_show_password ? "Ocultar 🔒" : "Mostrar 👁️";
                                                font-size: 11px;
                                                font-weight: 700;
                                                color: #2563eb;
                                                vertical-alignment: center;
                                            }
                                        }

                                        btn_eye := TouchArea {
                                            mouse-cursor: pointer;
                                            clicked => {
                                                AppData.db_cfg_show_password = !AppData.db_cfg_show_password;
                                            }
                                        }
                                    }
                                }

                                LineEdit {
                                    text <=> AppData.db_cfg_password;
                                    placeholder-text: "Contraseña del usuario";
                                    input-type: AppData.db_cfg_show_password ? InputType.text : InputType.password;
                                    height: 38px;
                                }
                            }
                        }
                    }

                    // Formulario Modo 2: Cadena de Conexión Completa (URL)
                    if AppData.db_cfg_use_custom_url : VerticalLayout {
                        spacing: 10px;

                        Text {
                            text: "Cadena de Conexión URI (DATABASE_URL):";
                            font-size: 12.5px;
                            font-weight: 700;
                            color: #334155;
                        }

                        LineEdit {
                            text <=> AppData.db_cfg_connection_url;
                            placeholder-text: "postgres://usuario:contraseña@servidor.remoto:5432/nombre_base_datos?sslmode=disable";
                            height: 42px;
                        }

                        Text {
                            text: "Si especifica una cadena URI válida, tendrá prioridad sobre los campos individuales al establecer la conexión.";
                            font-size: 11.5px;
                            color: #64748b;
                        }
                    }

                    // 4. Banner de Resultado de Prueba de Conexión
                    if AppData.db_cfg_test_status != "" : Rectangle {
                        border-radius: 8px;
                        background: AppData.db_cfg_test_status == "success" ? #f0fdf4 : (AppData.db_cfg_test_status == "testing" ? #eff6ff : #fef2f2);
                        border-width: 1px;
                        border-color: AppData.db_cfg_test_status == "success" ? #86efac : (AppData.db_cfg_test_status == "testing" ? #bfdbfe : #fca5a5);

                        HorizontalLayout {
                            padding: 12px;
                            spacing: 10px;
                            alignment: start;

                            Text {
                                text: AppData.db_cfg_test_status == "success" ? "✓" : (AppData.db_cfg_test_status == "testing" ? "⏳" : "⛔");
                                font-size: 16px;
                                font-weight: 800;
                                color: AppData.db_cfg_test_status == "success" ? #16a34a : (AppData.db_cfg_test_status == "testing" ? #2563eb : #dc2626);
                                vertical-alignment: center;
                            }

                            Text {
                                text: AppData.db_cfg_test_result;
                                font-size: 12.5px;
                                font-weight: 700;
                                color: AppData.db_cfg_test_status == "success" ? #15803d : (AppData.db_cfg_test_status == "testing" ? #1d4ed8 : #b91c1c);
                                vertical-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // 5. Botonera de Acciones
                    HorizontalLayout {
                        alignment: space-between;
                        spacing: 16px;

                        // Izquierda: Restaurar predeterminados
                        Rectangle {
                            height: 40px;
                            border-radius: 8px;
                            background: btn_reset.has-hover ? #f1f5f9 : transparent;
                            border-width: 1px;
                            border-color: #cbd5e1;

                            HorizontalLayout {
                                padding-left: 14px;
                                padding-right: 14px;
                                spacing: 6px;
                                alignment: center;

                                Text { text: "↺"; font-size: 14px; vertical-alignment: center; color: #475569; }
                                Text {
                                    text: "Restaurar Predeterminados";
                                    font-size: 12.5px;
                                    font-weight: 700;
                                    color: #475569;
                                    vertical-alignment: center;
                                }
                            }

                            btn_reset := TouchArea {
                                mouse-cursor: pointer;
                                clicked => {
                                    AppLogic.reset_db_config_defaults();
                                }
                            }
                        }

                        // Derecha: Probar y Guardar
                        HorizontalLayout {
                            spacing: 12px;

                            // Botón Probar Conexión
                            Rectangle {
                                height: 40px;
                                border-radius: 8px;
                                background: btn_test.has-hover ? #f8fafc : #ffffff;
                                border-width: 1.5px;
                                border-color: #2563eb;

                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    spacing: 8px;
                                    alignment: center;

                                    Text {
                                        text: AppData.db_cfg_is_testing ? "⏳" : "🔍";
                                        font-size: 13px;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: AppData.db_cfg_is_testing ? "Probando..." : "Probar Conexión";
                                        font-size: 13px;
                                        font-weight: 700;
                                        color: #1d4ed8;
                                        vertical-alignment: center;
                                    }
                                }

                                btn_test := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        if !AppData.db_cfg_is_testing {
                                            AppLogic.test_db_config(
                                                AppData.db_cfg_host,
                                                AppData.db_cfg_port,
                                                AppData.db_cfg_database,
                                                AppData.db_cfg_user,
                                                AppData.db_cfg_password,
                                                AppData.db_cfg_ssl_mode,
                                                AppData.db_cfg_use_custom_url ? AppData.db_cfg_connection_url : ""
                                            );
                                        }
                                    }
                                }
                            }

                            // Botón Guardar y Conectar
                            Rectangle {
                                height: 40px;
                                border-radius: 8px;
                                background: btn_save.has-hover ? #1d4ed8 : #1e3a8a;
                                drop-shadow-blur: 8px;
                                drop-shadow-color: #1e3a8a40;
                                drop-shadow-offset-y: 2px;

                                HorizontalLayout {
                                    padding-left: 18px;
                                    padding-right: 18px;
                                    spacing: 8px;
                                    alignment: center;

                                    Text {
                                        text: AppData.db_cfg_is_saving ? "⏳" : "💾";
                                        font-size: 13px;
                                        color: #ffffff;
                                        vertical-alignment: center;
                                    }

                                    Text {
                                        text: AppData.db_cfg_is_saving ? "Guardando..." : "Guardar y Conectar";
                                        font-size: 13px;
                                        font-weight: 800;
                                        color: #ffffff;
                                        vertical-alignment: center;
                                    }
                                }

                                btn_save := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        if !AppData.db_cfg_is_saving {
                                            AppLogic.save_db_config(
                                                AppData.db_cfg_host,
                                                AppData.db_cfg_port,
                                                AppData.db_cfg_database,
                                                AppData.db_cfg_user,
                                                AppData.db_cfg_password,
                                                AppData.db_cfg_ssl_mode,
                                                AppData.db_cfg_use_custom_url ? AppData.db_cfg_connection_url : ""
                                            );
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // 6. Tarjeta de Consejos y Ayuda para PostgreSQL
            Rectangle {
                border-radius: 12px;
                background: #f1f5f9;
                border-width: 1px;
                border-color: #e2e8f0;

                VerticalLayout {
                    padding: 18px;
                    spacing: 10px;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;

                        Text { text: "💡"; font-size: 14px; vertical-alignment: center; }
                        Text {
                            text: "Instrucciones de Conexión y Buenas Prácticas:";
                            font-size: 13px;
                            font-weight: 800;
                            color: #1e293b;
                            vertical-alignment: center;
                        }
                    }

                    HorizontalLayout {
                        spacing: 14px;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 4px;

                            Text {
                                text: "1. Conexión Local:";
                                font-size: 12px;
                                font-weight: 700;
                                color: #334155;
                            }
                            Text {
                                text: "• Use 'localhost' o '127.0.0.1' con el puerto estándar 5432.\n• Asegúrese de que el servicio PostgreSQL se encuentre iniciado en su equipo.";
                                font-size: 11.5px;
                                color: #475569;
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 4px;

                            Text {
                                text: "2. Servidor en Red / Remoto:";
                                font-size: 12px;
                                font-weight: 700;
                                color: #334155;
                            }
                            Text {
                                text: "• En postgresql.conf verifique listen_addresses = '*'.\n• En pg_hba.conf autorice el rango de red de los equipos clientes (md5 / scram-sha-256).";
                                font-size: 11.5px;
                                color: #475569;
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 4px;

                            Text {
                                text: "3. Inicialización Automática:";
                                font-size: 12px;
                                font-weight: 700;
                                color: #334155;
                            }
                            Text {
                                text: "• La base de datos debe existir previamente en el servidor.\n• Al hacer clic en 'Guardar y Conectar', la aplicación creará las tablas y catálogos requeridos.";
                                font-size: 11.5px;
                                color: #475569;
                            }
                        }
                    }
                }
            }
        }
    }
}
