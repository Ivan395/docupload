import { AppData, AppLogic } from "models.slint";

export component Sidebar inherits Rectangle {
    width: 240px;
    background: #ffffff;
    border-width: 1px;
    border-color: #e2e8f0;

    property <bool> client_selected: AppData.selected_cliente_id != "";
    property <bool> rp_selected: AppData.selected_rp_id != "";
    property <bool> revision_selected: AppData.selected_revision_id != "";

    VerticalLayout {
        padding: 16px;
        spacing: 12px;
        alignment: space-between;

        VerticalLayout {
            spacing: 16px;

            // Brand Header
            HorizontalLayout {
                spacing: 10px;
                alignment: start;

                Rectangle {
                    width: 38px;
                    height: 38px;
                    border-radius: 8px;
                    background: #1e3a8a;

                    Text {
                        text: "🏛";
                        font-size: 20px;
                        color: #ffffff;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                VerticalLayout {
                    alignment: center;

                    Text {
                        text: "Firma Fiscal ACD";
                        font-size: 15px;
                        font-weight: 800;
                        color: #0f172a;
                        letter-spacing: 0.5px;
                    }
                }
            }

            Rectangle {
                height: 1px;
                background: #f1f5f9;
            }

            // Back to Auditoría General (View 0)
            Rectangle {
                height: 38px;
                border-radius: 8px;
                background: btn_esc.has-hover ? #f8fafc : (AppData.current_view == 0 ? #eff6ff : transparent);
                border-width: AppData.current_view == 0 ? 1px : 0px;
                border-color: #bfdbfe;

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 10px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 8px;
                        alignment: center;
                        Text { text: "←"; font-size: 14px; color: AppData.current_view == 0 ? #1d4ed8 : #475569; font-weight: 700; }
                        Text {
                            text: "Auditoría General";
                            font-size: 12.5px;
                            font-weight: 700;
                            color: AppData.current_view == 0 ? #1d4ed8 : #334155;
                            vertical-alignment: center;
                        }
                    }

                    Rectangle {
                        height: 20px;
                        width: 32px;
                        border-radius: 4px;
                        background: #f1f5f9;
                        y: (parent.height - self.height) / 2;
                        Text {
                            text: "Esc";
                            font-size: 11px;
                            font-weight: 700;
                            color: #64748b;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                btn_esc := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { AppLogic.navigate_view(0); }
                }
            }

            // Section 1: Correcciones Patronales
            VerticalLayout {
                spacing: 4px;

                Text {
                    text: "CORRECCIONES PATRONALES";
                    font-size: 11px;
                    font-weight: 800;
                    color: #94a3b8;
                    letter-spacing: 0.5px;
                }

                // Clientes (F2) -> View 1
                Rectangle {
                    height: 42px;
                    border-radius: 8px;
                    background: AppData.current_view == 1 ? #1e3a8a : (btn_f2.has-hover ? #f8fafc : transparent);

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 10px;
                            alignment: center;
                            Text {
                                text: "🏢";
                                font-size: 15px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "Clientes";
                                font-size: 13.5px;
                                font-weight: 700;
                                color: AppData.current_view == 1 ? #ffffff : #1e293b;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            height: 20px;
                            width: 26px;
                            border-radius: 4px;
                            background: AppData.current_view == 1 ? #2563eb : #f1f5f9;
                            y: (parent.height - self.height) / 2;
                            Text {
                                text: "F2";
                                font-size: 11px;
                                font-weight: 700;
                                color: AppData.current_view == 1 ? #ffffff : #64748b;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    btn_f2 := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppLogic.navigate_view(1); }
                    }
                }

                // Registros Patronales (F3) -> View 2 (Deshabilitado hasta acceder desde Clientes)
                Rectangle {
                    height: 42px;
                    border-radius: 8px;
                    background: AppData.current_view == 2 ? #1e3a8a : (root.client_selected && btn_f3.has-hover ? #f8fafc : transparent);
                    opacity: root.client_selected ? 1.0 : 0.4;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 10px;
                            alignment: center;
                            Text {
                                text: "📜";
                                font-size: 15px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "Registros Patronales";
                                font-size: 13.5px;
                                font-weight: 700;
                                color: AppData.current_view == 2 ? #ffffff : (root.client_selected ? #1e293b : #94a3b8);
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            height: 20px;
                            width: 26px;
                            border-radius: 4px;
                            background: AppData.current_view == 2 ? #2563eb : #f1f5f9;
                            y: (parent.height - self.height) / 2;
                            Text {
                                text: "F3";
                                font-size: 11px;
                                font-weight: 700;
                                color: AppData.current_view == 2 ? #ffffff : (root.client_selected ? #64748b : #cbd5e1);
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    btn_f3 := TouchArea {
                        enabled: root.client_selected;
                        mouse-cursor: root.client_selected ? pointer : not-allowed;
                        clicked => {
                            if root.client_selected {
                                AppLogic.navigate_view(2);
                            }
                        }
                    }
                }

                // Revisiones (F4) -> View 3 (Deshabilitado por default; sólo accesible por botón "Ver" de Registros Patronales)
                Rectangle {
                    height: 42px;
                    border-radius: 8px;
                    background: AppData.current_view == 3 ? #1e3a8a : transparent;
                    opacity: AppData.current_view == 3 ? 1.0 : 0.35;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 10px;
                            alignment: center;
                            Text {
                                text: "📋";
                                font-size: 15px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "Revisiones";
                                font-size: 13.5px;
                                font-weight: 700;
                                color: AppData.current_view == 3 ? #ffffff : #94a3b8;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            height: 20px;
                            width: 26px;
                            border-radius: 4px;
                            background: AppData.current_view == 3 ? #2563eb : #f1f5f9;
                            y: (parent.height - self.height) / 2;
                            Text {
                                text: "F4";
                                font-size: 11px;
                                font-weight: 700;
                                color: AppData.current_view == 3 ? #ffffff : #cbd5e1;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    TouchArea {
                        enabled: false;
                        mouse-cursor: not-allowed;
                    }
                }

                // Registros de Obras (F5) -> View 4 (Deshabilitado por default; sólo accesible por botón "Ver Registros de Obras" en Revisiones)
                Rectangle {
                    height: 42px;
                    border-radius: 8px;
                    background: AppData.current_view == 4 ? #1e3a8a : transparent;
                    opacity: AppData.current_view == 4 ? 1.0 : 0.35;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 10px;
                            alignment: center;
                            Text {
                                text: "🏗";
                                font-size: 15px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "Registros de Obras";
                                font-size: 13.5px;
                                font-weight: 700;
                                color: AppData.current_view == 4 ? #ffffff : #94a3b8;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            height: 20px;
                            width: 26px;
                            border-radius: 4px;
                            background: AppData.current_view == 4 ? #2563eb : #f1f5f9;
                            y: (parent.height - self.height) / 2;
                            Text {
                                text: "F5";
                                font-size: 11px;
                                font-weight: 700;
                                color: AppData.current_view == 4 ? #ffffff : #cbd5e1;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    TouchArea {
                        enabled: false;
                        mouse-cursor: not-allowed;
                    }
                }

                // Empleados (F6) -> View 5 (Habilitado con Cliente seleccionado)
                Rectangle {
                    height: 42px;
                    border-radius: 8px;
                    background: AppData.current_view == 5 ? #1e3a8a : (root.client_selected && btn_f6.has-hover ? #f8fafc : transparent);
                    opacity: root.client_selected ? 1.0 : 0.4;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 10px;
                            alignment: center;
                            Text {
                                text: "👥";
                                font-size: 15px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "Empleados";
                                font-size: 13.5px;
                                font-weight: 700;
                                color: AppData.current_view == 5 ? #ffffff : (root.client_selected ? #1e293b : #94a3b8);
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            height: 20px;
                            width: 26px;
                            border-radius: 4px;
                            background: AppData.current_view == 5 ? #2563eb : #f1f5f9;
                            y: (parent.height - self.height) / 2;
                            Text {
                                text: "F6";
                                font-size: 11px;
                                font-weight: 700;
                                color: AppData.current_view == 5 ? #ffffff : (root.client_selected ? #64748b : #cbd5e1);
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    btn_f6 := TouchArea {
                        enabled: root.client_selected;
                        mouse-cursor: root.client_selected ? pointer : not-allowed;
                        clicked => {
                            if root.client_selected {
                                AppLogic.navigate_view(5);
                            }
                        }
                    }
                }

                // Cédula de Cuotas (F7) -> View 6 (Deshabilitado hasta acceder por botón "Cargar Cédulas de Cuotas" en Registros de Obras)
                Rectangle {
                    height: 42px;
                    border-radius: 8px;
                    background: AppData.current_view == 6 ? #1e3a8a : (AppData.cedulas_access_allowed && btn_f7.has-hover ? #f8fafc : transparent);
                    opacity: AppData.current_view == 6 || AppData.cedulas_access_allowed ? 1.0 : 0.35;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 10px;
                            alignment: center;
                            Text {
                                text: "📑";
                                font-size: 15px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "Cédula de Cuotas";
                                font-size: 13.5px;
                                font-weight: 700;
                                color: AppData.current_view == 6 ? #ffffff : (AppData.cedulas_access_allowed ? #1e293b : #94a3b8);
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            height: 20px;
                            width: 26px;
                            border-radius: 4px;
                            background: AppData.current_view == 6 ? #2563eb : #f1f5f9;
                            y: (parent.height - self.height) / 2;
                            Text {
                                text: "F7";
                                font-size: 11px;
                                font-weight: 700;
                                color: AppData.current_view == 6 ? #ffffff : (AppData.cedulas_access_allowed ? #64748b : #cbd5e1);
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    btn_f7 := TouchArea {
                        enabled: AppData.cedulas_access_allowed;
                        mouse-cursor: AppData.cedulas_access_allowed ? pointer : not-allowed;
                        clicked => {
                            if AppData.cedulas_access_allowed {
                                AppLogic.navigate_view(6);
                            }
                        }
                    }
                }

                // Reporte Liquidaciones (F8) -> View 7
                Rectangle {
                    height: 42px;
                    border-radius: 8px;
                    background: AppData.current_view == 7 ? #1e3a8a : (AppData.reporte_liquidaciones_access_allowed && btn_f8.has-hover ? #f8fafc : transparent);
                    opacity: AppData.current_view == 7 || AppData.reporte_liquidaciones_access_allowed ? 1.0 : 0.35;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 10px;
                            alignment: center;
                            Text {
                                text: "📊";
                                font-size: 15px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "Reporte Liquidaciones";
                                font-size: 13.5px;
                                font-weight: 700;
                                color: AppData.current_view == 7 ? #ffffff : (AppData.reporte_liquidaciones_access_allowed ? #1e293b : #94a3b8);
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            height: 20px;
                            width: 26px;
                            border-radius: 4px;
                            background: AppData.current_view == 7 ? #2563eb : #f1f5f9;
                            y: (parent.height - self.height) / 2;
                            Text {
                                text: "F8";
                                font-size: 11px;
                                font-weight: 700;
                                color: AppData.current_view == 7 ? #ffffff : (AppData.reporte_liquidaciones_access_allowed ? #64748b : #cbd5e1);
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    btn_f8 := TouchArea {
                        enabled: AppData.reporte_liquidaciones_access_allowed;
                        mouse-cursor: AppData.reporte_liquidaciones_access_allowed ? pointer : not-allowed;
                        clicked => {
                            if AppData.reporte_liquidaciones_access_allowed {
                                AppLogic.navigate_view(7);
                            }
                        }
                    }
                }

                // Calendario Fiscal & Revisiones (F9) -> View 8
                Rectangle {
                    height: 42px;
                    border-radius: 8px;
                    background: AppData.current_view == 8 ? #1e3a8a : (btn_f9.has-hover ? #f8fafc : transparent);

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 10px;
                            alignment: center;
                            Text {
                                text: "📅";
                                font-size: 15px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "Calendario Fiscal";
                                font-size: 13.5px;
                                font-weight: 700;
                                color: AppData.current_view == 8 ? #ffffff : #1e293b;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            height: 20px;
                            width: 26px;
                            border-radius: 4px;
                            background: AppData.current_view == 8 ? #2563eb : #f1f5f9;
                            y: (parent.height - self.height) / 2;
                            Text {
                                text: "F9";
                                font-size: 11px;
                                font-weight: 700;
                                color: AppData.current_view == 8 ? #ffffff : #64748b;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    btn_f9 := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            AppLogic.navigate_view(8);
                        }
                    }
                }

                // Reporte Nóminas (F10) -> View 9
                Rectangle {
                    height: 42px;
                    border-radius: 8px;
                    background: AppData.current_view == 9 ? #1e3a8a : (AppData.nominas_access_allowed && btn_f10.has-hover ? #f8fafc : transparent);
                    opacity: AppData.current_view == 9 || AppData.nominas_access_allowed ? 1.0 : 0.35;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: 10px;
                            alignment: center;
                            Text {
                                text: "💵";
                                font-size: 15px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "Reporte Nóminas";
                                font-size: 13.5px;
                                font-weight: 700;
                                color: AppData.current_view == 9 ? #ffffff : (AppData.nominas_access_allowed ? #1e293b : #94a3b8);
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            height: 20px;
                            width: 26px;
                            border-radius: 4px;
                            background: AppData.current_view == 9 ? #2563eb : #f1f5f9;
                            y: (parent.height - self.height) / 2;
                            Text {
                                text: "F10";
                                font-size: 11px;
                                font-weight: 700;
                                color: AppData.current_view == 9 ? #ffffff : (AppData.nominas_access_allowed ? #64748b : #cbd5e1);
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    btn_f10 := TouchArea {
                        enabled: AppData.nominas_access_allowed;
                        mouse-cursor: AppData.nominas_access_allowed ? pointer : not-allowed;
                        clicked => {
                            if AppData.nominas_access_allowed {
                                AppLogic.navigate_view(9);
                            }
                        }
                    }
                }
            }

        }

        // Bottom status indicators
        VerticalLayout {
            spacing: 8px;
            padding-bottom: 6px;

            Rectangle {
                height: 1px;
                background: #f1f5f9;
            }

            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: #10b981;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: "Motor Local: Rust/Slint GPU";
                    font-size: 11px;
                    font-weight: 600;
                    color: #475569;
                }
            }

            HorizontalLayout {
                spacing: 6px;
                alignment: start;
                Rectangle {
                    width: 7px;
                    height: 7px;
                    border-radius: 3.5px;
                    background: #2563eb;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: "Sincronización DB: En línea";
                    font-size: 11px;
                    font-weight: 600;
                    color: #475569;
                }
            }
        }
    }
}
