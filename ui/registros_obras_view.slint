import { ScrollView, LineEdit, Button, ComboBox } from "std-widgets.slint";
import { AppData, AppLogic, RegistroObraData } from "models.slint";
import { DatePickerField } from "date_picker.slint";

export component RegistrosObrasView inherits Rectangle {
    background: #f8fafc;

    VerticalLayout {
        padding: 24px;
        spacing: 18px;

        // 1. Sub-Breadcrumb & Context Banner
        HorizontalLayout {
            spacing: 10px;
            alignment: start;

            // Botón Volver a Revisiones (F4)
            Rectangle {
                height: 26px;
                border-radius: 4px;
                background: btn_back_rev.has-hover ? #e2e8f0 : #f1f5f9;
                border-width: 1px;
                border-color: #cbd5e1;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 4px;
                    alignment: center;
                    Text { text: "←"; font-size: 11px; font-weight: 800; color: #334155; vertical-alignment: center; }
                    Text { text: "Revisiones (F4)"; font-size: 11px; font-weight: 700; color: #334155; vertical-alignment: center; }
                }
                btn_back_rev := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { AppLogic.navigate_view(3); }
                }
            }

            // Badge Obra
            Rectangle {
                height: 26px;
                border-radius: 4px;
                background: #ecfdf5;
                border-width: 1px;
                border-color: #a7f3d0;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    spacing: 4px;
                    Text { text: "🏗"; font-size: 11px; vertical-alignment: center; }
                    Text {
                        text: "Obra";
                        font-size: 11px;
                        font-weight: 800;
                        color: #065f46;
                        vertical-alignment: center;
                    }
                }
            }

            Text { text: "·"; font-size: 14px; font-weight: 800; color: #94a3b8; vertical-alignment: center; }

            // Badge RP
            Rectangle {
                height: 26px;
                border-radius: 4px;
                background: #eff6ff;
                border-width: 1px;
                border-color: #bfdbfe;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    Text {
                        text: "RP: " + (AppData.selected_rp_registro != "" ? AppData.selected_rp_registro : "General");
                        font-size: 11px;
                        font-weight: 800;
                        color: #1d4ed8;
                        vertical-alignment: center;
                    }
                }
            }

            Text { text: "·"; font-size: 14px; font-weight: 800; color: #94a3b8; vertical-alignment: center; }

            // Badge Revisión Folio & Nombre
            Rectangle {
                height: 26px;
                border-radius: 4px;
                background: #f8fafc;
                border-width: 1px;
                border-color: #e2e8f0;
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 8px;
                    Text {
                        text: "Revisión: " + (AppData.selected_revision_folio != "" ? (AppData.selected_revision_folio + " - ") : "") + (AppData.selected_revision_nombre != "" ? AppData.selected_revision_nombre : "General");
                        font-size: 11px;
                        font-weight: 700;
                        color: #475569;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // 2. Header Superior: Título y Acciones
        HorizontalLayout {
            alignment: space-between;

            VerticalLayout {
                spacing: 4px;
                Text {
                    text: "Registros de Obras";
                    font-size: 22px;
                    font-weight: 800;
                    color: #0f172a;
                }
                Text {
                    text: "Gestión y control de obras de construcción registradas ante el IMSS vinculadas a la revisión patronal.";
                    font-size: 12px;
                    color: #64748b;
                }
            }

            HorizontalLayout {
                spacing: 12px;
                alignment: center;

                // Botón Cargar Nominas
                Rectangle {
                    height: 38px;
                    border-radius: 6px;
                    background: btn_load_cedulas.has-hover ? #1d4ed8 : #1e40af;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 8px;
                        alignment: center;
                        Text { text: "📑"; font-size: 13px; vertical-alignment: center; }
                        Text {
                            text: "Cargar Nominas";
                            font-size: 12px;
                            font-weight: 700;
                            color: #ffffff;
                            vertical-alignment: center;
                        }
                    }

                    btn_load_nominas := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppLogic.open_nominas_carga(); }
                    }
                }

                // Botón Cargar Cédulas de Cuotas
                Rectangle {
                    height: 38px;
                    border-radius: 6px;
                    background: btn_load_cedulas.has-hover ? #1d4ed8 : #1e40af;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 8px;
                        alignment: center;
                        Text { text: "📑"; font-size: 13px; vertical-alignment: center; }
                        Text {
                            text: "Cargar Cédulas de Cuotas";
                            font-size: 12px;
                            font-weight: 700;
                            color: #ffffff;
                            vertical-alignment: center;
                        }
                    }

                    btn_load_cedulas := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppLogic.open_cedulas_from_obras(); }
                    }
                }

                // Botón + Nuevo Registro de Obra
                Rectangle {
                    height: 38px;
                    border-radius: 6px;
                    background: btn_new_obra.has-hover ? #047857 : #065f46;

                    HorizontalLayout {
                        padding-left: 16px;
                        padding-right: 16px;
                        spacing: 8px;
                        alignment: center;
                        Text {
                            text: "+ Nuevo Registro de Obra";
                            font-size: 12px;
                            font-weight: 700;
                            color: #ffffff;
                            vertical-alignment: center;
                        }
                    }

                    btn_new_obra := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppLogic.open_new_obra_dialog(); }
                    }
                }
            }
        }

        // 3. KPI Cards (4 Métricas de Obras)
        HorizontalLayout {
            spacing: 14px;

            // KPI 1: Total Obras
            Rectangle {
                horizontal-stretch: 1;
                height: 72px;
                border-radius: 8px;
                background: #ffffff;
                border-width: 1px;
                border-color: #e2e8f0;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        Text { text: "TOTAL OBRAS"; font-size: 10px; font-weight: 800; color: #64748b; letter-spacing: 0.5px; }
                        Text {
                            text: AppData.obras_list.length + " Obras";
                            font-size: 16px;
                            font-weight: 800;
                            color: #0f172a;
                        }
                    }

                    Text { text: "🏗"; font-size: 22px; vertical-alignment: center; }
                }
            }

            // KPI 2: Superficie Total Construida
            Rectangle {
                horizontal-stretch: 1;
                height: 72px;
                border-radius: 8px;
                background: #ffffff;
                border-width: 1px;
                border-color: #e2e8f0;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        Text { text: "SUPERFICIE CONSTRUIDA TOTAL"; font-size: 10px; font-weight: 800; color: #64748b; letter-spacing: 0.5px; }
                        Text {
                            text: AppData.obras_superficie_total_str;
                            font-size: 16px;
                            font-weight: 800;
                            color: #0f172a;
                        }
                    }

                    Text { text: "📐"; font-size: 22px; vertical-alignment: center; }
                }
            }

            // KPI 3: Monto Contratado Total
            Rectangle {
                horizontal-stretch: 1;
                height: 72px;
                border-radius: 8px;
                background: #ffffff;
                border-width: 1px;
                border-color: #e2e8f0;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        Text { text: "MONTO CONTRATADO TOTAL"; font-size: 10px; font-weight: 800; color: #64748b; letter-spacing: 0.5px; }
                        Text {
                            text: AppData.obras_monto_total_str;
                            font-size: 15px;
                            font-weight: 800;
                            color: #047857;
                        }
                    }

                    Text { text: "💵"; font-size: 22px; vertical-alignment: center; }
                }
            }

            // KPI 4: Subdelegación
            Rectangle {
                horizontal-stretch: 1;
                height: 72px;
                border-radius: 8px;
                background: #ffffff;
                border-width: 1px;
                border-color: #e2e8f0;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 16px;
                    alignment: space-between;

                    VerticalLayout {
                        alignment: center;
                        spacing: 4px;
                        Text { text: "SUBDELEGACIÓN IMSS"; font-size: 10px; font-weight: 800; color: #64748b; letter-spacing: 0.5px; }
                        Text {
                            text: AppData.selected_rp_subdelegacion != "" ? AppData.selected_rp_subdelegacion : "01 Hidalgo Sur";
                            font-size: 15px;
                            font-weight: 800;
                            color: #0f172a;
                        }
                    }

                    Text { text: "🏛"; font-size: 22px; vertical-alignment: center; }
                }
            }
        }

        // 4. Barra de Búsqueda y Filtros
        HorizontalLayout {
            spacing: 14px;
            alignment: space-between;

            HorizontalLayout {
                spacing: 12px;
                alignment: start;

                // Buscador
                Rectangle {
                    width: 340px;
                    height: 38px;
                    border-radius: 6px;
                    background: #ffffff;
                    border-width: 1px;
                    border-color: #cbd5e1;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;
                        alignment: center;

                        Text { text: "🔍"; font-size: 12px; vertical-alignment: center; }
                        LineEdit {
                            text <=> AppData.obras_search;
                            placeholder-text: "Buscar por Número, Clase, Tipo, Ubicación...";
                            edited => { AppLogic.filter_obras_search(); }
                        }
                    }
                }

                // Filtro: Todas
                Rectangle {
                    height: 38px;
                    border-radius: 6px;
                    background: AppData.obras_filter_tab == 0 ? #065f46 : #ffffff;
                    border-width: 1px;
                    border-color: AppData.obras_filter_tab == 0 ? #065f46 : #cbd5e1;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        Text {
                            text: "Todas (" + AppData.obras_list.length + ")";
                            font-size: 11px;
                            font-weight: 700;
                            color: AppData.obras_filter_tab == 0 ? #ffffff : #475569;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppLogic.filter_obras_tab(0); }
                    }
                }

                // Filtro: Privadas
                Rectangle {
                    height: 38px;
                    border-radius: 6px;
                    background: AppData.obras_filter_tab == 1 ? #065f46 : #ffffff;
                    border-width: 1px;
                    border-color: AppData.obras_filter_tab == 1 ? #065f46 : #cbd5e1;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        Text {
                            text: "Privadas";
                            font-size: 11px;
                            font-weight: 700;
                            color: AppData.obras_filter_tab == 1 ? #ffffff : #475569;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppLogic.filter_obras_tab(1); }
                    }
                }

                // Filtro: Públicas
                Rectangle {
                    height: 38px;
                    border-radius: 6px;
                    background: AppData.obras_filter_tab == 2 ? #065f46 : #ffffff;
                    border-width: 1px;
                    border-color: AppData.obras_filter_tab == 2 ? #065f46 : #cbd5e1;
                    HorizontalLayout {
                        padding-left: 14px;
                        padding-right: 14px;
                        Text {
                            text: "Públicas";
                            font-size: 11px;
                            font-weight: 700;
                            color: AppData.obras_filter_tab == 2 ? #ffffff : #475569;
                            vertical-alignment: center;
                        }
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AppLogic.filter_obras_tab(2); }
                    }
                }
            }

            // Orden indicador
            HorizontalLayout {
                spacing: 6px;
                alignment: center;
                Text { text: "⇅"; font-size: 12px; color: #64748b; vertical-alignment: center; }
                Text {
                    text: "Orden: Fecha de Creación (Desc)";
                    font-size: 11px;
                    font-weight: 700;
                    color: #64748b;
                    vertical-alignment: center;
                }
            }
        }

        // 5. Lista de Obras en ScrollView
        ScrollView {
            vertical-stretch: 1;

            VerticalLayout {
                alignment: start;
                spacing: 14px;
                padding-bottom: 24px;

                if AppData.obras_list.length == 0 : Rectangle {
                    height: 220px;
                    border-radius: 8px;
                    background: #ffffff;
                    border-width: 1px;
                    border-color: #e2e8f0;

                    VerticalLayout {
                        alignment: center;
                        spacing: 10px;

                        Text { text: "🏗"; font-size: 36px; horizontal-alignment: center; }
                        Text {
                            text: "No hay registros de obras vinculados a esta revisión patronal.";
                            font-size: 14px;
                            font-weight: 700;
                            color: #334155;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Haz clic en \"+ Nuevo Registro de Obra\" para agregar una obra de construcción.";
                            font-size: 12px;
                            color: #64748b;
                            horizontal-alignment: center;
                        }
                    }
                }

                for obra in AppData.obras_list : Rectangle {
                    border-radius: 8px;
                    background: #ffffff;
                    border-width: 1px;
                    border-color: #e2e8f0;

                    VerticalLayout {
                        alignment: start;
                        padding: 18px;
                        spacing: 12px;

                        // Línea 1: Icono + Número + Clase + Tipo de Obra
                        HorizontalLayout {
                            alignment: space-between;

                            HorizontalLayout {
                                spacing: 14px;
                                alignment: start;

                                // Icon Box
                                Rectangle {
                                    width: 44px;
                                    height: 44px;
                                    border-radius: 8px;
                                    background: #ecfdf5;
                                    border-width: 1px;
                                    border-color: #a7f3d0;
                                    Text {
                                        text: "🏗";
                                        font-size: 20px;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                VerticalLayout {
                                    spacing: 4px;

                                    HorizontalLayout {
                                        spacing: 8px;
                                        alignment: center;

                                        Text {
                                            text: "REGISTRO: " + obra.numero;
                                            font-size: 16px;
                                            font-weight: 800;
                                            color: #0f172a;
                                        }

                                        if !obra.is_valid_structure : Rectangle {
                                            height: 22px;
                                            border-radius: 4px;
                                            background: #fee2e2;
                                            border-width: 1px;
                                            border-color: #fca5a5;
                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                Text {
                                                    text: "⚠️ Estructura no válida";
                                                    font-size: 11px;
                                                    font-weight: 700;
                                                    color: #b91c1c;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        // Badge Clase
                                        Rectangle {
                                            height: 22px;
                                            border-radius: 4px;
                                            background: #eff6ff;
                                            border-width: 1px;
                                            border-color: #bfdbfe;
                                            HorizontalLayout {
                                                padding-left: 6px;
                                                padding-right: 6px;
                                                Text {
                                                    text: "CLASE: " + obra.clase;
                                                    font-size: 11px;
                                                    font-weight: 800;
                                                    color: #1d4ed8;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }

                                    Text {
                                        text: "Tipo: " + obra.tipo_obra;
                                        font-size: 13px;
                                        font-weight: 600;
                                        color: #475569;
                                    }
                                }
                            }

                            // Monto Destacado a la derecha
                            VerticalLayout {
                                alignment: center;
                                spacing: 2px;
                                Text { text: "MONTO CONTRATADO"; font-size: 10px; font-weight: 800; color: #64748b; horizontal-alignment: right; }
                                Text {
                                    text: obra.monto_str;
                                    font-size: 17px;
                                    font-weight: 800;
                                    color: #047857;
                                    horizontal-alignment: right;
                                }
                            }
                        }

                        // Línea 2: Ubicación
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            Text { text: "📍"; font-size: 13px; vertical-alignment: center; }
                            Text {
                                text: "Ubicación:";
                                font-size: 12px;
                                font-weight: 800;
                                color: #334155;
                                vertical-alignment: center;
                            }
                            Text {
                                text: obra.ubicacion != "" ? obra.ubicacion : "Sin ubicación especificada";
                                font-size: 12px;
                                color: #475569;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle {
                            height: 1px;
                            background: #f1f5f9;
                        }

                        // Línea 3: Grid de Datos
                        HorizontalLayout {
                            spacing: 14px;

                            // 1. Fecha Inicio
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "Fecha Inicio"; font-size: 11px; font-weight: 700; color: #64748b; }
                                Text { text: obra.fecha_inicio; font-size: 13px; font-weight: 800; color: #0f172a; }
                            }

                            // 2. Fecha Fin
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "Fecha Fin"; font-size: 11px; font-weight: 700; color: #64748b; }
                                Text { text: obra.fecha_fin; font-size: 13px; font-weight: 800; color: #0f172a; }
                            }

                            // 3. Superficie Construida
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "Superficie Construida"; font-size: 11px; font-weight: 700; color: #64748b; }
                                Text { text: obra.superficie_construida_str; font-size: 13px; font-weight: 800; color: #0f172a; }
                            }

                            // 4. Delegación
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "Delegación IMSS"; font-size: 11px; font-weight: 700; color: #64748b; }
                                Text { text: obra.delegacion != "" ? obra.delegacion : "--"; font-size: 13px; font-weight: 700; color: #334155; }
                            }

                            // 5. Subdelegación
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;
                                Text { text: "Subdelegación"; font-size: 11px; font-weight: 700; color: #64748b; }
                                Text { text: obra.subdelegacion != "" ? obra.subdelegacion : "--"; font-size: 13px; font-weight: 700; color: #334155; }
                            }
                        }

                        // Línea 4: Acciones Inferiores
                        HorizontalLayout {
                            alignment: end;
                            spacing: 10px;

                            // Botón Editar Obra
                            Rectangle {
                                height: 34px;
                                border-radius: 6px;
                                background: btn_edit_obra.has-hover ? #eff6ff : #ffffff;
                                border-width: 1px;
                                border-color: #bfdbfe;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 6px;
                                    alignment: center;
                                    Text { text: "✏"; font-size: 12px; color: #1d4ed8; vertical-alignment: center; }
                                    Text {
                                        text: "Editar Obra";
                                        font-size: 12px;
                                        font-weight: 700;
                                        color: #1d4ed8;
                                        vertical-alignment: center;
                                    }
                                }

                                btn_edit_obra := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        AppLogic.select_obra_for_edit(obra.id);
                                    }
                                }
                            }

                            // Botón Eliminar
                            Rectangle {
                                height: 34px;
                                width: 36px;
                                border-radius: 6px;
                                background: btn_del_obra.has-hover ? #fef2f2 : #ffffff;
                                border-width: 1px;
                                border-color: #fecaca;

                                Text {
                                    text: "🗑";
                                    font-size: 13px;
                                    color: #dc2626;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                btn_del_obra := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => {
                                        AppLogic.open_delete_obra_dialog(obra.id, obra.numero);
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ==========================================
    // MODAL: NUEVA / EDITAR OBRA
    // ==========================================
    if AppData.show_obra_modal : Rectangle {
        background: #00000077;
        width: 100%;
        height: 100%;

        Rectangle {
            width: 720px;
            height: 600px;
            border-radius: 12px;
            background: #ffffff;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                // Header Modal
                HorizontalLayout {
                    alignment: space-between;

                    VerticalLayout {
                        spacing: 2px;
                        Text {
                            text: AppData.obra_form_is_editing ? "Editar Registro de Obra" : "Nuevo Registro de Obra";
                            font-size: 17px;
                            font-weight: 800;
                            color: #0f172a;
                        }
                        Text {
                            text: "Registro de obra ante el IMSS según Reglamento del Seguro Social Obligatorio.";
                            font-size: 11px;
                            color: #64748b;
                        }
                    }

                    Rectangle {
                        width: 28px;
                        height: 28px;
                        border-radius: 14px;
                        background: btn_close_obra.has-hover ? #fee2e2 : #f1f5f9;
                        Text {
                            text: "✕";
                            font-size: 12px;
                            font-weight: 800;
                            color: btn_close_obra.has-hover ? #b91c1c : #64748b;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                        btn_close_obra := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.close_obra_dialog(); }
                        }
                    }
                }

                Rectangle { height: 1px; background: #e2e8f0; }

                // Form Scrollable
                ScrollView {
                    vertical-stretch: 1;

                    VerticalLayout {
                        spacing: 14px;

                        // Línea 1: Número de Obra + Clase
                        HorizontalLayout {
                            spacing: 14px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Número de Registro de Obra * (SIROC / SATIC)"; font-size: 11px; font-weight: 700; color: #334155; }
                                LineEdit {
                                    text <=> AppData.obra_form_numero;
                                    placeholder-text: "Ej. C1234567 o 08-12345-67";
                                    edited => { AppLogic.validate_obra_input(); }
                                    changed text => { AppLogic.validate_obra_input(); }
                                }
                                if AppData.obra_form_numero_msg != "" : Text {
                                    text: AppData.obra_form_numero_msg;
                                    font-size: 10px;
                                    font-weight: 600;
                                    color: AppData.obra_form_numero_status == "valid" ? #16a34a : #dc2626;
                                    wrap: word-wrap;
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Clase de Obra *"; font-size: 11px; font-weight: 700; color: #334155; }
                                ComboBox {
                                    model: AppData.clases_obra_combo;
                                    current-value <=> AppData.obra_form_clase_val;
                                }
                            }
                        }

                        // Línea 2: Tipo de Obra
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "Tipo de Obra *"; font-size: 11px; font-weight: 700; color: #334155; }
                            LineEdit {
                                text <=> AppData.obra_form_tipo_obra;
                                placeholder-text: "Ej. Edificación de Vivienda Multifamiliar / Comercial";
                            }
                        }

                        // Línea 3: Ubicación
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "Ubicación del Centro de Trabajo / Obra *"; font-size: 11px; font-weight: 700; color: #334155; }
                            LineEdit {
                                text <=> AppData.obra_form_ubicacion;
                                placeholder-text: "Ej. Av. Insurgentes Sur 1602, Benito Juárez, CDMX";
                            }
                        }

                        // Línea 4: Fecha Inicio + Fecha Fin
                        HorizontalLayout {
                            spacing: 14px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Fecha de Inicio * (DD/MM/YYYY)"; font-size: 10px; font-weight: 700; color: #475569; }
                                DatePickerField {
                                    date-val <=> AppData.obra_form_fecha_inicio;
                                    placeholder-text: "DD/MM/YYYY (ej. 01/02/2023)";
                                    enabled: true;
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Fecha Fin * (DD/MM/YYYY)"; font-size: 10px; font-weight: 700; color: #475569; }
                                DatePickerField {
                                    date-val <=> AppData.obra_form_fecha_fin;
                                    placeholder-text: "DD/MM/YYYY (ej. 30/11/2023)";
                                    enabled: true;
                                }
                            }
                        }

                        // Línea 5: Superficie Construida + Monto Contratado
                        HorizontalLayout {
                            spacing: 14px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Superficie Construida (m²)"; font-size: 10px; font-weight: 700; color: #475569; }
                                LineEdit {
                                    text <=> AppData.obra_form_superficie;
                                    placeholder-text: "Ej. 4500.00";
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Monto Contratado ($ MXN)"; font-size: 10px; font-weight: 700; color: #475569; }
                                LineEdit {
                                    text <=> AppData.obra_form_monto;
                                    placeholder-text: "Ej. 18500000.00";
                                }
                            }
                        }

                        // Línea 6: Delegación + Subdelegación
                        HorizontalLayout {
                            spacing: 14px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Delegación IMSS"; font-size: 10px; font-weight: 700; color: #475569; }
                                LineEdit {
                                    text <=> AppData.obra_form_delegacion;
                                    placeholder-text: "Ej. Ciudad de México Sur";
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;
                                Text { text: "Subdelegación IMSS"; font-size: 10px; font-weight: 700; color: #475569; }
                                LineEdit {
                                    text <=> AppData.obra_form_subdelegacion;
                                    placeholder-text: "Ej. 01 Hidalgo Sur";
                                }
                            }
                        }
                    }
                }

                Rectangle { height: 1px; background: #e2e8f0; }

                // Footer Modal
                HorizontalLayout {
                    alignment: end;
                    spacing: 12px;

                    // Botón Cancelar
                    Rectangle {
                        height: 38px;
                        border-radius: 6px;
                        background: btn_cancel_obra.has-hover ? #f1f5f9 : #ffffff;
                        border-width: 1px;
                        border-color: #cbd5e1;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            alignment: center;
                            Text {
                                text: "Cancelar";
                                font-size: 12px;
                                font-weight: 700;
                                color: #475569;
                                vertical-alignment: center;
                            }
                        }

                        btn_cancel_obra := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.close_obra_dialog(); }
                        }
                    }

                    // Botón Guardar
                    Rectangle {
                        height: 38px;
                        border-radius: 6px;
                        background: (AppData.obra_form_numero != "" && AppData.obra_form_numero_status == "valid")
                            ? (btn_submit_obra.has-hover ? #047857 : #065f46)
                            : #94a3b8;

                        HorizontalLayout {
                            padding-left: 20px;
                            padding-right: 20px;
                            spacing: 6px;
                            alignment: center;
                            Text { text: "💾"; font-size: 12px; vertical-alignment: center; }
                            Text {
                                text: AppData.obra_form_is_editing ? "Actualizar Registro de Obra" : "Guardar Registro de Obra";
                                font-size: 12px;
                                font-weight: 700;
                                color: #ffffff;
                                vertical-alignment: center;
                            }
                        }

                        btn_submit_obra := TouchArea {
                            mouse-cursor: (AppData.obra_form_numero != "" && AppData.obra_form_numero_status == "valid") ? pointer : default;
                            clicked => {
                                if (AppData.obra_form_numero != "" && AppData.obra_form_numero_status == "valid") {
                                    AppLogic.submit_obra(
                                        AppData.obra_form_id,
                                        AppData.obra_form_numero,
                                        AppData.obra_form_clase_val,
                                        AppData.obra_form_tipo_obra,
                                        AppData.obra_form_fecha_inicio,
                                        AppData.obra_form_fecha_fin,
                                        AppData.obra_form_ubicacion,
                                        AppData.obra_form_superficie,
                                        AppData.obra_form_monto,
                                        AppData.obra_form_delegacion,
                                        AppData.obra_form_subdelegacion
                                    );
                                } else {
                                    AppLogic.validate_obra_input();
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // ==========================================
    // MODAL CARD: CONFIRMAR ELIMINACIÓN OBRA
    // ==========================================
    if AppData.show_delete_obra_modal : Rectangle {
        background: #00000077;
        width: 100%;
        height: 100%;

        Rectangle {
            width: 480px;
            height: 230px;
            border-radius: 12px;
            background: #ffffff;
            border-width: 1px;
            border-color: #fecaca;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;

            VerticalLayout {
                padding: 24px;
                spacing: 16px;

                HorizontalLayout {
                    spacing: 14px;
                    alignment: start;

                    Rectangle {
                        width: 44px;
                        height: 44px;
                        border-radius: 22px;
                        background: #fef2f2;
                        border-width: 1px;
                        border-color: #fecaca;
                        Text {
                            text: "⚠️";
                            font-size: 20px;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    VerticalLayout {
                        spacing: 4px;
                        Text {
                            text: "¿Eliminar Registro de Obra?";
                            font-size: 16px;
                            font-weight: 800;
                            color: #991b1b;
                        }
                        Text {
                            text: "Esta acción eliminará el registro de obra seleccionado y sus vinculaciones asociadas.";
                            font-size: 12px;
                            color: #475569;
                            wrap: word-wrap;
                        }
                    }
                }

                // Card resumen
                Rectangle {
                    border-radius: 6px;
                    background: #f8fafc;
                    border-width: 1px;
                    border-color: #e2e8f0;

                    VerticalLayout {
                        padding: 12px;
                        spacing: 4px;
                        Text {
                            text: "REGISTRO DE OBRA:";
                            font-size: 10px;
                            font-weight: 800;
                            color: #065f46;
                        }
                        Text {
                            text: AppData.delete_obra_numero;
                            font-size: 14px;
                            font-weight: 800;
                            color: #0f172a;
                        }
                    }
                }

                HorizontalLayout {
                    alignment: end;
                    spacing: 10px;

                    // Cancelar
                    Rectangle {
                        height: 36px;
                        border-radius: 6px;
                        background: btn_cancel_del_o.has-hover ? #f1f5f9 : #ffffff;
                        border-width: 1px;
                        border-color: #cbd5e1;

                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            alignment: center;
                            Text {
                                text: "Cancelar";
                                font-size: 12px;
                                font-weight: 700;
                                color: #475569;
                                vertical-alignment: center;
                            }
                        }

                        btn_cancel_del_o := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AppLogic.close_delete_obra_dialog(); }
                        }
                    }

                    // Sí, Eliminar
                    Rectangle {
                        height: 36px;
                        border-radius: 6px;
                        background: btn_confirm_del_o.has-hover ? #b91c1c : #dc2626;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 6px;
                            alignment: center;
                            Text { text: "🗑"; font-size: 12px; color: #ffffff; vertical-alignment: center; }
                            Text {
                                text: "Sí, Eliminar Obra";
                                font-size: 12px;
                                font-weight: 700;
                                color: #ffffff;
                                vertical-alignment: center;
                            }
                        }

                        btn_confirm_del_o := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                AppLogic.confirm_delete_obra(AppData.delete_obra_id);
                            }
                        }
                    }
                }
            }
        }
    }
}
